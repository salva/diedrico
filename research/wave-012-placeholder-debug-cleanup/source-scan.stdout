== operation registry ==
     1	import type { IOperation, OperationDescriptor } from './IOperation';
     2	
     3	type OperationRestorer<TDescriptor extends OperationDescriptor = OperationDescriptor> = (descriptor: TDescriptor) => IOperation;
     4	
     5	export class OperationRegistry {
     6	  private readonly restorers = new Map<string, OperationRestorer>();
     7	
     8	  register<TDescriptor extends OperationDescriptor>(opType: TDescriptor['opType'], restore: OperationRestorer<TDescriptor>): void {
     9	    if (this.restorers.has(opType)) {
    10	      throw new Error(`Duplicate operation descriptor registration: ${opType}`);
    11	    }
    12	    this.restorers.set(opType, restore as OperationRestorer);
    13	  }
    14	
    15	  deserialize(descriptor: OperationDescriptor): IOperation {
    16	    assertOperationDescriptor(descriptor);
    17	    const restore = this.restorers.get(descriptor.opType);
    18	    if (!restore) {
    19	      throw new Error(`Unknown operation type: ${descriptor.opType}`);
    20	    }
    21	    return restore(descriptor);
    22	  }
    23	
    24	  serialize(operation: IOperation): OperationDescriptor {
    25	    if (!operation.serialize) {
    26	      throw new Error(`Operation type cannot be persisted without a descriptor serializer: ${operation.type}`);
    27	    }
    28	    const descriptor = operation.serialize();
    29	    assertOperationDescriptor(descriptor);
    30	    if (!this.restorers.has(descriptor.opType)) {
    31	      throw new Error(`Operation type is not registered: ${descriptor.opType}`);
    32	    }
    33	    return descriptor;
    34	  }
    35	
    36	  getRegisteredTypes(): readonly string[] {
    37	    return [...this.restorers.keys()].sort();
    38	  }
    39	}
    40	
    41	export function assertOperationDescriptor(value: unknown): asserts value is OperationDescriptor {
    42	  if (!value || typeof value !== 'object' || Array.isArray(value)) {
    43	    throw new Error('Invalid operation descriptor: expected object');
    44	  }
    45	  const opType = (value as { opType?: unknown }).opType;
    46	  if (typeof opType !== 'string' || opType.length === 0) {
    47	    throw new Error('Invalid operation descriptor: missing opType');
    48	  }
    49	}
    50	
    51	const defaultRegistry = new OperationRegistry();
    52	let registered = false;
    53	
    54	export function registerAllOperations(registry: OperationRegistry = defaultRegistry): OperationRegistry {
    55	  if (registry === defaultRegistry && registered) {
    56	    return defaultRegistry;
    57	  }
    58	  registerWorldOperationDescriptors(registry);
    59	  registerProcessTreeOperationDescriptors(registry);
    60	  if (registry === defaultRegistry) {
    61	    registered = true;
    62	  }
    63	  return registry;
    64	}
    65	
    66	export function serializeOperation(operation: IOperation): OperationDescriptor {
    67	  return registerAllOperations().serialize(operation);
    68	}
    69	
    70	export function deserializeOperation(descriptor: OperationDescriptor): IOperation {
    71	  return registerAllOperations().deserialize(descriptor);
    72	}
    73	
    74	export function getRegisteredOperationTypes(): readonly string[] {
    75	  return registerAllOperations().getRegisteredTypes();
    76	}
    77	
    78	import { registerWorldOperationDescriptors } from './world/registerWorldOperationDescriptors';
    79	import { registerProcessTreeOperationDescriptors } from './processTree/registerProcessTreeOperationDescriptors';

