--- frontend/src/services/ProjectService.ts ---
     1	/**
     2	 * ProjectService - current-schema command-stream persistence orchestration.
     3	 */
     4	
     5	import { World } from '@/domain/world/World';
     6	import type { CommandStack } from '@/commands/CommandStack';
     7	import { Command, type CommandSnapshot } from '@/commands/Command';
     8	import type { OperationDescriptor } from '@/commands/operations/IOperation';
     9	import { deserializeOperation } from '@/commands/operations/OperationRegistry';
    10	
    11	export interface ProjectData {
    12	  id: string;
    13	  name: string;
    14	  schemaVersion: string;
    15	  created: string;
    16	  modified: string;
    17	  nextElementId: number;
    18	  commands: SerializedCommand[];
    19	}
    20	
    21	type SerializedCommand = CommandSnapshot;
    22	type SerializedOperation = OperationDescriptor;
    23	
    24	export class ProjectService {
    25	  private static readonly SCHEMA_VERSION = '6.0.0';
    26	
    27	  static serializeCommands(commandStack: CommandStack, nextElementId: number, projectName: string): ProjectData {
    28	    if (!Number.isInteger(nextElementId) || nextElementId < 1) {
    29	      throw new Error(`Invalid next element ID: ${nextElementId}`);
    30	    }
    31	    const now = new Date().toISOString();
    32	    const commands = commandStack.getCommittedCommands().map(command => command.toSnapshot());
    33	
    34	    return {
    35	      id: this.generateProjectId(),
    36	      name: projectName,
    37	      schemaVersion: this.SCHEMA_VERSION,
    38	      created: now,
    39	      modified: now,
    40	      nextElementId,
    41	      commands
    42	    };
    43	  }
    44	
    45	  static deserializeCommands(data: ProjectData, world: World, commandStack: CommandStack): void {
    46	    this.validateProjectData(data);
    47	    commandStack.clear();
    48	    world.restoreNextId(data.nextElementId);
    49	
    50	    const restoredCommands: Command[] = [];
    51	    for (const serializedCommand of data.commands) {
    52	      const operations = serializedCommand.operations.map((descriptor: SerializedOperation) => deserializeOperation(descriptor));
    53	      for (const operation of operations) {
    54	        const result = operation.apply(world);
    55	        if (!result.success) {
    56	          throw new Error(`Failed to replay operation ${operation.type}: ${result.error}`);
    57	        }
    58	      }
    59	      restoredCommands.push(Command.restore({
    60	        id: serializedCommand.id,
    61	        timestamp: serializedCommand.timestamp,
    62	        description: serializedCommand.description,
    63	        operations
    64	      }, world));
    65	    }
    66	
    67	    commandStack.restoreCommittedCommands(restoredCommands);
    68	
    69	    if (!world.getActivePlaneId()) {
    70	      const planes = world.getAllProjectionPlanes();
    71	      const ph = planes.find(p => p.id === 'projPlaneH' || p.name === 'P_H');
    72	      if (ph) {
    73	        world.setActivePlaneId(ph.id);
    74	      } else if (planes.length > 0) {
    75	        world.setActivePlaneId(planes[0].id);
    76	      }
    77	    }
    78	  }
    79	
    80	  static validateProjectData(data: unknown): asserts data is ProjectData {
    81	    if (!data || typeof data !== 'object' || Array.isArray(data)) {
    82	      throw new Error('Invalid project file - not a valid JSON object');
    83	    }
    84	    const record = data as Partial<ProjectData>;
    85	    if (record.schemaVersion !== this.SCHEMA_VERSION) {
    86	      throw new Error(`Unsupported project schema version: ${String(record.schemaVersion)}`);
    87	    }
    88	    for (const field of ['id', 'name', 'created', 'modified'] as const) {
    89	      if (typeof record[field] !== 'string' || record[field]!.length === 0) {
    90	        throw new Error(`Invalid project file - missing required field: ${field}`);
    91	      }
    92	    }
    93	    if (!Number.isInteger(record.nextElementId) || record.nextElementId < 1) {
    94	      throw new Error('Invalid project file - nextElementId must be a positive integer');
    95	    }
    96	    if (!Array.isArray(record.commands)) {
    97	      throw new Error('Invalid project file - commands must be an array');
    98	    }
    99	    for (const command of record.commands) {
   100	      this.validateSerializedCommand(command);
   101	    }
   102	  }
   103	
   104	  private static validateSerializedCommand(command: unknown): asserts command is SerializedCommand {
   105	    if (!command || typeof command !== 'object' || Array.isArray(command)) {
   106	      throw new Error('Invalid project file - command must be an object');
   107	    }
   108	    const record = command as Partial<SerializedCommand>;
   109	    if (typeof record.id !== 'string' || record.id.length === 0) {
   110	      throw new Error('Invalid project file - command missing id');
   111	    }
   112	    if (typeof record.timestamp !== 'string' || Number.isNaN(Date.parse(record.timestamp))) {
   113	      throw new Error(`Invalid project file - command ${record.id} has invalid timestamp`);
   114	    }
   115	    if (typeof record.description !== 'string' || record.description.length === 0) {
   116	      throw new Error(`Invalid project file - command ${record.id} missing description`);
   117	    }
   118	    if (record.status !== 'committed') {
   119	      throw new Error(`Invalid project file - command ${record.id} must be committed`);
   120	    }
   121	    if (!Array.isArray(record.operations) || record.operations.length === 0) {
   122	      throw new Error(`Invalid project file - command ${record.id} must contain operations`);
   123	    }
   124	    for (const operation of record.operations) {
   125	      if (!operation || typeof operation !== 'object' || Array.isArray(operation) || typeof (operation as { opType?: unknown }).opType !== 'string') {
   126	        throw new Error(`Invalid project file - command ${record.id} has invalid operation descriptor`);
   127	      }
   128	    }
   129	  }
   130	
   131	  private static generateProjectId(): string {
   132	    return `proj_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;
   133	  }
   134	}
--- frontend/src/services/GoogleDriveService.ts ---
     1	/**
     2	 * GoogleDriveService
     3	 * 
     4	 * Service for interacting with Google Drive API to store and retrieve project files.
     5	 * Projects are stored in a "diedrico" folder in the user's Google Drive as .diedrico files.
     6	 * 
     7	 * Architecture:
     8	 * - Direct browser-to-Drive communication using gapi.client
     9	 * - OAuth2 authentication with scope: drive.file (app-created files only)
    10	 * - No backend server required
    11	 * 
    12	 * @see specs/001-dihedral-learning-mvp/ui-spec.md - Startup Flow and Google Drive Authentication
    13	 * @see specs/001-dihedral-learning-mvp/data-model.md - Persistence Strategy
    14	 */
    15	
    16	/// <reference types="gapi" />
    17	/// <reference types="gapi.client.drive-v3" />
    18	
    19	export interface GoogleDriveFile {
    20	  id: string;
    21	  name: string;
    22	  modifiedTime: string;
    23	}
    24	
    25	export interface GoogleDriveConfig {
    26	  clientId: string;
    27	  apiKey?: string;  // Optional: recommended for quota tracking but not required for OAuth
    28	  appId: string;
    29	}
    30	
    31	export interface GoogleUserProfile {
    32	  name: string;       // Display name (e.g., "John Doe")
    33	  email: string;      // Email address
    34	  picture?: string;   // Avatar URL (if available)
    35	  sub: string;        // Google user ID (unique identifier)
    36	}
    37	
    38	/**
    39	 * Service for Google Drive operations
    40	 */
    41	export class GoogleDriveService {
    42	  private static readonly DISCOVERY_DOCS = [
    43	    'https://www.googleapis.com/discovery/v1/apis/drive/v3/rest',
    44	  ];
    45	  
    46	  // T400: Add profile and email scopes for user profile information
    47	  private static readonly SCOPES = 'https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email';
    48	  
    49	  private static readonly FOLDER_NAME = 'diedrico';
    50	  private static readonly FILE_EXTENSION = '.diedrico';
    51	  
    52	  private config: GoogleDriveConfig;
    53	  private initialized = false;
    54	  private initializing = false; // Prevent multiple simultaneous initializations
    55	  private folderId: string | null = null;
    56	  private tokenClient: any = null;
    57	  private accessToken: string | null = null;
    58	
    59	  constructor(config: GoogleDriveConfig) {
    60	    this.config = config;
    61	  }
    62	
    63	  /**
    64	   * Initialize Google API client with new Google Identity Services
    65	   */
    66	  async initialize(): Promise<void> {
    67	    if (this.initialized) {
    68	      return;
    69	    }
    70	    
    71	    // Prevent multiple simultaneous initializations
    72	    if (this.initializing) {
    73	      return;
    74	    }
    75	    
    76	    this.initializing = true;
    77	
    78	    return new Promise((resolve, reject) => {
    79	      // Load gapi client
    80	      gapi.load('client', async () => {
    81	        try {
    82	          console.log('[GoogleDrive] Initializing with config:', {
    83	            clientId: this.config.clientId?.substring(0, 20) + '...',
    84	            hasApiKey: !!this.config.apiKey,
    85	            scope: GoogleDriveService.SCOPES,
    86	          });
    87	          
    88	          // Initialize gapi client (for Drive API calls)
    89	          const initConfig: any = {
    90	            discoveryDocs: GoogleDriveService.DISCOVERY_DOCS,
    91	          };
    92	          
    93	          if (this.config.apiKey) {
    94	            initConfig.apiKey = this.config.apiKey;
    95	          }
    96	          
    97	          await gapi.client.init(initConfig);
    98	          
    99	          // Initialize Token Client (new GIS auth)
   100	          this.tokenClient = (window as any).google.accounts.oauth2.initTokenClient({
   101	            client_id: this.config.clientId,
   102	            scope: GoogleDriveService.SCOPES,
   103	            callback: '', // Will be set during signIn
   104	          });
   105	          
   106	          this.initialized = true;
   107	          this.initializing = false;
   108	          console.log('[GoogleDrive] Initialization successful');
   109	          
   110	          // Try to restore previous session AFTER initialization is complete
   111	          await this.tryRestoreSession();
   112	          resolve();
   113	        } catch (error: any) {
   114	          console.error('[GoogleDrive] Initialization failed:', error);
   115	          console.error('[GoogleDrive] Error details:', JSON.stringify(error, null, 2));
   116	          reject(new Error(`Failed to initialize Google API: ${error.error || error.message || JSON.stringify(error)}`));
   117	        }
   118	      });
   119	    });
   120	  }
   121	
   122	  /**
   123	   * Try to restore previous session (silent sign-in)
   124	   */
   125	  private async tryRestoreSession(): Promise<void> {
   126	    const wasSignedIn = localStorage.getItem('diedrico_was_signed_in');
   127	    if (wasSignedIn === 'true') {
   128	      try {
   129	        // Try silent sign-in (no popup if user is still signed in to Google)
   130	        await this.signInSilently();
   131	        console.log('[GoogleDrive] Session restored automatically');
   132	      } catch (error) {
   133	        console.log('[GoogleDrive] Could not restore session:', error);
   134	        localStorage.removeItem('diedrico_was_signed_in');
   135	      }
   136	    }
   137	  }
   138	
   139	  /**
   140	   * Check if user is signed in (has valid access token)
   141	   */
   142	  isSignedIn(): boolean {
   143	    // Check if we have an access token, or if gapi client has a token
   144	    const token = gapi.client.getToken();
   145	    return this.accessToken !== null || (token !== null && token.access_token !== undefined);
   146	  }
   147	
   148	  /**
   149	   * Sign in silently (no popup) if user is already signed in to Google
   150	   */
   151	  private async signInSilently(): Promise<void> {
   152	    // Don't call initialize again - we should already be initialized
   153	    if (!this.initialized) {
   154	      throw new Error('Service not initialized');
   155	    }
   156	
   157	    return new Promise((resolve, reject) => {
   158	      try {
   159	        this.tokenClient.callback = (response: any) => {
   160	          if (response.error) {
   161	            reject(new Error(response.error));
   162	            return;
   163	          }
   164	          
   165	          this.accessToken = response.access_token;
   166	          gapi.client.setToken({ access_token: this.accessToken });
   167	          localStorage.setItem('diedrico_was_signed_in', 'true');
   168	          resolve();
   169	        };
   170	        
   171	        // Request access token silently (no popup if already signed in)
   172	        this.tokenClient.requestAccessToken({ prompt: '' });
   173	      } catch (error: any) {
   174	        reject(error);
   175	      }
   176	    });
   177	  }
   178	
   179	  /**
   180	   * Sign in with Google using new GIS library (shows popup)
   181	   */
   182	  async signIn(): Promise<void> {
   183	    if (!this.initialized) {
   184	      await this.initialize();
   185	    }
   186	
   187	    return new Promise((resolve, reject) => {
   188	      try {
   189	        this.tokenClient.callback = (response: any) => {
   190	          if (response.error) {
   191	            if (response.error === 'popup_closed_by_user') {
   192	              reject(new Error('Sign-in cancelled by user'));
   193	            } else if (response.error === 'access_denied') {
   194	              reject(new Error('Access denied. Please grant permission to access Google Drive.'));
   195	            } else {
   196	              reject(new Error(`Sign-in failed: ${response.error}`));
   197	            }
   198	            return;
   199	          }
   200	          
   201	          this.accessToken = response.access_token;
   202	          gapi.client.setToken({ access_token: this.accessToken });
   203	          localStorage.setItem('diedrico_was_signed_in', 'true');
   204	          console.log('[GoogleDrive] Sign-in successful');
   205	          resolve();
   206	        };
   207	        
   208	        // Request access token (will show popup)
   209	        this.tokenClient.requestAccessToken({ prompt: 'consent' });
   210	      } catch (error: any) {
   211	        reject(new Error(`Sign-in failed: ${error.message}`));
   212	      }
   213	    });
   214	  }
   215	
   216	  /**
