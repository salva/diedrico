   219	  async signOut(): Promise<void> {
   220	    if (!this.initialized) {
   221	      return;
   222	    }
   223	
   224	    try {
   225	      if (this.accessToken) {
   226	        await (window as any).google.accounts.oauth2.revoke(this.accessToken);
   227	        this.accessToken = null;
   228	        gapi.client.setToken(null);
   229	      }
