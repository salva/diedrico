   902	  private generate3DProjectionPrimitives(context: PrimitiveContext): Primitive[] {
   903	    if (!context.showProjectedElements) return [];
   904	
   905	    const primitives: Primitive[] = [];
   906	    const world = context.world;
   907	    const EPSILON = 1e-10;
   908	
   909	    for (const plane of world.getAllProjectionPlanes()) {
   910	      const planeRealization = world.getProjectionPlane3DRealization(plane.id);
   911	      if (!planeRealization) continue;
   912	
   913	      const threeDToPlane = planeRealization.threeDToPlane;
   914	      const planeToPaper = context.planeTransforms.get(plane.id);
   915	      if (!planeToPaper) continue;
   916	
   917	      // Project all feasible 3D points
   918	      for (const point3D of world.getAll3DPoints()) {
   919	        const realization = point3D.realize3D(world);
   920	        if (!realization || !realization.isFeasible()) continue;
   921	
   922	        const planeCoords = applyMatrix3x4(realization.position, threeDToPlane);
   923	        const paperPos = planeCoords.clone().applyMatrix3(planeToPaper);
   924	
   925	        primitives.push({
   926	          type: 'point',
   927	          id: `proj3d-point-${point3D.id}-on-${plane.id}`,
   928	          sourceEntityId: point3D.id,
   929	          planeId: plane.id,
   930	          layer: RenderLayer.Guides + 3,   // Between Guides(10) and Elements(20)
   931	          visible: true,
   932	          style: PROJECTED_POINT_STYLE,
   933	          position: paperPos,
   934	          radius: 6,
   935	        } as PointPrimitive);
   936	      }
   937	
   938	      // Project all feasible 3D lines
   939	      for (const line3D of world.getAll3DLines()) {
   940	        const realization = line3D.realize3D(world);
   941	        if (!realization || !realization.isFeasible()) continue;
   942	
   943	        // Project point (w=1) and direction (w=0) separately via threeDToPlane
   944	        const projPoint = applyMatrix3x4(realization.point, threeDToPlane);
   945	        const projDir = applyMatrix3x4(realization.direction, threeDToPlane);
   946	
   947	        // Skip degenerate cases: direction projects to zero (line perpendicular to plane)
   948	        if (projDir.length() < EPSILON) continue;
   949	
   950	        const paperPoint = projPoint.clone().applyMatrix3(planeToPaper);
   951	        const paperDir = projDir.clone().applyMatrix3(planeToPaper);
   952	
   953	        primitives.push({
   954	          type: 'line',
   955	          id: `proj3d-line-${line3D.id}-on-${plane.id}`,
   956	          sourceEntityId: line3D.id,
   957	          planeId: plane.id,
   958	          layer: RenderLayer.Guides + 3,
   959	          visible: true,
   960	          style: PROJECTED_LINE_STYLE,
   961	          point: paperPoint,
   962	          direction: paperDir,
   963	        } as LinePrimitive);
   964	      }
   965	
   966	      // Project all feasible 3D segments
   967	      for (const segment3D of world.getAll3DSegments()) {
   968	        const realization = segment3D.realize3D(world);
   969	        if (!realization || !realization.isFeasible()) continue;
   970	
   971	        const projStart = applyMatrix3x4(realization.startPoint, threeDToPlane);
   972	        const projEnd = applyMatrix3x4(realization.endPoint, threeDToPlane);
   973	
   974	        const paperStart = projStart.clone().applyMatrix3(planeToPaper);
   975	        const paperEnd = projEnd.clone().applyMatrix3(planeToPaper);
   976	
   977	        primitives.push({
   978	          type: 'segment',
   979	          id: `proj3d-segment-${segment3D.id}-on-${plane.id}`,
   980	          sourceEntityId: segment3D.id,
   981	          planeId: plane.id,
   982	          layer: RenderLayer.Guides + 3,
   983	          visible: true,
   984	          style: PROJECTED_SEGMENT_STYLE,
   985	          point1: paperStart,
   986	          point2: paperEnd,
   987	        } as SegmentPrimitive);
   988	      }
   989	    }
