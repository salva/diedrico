## Paper 79,180p
    79	 * Base interface for all drawing primitives
    80	 */
    81	export interface DrawingPrimitive {
    82	  id: string;                       // Unique ID for this primitive
    83	  sourceEntityId?: string;          // ID of domain entity that generated this primitive
    84	  planeId?: string;                 // Plane this element belongs to (for hit testing filter)
    85	  layer: RenderLayer;               // Z-ordering layer
    86	  visible: boolean;                 // Whether to render this primitive
    87	  style: ResolvedStyle;             // Fully resolved visual attributes
    88	}
    89	
    90	/**
    91	 * Point primitive - rendered as a circle
    92	 * Coordinates in paper coordinate system
    93	 */
    94	export interface PointPrimitive extends DrawingPrimitive {
    95	  type: 'point';
    96	  position: Vector3;                // Position in paper space (homogeneous coordinates)
    97	  radius: number;                   // Display radius in pixels
    98	}
    99	
   100	/**
   101	 * Path primitive - rendered as polyline or polygon
   102	 * All coordinates in paper coordinate system
   103	 */
   104	export interface PathPrimitive extends DrawingPrimitive {
   105	  type: 'path';
   106	  points: Array<[number, number]>; // Array of [x, y] coordinates in paper space
   107	  closed: boolean;                  // Connect last to first point?
   108	}
   109	
   110	/**
   111	 * Line primitive - infinite line in parametric form (clipped to viewport bounds)
   112	 * Parametric form: P(t) = point + t * direction
   113	 * All coordinates in paper coordinate system
   114	 */
   115	export interface LinePrimitive extends DrawingPrimitive {
   116	  type: 'line';
   117	  point: Vector3;                     // Point on the line (paper coords, homogeneous)
   118	  direction: Vector3;                 // Direction vector (paper coords, homogeneous)
   119	}
   120	
   121	/**
   122	 * Segment primitive - finite line segment between two points
   123	 * Endpoints are stored as Vector3 for compatibility with Three.js
   124	 * Coordinates in paper coordinate system
   125	 */
   126	export interface SegmentPrimitive extends DrawingPrimitive {
   127	  type: 'segment';
   128	  point1: Vector3;                    // First endpoint in paper space (homogeneous coordinates)
   129	  point2: Vector3;                    // Second endpoint in paper space (homogeneous coordinates)
   130	}
   131	
   132	/**
   133	 * Circle primitive
   134	 * Coordinates in paper coordinate system
   135	 */
   136	export interface CirclePrimitive extends DrawingPrimitive {
   137	  type: 'circle';
   138	  cx: number;                       // Center X coordinate in paper space
   139	  cy: number;                       // Center Y coordinate in paper space
   140	  radius: number;                   // Radius in paper space units
   141	}
   142	
   143	/**
   144	 * Arc primitive
   145	 * Coordinates in paper coordinate system
   146	 */
   147	export interface ArcPrimitive extends DrawingPrimitive {
   148	  type: 'arc';
   149	  cx: number;                       // Center X coordinate in paper space
   150	  cy: number;                       // Center Y coordinate in paper space
   151	  radius: number;                   // Radius in paper space units
   152	  startAngle: number;               // Start angle in radians
   153	  endAngle: number;                 // End angle in radians
   154	  largeArc: boolean;                // SVG large-arc-flag
   155	  sweep: boolean;                   // SVG sweep-flag (clockwise)
   156	}
   157	
   158	/**
   159	 * Text primitive for labels
   160	 * Coordinates in paper coordinate system
   161	 */
   162	export interface TextPrimitive extends DrawingPrimitive {
   163	  type: 'text';
   164	  x: number;                        // X coordinate in paper space
   165	  y: number;                        // Y coordinate in paper space
   166	  text: string;                     // Text content
   167	  fontSize: number;                 // Font size in pixels
   168	  anchor: 'start' | 'middle' | 'end'; // Text alignment
   169	}
   170	
   171	/**
   172	 * Union type of all drawing primitives
   173	 */
   174	export type Primitive = 
   175	  | PointPrimitive 
   176	  | PathPrimitive
   177	  | LinePrimitive
   178	  | SegmentPrimitive
   179	  | CirclePrimitive 
   180	  | ArcPrimitive 
## Paper 331,460p
   331	  hitTest(
   332	    canvasPos: Vector3,
   333	    snapRadiusPixels: number,
   334	    activePlaneId: string | undefined,
   335	    paperToPlaneTransform: Matrix3 | undefined,
   336	    world: World,
   337	    selectionMask?: SelectionMask
   338	  ): HitResult | null {
   339	    if (!activePlaneId || !paperToPlaneTransform) {
   340	      // No active plane or transform - cannot perform hit testing
   341	      return null;
   342	    }
   343	
   344	    // Transform canvas → paper using inverse viewport
   345	    const paperPos = this.canvasToPaper(canvasPos);
   346	    
   347	    // Transform paper → plane using plane's inverse transform
   348	    const planePos = paperPos.clone().applyMatrix3(paperToPlaneTransform);
   349	    
   350	    // Transform snap radius as a VECTOR (not scalar) to handle non-uniform scaling
   351	    // The radius vector (snapRadiusPixels, 0, 0) in canvas space transforms through
   352	    // the same coordinate chain, properly accounting for scaling and rotation
   353	    const canvasRadiusVector = new Vector3(snapRadiusPixels, 0, 0);
   354	    const paperRadiusVector = canvasRadiusVector.clone().applyMatrix3(this.canvasToPaperMatrix);
   355	    const planeRadiusVector = paperRadiusVector.clone().applyMatrix3(paperToPlaneTransform);
   356	    const planeRadius = planeRadiusVector.length();
   357	    
   358	    // Search entity realizations for closest within radius
   359	    let closestHit: HitResult | null = null;
   360	    let minDistance = planeRadius;
   361	    
   362	    // Get active plane for direct element access
   363	    const activePlane = activePlaneId ? world.projectionPlanes.get(activePlaneId) : null;
   364	    
   365	    // Visual radius for points (used for distance adjustment)
   366	    // Points rendered as circles with ~5px radius; this creates a "capture zone"
   367	    const POINT_VISUAL_RADIUS_PIXELS = 5;
   368	    const pointRadiusInPlaneSpace = POINT_VISUAL_RADIUS_PIXELS / this.viewportTransform.zoom;
   369	    
   370	    // Test points (only from active plane)
   371	    if (activePlane) {
   372	      for (const point of activePlane.getAllPoints()) {
   373	        // Filter by selection mask if provided (uses instanceof)
   374	        const matchesPoint = !selectionMask || selectionMask.matches(point);
   375	        if (!matchesPoint) {
   376	          continue;
   377	        }
   378	        
   379	        const realization = activePlane.realizePoint2D(point, world);
   380	        if (!realization) continue;
   381	        
   382	        const distance = planePos.distanceTo(realization.position);
   383	        
   384	        // Adjust distance by subtracting point visual radius
   385	        // This naturally gives points preference when they're nearby
   386	        const adjustedDistance = distance - pointRadiusInPlaneSpace;
   387	        
   388	        if (adjustedDistance < minDistance) {
   389	          closestHit = {
   390	            elementId: point.id,
   391	            elementType: 'point',
   392	            primitiveId: point.id,
   393	            distance: distance * this.viewportTransform.zoom, // Store actual distance for consistency
   394	            snapPoint: realization.position.clone()  // Snap point in plane coordinates
   395	          };
   396	          minDistance = adjustedDistance;
   397	        }
   398	      }
   399	    }
   400	    
   401	    // Test lines (includes HalfHingeLine2D on active plane)
   402	    if (activePlane) {
   403	      for (const line of activePlane.getAllLines()) {
   404	        // Get actual element type
   405	        const elementType = this.getElementType(line, world);
   406	        
   407	        // Filter by selection mask if provided (uses instanceof)
   408	        const matchesLine = !selectionMask || selectionMask.matches(line);
   409	        if (!matchesLine) {
   410	          continue; // Skip this element - doesn't match selection mask
   411	        }
   412	        
   413	        const realization = activePlane.realizeLine2D(line, world);
   414	        if (!realization) {
   415	          continue;
   416	        }
   417	        
   418	        const distance = this.distanceToLineInPlaneSpace(planePos, realization);
   419	        
   420	        if (distance < minDistance) {
   421	          closestHit = {
   422	            elementId: line.id,
   423	            elementType: elementType,  // Use actual element type, not hardcoded 'line'
   424	            primitiveId: line.id,
   425	            distance: distance * this.viewportTransform.zoom,
   426	            snapPoint: this.snapToLineInPlaneSpace(planePos, realization)
   427	          };
   428	          minDistance = distance;
   429	        }
   430	      }
   431	    }
   432	    
   433	    // Test circles (only from active plane)
   434	    if (activePlane) {
   435	      for (const circle of activePlane.getAllCircles()) {
   436	        // Filter by selection mask if provided (uses instanceof)
   437	        if (selectionMask && !selectionMask.matches(circle)) {
   438	          continue;
   439	        }
   440	        
   441	        const realization = activePlane.realizeCircle2D(circle, world);
   442	        if (!realization) continue;
   443	        
   444	        const distance = this.distanceToCircleInPlaneSpace(planePos, realization);
   445	        
   446	        if (distance < minDistance) {
   447	          closestHit = {
   448	            elementId: circle.id,
   449	            elementType: 'circle',
   450	            primitiveId: circle.id,
   451	            distance: distance * this.viewportTransform.zoom,
   452	            snapPoint: this.snapToCircleInPlaneSpace(planePos, realization)
   453	          };
   454	          minDistance = distance;
   455	        }
   456	      }
   457	    }
   458	    
   459	    // Note: Segments, guides, and hinge lines are all handled in the line iteration above
   460	    // (they're all Line2D subclasses tested from the active plane)
