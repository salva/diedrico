    56	/**
    57	 * Context for primitive generation
    58	 */
    59	export interface PrimitiveContext {
    60	  world: World;
    61	  planeTransforms: Map<string, Matrix3>;  // planeId → plane-to-paper transformation matrix
    62	  highlightedEntityIds?: Set<string>;  // Hover/selection state (legacy - use hoveredIds/selectedIds instead)
    63	  hoveredIds?: Set<string>;            // Hovered entities (lighter highlight)
    64	  selectedIds?: Set<string>;           // Selected entities (bold highlight)
    65	  cascadeHighlightIds?: Set<string>;   // Elements that will be cascade deleted (orange warning)
    66	  activeSnapTargetId?: string;         // Current snap target
    67	  activePlaneId?: string;              // Active plane for visual emphasis (FR-002)
    68	  showProjectedElements?: boolean;     // Phase 106: toggle for 3D element projection display
    69	}
