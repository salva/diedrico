## PaperService 117,207p
   117	  generatePrimitives(context: PrimitiveContext): Primitive[] {
   118	    const primitives: Primitive[] = [];
   119	
   120	    // WALK: Iterate over all projection planes
   121	    for (const plane of context.world.projectionPlanes.values()) {
   122	      const transform = context.planeTransforms.get(plane.id!);
   123	      if (!transform) continue;
   124	
   125	      // WALK: Iterate over all points in this plane
   126	      for (const point of plane.getAllPoints()) {
   127	        // Skip invisible points (Phase 87: Encapsulation support via styleService)
   128	        if (!resolveVisibility(point, context.world)) continue;
   129	        
   130	        // REALIZE: Compute position (numeric data) from plane - computes and caches
   131	        const realization = plane.realizePoint2D(point, context.world);
   132	        
   133	        if (realization) {
   134	          // RENDER: Generate primitive using realization (numeric) + point (structural)
   135	          const primitive = this.pointToPrimitive(point, realization, transform, context);
   136	          primitives.push(primitive);
   137	        }
   138	      }
   139	
   140	      // WALK: Iterate over all lines in this plane (including HalfHingeLine2D)
   141	      // HalfHingeLine2D are Line2D entities with type 'half-hinge'
   142	      for (const line of plane.getAllLines()) {
   143	        // Skip invisible lines (Phase 87: Encapsulation support via styleService)
   144	        const isVisible = resolveVisibility(line, context.world);
   145	        if (line instanceof HalfHingeLine2D) {
   146	          console.log(`[PaperService] Checking visibility for ${line.constructor.name}: ${line.id} (${line.label}) - visible: ${isVisible}`);
   147	        }
   148	        if (!isVisible) continue;
   149	        
   150	        // REALIZE: Compute line equation (numeric data) from plane - computes and caches
   151	        const realization = plane.realizeLine2D(line, context.world);
   152	        
   153	        if (realization) {
   154	          // Check most specific types first (subclasses before base classes)
   155	          if (line instanceof HalfHingeLine2D) {
   156	            console.log(`[PaperService] Creating primitive for ${line.constructor.name}: ${line.id} (${line.label})`);
   157	            const primitive = this.halfHingeLineToPrimitive(line, realization, transform, line.planeId!, context);
   158	            console.log(`[PaperService] Created primitive:`, primitive.id, 'visible:', primitive.visible, 'layer:', primitive.layer);
   159	            primitives.push(primitive);
   160	          } else if (line instanceof Segment2DByPoints) {
   161	            // Segments are Line2D subclass with finite endpoints
   162	            const primitive = this.segmentToPrimitive(line, realization, transform, context);
   163	            primitives.push(primitive);
   164	          } else if (line instanceof Guide2D || line instanceof SiblingGuide2D) {
   165	            // Guides (both primary and sibling) are perpendicular lines with special rendering
   166	            const primitive = this.guideToPrimitive(line as Guide2D | SiblingGuide2D, realization, transform, context);
   167	            primitives.push(primitive);
   168	            
   169	            // Phase 101: If guide has arcGeometry, create arc primitive
   170	            if ((line as any).arcGeometry) {
   171	              const arcPrimitive = this.arcGeometryToPrimitive(line.id!, (line as any).arcGeometry, context);
   172	              if (arcPrimitive) {
   173	                primitives.push(arcPrimitive);
   174	              }
   175	            }
   176	          } else {
   177	            // RENDER: Normal infinite lines
   178	            const primitive = this.lineToPrimitive(line, realization, transform, context);
   179	            primitives.push(primitive);
   180	          }
   181	        } else {
   182	          // console.warn('[PaperService] Skipping line - missing realization');
   183	        }
   184	      }
   185	
   186	      // WALK: Iterate over all circles in this plane
   187	      for (const circle of plane.getAllCircles()) {
   188	        // Skip invisible circles (Phase 87: Encapsulation support via styleService)
   189	        if (!resolveVisibility(circle, context.world)) continue;
   190	        
   191	        // REALIZE: Compute circle geometry (numeric data) from plane - computes and caches
   192	        const realization = plane.realizeCircle2D(circle, context.world);
   193	        
   194	        if (realization) {
   195	          // RENDER: Generate primitive using realization (numeric) + circle (structural)
   196	          const primitive = this.circleToPrimitive(circle, realization, transform, context);
   197	          primitives.push(primitive);
   198	        }
   199	      }
   200	    }
   201	
   202	    // TODO: Add primitives for other element types (arcs, etc.)
   203	
   204	    // Phase 106: Generate projected 3D element primitives if enabled
   205	    primitives.push(...this.generate3DProjectionPrimitives(context));
   206	
   207	    return primitives;
## PaperService 850,890p
   850	   * Update paper with current primitives
   851	   */
   852	  updatePaper(paper: Paper, context: PrimitiveContext): void {
   853	    // Clear existing primitives
   854	    paper.clear();
   855	
   856	    // Generate new primitives for all planes
   857	    const primitives = this.generatePrimitives(context);
   858	
   859	    // Add to paper
   860	    paper.setPrimitives(primitives);
   861	  }
   862	
   863	  /**
   864	   * Update primitives for a specific entity (incremental update)
   865	   */
   866	  updateEntity(
   867	    entityId: string,
   868	    paper: Paper,
   869	    context: PrimitiveContext
   870	  ): void {
   871	    // Remove old primitives for this entity
   872	    paper.removePrimitivesByEntity(entityId);
   873	
   874	    // Find the entity by searching through planes
   875	    for (const plane of context.world.projectionPlanes.values()) {
   876	      const point = plane.getPoint(entityId);
   877	      if (point) {
   878	        const realization = plane.realizePoint2D(point, context.world);
   879	        const transform = context.planeTransforms.get(point.planeId!);
   880	        
   881	        if (realization && transform) {
   882	          const primitive = this.pointToPrimitive(point, realization, transform, context);
   883	          paper.setPrimitive(primitive);
   884	        }
   885	        return;
   886	      }
   887	
   888	      // TODO: Handle other element types (lines, circles)
   889	    }
   890	  }
