{
  "name": "diedrico",
  "version": "0.1.0",
  "description": "Educational web application for teaching dihedral/orthographic projection",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "validate:routine": "npm run test:architecture && npm run test --workspace=frontend && npm run build --workspace=frontend",
    "validate:docs": "npm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:architecture": "npm run test:architecture --workspace=frontend",
    "test:e2e": "npm run test:e2e --workspace=frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
