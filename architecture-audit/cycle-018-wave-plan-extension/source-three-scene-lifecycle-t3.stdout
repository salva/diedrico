ThreeView.vue
     1	<template>
     2	  <div class="three-view-panel" ref="containerRef">
     3	    <canvas ref="canvasRef" class="three-canvas"></canvas>
     4	    <div class="three-controls">
     5	      <div class="control-group">
     6	        <label class="control-label" title="Show or hide projection plane surfaces in 3D view">
     7	          <input type="checkbox" v-model="displayOptions.showPlanes" @change="handleDisplayChange" />
     8	          Show Planes
     9	        </label>
    10	        <label class="control-label" title="Display 2D geometric elements (points, lines, circles) positioned on their planes in 3D space">
    11	          <input type="checkbox" v-model="displayOptions.show2DElementsOnPlanes" @change="handleDisplayChange" />
    12	          Show 2D Elements on Planes
    13	        </label>
    14	        <label class="control-label" title="Show coordinate grid on each projection plane for spatial reference">
    15	          <input type="checkbox" v-model="displayOptions.showGrid" @change="handleDisplayChange" />
    16	          Show Grid
    17	        </label>
    18	        <label class="control-label" title="Show coordinate axes (X/Y/Z) at origin for spatial reference and debugging">
    19	          <input type="checkbox" v-model="displayOptions.showReferenceAxes" @change="handleDisplayChange" />
    20	          Show Reference Axes
    21	        </label>
    22	      </div>
    23	    </div>
    24	  </div>
    25	</template>
    26	
    27	<script setup lang="ts">
    28	import { inject, onMounted, onUnmounted, ref, watch } from 'vue';
    29	import type { World } from '@/domain/world/World';
    30	import { useSelectionStore } from '@/stores/selectionStore';
    31	import { useViewStore } from '@/stores/viewStore';
    32	import { ThreeViewRuntime } from '@/rendering/threeView/ThreeViewRuntime';
    33	import { createThreeWorldReadPort } from '@/application/threePresentation/ThreeWorldReadPort';
    34	
    35	const containerRef = ref<HTMLDivElement>();
    36	const canvasRef = ref<HTMLCanvasElement>();
    37	const renderTick = ref(0);
    38	
    39	const viewStore = useViewStore();
    40	const displayOptions = viewStore.threeViewOptions;
    41	const selectionStore = useSelectionStore();
    42	const world = inject<World>('world')!;
    43	const readPort = createThreeWorldReadPort(world);
    44	const runtime = new ThreeViewRuntime();
    45	let unsubscribeWorldChanges: (() => void) | undefined;
    46	
    47	function selectedIds(): string[] { return [...selectionStore.selectedIdsArray]; }
    48	function refreshThreeView(): void { runtime.refresh({ readPort, displayOptions: displayOptions.value, selectedIds: selectedIds() }); }
    49	function handleDisplayChange(): void { refreshThreeView(); }
    50	function handleResize(): void { runtime.resize(); }
    51	
    52	onMounted(() => {
    53	  if (!containerRef.value || !canvasRef.value) return;
    54	  runtime.mount({ container: containerRef.value, canvas: canvasRef.value });
    55	  refreshThreeView();
    56	  window.addEventListener('resize', handleResize);
    57	
    58	  const handleWorldChange = () => { renderTick.value++; };
    59	  world.subscribeToChanges(handleWorldChange);
    60	  unsubscribeWorldChanges = () => world.unsubscribeFromChanges(handleWorldChange);
    61	
    62	  watch(renderTick, refreshThreeView);
    63	  watch(() => selectionStore.selectedIdsArray, refreshThreeView);
    64	  watch(displayOptions, refreshThreeView, { deep: true });
    65	});
    66	
    67	onUnmounted(() => {
    68	  unsubscribeWorldChanges?.();
    69	  window.removeEventListener('resize', handleResize);
    70	  runtime.dispose();
    71	});
    72	</script>
    73	
    74	<style scoped>
    75	.three-view-panel {
    76	  position: relative;
    77	  width: 100%;
    78	  height: 100%;
    79	  background: #f5f5f5;
    80	  overflow: hidden;
    81	}
    82	
    83	.three-canvas {
    84	  display: block;
    85	  width: 100%;
    86	  height: 100%;
    87	}
    88	
    89	.three-controls {
    90	  pointer-events: auto;
    91	  position: absolute;
    92	  top: 10px;
    93	  right: 10px;
    94	  background: rgba(255, 255, 255, 0.9);
    95	  padding: 12px;
    96	  border-radius: 4px;
    97	  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    98	}
    99	
   100	.control-group {
   101	  display: flex;
   102	  flex-direction: column;
   103	  gap: 8px;
   104	}
   105	
   106	.control-label {
   107	  display: flex;
   108	  align-items: center;
   109	  gap: 6px;
   110	  font-size: 13px;
   111	  cursor: pointer;
   112	  user-select: none;
   113	}
   114	
   115	.control-label input[type="checkbox"] { cursor: pointer; }
   116	</style>

ThreeViewRuntime.ts
     1	import type { ThreePresentationInput } from '@/application/threePresentation/ThreePresentationModel';
     2	import { ThreePresentationController } from '@/application/threePresentation/ThreePresentationController';
     3	import { ThreeSceneHost, type ThreeSceneHostMount } from './ThreeSceneHost';
     4	import { ProjectionPlaneSceneAdapter } from './ProjectionPlaneSceneAdapter';
     5	import { PlanarElementSceneAdapter } from './PlanarElementSceneAdapter';
     6	import { ReconstructedElementSceneAdapter } from './ReconstructedElementSceneAdapter';
     7	import { GuideSceneAdapter } from './GuideSceneAdapter';
     8	import { HingeSceneAdapter } from './HingeSceneAdapter';
     9	
    10	export class ThreeViewRuntime {
    11	  private readonly host = new ThreeSceneHost();
    12	  private readonly controller = new ThreePresentationController();
    13	  private readonly projectionPlaneAdapter = new ProjectionPlaneSceneAdapter();
    14	  private readonly planarElementAdapter = new PlanarElementSceneAdapter();
    15	  private readonly reconstructedElementAdapter = new ReconstructedElementSceneAdapter();
    16	  private readonly guideAdapter = new GuideSceneAdapter();
    17	  private readonly hingeAdapter = new HingeSceneAdapter();
    18	
    19	  mount(mount: ThreeSceneHostMount): void { this.host.mount(mount); }
    20	
    21	  refresh(input: ThreePresentationInput): void {
    22	    const model = this.controller.buildModel(input);
    23	    this.host.registry.replaceGroup('projectionPlanes', this.projectionPlaneAdapter.createObjects(model.projectionPlanes));
    24	    this.host.registry.replaceGroup('planarElements', this.planarElementAdapter.createObjects(model.planarElements));
    25	    this.host.registry.replaceGroup('reconstructedElements', this.reconstructedElementAdapter.createObjects(model.reconstructedElements));
    26	    this.host.registry.replaceGroup('guides', this.guideAdapter.createObjects(model.guides));
    27	    this.host.registry.replaceGroup('hinges', this.hingeAdapter.createObjects(model.hinges));
    28	  }
    29	
    30	  resize(): void { this.host.resize(); }
    31	  dispose(): void { this.host.dispose(); }
    32	}

ThreeSceneHost.ts
     1	import * as THREE from 'three';
     2	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
     3	import { CSS2DRenderer } from 'three/examples/jsm/renderers/CSS2DRenderer.js';
     4	import { domainDirectionToThreeJS } from '@/utils/threeUtils';
     5	import { ThreeObjectRegistry } from './ThreeObjectRegistry';
     6	
     7	export interface ThreeSceneHostMount { container: HTMLElement; canvas: HTMLCanvasElement }
     8	
     9	export class ThreeSceneHost {
    10	  readonly scene = new THREE.Scene();
    11	  readonly registry = new ThreeObjectRegistry(this.scene);
    12	  private camera?: THREE.PerspectiveCamera;
    13	  private renderer?: THREE.WebGLRenderer;
    14	  private labelRenderer?: CSS2DRenderer;
    15	  private controls?: OrbitControls;
    16	  private animationFrameId?: number;
    17	  private mounted?: ThreeSceneHostMount;
    18	
    19	  mount(mount: ThreeSceneHostMount): void {
    20	    this.mounted = mount;
    21	    this.scene.background = new THREE.Color(0xf5f5f5);
    22	    const aspect = mount.container.clientWidth / Math.max(1, mount.container.clientHeight);
    23	    this.camera = new THREE.PerspectiveCamera(60, aspect, 0.1, 10000);
    24	    const cameraPos = domainDirectionToThreeJS(new THREE.Vector3(1, 1, 1).normalize());
    25	    this.camera.position.set(cameraPos.x * 30, cameraPos.y * 30, cameraPos.z * 30);
    26	    const up = domainDirectionToThreeJS(new THREE.Vector3(0, 0, 1));
    27	    this.camera.up.set(up.x, up.y, up.z);
    28	    this.camera.lookAt(0, 0, 0);
    29	
    30	    this.renderer = new THREE.WebGLRenderer({ canvas: mount.canvas, antialias: true, alpha: false });
    31	    this.renderer.setPixelRatio(window.devicePixelRatio);
    32	    this.labelRenderer = new CSS2DRenderer();
    33	    this.labelRenderer.domElement.style.position = 'absolute';
    34	    this.labelRenderer.domElement.style.top = '0px';
    35	    this.labelRenderer.domElement.style.pointerEvents = 'none';
    36	    mount.container.appendChild(this.labelRenderer.domElement);
    37	    this.controls = new OrbitControls(this.camera, this.renderer.domElement);
    38	    this.controls.enableDamping = true;
    39	    this.controls.dampingFactor = 0.05;
    40	    this.controls.screenSpacePanning = false;
    41	    this.controls.minDistance = 2;
    42	    this.controls.maxDistance = 500;
    43	    this.controls.maxPolarAngle = Math.PI;
    44	    this.scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    45	    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.4);
    46	    directionalLight.position.set(10, 10, 10);
    47	    this.scene.add(directionalLight);
    48	    this.resize();
    49	    this.animate();
    50	  }
    51	
    52	  resize(): void {
    53	    if (!this.mounted || !this.camera || !this.renderer || !this.labelRenderer) return;
    54	    const width = this.mounted.container.clientWidth;
    55	    const height = this.mounted.container.clientHeight;
    56	    this.camera.aspect = width / Math.max(1, height);
    57	    this.camera.updateProjectionMatrix();
    58	    this.renderer.setSize(width, height);
    59	    this.labelRenderer.setSize(width, height);
    60	  }
    61	
    62	  dispose(): void {
    63	    if (this.animationFrameId) cancelAnimationFrame(this.animationFrameId);
    64	    this.registry.dispose();
    65	    this.controls?.dispose();
    66	    this.renderer?.dispose();
    67	    this.labelRenderer?.domElement.remove();
    68	  }
    69	
    70	  private animate = (): void => {
    71	    this.animationFrameId = requestAnimationFrame(this.animate);
    72	    if (!this.camera || !this.renderer || !this.labelRenderer) return;
    73	    this.controls?.update();
    74	    this.renderer.render(this.scene, this.camera);
    75	    this.labelRenderer.render(this.scene, this.camera);
    76	  };
    77	}
