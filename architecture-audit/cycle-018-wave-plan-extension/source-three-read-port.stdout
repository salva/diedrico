     1	import type { Vector4 } from 'three';
     2	import type { Circle2DRealization2D } from '@/domain/world/Circle';
     3	import type { Line2DRealization2D } from '@/domain/world/Line';
     4	import type { Point2DRealization2D } from '@/domain/world/Point';
     5	import type { Point3DRealization3D, Line3DRealization3D, Segment3DRealization3D, Plane3DRealization3D } from '@/domain/world/Element3DRealization3D';
     6	import { AuxiliaryProjectionPlane } from '@/domain/world/projectionPlane/AuxiliaryProjectionPlane';
     7	import type { ProjectionPlaneRealization3D } from '@/domain/world/projectionPlane/ProjectionPlaneRealization';
     8	import type { VisualStyle } from '@/domain/world/VisualStyle';
     9	import type { World } from '@/domain/world/World';
    10	import { isGuide2D, isSiblingGuide2D } from '@/domain/world/Guide';
    11	import { Segment2DByPoints } from '@/domain/world/Segment';
    12	
    13	export interface ThreeEntityPresentationData { id: string; visualStyle?: VisualStyle }
    14	
    15	export interface ThreeProjectionPlaneReadModel {
    16	  id: string;
    17	  kind: 'fixed' | 'auxiliary';
    18	  plane3DId: string | undefined;
    19	  realization: ProjectionPlaneRealization3D | undefined;
    20	}
    21	
    22	export interface ThreePlanarPointReadModel extends ThreeEntityPresentationData { realization: Point2DRealization2D | undefined }
    23	export interface ThreePlanarLineReadModel extends ThreeEntityPresentationData { realization: Line2DRealization2D | undefined; isSegment: boolean }
    24	export interface ThreePlanarCircleReadModel extends ThreeEntityPresentationData { realization: Circle2DRealization2D | undefined | null }
    25	
    26	export interface ThreePlanarPlaneReadModel {
    27	  id: string;
    28	  realization: ProjectionPlaneRealization3D | undefined;
    29	  points: ThreePlanarPointReadModel[];
    30	  lines: ThreePlanarLineReadModel[];
    31	  circles: ThreePlanarCircleReadModel[];
    32	}
    33	
    34	export interface ThreeReconstructedReadModel {
    35	  points: Array<ThreeEntityPresentationData & { realization: Point3DRealization3D | undefined }>;
    36	  lines: Array<ThreeEntityPresentationData & { realization: Line3DRealization3D | undefined }>;
    37	  segments: Array<ThreeEntityPresentationData & { realization: Segment3DRealization3D | undefined }>;
    38	  planes: Array<ThreeEntityPresentationData & { realization: Plane3DRealization3D | undefined }>;
    39	}
    40	
    41	export interface ThreeGuideReadModel extends ThreeEntityPresentationData {
    42	  planeId: string;
    43	  planeRealization: ProjectionPlaneRealization3D | undefined;
    44	  realization: Line2DRealization2D | undefined;
    45	}
    46	
    47	export interface ThreeGuideIntersectionReadModel {
    48	  points: Array<ThreeEntityPresentationData & { cartesian: [number, number, number] | undefined }>;
    49	  lines: Array<ThreeEntityPresentationData & { point: Vector4 | undefined; direction: Vector4 | undefined }>;
    50	  segments: Array<ThreeEntityPresentationData & { startPoint: Vector4 | undefined; endPoint: Vector4 | undefined }>;
    51	}
    52	
    53	export interface ThreeHingeReadModel extends ThreeEntityPresentationData { realization: Line3DRealization3D | undefined }
    54	
    55	export interface ThreeWorldReadPort {
    56	  getProjectionPlaneModels(): ThreeProjectionPlaneReadModel[];
    57	  getProjectionPlaneGridSource(planeId: string): { plane3DRealization: Plane3DRealization3D | undefined; projectionRealization: ProjectionPlaneRealization3D | undefined };
    58	  getPlanarPlaneModels(): ThreePlanarPlaneReadModel[];
    59	  getReconstructedModels(): ThreeReconstructedReadModel;
    60	  getSelectedGuideModels(selectedIds: readonly string[]): ThreeGuideReadModel[];
    61	  getGuideIntersectionModels(): ThreeGuideIntersectionReadModel;
    62	  getHingeModels(): ThreeHingeReadModel[];
    63	}
    64	
    65	export function createThreeWorldReadPort(world: World): ThreeWorldReadPort {
    66	  return {
    67	    getProjectionPlaneModels: () => world.getAllProjectionPlanes().map(plane => ({
    68	      id: plane.id,
    69	      kind: plane instanceof AuxiliaryProjectionPlane ? 'auxiliary' : 'fixed',
    70	      plane3DId: plane instanceof AuxiliaryProjectionPlane ? plane.plane3DId : plane.id,
    71	      realization: world.getProjectionPlane3DRealization(plane.id),
    72	    })),
    73	    getProjectionPlaneGridSource: (planeId: string) => {
    74	      const plane = world.getProjectionPlaneById(planeId);
    75	      const plane3DId = plane instanceof AuxiliaryProjectionPlane ? plane.plane3DId : plane?.id;
    76	      return {
    77	        plane3DRealization: plane3DId ? world.get3DPlaneRealization(plane3DId) : undefined,
    78	        projectionRealization: world.getProjectionPlane3DRealization(planeId),
    79	      };
    80	    },
    81	    getPlanarPlaneModels: () => world.getAllProjectionPlanes().map(plane => ({
    82	      id: plane.id,
    83	      realization: world.getProjectionPlane3DRealization(plane.id),
    84	      points: plane.getAllPoints().map(point => ({ id: point.id, visualStyle: point.visualStyle, realization: point.realize2D(world) })),
    85	      lines: plane.getAllLines().map(line => ({ id: line.id, visualStyle: line.visualStyle, realization: line.realize2D(world), isSegment: line instanceof Segment2DByPoints })),
    86	      circles: plane.getAllCircles().map(circle => ({ id: circle.id, visualStyle: circle.visualStyle, realization: circle.realize2D(world) })),
    87	    })),
    88	    getReconstructedModels: () => ({
    89	      points: world.getAll3DPoints().map(point => ({ id: point.id!, visualStyle: point.visualStyle, realization: world.get3DPointRealization(point.id!) })),
    90	      lines: world.getAll3DLines().map(line => ({ id: line.id!, visualStyle: line.visualStyle, realization: world.get3DLineRealization(line.id!) })),
    91	      segments: world.getAll3DSegments().map(segment => ({ id: segment.id!, visualStyle: segment.visualStyle, realization: world.get3DSegmentRealization(segment.id!) })),
    92	      planes: world.getAllPlanes().map(plane => ({ id: plane.id!, visualStyle: plane.visualStyle, realization: world.get3DPlaneRealization(plane.id!) })),
    93	    }),
    94	    getSelectedGuideModels: (selectedIds: readonly string[]) => selectedIds.flatMap(selectedId => {
    95	      try {
    96	        const line = world.getLine2D(selectedId);
    97	        if (!line || (!isGuide2D(line) && !isSiblingGuide2D(line))) return [];
    98	        return [{ id: line.id, visualStyle: line.visualStyle, planeId: line.planeId, planeRealization: world.getProjectionPlane3DRealization(line.planeId), realization: line.realize2D(world) }];
    99	      } catch {
   100	        return [];
   101	      }
   102	    }),
   103	    getGuideIntersectionModels: () => ({
   104	      points: world.getAll3DPoints().map(point => {
   105	        const realization = world.get3DPointRealization(point.id!);
   106	        return { id: point.id!, visualStyle: point.visualStyle, cartesian: realization?.isFeasible() ? realization.getCartesian() : undefined };
   107	      }),
   108	      lines: world.getAll3DLines().map(line => {
   109	        const realization = world.get3DLineRealization(line.id!);
   110	        return { id: line.id!, visualStyle: line.visualStyle, point: realization?.isFeasible() ? realization.point : undefined, direction: realization?.isFeasible() ? realization.getDirection() : undefined };
   111	      }),
   112	      segments: world.getAll3DSegments().map(segment => {
   113	        const realization = world.get3DSegmentRealization(segment.id!);
   114	        return { id: segment.id!, visualStyle: segment.visualStyle, startPoint: realization?.isFeasible() ? realization.startPoint : undefined, endPoint: realization?.isFeasible() ? realization.endPoint : undefined };
   115	      }),
   116	    }),
   117	    getHingeModels: () => world.getAllHingeLines().map(hingeLine => ({ id: hingeLine.id, visualStyle: hingeLine.visualStyle, realization: hingeLine.realize3D(world) })),
   118	  };
   119	}
