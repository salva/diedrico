     1	/**
     2	 * Line3DReconstruction.test.ts
     3	 * 
     4	 * Tests for 3D line reconstruction from 2D projections.
     5	 * Uses operations to properly build World state, then checks 3D realizations.
     6	 */
     7	
     8	import { describe, it, expect, beforeEach } from 'vitest';
     9	import type { World } from '@/domain/world/World';
    10	import { AddFreePoint2DOp } from '@/commands/operations/world/AddFreePointOp';
    11	import { AddLine2DByTwoPointsOp } from '@/commands/operations/world/AddLineOp';
    12	import { Add3DLineOp } from '@/commands/operations/world/Add3DLineOp';
    13	import { Command } from '@/commands/Command';
    14	import { Vector3, Vector4 } from 'three';
    15	import { createTestWorld } from '../../helpers/worldHelpers';
    16	
    17	describe('Line3D Reconstruction from Projections', () => {
    18	  let world: World;
    19	  let command: Command;
    20	
    21	  beforeEach(() => {
    22	    const { world: w } = createTestWorld();
    23	    world = w;
    24	    command = new Command('test-command', world);
    25	  });
    26	
    27	  /**
    28	   * Helper: Create a 2D line on a projection plane using operations
    29	   * Returns the line ID
    30	   */
    31	  function createLine2D(
    32	    planeId: string,
    33	    x1: number, y1: number,
    34	    x2: number, y2: number,
    35	    label: string
    36	  ): string {
    37	    // Add first point
    38	    const addP1 = new AddFreePoint2DOp(planeId, new Vector3(x1, y1, 1));
    39	    const result1 = command.addAndExecute(addP1);
    40	    const p1Id = result1.outputs.pointId!;
    41	
    42	    // Add second point
    43	    const addP2 = new AddFreePoint2DOp(planeId, new Vector3(x2, y2, 1));
    44	    const result2 = command.addAndExecute(addP2);
    45	    const p2Id = result2.outputs.pointId!;
    46	
    47	    // Add line between points
    48	    const addLine = new AddLine2DByTwoPointsOp(planeId, p1Id, p2Id);
    49	    const result3 = command.addAndExecute(addLine);
    50	    return result3.outputs.lineId!;
    51	  }
    52	
    53	  /**
    54	   * Helper: Create a 3D line from two 2D projections using operations
    55	   * Returns the line3D ID
    56	   */
    57	  function create3DLine(
    58	    line1Id: string, plane1Id: string,
    59	    line2Id: string, plane2Id: string,
    60	    label: string
    61	  ): string {
    62	    const addLine3D = new Add3DLineOp(line1Id, line2Id, plane1Id, plane2Id, label);
    63	    const result = command.addAndExecute(addLine3D);
    64	    return result.outputs.lineId!;
    65	  }
    66	
    67	  /**
    68	   * Helper: Normalize a direction vector
    69	   */
    70	  function normalize(v: Vector4): Vector4 {
    71	    const len = Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
    72	    return new Vector4(v.x / len, v.y / len, v.z / len, 0);
    73	  }
    74	
    75	  /**
    76	   * Helper: Check if two direction vectors are parallel (same or opposite)
    77	   */
    78	  function areParallel(v1: Vector4, v2: Vector4, tolerance = 1e-6): boolean {
    79	    const n1 = normalize(v1);
    80	    const n2 = normalize(v2);
--- frontend/tests/unit/domain/Plane3DFromTraces.test.ts ---
     1	/**
     2	 * Plane3DFromTraces.test.ts
     3	 * 
     4	 * Tests for 3D plane reconstruction from trace lines.
     5	 * Verifies that Plane3DFromTraces correctly reconstructs 3D planes
     6	 * when trace lines intersect via hinge line points.
     7	 */
     8	
     9	import { describe, it, expect, beforeEach } from 'vitest';
    10	import type { World } from '../../../src/domain/world/World';
    11	import { Plane3DFromTraces } from '../../../src/domain/world/Plane';
    12	import { FreePoint2D, Point2DLineLineIntersection } from '../../../src/domain/world/Point';
    13	import { Line2DByTwoPoints } from '../../../src/domain/world/Line';
    14	import { HalfHingeLine2D } from '../../../src/domain/world/HingeLine';
    15	import { Vector3 } from 'three';
    16	import { createTestWorld } from '../../helpers/worldHelpers';
    17	
    18	describe('Plane3DFromTraces - Intersecting via Hinge Line', () => {
    19	  let world: World;
    20	
    21	  beforeEach(() => {
    22	    const { world: w } = createTestWorld();
    23	    world = w;
    24	  });
    25	
    26	  /**
    27	   * Test Case: User's actual scenario
    28	   * 
    29	   * 1. Initialize world
    30	   * 2. Create two points A and B in P_H
    31	   * 3. Create line L passing through A and B
    32	   * 4. Create C as intersection of L with HL_HV
    33	   * 5. Create point D in P_V
    34	   * 6. Create line M between D and C' (C' is sibling of C)
    35	   * 7. Define plane P with traces L and M
    36	   * 
    37	   * Expected: The 3D plane should be feasible since both lines share
    38	   * point C on the hinge line (C and C' map to the same 3D point).
    39	   */
    40	  it('should create feasible 3D plane from user scenario', () => {
    41	    const planeH = world.getProjectionPlaneById('projPlane3'); // P_H
    42	    const planeV = world.getProjectionPlaneById('projPlane4'); // P_V
    43	    
    44	    expect(planeH).toBeDefined();
    45	    expect(planeV).toBeDefined();
    46	    
    47	    if (!planeH || !planeV) throw new Error('Base planes not found');
    48	
    49	    // Find the hinge line on P_H
    50	    const hingeLineH = planeH.getAllLines().find(line => 
    51	      line instanceof HalfHingeLine2D && line.hingeLineId === 'hingeLine7'
    52	    );
    53	    expect(hingeLineH).toBeDefined();
    54	    if (!hingeLineH) throw new Error('Hinge line not found on P_H');
    55	
    56	    // 2. Create two points A and B in P_H
    57	    const pointA = new FreePoint2D(
    58	      'projPlane3/point_A',
    59	      new Vector3(10, 5, 1),
    60	      'projPlane3'
    61	    );
    62	    planeH.addPoint(pointA);
    63	
    64	    const pointB = new FreePoint2D(
    65	      'projPlane3/point_B',
    66	      new Vector3(20, -5, 1),
    67	      'projPlane3'
    68	    );
    69	    planeH.addPoint(pointB);
    70	
    71	    // 3. Create line L passing through A and B
    72	    const lineL = new Line2DByTwoPoints(
    73	      'projPlane3/line_L',
    74	      'projPlane3/point_A',
    75	      'projPlane3/point_B',
    76	      'projPlane3'
    77	    );
    78	    planeH.addLine(lineL);
    79	
    80	    // 4. Create C as intersection of L with HL_HV
--- frontend/tests/unit/domain/Point3DReconstruction.test.ts ---
     1	/**
     2	 * Point3DReconstruction.test.ts
     3	 * 
     4	 * Tests for 3D point reconstruction from 2D projections.
     5	 * Verifies that Point3DFromProjections correctly reconstructs 3D coordinates
     6	 * from horizontal and vertical plane projections.
     7	 */
     8	
     9	import { describe, it, expect, beforeEach } from 'vitest';
    10	import type { World } from '../../../src/domain/world/World';
    11	import { Point3DFromProjections } from '@/domain/world/Point3D';
    12	import { FreePoint2D } from '@/domain/world/Point';
    13	import { Vector3 } from 'three';
    14	import { createVisualStyle } from '../../../src/domain/world/VisualStyle';
    15	import { createTestWorld } from '../../helpers/worldHelpers';
    16	
    17	describe('Point3DFromProjections - Coordinate Reconstruction', () => {
    18	  let world: World;
    19	
    20	  beforeEach(() => {
    21	    const { world: w } = createTestWorld();
    22	    world = w;
    23	  });
    24	
    25	  /**
    26	   * Test Case from User Request:
    27	   * - P_V projection: (x=1, z=1) → in plane coords (u=1, v=1)
    28	   * - P_H projection: (x=1, y=3) → in plane coords (u=1, v=3)
    29	   * - Expected 3D point: (x=1, y=3, z=1)
    30	   * 
    31	   * Note: User mentioned y=2, but based on the coordinate system:
    32	   * - P_H: (u,v) → (x,y,z) = (u, v, 0)
    33	   * - P_V: (u,v) → (x,y,z) = (u, 0, v)
    34	   * The y-coordinate should come from P_H's v-coordinate (y=3)
    35	   */
    36	  it('should reconstruct 3D point from H and V projections - user test case', () => {
    37	    // Get projection planes
    38	    const planeH = world.getProjectionPlaneByLabel('P_H');
    39	    const planeV = world.getProjectionPlaneByLabel('P_V');
    40	    
    41	    expect(planeH).toBeDefined();
    42	    expect(planeV).toBeDefined();
    43	    
    44	    if (!planeH || !planeV) throw new Error('Base planes not found');
    45	
    46	    // Create point on P_V at (u=1, v=1) → corresponds to 3D (x=1, y=0, z=1)
    47	    const pointV = planeV.addFreePoint2D(
    48	      new Vector3(1, 1, 1),  // (u, v, w) homogeneous
    49	      world,
    50	      undefined,
    51	      'V'
    52	    );
    53	
    54	    // Create point on P_H at (u=1, v=3) → corresponds to 3D (x=1, y=3, z=0)
    55	    const pointH = planeH.addFreePoint2D(
    56	      new Vector3(1, 3, 1),  // (u, v, w) homogeneous
    57	      world,
    58	      undefined,
    59	      'H'
    60	    );
    61	
    62	    // Create 3D point from projections
    63	    const point3D = new Point3DFromProjections(
    64	      'world/point3d_1',
    65	      'P',
    66	      pointV.id,
    67	      pointH.id,
    68	      planeV.id!,
    69	      planeH.id!,
    70	      createVisualStyle()
    71	    );
    72	
    73	    // Realize the 3D point
    74	    const realization = point3D.realize3D(world);
    75	
    76	    // Check feasibility
    77	    expect(realization.isFeasible()).toBe(true);
    78	
    79	    // Get Cartesian coordinates
    80	    const [x, y, z] = realization.getCartesian();
--- frontend/tests/unit/domain/segment3DRealization.spec.ts ---
     1	/**
     2	 * Unit tests for Phase 107: 3D Segment Realization
     3	 * 
     4	 * Tests:
     5	 * 1. reconstruct3DPointFromProjections() shared utility
     6	 * 2. Segment3DFromProjections.realize3D() with endpoint pairing
     7	 * 3. Add3DSegmentOp compatibility validation
     8	 */
     9	
    10	import { describe, it, expect, beforeEach } from 'vitest';
    11	import { Vector3, Vector4 } from 'three';
    12	import { reconstruct3DPointFromProjections, Matrix3x4 } from '@/utils/threeUtils';
    13	import { Segment3DFromProjections } from '@/domain/world/Segment3D';
    14	import { createVisualStyle } from '@/domain/world/VisualStyle';
    15	import { createTestWorld } from '../../helpers/worldHelpers';
    16	import { AddFreePoint2DOp } from '@/commands/operations/world/AddFreePointOp';
    17	import { AddSegment2DByPointsOp } from '@/commands/operations/world/AddSegmentOp';
    18	import { Add3DSegmentOp } from '@/commands/operations/world/Add3DSegmentOp';
    19	import { Command } from '@/commands/Command';
    20	import type { World } from '@/domain/world/World';
    21	
    22	describe('reconstruct3DPointFromProjections', () => {
    23	  // Standard PH: threeDToPlane projects (x,y,z,1) → (x,y,1)
    24	  const threeDToPlaneH = new Matrix3x4().set(
    25	    1, 0, 0, 0,
    26	    0, 1, 0, 0,
    27	    0, 0, 0, 1
    28	  );
    29	
    30	  // Standard PV: threeDToPlane projects (x,y,z,1) → (x,z,1)
    31	  const threeDToPlaneV = new Matrix3x4().set(
    32	    1, 0, 0, 0,
    33	    0, 0, 1, 0,
    34	    0, 0, 0, 1
    35	  );
    36	
    37	  it('should reconstruct a point at origin', () => {
    38	    const posH = new Vector3(0, 0, 1);  // (0,0) on PH → x=0, y=0
    39	    const posV = new Vector3(0, 0, 1);  // (0,0) on PV → x=0, z=0
    40	    
    41	    const result = reconstruct3DPointFromProjections(posH, posV, threeDToPlaneH, threeDToPlaneV);
    42	    
    43	    expect(result.feasible).toBe(true);
    44	    expect(result.point.x).toBeCloseTo(0);
    45	    expect(result.point.y).toBeCloseTo(0);
    46	    expect(result.point.z).toBeCloseTo(0);
    47	  });
    48	
    49	  it('should reconstruct a point at (5, 10, 15)', () => {
    50	    // PH projection: (x,y) = (5,10)
    51	    const posH = new Vector3(5, 10, 1);
    52	    // PV projection: (x,z) = (5,15)
    53	    const posV = new Vector3(5, 15, 1);
    54	    
    55	    const result = reconstruct3DPointFromProjections(posH, posV, threeDToPlaneH, threeDToPlaneV);
    56	    
    57	    expect(result.feasible).toBe(true);
    58	    expect(result.point.x).toBeCloseTo(5);
    59	    expect(result.point.y).toBeCloseTo(10);
    60	    expect(result.point.z).toBeCloseTo(15);
    61	  });
    62	
    63	  it('should return infeasible for inconsistent projections', () => {
    64	    // PH says x=5, PV says x=10 — inconsistent!
    65	    const posH = new Vector3(5, 10, 1);
    66	    const posV = new Vector3(10, 15, 1);
    67	    
    68	    const result = reconstruct3DPointFromProjections(posH, posV, threeDToPlaneH, threeDToPlaneV);
    69	    
    70	    expect(result.feasible).toBe(false);
    71	    expect(result.error).toBeGreaterThan(1e-6);
    72	  });
    73	
    74	  it('should handle negative coordinates', () => {
    75	    const posH = new Vector3(-3, -7, 1);
    76	    const posV = new Vector3(-3, 4, 1);
    77	    
    78	    const result = reconstruct3DPointFromProjections(posH, posV, threeDToPlaneH, threeDToPlaneV);
    79	    
    80	    expect(result.feasible).toBe(true);
