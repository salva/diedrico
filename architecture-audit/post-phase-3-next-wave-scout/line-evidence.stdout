===== frontend/tests/e2e/selection-mask.spec.ts =====
     1	/**
     2	 * E2E tests for Selection Mask System
     3	 * 
     4	 * Tests user-facing behavior:
     5	 * - Only valid elements highlight on hover based on active tool
     6	 * - Invalid elements do not highlight
     7	 * - Dynamic masks change as tool progresses through steps
     8	 * 
     9	 * Reference: specs/001-dihedral-learning-mvp/data-model.md §Selection Mask System
    10	 */
    11	
    12	import { test, expect } from '@playwright/test';
    13	
    14	test.describe('Selection Mask System E2E', () => {
    15	  test.beforeEach(async ({ page }) => {
    16	    await page.goto('/');
    17	    // Wait for application to load
    18	    await page.waitForSelector('[data-testid="svg-canvas"]', { timeout: 5000 });
    19	  });
    20	
    21	  test('PointTool: no elements highlight (empty mask)', async ({ page }) => {
    22	    // Select Point tool
    23	    await page.click('[data-testid="tool-point"]');
    24	
    25	    // Create a point first
    26	    await page.click('[data-testid="svg-canvas"]', { position: { x: 100, y: 100 } });
    27	
    28	    // Move mouse over the created point
    29	    await page.mouse.move(100, 100);
    30	    await page.waitForTimeout(200); // Wait for hover state
    31	
    32	    // Check that point does NOT have hover class (PointTool has empty mask)
    33	    const pointElement = page.locator('[data-element-type="point"]').first();
    34	    const hasHoverClass = await pointElement.evaluate(el => 
    35	      el.classList.contains('hover') || el.classList.contains('hovered')
    36	    );
    37	    
    38	    expect(hasHoverClass).toBe(false);
    39	  });
    40	
    41	  test('LineTool: only points highlight', async ({ page }) => {
    42	    // Create initial setup: two points and a line
    43	    await page.click('[data-testid="tool-point"]');
    44	    await page.click('[data-testid="svg-canvas"]', { position: { x: 100, y: 100 } });
    45	    await page.click('[data-testid="svg-canvas"]', { position: { x: 200, y: 100 } });
    46	    
    47	    await page.click('[data-testid="tool-line"]');
    48	    await page.click('[data-testid="svg-canvas"]', { position: { x: 100, y: 100 } });
    49	    await page.click('[data-testid="svg-canvas"]', { position: { x: 200, y: 100 } });
    50	
    51	    // Now test: LineTool should only highlight points, not lines
    52	    await page.click('[data-testid="tool-line"]'); // Activate line tool
    53	
    54	    // Hover over point - should highlight
    55	    await page.mouse.move(100, 100);
    56	    await page.waitForTimeout(200);
    57	    
    58	    let pointElement = page.locator('[data-element-type="point"]').first();
    59	    let hasHover = await pointElement.evaluate(el => 
    60	      el.classList.contains('hover') || el.classList.contains('hovered')
    61	    );
    62	    expect(hasHover).toBe(true);
    63	
    64	    // Hover over line - should NOT highlight
    65	    await page.mouse.move(150, 100); // On the line
    66	    await page.waitForTimeout(200);
    67	    
    68	    const lineElement = page.locator('[data-element-type="line"]').first();
    69	    const lineHasHover = await lineElement.evaluate(el => 
    70	      el.classList.contains('hover') || el.classList.contains('hovered')
    71	    );
    72	    expect(lineHasHover).toBe(false);
    73	  });
    74	
    75	  test('GuideTool: dynamic mask changes after first selection', async ({ page }) => {
