    84	
    85	    // Initial state: both lines and points should be highlightable
    86	    // Hover over hinge line (HalfHingeLine2D)
    87	    await page.mouse.move(250, 300);
    88	    await page.waitForTimeout(200);
    89	    
    90	    const hhlElement = page.locator('[data-element-type="half-hinge-line"]').first();
    91	    const hhlHasHover = await hhlElement.evaluate(el => 
    92	      el.classList.contains('hover') || el.classList.contains('hovered')
    93	    );
    94	    expect(hhlHasHover).toBe(true);
    95	
    96	    // Click to select the hinge line
    97	    await page.click('[data-testid="svg-canvas"]', { position: { x: 250, y: 300 } });
    98	
    99	    // After selecting line: only points should highlight
   100	    // Hover over point - should highlight
