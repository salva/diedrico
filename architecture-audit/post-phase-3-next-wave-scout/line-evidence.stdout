    22	            <div class="info-row" v-if="planeId">
    23	              <span class="info-label">Plane:</span>
    24	              <span class="info-value">{{ planeId }}</span>
    25	            </div>
    26	            <div class="info-row" v-if="coordinates">
    27	              <span class="info-label">Coordinates:</span>
    28	              <span class="info-value">{{ coordinates }}</span>
    29	            </div>
    30	            <div class="info-row" v-if="dependencies && dependencies.length > 0">
    31	              <span class="info-label">Dependencies:</span>
    32	              <span class="info-value">{{ dependencies.join(', ') }}</span>
    33	            </div>
    34	            <div class="info-row" v-if="createdBy">
    35	              <span class="info-label">Created by:</span>
    36	              <span class="info-value">{{ createdBy }}</span>
    37	            </div>
    38	          </div>
    39	        </section>
    40	
    41	        <!-- Visual Style Section (Editable) -->
    42	        <section class="visual-style-section">
    43	          <h3>Visual Style</h3>
    44	          <div class="style-controls">
    45	            <!-- Color -->
    46	            <div class="control-row">
    47	              <label for="color-input">Color:</label>
    48	              <input
    49	                id="color-input"
    50	                type="color"
    51	                v-model="editableColor"
    52	                :disabled="!colorOverride"
    53	                @blur="colorOverride && validateColor(editableColor)"
    54	              />
    55	              <input
    56	                type="text"
    57	                v-model="editableColor"
    58	                pattern="^#[0-9A-Fa-f]{6}$"
    59	                class="hex-input"
    60	                :class="{ 'input-error': colorError }"
    61	                :disabled="!colorOverride"
    62	                placeholder="#000000"
    63	                @blur="colorOverride && validateColor(editableColor)"
    64	              />
    65	              <label class="override-checkbox">
    66	                <input type="checkbox" v-model="colorOverride" />
    67	                Override
    68	              </label>
    69	            </div>
    70	            <div v-if="colorError" class="error-message">{{ colorError }}</div>
    71	
    72	            <!-- Line Width (for non-point elements) -->
    73	            <div class="control-row" v-if="elementType !== '2D Point'">
    74	              <label for="width-input">Line Width:</label>
    75	              <input
    76	                id="width-input"
    77	                type="range"
    78	                min="0.5"
    79	                max="5.0"
    80	                step="0.1"
    81	                v-model.number="editableLineWidth"
    82	                :disabled="!lineWidthOverride"
    83	                @change="lineWidthOverride && validateLineWidth(editableLineWidth)"
    84	              />
    85	              <input
    86	                type="number"
    87	                v-model.number="editableLineWidth"
    88	                min="0.5"
    89	                max="5.0"
    90	                step="0.1"
    91	                class="number-input"
    92	                :class="{ 'input-error': lineWidthError }"
    93	                :disabled="!lineWidthOverride"
    94	                @blur="lineWidthOverride && validateLineWidth(editableLineWidth)"
    95	              />
    96	              <label class="override-checkbox">
    97	                <input type="checkbox" v-model="lineWidthOverride" />
    98	                Override
    99	              </label>
   100	            </div>
   101	            <div v-if="lineWidthError" class="error-message">{{ lineWidthError }}</div>
   102	
   103	            <!-- Line Style (for line/segment/guide elements) -->
   104	            <div class="control-row" v-if="hasLineStyle">
   105	              <label for="style-input">Line Style:</label>
   106	              <select
   107	                id="style-input"
   108	                v-model="editableLineStyle"
   109	                :class="{ 'input-error': lineStyleError }"
   110	                :disabled="!lineStyleOverride"
   111	                @change="lineStyleOverride && validateLineStyle(editableLineStyle)"
   112	              >
   113	                <option value="solid">Solid</option>
   114	                <option value="dashed">Dashed</option>
   115	                <option value="dotted">Dotted</option>
   116	              </select>
   117	              <label class="override-checkbox">
   118	                <input type="checkbox" v-model="lineStyleOverride" />
   119	                Override
   120	              </label>
   121	            </div>
   122	            <div v-if="lineStyleError" class="error-message">{{ lineStyleError }}</div>
   123	
   124	            <!-- Visibility -->
   125	            <div class="control-row">
   126	              <label for="visibility-input">Visibility:</label>
