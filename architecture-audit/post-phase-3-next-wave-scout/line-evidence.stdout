===== frontend/tests/integration/guide-creation.test.ts =====
     1	import { describe, it, expect, beforeEach } from 'vitest';
     2	import type { World } from '../../src/domain/world/World';
     3	import type { CommandStack } from '../../src/commands/CommandStack';
     4	import { Command } from '../../src/commands/Command';
     5	import { AddFreePoint2DOp } from '../../src/commands/operations/AddFreePoint2DOp';
     6	import { AddLine2DOp } from '../../src/commands/operations/AddLine2DOp';
     7	import { GuideSequenceFactory } from '../../src/commands/factories/GuideSequenceFactory';
     8	import { setupBasicWorld } from '../helpers/worldHelpers';
     9	
    10	describe('Guide Creation - Integration Tests', () => {
    11	  let world: World;
    12	  let commandStack: CommandStack;
    13	
    14	  beforeEach(() => {
    15	    const setup = setupBasicWorld();
    16	    world = setup.world;
    17	    commandStack = setup.commandStack;
    18	  });
    19	
    20	  describe('Regular Line Reference', () => {
    21	    it('should create guide on regular line without sibling', () => {
    22	      const { projPlaneH } = setupBasicWorld();
    23	      const planeId = projPlaneH;
    24	
    25	      // Create two points and a line between them
    26	      const cmd = new Command('Setup test geometry', world);
    27	      
    28	      const point1Result = cmd.addAndExecute(
    29	        new AddFreePoint2DOp(planeId, [100, 100, 1])
    30	      );
    31	      const point1Id = point1Result.outputs.pointId;
    32	
    33	      const point2Result = cmd.addAndExecute(
    34	        new AddFreePoint2DOp(planeId, [200, 100, 1])
    35	      );
    36	      const point2Id = point2Result.outputs.pointId;
    37	
    38	      const lineResult = cmd.addAndExecute(
    39	        new AddLine2DOp(planeId, point1Id, point2Id)
    40	      );
    41	      const lineId = lineResult.outputs.lineId;
    42	
    43	      // Create point for guide to pass through
    44	      const throughPointResult = cmd.addAndExecute(
    45	        new AddFreePoint2DOp(planeId, [150, 150, 1])
    46	      );
    47	      const throughPointId = throughPointResult.outputs.pointId;
    48	
    49	      cmd.commit();
    50	      commandStack.push(cmd);
    51	
    52	      // Create guide using regular line as reference
    53	      const guideCmd = new Command('Create guide on regular line', world);
    54	      const result = GuideSequenceFactory.createGuideWithSibling(
    55	        guideCmd,
    56	        planeId,
    57	        lineId,
    58	        throughPointId,
    59	        world
    60	      );
    61	
    62	      guideCmd.commit();
    63	      commandStack.push(guideCmd);
    64	
    65	      // Verify results
    66	      expect(result.guideId).toBeDefined();
    67	      expect(result.siblingGuideId).toBeUndefined(); // No sibling for regular line
    68	
    69	      // Verify guide exists in world
    70	      const plane = world.getProjectionPlane(planeId);
    71	      const guide = plane.getElement(result.guideId);
    72	      expect(guide).toBeDefined();
    73	      expect(guide?.elementType).toBe('Guide2D');
    74	    });
    75	  });
    76	
    77	  describe('HalfHingeLine2D Reference', () => {
    78	    it('should create sibling guide when reference is hinge line', () => {
    79	      // After basic world setup, there should be hinge lines
    80	      const { projPlaneH, projPlaneV } = setupBasicWorld();
    81	      
    82	      // Get the hinge line on plane H
    83	      const planeH = world.getProjectionPlane(projPlaneH);
    84	      const hingeLines = Array.from(planeH.lines.values()).filter(
    85	        line => line.elementType === 'HalfHingeLine2D'
    86	      );
    87	      
    88	      expect(hingeLines.length).toBeGreaterThan(0);
    89	      const hingeLineId = hingeLines[0]!.id;
    90	
    91	      // Create point for guide to pass through
    92	      const cmd = new Command('Create test point', world);
    93	      const pointResult = cmd.addAndExecute(
    94	        new AddFreePoint2DOp(projPlaneH, [100, 100, 1])
    95	      );
    96	      const throughPointId = pointResult.outputs.pointId;
    97	      cmd.commit();
    98	      commandStack.push(cmd);
    99	
   100	      // Create guide using hinge line as reference
   101	      const guideCmd = new Command('Create guide on hinge line', world);
   102	      const result = GuideSequenceFactory.createGuideWithSibling(
   103	        guideCmd,
   104	        projPlaneH,
   105	        hingeLineId,
   106	        throughPointId,
   107	        world
   108	      );
   109	
   110	      guideCmd.commit();
   111	      commandStack.push(guideCmd);
   112	
   113	      // Verify results
   114	      expect(result.guideId).toBeDefined();
   115	      expect(result.siblingGuideId).toBeDefined(); // Should have sibling
   116	
   117	      // Verify both guides exist
   118	      const planeHGuide = planeH.getElement(result.guideId);
   119	      expect(planeHGuide).toBeDefined();
   120	
   121	      const planeV = world.getProjectionPlane(projPlaneV);
   122	      const planeVGuide = planeV.getElement(result.siblingGuideId!);
   123	      expect(planeVGuide).toBeDefined();
   124	    });
   125	  });
   126	
   127	  describe('BrokenHalfHingeLine2D Reference', () => {
   128	    it('should create sibling guide when reference is broken hinge line', () => {
   129	      // This test would require setting up an auxiliary plane with BHHL
   130	      // For now, we document the expected behavior:
   131	      
   132	      // Given: Auxiliary plane with BrokenHalfHingeLine2D
   133	      // When: Create guide using BHHL as reference
   134	      // Then: 
   135	      //   - Primary guide created on auxiliary plane
   136	      //   - Sibling guide created on base plane
   137	      //   - Both guides parallel to main hinge T1
   138	      //   - No error thrown
   139	      
   140	      // This is the scenario that was failing before the fix
   141	    });
   142	  });
   143	
   144	  describe('Error Prevention', () => {
   145	    it('should not throw when creating guide on non-hinge line', () => {
   146	      // Regression test for: "Failed to get sibling info for half-hinge-line"
   147	      // This error occurred when GuideTool assumed all guides had siblings
   148	      
   149	      const { projPlaneH } = setupBasicWorld();
   150	      
   151	      // Create regular line (not hinge)
   152	      const cmd = new Command('Setup', world);
   153	      const p1 = cmd.addAndExecute(new AddFreePoint2DOp(projPlaneH, [0, 0, 1]));
   154	      const p2 = cmd.addAndExecute(new AddFreePoint2DOp(projPlaneH, [100, 0, 1]));
   155	      const line = cmd.addAndExecute(new AddLine2DOp(projPlaneH, p1.outputs.pointId, p2.outputs.pointId));
   156	      const throughPoint = cmd.addAndExecute(new AddFreePoint2DOp(projPlaneH, [50, 50, 1]));
   157	      cmd.commit();
   158	      commandStack.push(cmd);
   159	
   160	      // This should NOT throw
   161	      expect(() => {
   162	        const guideCmd = new Command('Create guide', world);
   163	        GuideSequenceFactory.createGuideWithSibling(
   164	          guideCmd,
   165	          projPlaneH,
   166	          line.outputs.lineId,
   167	          throughPoint.outputs.pointId,
   168	          world
   169	        );
   170	        guideCmd.commit();
   171	      }).not.toThrow();
   172	    });
   173	  });
   174	});
