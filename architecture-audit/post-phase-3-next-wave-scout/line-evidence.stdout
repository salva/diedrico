    78	    await page.click('[data-testid="svg-canvas"]', { position: { x: 100, y: 300 } }); // Hinge point 1
    79	    await page.click('[data-testid="svg-canvas"]', { position: { x: 400, y: 300 } }); // Hinge point 2
    80	    await page.click('[data-testid="svg-canvas"]', { position: { x: 200, y: 100 } }); // Regular point
    81	
    82	    // Activate guide tool
