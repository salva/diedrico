===== frontend/src/application/canvas/CanvasStyleUseCase.ts =====
     1	import { Command } from '@/commands/Command';
     2	import type { CommandStack } from '@/commands/CommandStack';
     3	import type { World } from '@/domain/world/World';
     4	import { UpdateElementStyleOp } from '@/commands/operations/world/UpdateElementStyleOp';
     5	import type { StyleUpdateRequest, ToolCommandResult } from '@/application/tools/ToolCommandIntents';
     6	
     7	export class CanvasStyleUseCase {
     8	  constructor(private readonly world: World, private readonly commandStack: CommandStack) {}
     9	
    10	  update(request: StyleUpdateRequest): ToolCommandResult {
    11	    const cmd = new Command(`Update style: ${request.elementId}`, this.world);
    12	    try {
    13	      cmd.addAndExecute(new UpdateElementStyleOp(request.elementId, request.planeId, request.style) as any);
    14	      cmd.commit();
    15	      this.commandStack.push(cmd);
    16	      return { success: true };
    17	    } catch (error) {
    18	      cmd.rollback();
    19	      return { success: false, message: error instanceof Error ? error.message : String(error) };
    20	    }
    21	  }
    22	}
===== frontend/src/components/dialogs/PropertiesDialog.vue =====
     1	<template>
     2	  <div v-if="isOpen" class="dialog-overlay" @click.self="handleCancel">
     3	    <div class="properties-dialog" role="dialog" aria-labelledby="dialog-title">
     4	      <!-- Header -->
     5	      <div class="dialog-header">
     6	        <h2 id="dialog-title">Properties: {{ elementLabel }}</h2>
     7	        <button class="close-button" @click="handleCancel" aria-label="Close dialog">
     8	          ×
     9	        </button>
    10	      </div>
    11	
    12	      <!-- Content -->
    13	      <div class="dialog-content">
    14	        <!-- Geometry Info Section (Read-only) -->
    15	        <section class="geometry-section">
    16	          <h3>Geometry Info</h3>
    17	          <div class="info-grid">
    18	            <div class="info-row">
    19	              <span class="info-label">Type:</span>
    20	              <span class="info-value">{{ elementType }}</span>
    21	            </div>
    22	            <div class="info-row" v-if="planeId">
    23	              <span class="info-label">Plane:</span>
    24	              <span class="info-value">{{ planeId }}</span>
    25	            </div>
    26	            <div class="info-row" v-if="coordinates">
    27	              <span class="info-label">Coordinates:</span>
    28	              <span class="info-value">{{ coordinates }}</span>
    29	            </div>
    30	            <div class="info-row" v-if="dependencies && dependencies.length > 0">
    31	              <span class="info-label">Dependencies:</span>
    32	              <span class="info-value">{{ dependencies.join(', ') }}</span>
    33	            </div>
    34	            <div class="info-row" v-if="createdBy">
    35	              <span class="info-label">Created by:</span>
    36	              <span class="info-value">{{ createdBy }}</span>
    37	            </div>
    38	          </div>
    39	        </section>
    40	
    41	        <!-- Visual Style Section (Editable) -->
    42	        <section class="visual-style-section">
    43	          <h3>Visual Style</h3>
    44	          <div class="style-controls">
    45	            <!-- Color -->
    46	            <div class="control-row">
    47	              <label for="color-input">Color:</label>
    48	              <input
    49	                id="color-input"
    50	                type="color"
    51	                v-model="editableColor"
    52	                :disabled="!colorOverride"
    53	                @blur="colorOverride && validateColor(editableColor)"
    54	              />
    55	              <input
    56	                type="text"
    57	                v-model="editableColor"
    58	                pattern="^#[0-9A-Fa-f]{6}$"
    59	                class="hex-input"
    60	                :class="{ 'input-error': colorError }"
    61	                :disabled="!colorOverride"
    62	                placeholder="#000000"
    63	                @blur="colorOverride && validateColor(editableColor)"
    64	              />
    65	              <label class="override-checkbox">
    66	                <input type="checkbox" v-model="colorOverride" />
    67	                Override
    68	              </label>
    69	            </div>
    70	            <div v-if="colorError" class="error-message">{{ colorError }}</div>
    71	
    72	            <!-- Line Width (for non-point elements) -->
    73	            <div class="control-row" v-if="elementType !== '2D Point'">
    74	              <label for="width-input">Line Width:</label>
    75	              <input
    76	                id="width-input"
    77	                type="range"
    78	                min="0.5"
    79	                max="5.0"
    80	                step="0.1"
    81	                v-model.number="editableLineWidth"
    82	                :disabled="!lineWidthOverride"
    83	                @change="lineWidthOverride && validateLineWidth(editableLineWidth)"
    84	              />
    85	              <input
    86	                type="number"
    87	                v-model.number="editableLineWidth"
    88	                min="0.5"
    89	                max="5.0"
    90	                step="0.1"
    91	                class="number-input"
    92	                :class="{ 'input-error': lineWidthError }"
    93	                :disabled="!lineWidthOverride"
    94	                @blur="lineWidthOverride && validateLineWidth(editableLineWidth)"
    95	              />
    96	              <label class="override-checkbox">
    97	                <input type="checkbox" v-model="lineWidthOverride" />
    98	                Override
    99	              </label>
   100	            </div>
   101	            <div v-if="lineWidthError" class="error-message">{{ lineWidthError }}</div>
   102	
   103	            <!-- Line Style (for line/segment/guide elements) -->
   104	            <div class="control-row" v-if="hasLineStyle">
   105	              <label for="style-input">Line Style:</label>
   106	              <select
   107	                id="style-input"
   108	                v-model="editableLineStyle"
   109	                :class="{ 'input-error': lineStyleError }"
   110	                :disabled="!lineStyleOverride"
   111	                @change="lineStyleOverride && validateLineStyle(editableLineStyle)"
   112	              >
   113	                <option value="solid">Solid</option>
   114	                <option value="dashed">Dashed</option>
   115	                <option value="dotted">Dotted</option>
   116	              </select>
   117	              <label class="override-checkbox">
   118	                <input type="checkbox" v-model="lineStyleOverride" />
   119	                Override
   120	              </label>
   121	            </div>
   122	            <div v-if="lineStyleError" class="error-message">{{ lineStyleError }}</div>
   123	
   124	            <!-- Visibility -->
   125	            <div class="control-row">
   126	              <label for="visibility-input">Visibility:</label>
   127	              <input
   128	                id="visibility-input"
   129	                type="checkbox"
   130	                v-model="editableVisible"
   131	                :disabled="!visibilityOverride"
   132	              />
   133	              <label class="override-checkbox">
   134	                <input type="checkbox" v-model="visibilityOverride" />
   135	                Override
   136	              </label>
   137	            </div>
   138	          </div>
   139	
   140	          <!-- Reset Button -->
   141	          <button class="reset-button" @click="handleResetToDefault">
   142	            Reset to Default
   143	          </button>
   144	        </section>
   145	      </div>
   146	
   147	      <!-- Footer Actions -->
   148	      <div class="dialog-footer">
   149	        <button class="button button-secondary" @click="handleCancel">
   150	          Cancel
   151	        </button>
   152	        <button class="button button-primary" @click="handleSave">
   153	          Save
   154	        </button>
   155	      </div>
   156	    </div>
   157	  </div>
   158	</template>
   159	
   160	<script setup lang="ts">
   161	import { ref, computed, watch } from 'vue';
   162	import type { World } from '@/domain/world/World';
   163	
   164	interface Props {
   165	  isOpen: boolean;
   166	  elementId: string | null;
   167	  world: World | null;
   168	}
   169	
   170	interface Emits {
   171	  (e: 'close'): void;
   172	  (e: 'save', changes: StyleChanges): void;
   173	}
   174	
   175	interface StyleChanges {
   176	  elementId: string;
   177	  color?: string;
   178	  lineWidth?: number;
   179	  lineStyle?: string;
   180	  visible?: boolean;
   181	}
   182	
   183	const props = defineProps<Props>();
   184	const emit = defineEmits<Emits>();
   185	
   186	// Editable state
   187	const editableColor = ref<string>('#000000');
   188	const editableLineWidth = ref<number>(1.0);
   189	const editableLineStyle = ref<string>('solid');
   190	const editableVisible = ref<boolean>(true);
   191	
   192	// Override flags
   193	const colorOverride = ref<boolean>(false);
   194	const lineWidthOverride = ref<boolean>(false);
   195	const lineStyleOverride = ref<boolean>(false);
   196	const visibilityOverride = ref<boolean>(false);
   197	
   198	// Validation state
   199	const colorError = ref<string>('');
   200	const lineWidthError = ref<string>('');
   201	const lineStyleError = ref<string>('');
   202	
   203	// Computed properties for display
   204	const elementLabel = computed(() => {
   205	  if (!props.elementId || !props.world) return 'Unknown';
   206	  
   207	  // Get element label/ID
   208	  return props.elementId;
   209	});
   210	
   211	const elementType = computed(() => {
   212	  if (!props.elementId || !props.world) return 'Unknown';
   213	  
   214	  // Determine element type by checking which collection contains it
   215	  const point = props.world.getPoint2D(props.elementId);
   216	  if (point) return '2D Point';
   217	  
   218	  const line = props.world.getLine2D(props.elementId);
   219	  if (line) return '2D Line';
   220	  
   221	  const segment = props.world.getSegment2D(props.elementId);
   222	  if (segment) return '2D Segment';
   223	  
   224	  const circle = props.world.getCircle2D(props.elementId);
   225	  if (circle) return '2D Circle';
   226	  
   227	  const guide = props.world.getGuide2D(props.elementId);
   228	  if (guide) return '2D Guide';
   229	  
   230	  return 'Unknown';
   231	});
   232	
   233	const planeId = computed(() => {
   234	  if (!props.elementId || !props.world) return null;
   235	  
   236	  // Get plane ID from element
   237	  const point = props.world.getPoint2D(props.elementId);
   238	  if (point) return point.planeId;
   239	  
   240	  const line = props.world.getLine2D(props.elementId);
   241	  if (line) return line.planeId;
   242	  
   243	  const segment = props.world.getSegment2D(props.elementId);
   244	  if (segment) return segment.planeId;
   245	  
   246	  const circle = props.world.getCircle2D(props.elementId);
   247	  if (circle) return circle.planeId;
   248	  
   249	  const guide = props.world.getGuide2D(props.elementId);
   250	  if (guide) return guide.planeId;
   251	  
   252	  return null;
   253	});
   254	
   255	const coordinates = computed(() => {
   256	  if (!props.elementId || !props.world) return null;
   257	  
   258	  // Get coordinates from realization
   259	  const point = props.world.getPoint2D(props.elementId);
   260	  if (point) {
