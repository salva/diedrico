===== frontend/src/domain/calculations/Intersections.ts =====
     1	/**
     2	 * Intersections - Geometric intersection calculations using homogeneous coordinates
     3	 * 
     4	 * This module provides functions for calculating intersections between geometric
     5	 * primitives using homogeneous coordinate representation.
     6	 * 
     7	 * All calculations follow constitution.md Principle V:
     8	 * - Use homogeneous coordinates throughout
     9	 * - Convert parametric forms to implicit forms when needed
    10	 * - Use cross products for line-line intersections
    11	 * - Handle edge cases (parallel, coincident) explicitly
    12	 * 
    13	 * Line representation:
    14	 * - Parametric form: P(t) = point + t * direction (storage format)
    15	 * - Implicit form: ax + by + c = 0 (computation format for intersections)
    16	 * 
    17	 * Reference:
    18	 * - .specify/memory/constitution.md#v-homogeneous-coordinate-system
    19	 */
    20	
    21	import { Vector3 } from 'three';
    22	import type { Line2DRealization2D } from '../world/Line';
    23	import type { Circle2DRealization2D } from '../world/Circle';
    24	import { Point2DRealization2D } from '../world/Point';
    25	
    26	/**
    27	 * Convert line from parametric form to implicit form using homogeneous coordinates
    28	 * 
    29	 * Parametric form: P(t) = P0 + t * d where P0 = (x0, y0, 1), d = (dx, dy, 0)
    30	 * Implicit form: ax + by + c = 0
    31	 * 
    32	 * The implicit form can be derived from the parametric form:
    33	 * - A line passing through P0 = (x0, y0) with direction d = (dx, dy)
    34	 * - The perpendicular direction to d is (-dy, dx)
    35	 * - Points on the line satisfy: (P - P0) · perpendicular = 0
    36	 * - This gives: -dy(x - x0) + dx(y - y0) = 0
    37	 * - Expanding: -dy*x + dx*y + (dy*x0 - dx*y0) = 0
    38	 * - So: a = -dy, b = dx, c = dy*x0 - dx*y0
    39	 * 
    40	 * @param line Line in parametric form
    41	 * @returns Line in implicit form [a, b, c] where ax + by + c = 0
    42	 */
    43	function lineToImplicitForm(line: Line2DRealization2D): Vector3 {
    44	  const point = line.point1;
    45	  const direction = line.getDirection();
    46	  const x0 = point.x;
    47	  const y0 = point.y;
    48	  const dx = direction.x;
    49	  const dy = direction.y;
    50	  
    51	  // Implicit form: a*x + b*y + c = 0
    52	  // a = -dy, b = dx, c = dy*x0 - dx*y0
    53	  const a = -dy;
    54	  const b = dx;
    55	  const c = dy * x0 - dx * y0;
    56	  
    57	  // Return as Vector3 for convenience (not really a point, just 3 numbers)
    58	  return new Vector3(a, b, c);
    59	}
    60	
    61	/**
    62	 * Calculate intersection point of two lines using homogeneous coordinates
    63	 * 
    64	 * Algorithm (from projective geometry):
    65	 * 1. Convert lines from parametric to implicit form
    66	 * 2. Represent lines as homogeneous vectors L1 = [a1, b1, c1], L2 = [a2, b2, c2]
    67	 * 3. Intersection point is given by cross product: P = L1 × L2
    68	 * 4. Result is in homogeneous coordinates [x, y, w]
    69	 * 5. If w ≈ 0, lines are parallel (point at infinity)
    70	 * 6. Otherwise, convert to Cartesian: (x/w, y/w, 1)
    71	 * 
    72	 * Edge cases:
    73	 * - Parallel lines: Cross product yields [0, 0, 0] or [*, *, 0] (w = 0)
    74	 * - Coincident lines: Same as parallel (treated as no intersection)
    75	 * 
    76	 * @param line1 First line in parametric form
    77	 * @param line2 Second line in parametric form
    78	 * @returns Point2DRealization2D with feasible=false if parallel/coincident, feasible=true otherwise
    79	 */
    80	export function intersectLineLine(
    81	  line1: Line2DRealization2D,
    82	  line2: Line2DRealization2D
    83	): Point2DRealization2D {
    84	  // Convert to implicit form
    85	  const L1 = lineToImplicitForm(line1);
    86	  const L2 = lineToImplicitForm(line2);
    87	  
    88	  // Cross product in homogeneous coordinates
    89	  // L1 × L2 gives the intersection point in homogeneous form
    90	  // 
    91	  // Given L1 = (a1, b1, c1) and L2 = (a2, b2, c2):
    92	  // L1 × L2 = | i    j    k  |
    93	  //           | a1   b1   c1 |
    94	  //           | a2   b2   c2 |
    95	  //
    96	  // = i(b1*c2 - c1*b2) - j(a1*c2 - c1*a2) + k(a1*b2 - b1*a2)
    97	  // = (b1*c2 - c1*b2, c1*a2 - a1*c2, a1*b2 - b1*a2)
    98	  //
    99	  // This represents the point [x, y, w] in homogeneous coordinates
   100	  // where x/w and y/w are the Cartesian coordinates (if w ≠ 0)
   101	  
   102	  const a1 = L1.x, b1 = L1.y, c1 = L1.z;
   103	  const a2 = L2.x, b2 = L2.y, c2 = L2.z;
   104	  
   105	  // Cross product components
   106	  const px = b1 * c2 - c1 * b2;  // x-component (homogeneous)
   107	  const py = c1 * a2 - a1 * c2;  // y-component (homogeneous)
   108	  const w = a1 * b2 - b1 * a2;   // w-component (homogeneous scale)
   109	  
   110	  // Check for parallel lines (w ≈ 0)
   111	  const epsilon = 1e-10;
   112	  if (Math.abs(w) < epsilon) {
   113	    // Lines are parallel or coincident - return infeasible realization
   114	    return new Point2DRealization2D(new Vector3(0, 0, 1), false);
   115	  }
   116	  
   117	  // Convert from homogeneous to Cartesian coordinates
   118	  // Divide by w to get actual (x, y) coordinates
   119	  const x = px / w;
   120	  const y = py / w;
   121	  
   122	  // Return as point realization in homogeneous form (x, y, 1)
   123	  return new Point2DRealization2D(new Vector3(x, y, 1), true);
   124	}
   125	
   126	/**
   127	 * Check if two lines are parallel (without computing intersection)
   128	 * 
   129	 * Two lines are parallel if their directions are parallel (or anti-parallel).
   130	 * In 2D, this means the cross product of direction vectors is zero.
   131	 * 
   132	 * @param line1 First line
   133	 * @param line2 Second line
   134	 * @returns True if lines are parallel
   135	 */
   136	export function areLinesParallel(
   137	  line1: Line2DRealization2D,
   138	  line2: Line2DRealization2D
   139	): boolean {
   140	  const d1 = line1.getDirection();
   141	  const d2 = line2.getDirection();
   142	  
   143	  // Cross product in 2D: d1.x * d2.y - d1.y * d2.x
   144	  // If zero, directions are parallel
   145	  const cross = d1.x * d2.y - d1.y * d2.x;
   146	  
   147	  return Math.abs(cross) < 1e-10;
   148	}
   149	
   150	/**
   151	 * Sort intersection points by projection onto a direction vector.
   152	 * Index 0 = larger projection (more positive), Index 1 = smaller projection (more negative)
   153	 * 
   154	 * This generic function handles both line-circle and circle-circle intersection ordering:
   155	 * - Line-circle: direction = line direction, reference = point on line
   156	 * - Circle-circle: direction = perpendicular to center-line, reference = first circle center
   157	 * 
   158	 * @param points Array of intersection points (typically 2)
   159	 * @param direction Direction vector to project onto (defines "left" vs "right")
   160	 * @param referencePoint Reference point for computing relative positions
   161	 * @returns Sorted array with index 0 = larger (more positive) projection
   162	 */
   163	function sortIntersectionsByProjection(
   164	  points: Vector3[],
   165	  direction: { x: number; y: number },
   166	  referencePoint: Vector3
   167	): Vector3[] {
   168	  if (points.length < 2) return points;
   169	  
   170	  // Project each point onto direction vector (from reference point)
   171	  const projectionsAndPoints = points.map(point => {
   172	    const dx = point.x - referencePoint.x;
   173	    const dy = point.y - referencePoint.y;
   174	    const projection = dx * direction.x + dy * direction.y;
   175	    return { projection, point };
   176	  });
   177	  
   178	  // Sort by projection descending (larger/more positive first = index 0)
   179	  projectionsAndPoints.sort((a, b) => b.projection - a.projection);
   180	  
   181	  return projectionsAndPoints.map(item => item.point);
   182	}
   183	
   184	/**
   185	 * Calculate intersection points of a line and a circle using homogeneous coordinates
   186	 * 
   187	 * Algorithm:
   188	 * 1. Line in parametric form: P(t) = P0 + t*d where P0 is point, d is direction
   189	 * 2. Circle: (x - cx)² + (y - cy)² = r²
   190	 * 3. Substitute line equation into circle equation
   191	 * 4. Results in quadratic: at² + bt + c = 0
   192	 * 5. Solve quadratic to find t values
   193	 * 6. Substitute t back into line equation to get intersection points
   194	 * 
   195	 * Edge cases:
   196	 * - No intersection: discriminant < 0 (returns empty array)
   197	 * - Tangent: discriminant = 0 (returns array with 1 point)
   198	 * - Secant: discriminant > 0 (returns array with 2 points, sorted by projection on line direction)
   199	 * 
   200	 * @param line Line in parametric form
   201	 * @param circle Circle with center and radius
   202	 * @returns Array of intersection points (0, 1, or 2 points)
   203	 */
   204	export function intersectLineCircle(
   205	  line: Line2DRealization2D,
   206	  circle: Circle2DRealization2D
   207	): Vector3[] {
   208	  const P0 = line.point1;
   209	  const d = line.getDirection();
   210	  const C = circle.center;
   211	  const r = circle.getRadius();
   212	  
   213	  // Line: P(t) = P0 + t*d = (P0.x + t*d.x, P0.y + t*d.y)
   214	  // Circle: (x - C.x)² + (y - C.y)² = r²
   215	  //
   216	  // Substitute line into circle:
   217	  // (P0.x + t*d.x - C.x)² + (P0.y + t*d.y - C.y)² = r²
   218	  //
   219	  // Let dx = P0.x - C.x, dy = P0.y - C.y
   220	  // (dx + t*d.x)² + (dy + t*d.y)² = r²
   221	  //
   222	  // Expand:
   223	  // dx² + 2*dx*t*d.x + t²*d.x² + dy² + 2*dy*t*d.y + t²*d.y² = r²
   224	  //
   225	  // Group by powers of t:
   226	  // (d.x² + d.y²)*t² + 2*(dx*d.x + dy*d.y)*t + (dx² + dy² - r²) = 0
   227	  //
   228	  // This is quadratic: a*t² + b*t + c = 0
   229	  
   230	  const dx = P0.x - C.x;
   231	  const dy = P0.y - C.y;
   232	  
   233	  const a = d.x * d.x + d.y * d.y;  // Should be 1 if direction is normalized
   234	  const b = 2 * (dx * d.x + dy * d.y);
   235	  const c = dx * dx + dy * dy - r * r;
   236	  
   237	  // Calculate discriminant
   238	  const discriminant = b * b - 4 * a * c;
   239	  const epsilon = 1e-10;
   240	  
   241	  if (discriminant < -epsilon) {
   242	    // No intersection
   243	    return [];
   244	  } else if (Math.abs(discriminant) < epsilon) {
   245	    // Tangent - one intersection point
   246	    const t = -b / (2 * a);
   247	    const x = P0.x + t * d.x;
   248	    const y = P0.y + t * d.y;
   249	    
   250	    return [new Vector3(x, y, 1)];
   251	  } else {
   252	    // Secant - two intersection points
   253	    const sqrtDisc = Math.sqrt(discriminant);
   254	    const t1 = (-b - sqrtDisc) / (2 * a);
   255	    const t2 = (-b + sqrtDisc) / (2 * a);
   256	    
   257	    const x1 = P0.x + t1 * d.x;
   258	    const y1 = P0.y + t1 * d.y;
   259	    const x2 = P0.x + t2 * d.x;
   260	    const y2 = P0.y + t2 * d.y;
===== frontend/tests/unit/calculations/intersections.spec.ts =====
     1	/**
     2	 * Unit tests for Intersections module
     3	 * 
     4	 * Tests geometric intersection calculations using homogeneous coordinates.
     5	 * Validates:
     6	 * - Line-line intersections (cross product algorithm)
     7	 * - Line-circle intersections (quadratic formula)
     8	 * - Circle-circle intersections (geometric formula)
     9	 * 
    10	 * Test coverage:
    11	 * - Standard intersections (perpendicular, diagonal, tangent, secant)
    12	 * - Edge cases (parallel, coincident, no intersection, multiple solutions)
    13	 * - Homogeneous coordinate correctness
    14	 * - Numerical stability
    15	 */
    16	
    17	import { describe, it, expect } from 'vitest';
    18	import { Vector3 } from 'three';
    19	import { 
    20	  intersectLineLine, 
    21	  areLinesParallel,
    22	  intersectLineCircle,
    23	  intersectCircleCircle
    24	} from '../../../src/domain/calculations/Intersections';
    25	import { Line2DRealization2D } from '../../../src/domain/world/Line';
    26	import { Circle2DRealization2D } from '../../../src/domain/world/Circle';
    27	
    28	describe('Intersections', () => {
    29	  describe('intersectLineLine', () => {
    30	    it('should find intersection of perpendicular lines', () => {
    31	      // Horizontal line through (0, 2): y = 2
    32	      // Parametric: P(t) = (0, 2, 1) + t*(1, 0, 0)
    33	      const line1 = new Line2DRealization2D(
    34	        new Vector3(0, 2, 1),  // point
    35	        new Vector3(1, 0, 0)   // direction (horizontal)
    36	      );
    37	      
    38	      // Vertical line through (3, 0): x = 3
    39	      // Parametric: P(t) = (3, 0, 1) + t*(0, 1, 0)
    40	      const line2 = new Line2DRealization2D(
    41	        new Vector3(3, 0, 1),  // point
    42	        new Vector3(0, 1, 0)   // direction (vertical)
    43	      );
    44	      
    45	      const result = intersectLineLine(line1, line2);
    46	      
    47	      expect(result).not.toBeNull();
    48	      expect(result!.x).toBeCloseTo(3, 6);
    49	      expect(result!.y).toBeCloseTo(2, 6);
    50	      expect(result!.z).toBe(1); // homogeneous coordinate
    51	    });
    52	    
    53	    it('should find intersection of diagonal lines', () => {
    54	      // Line 1: passing through (0, 0) with direction (1, 1)
    55	      // Equation: y = x
    56	      const line1 = new Line2DRealization2D(
    57	        new Vector3(0, 0, 1),
    58	        new Vector3(1, 1, 0).normalize()
    59	      );
    60	      
    61	      // Line 2: passing through (0, 4) with direction (1, -1)
    62	      // Equation: y = -x + 4
    63	      const line2 = new Line2DRealization2D(
    64	        new Vector3(0, 4, 1),
    65	        new Vector3(1, -1, 0).normalize()
    66	      );
    67	      
    68	      const result = intersectLineLine(line1, line2);
    69	      
    70	      // Intersection: y = x and y = -x + 4
    71	      // x = -x + 4 => 2x = 4 => x = 2, y = 2
    72	      expect(result).not.toBeNull();
    73	      expect(result!.x).toBeCloseTo(2, 6);
    74	      expect(result!.y).toBeCloseTo(2, 6);
    75	      expect(result!.z).toBe(1);
    76	    });
    77	    
    78	    it('should detect parallel horizontal lines', () => {
