    93	      expect(result).toBeNull();
    94	    });
    95	    
    96	    it('should detect parallel vertical lines', () => {
    97	      // Line 1: x = 3
    98	      const line1 = new Line2DRealization2D(
    99	        new Vector3(3, 0, 1),
