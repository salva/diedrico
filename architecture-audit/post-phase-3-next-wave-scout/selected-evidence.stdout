    10	describe('Guide Creation - Integration Tests', () => {
    11	  let world: World;
    12	  let commandStack: CommandStack;
    13	
    14	  beforeEach(() => {
    15	    const setup = setupBasicWorld();
    16	    world = setup.world;
    17	    commandStack = setup.commandStack;
    18	  });
    19	
    20	  describe('Regular Line Reference', () => {
    21	    it('should create guide on regular line without sibling', () => {
    22	      const { projPlaneH } = setupBasicWorld();
    23	      const planeId = projPlaneH;
    24	
    25	      // Create two points and a line between them
    26	      const cmd = new Command('Setup test geometry', world);
    27	      
    28	      const point1Result = cmd.addAndExecute(
    29	        new AddFreePoint2DOp(planeId, [100, 100, 1])
    30	      );
    31	      const point1Id = point1Result.outputs.pointId;
    32	
    33	      const point2Result = cmd.addAndExecute(
    34	        new AddFreePoint2DOp(planeId, [200, 100, 1])
    35	      );
    36	      const point2Id = point2Result.outputs.pointId;
    37	
    38	      const lineResult = cmd.addAndExecute(
    39	        new AddLine2DOp(planeId, point1Id, point2Id)
    40	      );
    41	      const lineId = lineResult.outputs.lineId;
    42	
    43	      // Create point for guide to pass through
    44	      const throughPointResult = cmd.addAndExecute(
    45	        new AddFreePoint2DOp(planeId, [150, 150, 1])
    46	      );
    47	      const throughPointId = throughPointResult.outputs.pointId;
    48	
    49	      cmd.commit();
