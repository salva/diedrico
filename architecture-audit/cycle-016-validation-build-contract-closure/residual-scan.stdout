    18	  return file.projectPath === self;
    19	}
    20	
    21	describe('Architecture: deleted legacy world-state paths', () => {
    22	  it('active source and tests do not reference deleted store/workspace geometry surfaces', () => {
    23	    const files = scanTextFiles(['src', 'tests']);
    24	    const pattern = new RegExp(deletedPathTerms.join('|'));
    25	
    26	    expect(findContentMatches(files, pattern, { exclude: isThisArchitectureSpec })).toEqual([]);
    27	  });
