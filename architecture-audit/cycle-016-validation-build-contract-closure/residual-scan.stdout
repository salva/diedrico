    33	}
    34	
    35	function isWave010NegativeE2EGuard(file: ScannedFile): boolean {
    36	  return file.projectPath === 'tests/e2e/wave010-app-shell-project-flow.spec.ts';
    37	}
    38	
    39	describe('Architecture: import boundaries', () => {
    40	  it('keeps UI components from importing command construction surfaces', () => {
    41	    const componentFiles = scanTextFiles(['src/components']);
    42	
    43	    expect(findForbiddenImports(componentFiles, [
    44	      /^@\/commands(\/|$)/,
    45	      /^@\/application\/commands(\/|$)/,
    46	      /commands\/operations/,
    47	      /CommandStack$/,
    48	      /CommandFactory$/,
    49	    ])).toEqual([]);
    50	  });
    51	
    52	  it('keeps command construction available to application/use-case modules', () => {
    53	    const applicationFiles = scanTextFiles(['src/application']);
    54	    const commandImports = applicationFiles.flatMap(file =>
    55	      file.imports
    56	        .filter(importSource => /^@\/commands(\/|$)/.test(importSource) || /commands\/operations/.test(importSource))
    57	        .map(importSource => `${file.projectPath} imports ${importSource}`),
    58	    );
    59	
    60	    expect(commandImports.length).toBeGreaterThan(0);
    61	  });
    62	
    63	  it('forbids frontend source and tests from importing backend implementation files', () => {
    64	    const files = frontendSourceAndTests();
    65	
    66	    expect(findForbiddenImports(files, [/backend\/src/, /^backend\/src/])).toEqual([]);
    67	    expect(findContentMatches(files, /backend\/src\//g, { exclude: isArchitectureSpec })).toEqual([]);
    68	  });
    69	
    70	  it('keeps stale backend project API and DTO terms out of active frontend code', () => {
    71	    const files = frontendSourceAndTests();
    72	
    73	    expect(findContentMatches(files, staleBackendProjectTerms, {
    74	      exclude: file => isArchitectureSpec(file) || isWave010NegativeE2EGuard(file),
    75	    })).toEqual([]);
    76	  });
    77	
    78	  it('does not reference deleted debug/example/placeholder operation surfaces from active source or tests', () => {
    79	    const files = frontendSourceAndTests();
    80	
    81	    expect(findContentMatches(files, /operations\/(paper|toolbar|debug)|ExamplesMenu|AddExampleSetupOp|projection-plane-setup|basic-3d-point-setup/g, {
    82	      exclude: isArchitectureSpec,
    83	    })).toEqual([]);
    84	  });
    85	
    86	  it('keeps routine console noise out of the Wave 012 cleanup files only', () => {
    87	    const files = frontendSourceAndTests().filter(isWave012ConsoleHygieneFile);
    88	
    89	    expect(files.map(file => file.projectPath).sort()).toEqual([...wave012ConsoleHygieneFiles].sort());
    90	    expect(findContentMatches(files, /console\.(log|debug|info)\s*\(/g)).toEqual([]);
    91	  });
    92	});
### frontend/tests/unit/architecture/noCommandSubclasses.spec.ts
     1	import { describe, expect, it } from 'vitest';
     2	import { findContentMatches, scanTextFiles, type ScannedFile } from './helpers/sourceScanner';
     3	
     4	function isProductionSource(file: ScannedFile): boolean {
     5	  return file.projectPath.startsWith('src/');
     6	}
     7	
     8	function isCommentOrStringOnly(match: RegExpMatchArray): boolean {
     9	  const before = match.input?.slice(0, match.index).split('\n').pop() ?? '';
    10	  return before.trim().startsWith('//') || before.includes('*') || match[0].includes('"extends Command"') || match[0].includes("'extends Command'");
    11	}
    12	
    13	describe('Architecture: Command Pattern', () => {
    14	  it('does not subclass the generic Command container in production code', () => {
    15	    const productionFiles = scanTextFiles(['src']).filter(isProductionSource);
    16	    const violations = findContentMatches(productionFiles, /extends\s+Command\b/g, {
    17	      describe: (file, match) => `${file.projectPath}: ${match[0]}`,
    18	    }).filter(violation => {
    19	      const [projectPath] = violation.split(': ');
    20	      const file = productionFiles.find(candidate => candidate.projectPath === projectPath);
    21	      if (!file) {
    22	        return true;
    23	      }
    24	      const match = /extends\s+Command\b/g.exec(file.content);
    25	      return match ? !isCommentOrStringOnly(match) : true;
    26	    });
    27	
    28	    expect(violations).toEqual([]);
    29	  });
    30	
    31	  it('documents Command as sealed and operation-backed without relying on deleted spec authority', () => {
    32	    const commandFile = scanTextFiles(['src/commands']).find(file => file.projectPath === 'src/commands/Command.ts');
    33	
    34	    expect(commandFile?.content).toContain('@sealed');
    35	    expect(commandFile?.content).toContain('MUST NOT be subclassed');
    36	    expect(commandFile?.content).toContain('All domain logic belongs in Operation classes');
    37	    expect(commandFile?.content).toContain('Application use cases and sequence factories create operations');
    38	    expect(commandFile?.content).not.toContain('data-model.md');
    39	  });
    40	});
### frontend/tests/unit/architecture/worldBoundary.spec.ts
     1	import { describe, expect, it } from 'vitest';
     2	import { findForbiddenImports, scanTextFiles } from './helpers/sourceScanner';
     3	
     4	const forbiddenOuterLayerImports = [
     5	  /^@\/application(\/|$)/,
     6	  /^@\/commands(\/|$)/,
     7	  /^@\/services(\/|$)/,
     8	  /^@\/components(\/|$)/,
     9	  /^@\/stores(\/|$)/,
    10	  /^@\/persistence(\/|$)/,
    11	  /^\.\.\/(?:\.\.\/)*application(\/|$)/,
    12	  /^\.\.\/(?:\.\.\/)*commands(\/|$)/,
    13	  /^\.\.\/(?:\.\.\/)*services(\/|$)/,
    14	  /^\.\.\/(?:\.\.\/)*components(\/|$)/,
    15	  /^\.\.\/(?:\.\.\/)*stores(\/|$)/,
    16	  /^\.\.\/(?:\.\.\/)*persistence(\/|$)/,
    17	];
    18	
    19	describe('Architecture: domain world boundary', () => {
    20	  it('keeps every domain module independent of application, command, service, UI, store, and persistence layers', () => {
    21	    const domainFiles = scanTextFiles(['src/domain']);
    22	
    23	    expect(findForbiddenImports(domainFiles, forbiddenOuterLayerImports)).toEqual([]);
    24	  });
    25	
    26	  it('keeps World.ts specifically free of outer-layer imports', () => {
    27	    const worldFile = scanTextFiles(['src/domain/world']).filter(file => file.projectPath === 'src/domain/world/World.ts');
    28	
    29	    expect(worldFile).toHaveLength(1);
    30	    expect(findForbiddenImports(worldFile, forbiddenOuterLayerImports)).toEqual([]);
    31	  });
    32	});
