     1	/**
     2	 * Intersections - Geometric intersection calculations using homogeneous coordinates
     3	 * 
     4	 * This module provides functions for calculating intersections between geometric
     5	 * primitives using homogeneous coordinate representation.
     6	 * 
     7	 * All calculations follow the project's homogeneous-coordinate geometry policy:
     8	 * - Use homogeneous coordinates throughout
     9	 * - Convert parametric forms to implicit forms when needed
    10	 * - Use cross products for line-line intersections
    11	 * - Handle edge cases (parallel, coincident) explicitly
    12	 * 
    13	 * Line representation:
    14	 * - Parametric form: P(t) = point + t * direction (storage format)
    15	 * - Implicit form: ax + by + c = 0 (computation format for intersections)
    16	 */
    17	
    18	import { Vector3 } from 'three';
    19	import type { Line2DRealization2D } from '../world/Line';
    20	import type { Circle2DRealization2D } from '../world/Circle';
    21	import { Point2DRealization2D } from '../world/Point';
    22	
    23	/**
    24	 * Convert line from parametric form to implicit form using homogeneous coordinates
    25	 * 
    26	 * Parametric form: P(t) = P0 + t * d where P0 = (x0, y0, 1), d = (dx, dy, 0)
    27	 * Implicit form: ax + by + c = 0
    28	 * 
    29	 * The implicit form can be derived from the parametric form:
    30	 * - A line passing through P0 = (x0, y0) with direction d = (dx, dy)
    31	 * - The perpendicular direction to d is (-dy, dx)
    32	 * - Points on the line satisfy: (P - P0) · perpendicular = 0
    33	 * - This gives: -dy(x - x0) + dx(y - y0) = 0
    34	 * - Expanding: -dy*x + dx*y + (dy*x0 - dx*y0) = 0
    35	 * - So: a = -dy, b = dx, c = dy*x0 - dx*y0
    36	 * 
    37	 * @param line Line in parametric form
    38	 * @returns Line in implicit form [a, b, c] where ax + by + c = 0
    39	 */
    40	function lineToImplicitForm(line: Line2DRealization2D): Vector3 {
    41	  const point = line.point1;
    42	  const direction = line.getDirection();
    43	  const x0 = point.x;
    44	  const y0 = point.y;
    45	  const dx = direction.x;
    46	  const dy = direction.y;
    47	  
    48	  // Implicit form: a*x + b*y + c = 0
    49	  // a = -dy, b = dx, c = dy*x0 - dx*y0
    50	  const a = -dy;
    51	  const b = dx;
    52	  const c = dy * x0 - dx * y0;
    53	  
    54	  // Return as Vector3 for convenience (not really a point, just 3 numbers)
    55	  return new Vector3(a, b, c);
    56	}
    57	
    58	/**
    59	 * Calculate intersection point of two lines using homogeneous coordinates
    60	 * 
    61	 * Algorithm (from projective geometry):
    62	 * 1. Convert lines from parametric to implicit form
    63	 * 2. Represent lines as homogeneous vectors L1 = [a1, b1, c1], L2 = [a2, b2, c2]
    64	 * 3. Intersection point is given by cross product: P = L1 × L2
    65	 * 4. Result is in homogeneous coordinates [x, y, w]
    66	 * 5. If w ≈ 0, lines are parallel (point at infinity)
    67	 * 6. Otherwise, convert to Cartesian: (x/w, y/w, 1)
    68	 * 
    69	 * Edge cases:
    70	 * - Parallel lines: Cross product yields [0, 0, 0] or [*, *, 0] (w = 0)
    71	 * - Coincident lines: Same as parallel (treated as no intersection)
    72	 * 
    73	 * @param line1 First line in parametric form
    74	 * @param line2 Second line in parametric form
    75	 * @returns Point2DRealization2D with feasible=false if parallel/coincident, feasible=true otherwise
    76	 */
    77	export function intersectLineLine(
    78	  line1: Line2DRealization2D,
    79	  line2: Line2DRealization2D
    80	): Point2DRealization2D {
    81	  // Convert to implicit form
    82	  const L1 = lineToImplicitForm(line1);
    83	  const L2 = lineToImplicitForm(line2);
    84	  
    85	  // Cross product in homogeneous coordinates
    86	  // L1 × L2 gives the intersection point in homogeneous form
    87	  // 
    88	  // Given L1 = (a1, b1, c1) and L2 = (a2, b2, c2):
    89	  // L1 × L2 = | i    j    k  |
    90	  //           | a1   b1   c1 |
    91	  //           | a2   b2   c2 |
    92	  //
    93	  // = i(b1*c2 - c1*b2) - j(a1*c2 - c1*a2) + k(a1*b2 - b1*a2)
    94	  // = (b1*c2 - c1*b2, c1*a2 - a1*c2, a1*b2 - b1*a2)
    95	  //
    96	  // This represents the point [x, y, w] in homogeneous coordinates
    97	  // where x/w and y/w are the Cartesian coordinates (if w ≠ 0)
    98	  
    99	  const a1 = L1.x, b1 = L1.y, c1 = L1.z;
   100	  const a2 = L2.x, b2 = L2.y, c2 = L2.z;
   101	  
   102	  // Cross product components
   103	  const px = b1 * c2 - c1 * b2;  // x-component (homogeneous)
   104	  const py = c1 * a2 - a1 * c2;  // y-component (homogeneous)
   105	  const w = a1 * b2 - b1 * a2;   // w-component (homogeneous scale)
   106	  
   107	  // Check for parallel lines (w ≈ 0)
   108	  const epsilon = 1e-10;
   109	  if (Math.abs(w) < epsilon) {
   110	    // Lines are parallel or coincident - return infeasible realization
   111	    return new Point2DRealization2D(new Vector3(0, 0, 1), false);
   112	  }
   113	  
   114	  // Convert from homogeneous to Cartesian coordinates
   115	  // Divide by w to get actual (x, y) coordinates
   116	  const x = px / w;
   117	  const y = py / w;
   118	  
   119	  // Return as point realization in homogeneous form (x, y, 1)
   120	  return new Point2DRealization2D(new Vector3(x, y, 1), true);
   121	}
   122	
   123	/**
   124	 * Check if two lines are parallel (without computing intersection)
   125	 * 
   126	 * Two lines are parallel if their directions are parallel (or anti-parallel).
   127	 * In 2D, this means the cross product of direction vectors is zero.
   128	 * 
   129	 * @param line1 First line
   130	 * @param line2 Second line
   131	 * @returns True if lines are parallel
   132	 */
   133	export function areLinesParallel(
   134	  line1: Line2DRealization2D,
   135	  line2: Line2DRealization2D
   136	): boolean {
   137	  const d1 = line1.getDirection();
   138	  const d2 = line2.getDirection();
   139	  
   140	  // Cross product in 2D: d1.x * d2.y - d1.y * d2.x
   141	  // If zero, directions are parallel
   142	  const cross = d1.x * d2.y - d1.y * d2.x;
   143	  
   144	  return Math.abs(cross) < 1e-10;
   145	}
   146	
   147	/**
   148	 * Sort intersection points by projection onto a direction vector.
   149	 * Index 0 = larger projection (more positive), Index 1 = smaller projection (more negative)
   150	 * 
   151	 * This generic function handles both line-circle and circle-circle intersection ordering:
   152	 * - Line-circle: direction = line direction, reference = point on line
   153	 * - Circle-circle: direction = perpendicular to center-line, reference = first circle center
   154	 * 
   155	 * @param points Array of intersection points (typically 2)
   156	 * @param direction Direction vector to project onto (defines "left" vs "right")
   157	 * @param referencePoint Reference point for computing relative positions
   158	 * @returns Sorted array with index 0 = larger (more positive) projection
   159	 */
   160	function sortIntersectionsByProjection(
   161	  points: Vector3[],
   162	  direction: { x: number; y: number },
   163	  referencePoint: Vector3
   164	): Vector3[] {
   165	  if (points.length < 2) return points;
   166	  
   167	  // Project each point onto direction vector (from reference point)
   168	  const projectionsAndPoints = points.map(point => {
   169	    const dx = point.x - referencePoint.x;
   170	    const dy = point.y - referencePoint.y;
   171	    const projection = dx * direction.x + dy * direction.y;
   172	    return { projection, point };
   173	  });
   174	  
   175	  // Sort by projection descending (larger/more positive first = index 0)
   176	  projectionsAndPoints.sort((a, b) => b.projection - a.projection);
   177	  
   178	  return projectionsAndPoints.map(item => item.point);
   179	}
   180	
   181	/**
   182	 * Calculate intersection points of a line and a circle using homogeneous coordinates
   183	 * 
   184	 * Algorithm:
   185	 * 1. Line in parametric form: P(t) = P0 + t*d where P0 is point, d is direction
   186	 * 2. Circle: (x - cx)² + (y - cy)² = r²
   187	 * 3. Substitute line equation into circle equation
   188	 * 4. Results in quadratic: at² + bt + c = 0
   189	 * 5. Solve quadratic to find t values
   190	 * 6. Substitute t back into line equation to get intersection points
   191	 * 
   192	 * Edge cases:
   193	 * - No intersection: discriminant < 0 (returns empty array)
   194	 * - Tangent: discriminant = 0 (returns array with 1 point)
   195	 * - Secant: discriminant > 0 (returns array with 2 points, sorted by projection on line direction)
   196	 * 
   197	 * @param line Line in parametric form
   198	 * @param circle Circle with center and radius
   199	 * @returns Array of intersection points (0, 1, or 2 points)
   200	 */
   201	export function intersectLineCircle(
   202	  line: Line2DRealization2D,
   203	  circle: Circle2DRealization2D
   204	): Vector3[] {
   205	  const P0 = line.point1;
   206	  const d = line.getDirection();
   207	  const C = circle.center;
   208	  const r = circle.getRadius();
   209	  
   210	  // Line: P(t) = P0 + t*d = (P0.x + t*d.x, P0.y + t*d.y)
   211	  // Circle: (x - C.x)² + (y - C.y)² = r²
   212	  //
   213	  // Substitute line into circle:
   214	  // (P0.x + t*d.x - C.x)² + (P0.y + t*d.y - C.y)² = r²
   215	  //
   216	  // Let dx = P0.x - C.x, dy = P0.y - C.y
   217	  // (dx + t*d.x)² + (dy + t*d.y)² = r²
   218	  //
   219	  // Expand:
   220	  // dx² + 2*dx*t*d.x + t²*d.x² + dy² + 2*dy*t*d.y + t²*d.y² = r²
   221	  //
   222	  // Group by powers of t:
   223	  // (d.x² + d.y²)*t² + 2*(dx*d.x + dy*d.y)*t + (dx² + dy² - r²) = 0
   224	  //
   225	  // This is quadratic: a*t² + b*t + c = 0
   226	  
   227	  const dx = P0.x - C.x;
   228	  const dy = P0.y - C.y;
   229	  
   230	  const a = d.x * d.x + d.y * d.y;  // Should be 1 if direction is normalized
   231	  const b = 2 * (dx * d.x + dy * d.y);
   232	  const c = dx * dx + dy * dy - r * r;
   233	  
   234	  // Calculate discriminant
   235	  const discriminant = b * b - 4 * a * c;
   236	  const epsilon = 1e-10;
   237	  
   238	  if (discriminant < -epsilon) {
   239	    // No intersection
   240	    return [];
   241	  } else if (Math.abs(discriminant) < epsilon) {
   242	    // Tangent - one intersection point
   243	    const t = -b / (2 * a);
   244	    const x = P0.x + t * d.x;
   245	    const y = P0.y + t * d.y;
   246	    
   247	    return [new Vector3(x, y, 1)];
   248	  } else {
   249	    // Secant - two intersection points
   250	    const sqrtDisc = Math.sqrt(discriminant);
   251	    const t1 = (-b - sqrtDisc) / (2 * a);
   252	    const t2 = (-b + sqrtDisc) / (2 * a);
   253	    
   254	    const x1 = P0.x + t1 * d.x;
   255	    const y1 = P0.y + t1 * d.y;
   256	    const x2 = P0.x + t2 * d.x;
   257	    const y2 = P0.y + t2 * d.y;
   258	    
   259	    // Two intersection points (secant case)
   260	    const unsortedPoints = [

     1	/**
     2	 * Unit tests for Intersections module
     3	 * 
     4	 * Tests geometric intersection calculations using homogeneous coordinates.
     5	 * Validates:
     6	 * - Line-line intersections (cross product algorithm)
     7	 * - Line-circle intersections (quadratic formula)
     8	 * - Circle-circle intersections (geometric formula)
     9	 * 
    10	 * Test coverage:
    11	 * - Standard intersections (perpendicular, diagonal, tangent, secant)
    12	 * - Edge cases (parallel, coincident, no intersection, multiple solutions)
    13	 * - Homogeneous coordinate correctness
    14	 * - Numerical stability
    15	 */
    16	
    17	import { describe, it, expect } from 'vitest';
    18	import { Vector3 } from 'three';
    19	import { 
    20	  intersectLineLine, 
    21	  areLinesParallel,
    22	  intersectLineCircle,
    23	  intersectCircleCircle
    24	} from '../../../src/domain/calculations/Intersections';
    25	import { Line2DRealization2D } from '../../../src/domain/world/Line';
    26	import { Circle2DRealization2D } from '../../../src/domain/world/Circle';
    27	
    28	describe('Intersections', () => {
    29	  describe('intersectLineLine', () => {
    30	    it('should find intersection of perpendicular lines', () => {
    31	      // Horizontal line through (0, 2): y = 2
    32	      // Parametric: P(t) = (0, 2, 1) + t*(1, 0, 0)
    33	      const line1 = new Line2DRealization2D(
    34	        new Vector3(0, 2, 1),  // point
    35	        new Vector3(1, 0, 0)   // direction (horizontal)
    36	      );
    37	      
    38	      // Vertical line through (3, 0): x = 3
    39	      // Parametric: P(t) = (3, 0, 1) + t*(0, 1, 0)
    40	      const line2 = new Line2DRealization2D(
    41	        new Vector3(3, 0, 1),  // point
    42	        new Vector3(0, 1, 0)   // direction (vertical)
    43	      );
    44	      
    45	      const result = intersectLineLine(line1, line2);
    46	      
    47	      expect(result.feasible).toBe(true);
    48	      expect(result.position.x).toBeCloseTo(3, 6);
    49	      expect(result.position.y).toBeCloseTo(2, 6);
    50	      expect(result.position.z).toBe(1); // homogeneous coordinate
    51	    });
    52	    
    53	    it('should find intersection of diagonal lines', () => {
    54	      // Line 1: passing through (0, 0) with direction (1, 1)
    55	      // Equation: y = x
    56	      const line1 = new Line2DRealization2D(
    57	        new Vector3(0, 0, 1),
    58	        new Vector3(1, 1, 0).normalize()
    59	      );
    60	      
    61	      // Line 2: passing through (0, 4) with direction (1, -1)
    62	      // Equation: y = -x + 4
    63	      const line2 = new Line2DRealization2D(
    64	        new Vector3(0, 4, 1),
    65	        new Vector3(1, -1, 0).normalize()
    66	      );
    67	      
    68	      const result = intersectLineLine(line1, line2);
    69	      
    70	      // Intersection: y = x and y = -x + 4
    71	      // x = -x + 4 => 2x = 4 => x = 2, y = 2
    72	      expect(result.feasible).toBe(true);
    73	      expect(result.position.x).toBeCloseTo(2, 6);
    74	      expect(result.position.y).toBeCloseTo(2, 6);
    75	      expect(result.position.z).toBe(1);
    76	    });
    77	    
