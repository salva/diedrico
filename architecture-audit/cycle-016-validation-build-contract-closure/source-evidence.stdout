## guide integration
     1	import { describe, it, expect, beforeEach } from 'vitest';
     2	import type { World } from '../../src/domain/world/World';
     3	import type { CommandStack } from '../../src/commands/CommandStack';
     4	import { Command } from '../../src/commands/Command';
     5	import { AddFreePoint2DOp } from '../../src/commands/operations/world/AddFreePointOp';
     6	import { AddLine2DByTwoPointsOp } from '../../src/commands/operations/world/AddLineOp';
     7	import { GuideSequenceFactory } from '../../src/commands/factories/GuideSequenceFactory';
     8	import { setupBasicWorld } from '../helpers/worldHelpers';
     9	import { Vector3 } from 'three';
    10	
    11	describe('Guide Creation - Integration Tests', () => {
    12	  let world: World;
    13	  let commandStack: CommandStack;
    14	  let projPlaneH: string;
    15	
    16	  beforeEach(() => {
    17	    const setup = setupBasicWorld();
    18	    world = setup.world;
    19	    commandStack = setup.commandStack;
    20	    projPlaneH = setup.projPlaneH;
    21	  });
    22	
    23	  describe('Regular Line Reference', () => {
    24	    it('should create guide on regular line without sibling', () => {
    25	      const planeId = projPlaneH;
    26	
    27	      // Create two points and a line between them
    28	      const cmd = new Command('Setup test geometry', world);
    29	      
    30	      const point1Result = cmd.addAndExecute(
    31	        new AddFreePoint2DOp(planeId, new Vector3(100, 100, 1))
    32	      );
    33	      const point1Id = point1Result.outputs.pointId;
    34	
    35	      const point2Result = cmd.addAndExecute(
    36	        new AddFreePoint2DOp(planeId, new Vector3(200, 100, 1))
    37	      );
    38	      const point2Id = point2Result.outputs.pointId;
    39	
    40	      const lineResult = cmd.addAndExecute(
    41	        new AddLine2DByTwoPointsOp(planeId, point1Id, point2Id)
    42	      );
    43	      const lineId = lineResult.outputs.lineId;
    44	
    45	      // Create point for guide to pass through
    46	      const throughPointResult = cmd.addAndExecute(
    47	        new AddFreePoint2DOp(planeId, new Vector3(150, 150, 1))
    48	      );
    49	      const throughPointId = throughPointResult.outputs.pointId;
    50	
    51	      cmd.commit();
    52	      commandStack.push(cmd);
    53	
    54	      // Create guide using regular line as reference
    55	      const guideCmd = new Command('Create guide on regular line', world);
    56	      const result = GuideSequenceFactory.createGuideWithSibling(
    57	        guideCmd,
    58	        planeId,
    59	        lineId,
    60	        throughPointId,
    61	        world
    62	      );
    63	
    64	      guideCmd.commit();
    65	      commandStack.push(guideCmd);
    66	
    67	      // Verify results
    68	      expect(result.guideId).toBeDefined();
    69	      expect(result.siblingGuideId).toBeUndefined(); // No sibling for regular line
    70	
    71	      // Verify guide exists in world
    72	      const plane = world.getProjectionPlaneById(planeId)!;
    73	      const guide = plane.getLine(result.guideId);
    74	      expect(guide).toBeDefined();
    75	      expect(guide?.id).toBe(result.guideId);
    76	    });
    77	  });
    78	
    79	
    80	  describe('Error Prevention', () => {
    81	    it('should not throw when creating guide on non-hinge line', () => {
    82	      // Regression test for: "Failed to get sibling info for half-hinge-line"
    83	      // This error occurred when GuideTool assumed all guides had siblings
    84	      
    85	      // Create regular line (not hinge)
    86	      const cmd = new Command('Setup', world);
    87	      const p1 = cmd.addAndExecute(new AddFreePoint2DOp(projPlaneH, new Vector3(0, 0, 1)));
    88	      const p2 = cmd.addAndExecute(new AddFreePoint2DOp(projPlaneH, new Vector3(100, 0, 1)));
    89	      const line = cmd.addAndExecute(new AddLine2DByTwoPointsOp(projPlaneH, p1.outputs.pointId, p2.outputs.pointId));
    90	      const throughPoint = cmd.addAndExecute(new AddFreePoint2DOp(projPlaneH, new Vector3(50, 50, 1)));
    91	      cmd.commit();
    92	      commandStack.push(cmd);
    93	
    94	      // This should NOT throw
    95	      expect(() => {
    96	        const guideCmd = new Command('Create guide', world);
    97	        GuideSequenceFactory.createGuideWithSibling(
    98	          guideCmd,
    99	          projPlaneH,
   100	          line.outputs.lineId,
   101	          throughPoint.outputs.pointId,
   102	          world
   103	        );
   104	        guideCmd.commit();
   105	      }).not.toThrow();
   106	    });
   107	  });
   108	});

