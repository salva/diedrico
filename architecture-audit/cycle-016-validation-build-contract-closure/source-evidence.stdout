    16	          <h3>Geometry Info</h3>
    17	          <div class="info-grid">
    18	            <div class="info-row">
    19	              <span class="info-label">Type:</span>
    20	              <span class="info-value">{{ elementType }}</span>
    21	            </div>
    22	            <div class="info-row" v-if="planeId">
    23	              <span class="info-label">Plane:</span>
    24	              <span class="info-value">{{ planeId }}</span>
    25	            </div>
    26	            <div class="info-row" v-if="coordinates">
    27	              <span class="info-label">Coordinates:</span>
    28	              <span class="info-value">{{ coordinates }}</span>
    29	            </div>
    30	            <div class="info-row" v-if="dependencies && dependencies.length > 0">
    31	              <span class="info-label">Dependencies:</span>
    32	              <span class="info-value">{{ dependencies.join(', ') }}</span>
    33	            </div>
    34	            <div class="info-row" v-if="createdBy">
    35	              <span class="info-label">Created by:</span>
    36	              <span class="info-value">{{ createdBy }}</span>
    37	            </div>
    38	          </div>
    39	        </section>
    40	
    41	        <!-- Visual Style Section (Editable) -->
    42	        <section class="visual-style-section">
    43	          <h3>Visual Style</h3>
    44	          <div class="style-controls">
    45	            <!-- Color -->
    46	            <div class="control-row">
    47	              <label for="color-input">Color:</label>
    48	              <input
    49	                id="color-input"
    50	                type="color"
    51	                v-model="editableColor"
    52	                :disabled="!colorOverride"
    53	                @blur="colorOverride && validateColor(editableColor)"
    54	              />
    55	              <input
    56	                type="text"
    57	                v-model="editableColor"
    58	                pattern="^#[0-9A-Fa-f]{6}$"
    59	                class="hex-input"
    60	                :class="{ 'input-error': colorError }"
    61	                :disabled="!colorOverride"
    62	                placeholder="#000000"
    63	                @blur="colorOverride && validateColor(editableColor)"
    64	              />
    65	              <label class="override-checkbox">
    66	                <input type="checkbox" v-model="colorOverride" />
    67	                Override
    68	              </label>
    69	            </div>
    70	            <div v-if="colorError" class="error-message">{{ colorError }}</div>
    71	
    72	            <!-- Line Width (for non-point elements) -->
    73	            <div class="control-row" v-if="elementType !== '2D Point'">
    74	              <label for="width-input">Line Width:</label>
    75	              <input
    76	                id="width-input"
    77	                type="range"
    78	                min="0.5"
    79	                max="5.0"
    80	                step="0.1"
    81	                v-model.number="editableLineWidth"
    82	                :disabled="!lineWidthOverride"
    83	                @change="lineWidthOverride && validateLineWidth(editableLineWidth)"
