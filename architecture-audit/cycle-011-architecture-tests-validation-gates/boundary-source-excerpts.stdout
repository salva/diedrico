    49	
    50	<script setup lang="ts">
    51	import { ref, inject, onMounted, onUnmounted } from 'vue';
    52	import { Command } from '@/commands/Command';
    53	import { AddExampleSetupOp, type ExampleSetupType } from '@/commands/operations/debug/AddExampleSetupOp';
    54	import type { CommandStack } from '@/commands/CommandStack';
    55	import type { World } from '@/domain/world/World';
    56	
    57	const world = inject<World>('world')!;
    58	const commandStack = inject<CommandStack>('commandStack')!;
    59	
    60	const menuOpen = ref(false);
    61	
    62	function toggleMenu() {
    63	  menuOpen.value = !menuOpen.value;
    64	}
    65	
    66	function closeMenu() {
    67	  menuOpen.value = false;
    68	}
    69	
    70	function addExample(setupType: ExampleSetupType) {
    71	  try {
    72	    const cmd = new Command(`Add ${setupType} example`, world);
    73	    cmd.addAndExecute(new AddExampleSetupOp(setupType));
    74	    cmd.commit();
    75	    commandStack.push(cmd);
    76	    
    77	    closeMenu();
    78	  } catch (error) {
    79	    console.error('Failed to add example setup:', error);
    80	    alert(`Failed to add example: ${error instanceof Error ? error.message : String(error)}`);
    81	  }
    82	}
    83	
    84	// Keyboard shortcut: E
    85	function handleKeyPress(event: KeyboardEvent) {
    86	  if (event.key === 'e' || event.key === 'E') {
    87	    // Don't trigger if user is typing in an input field
    88	    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) {
    89	      return;
    90	    }
    91	    event.preventDefault();
    92	    toggleMenu();
    93	  } else if (event.key === 'Escape' && menuOpen.value) {
    94	    closeMenu();
    95	  }
    96	}
    97	
    98	onMounted(() => {
    99	  document.addEventListener('keydown', handleKeyPress);
   100	});
   101	
   102	onUnmounted(() => {
   103	  document.removeEventListener('keydown', handleKeyPress);
   104	});
   105	</script>
