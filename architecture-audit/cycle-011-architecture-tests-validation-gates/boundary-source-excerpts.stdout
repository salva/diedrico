     9	
    10	  update(request: StyleUpdateRequest): ToolCommandResult {
    11	    const cmd = new Command(`Update style: ${request.elementId}`, this.world);
    12	    try {
    13	      cmd.addAndExecute(new UpdateElementStyleOp(request.elementId, request.planeId, request.style) as any);
    14	      cmd.commit();
    15	      this.commandStack.push(cmd);
    16	      return { success: true };
    17	    } catch (error) {
    18	      cmd.rollback();
    19	      return { success: false, message: error instanceof Error ? error.message : String(error) };
    20	    }
    21	  }
    22	}
--- frontend/src/application/appShell/SelectionUseCases.ts
     1	import { watch, type WatchStopHandle } from 'vue';
     2	import { Command } from '@/commands/Command';
     3	import type { CommandStack } from '@/commands/CommandStack';
     4	import { DeletionSequenceFactory } from '@/commands/factories/DeletionSequenceFactory';
     5	import type { World } from '@/domain/world/World';
     6	import type { SelectionStorePort } from './AppShellPorts';
     7	
     8	export class SelectionUseCases {
     9	  private stopSelectionWatch: WatchStopHandle | null = null;
    10	
    11	  constructor(
    12	    private readonly world: World,
    13	    private readonly commandStack: CommandStack,
    14	    private readonly selectionStore: SelectionStorePort,
    15	    private readonly getActivePlaneId: () => string | undefined,
    16	  ) {}
    17	
    18	  start(): void {
    19	    if (this.stopSelectionWatch) return;
    20	    this.stopSelectionWatch = watch(
    21	      () => this.selectionStore.selectedIdsArray,
    22	      (selectedIds) => this.updateCascadePreview(selectedIds),
    23	      { immediate: true },
    24	    );
    25	  }
    26	
    27	  dispose(): void {
    28	    this.stopSelectionWatch?.();
    29	    this.stopSelectionWatch = null;
    30	    this.selectionStore.clearCascadeHighlight();
    31	  }
    32	
    33	  deleteSelected(): void {
    34	    const selectedIds = this.selectionStore.selectedIdsArray;
    35	    if (selectedIds.length === 0) return;
    36	    const deleteCommand = new Command('Delete elements', this.world);
    37	    DeletionSequenceFactory.createCascadeDeletion(deleteCommand, selectedIds, this.world);
    38	    deleteCommand.commit();
    39	    this.commandStack.push(deleteCommand);
    40	    this.selectionStore.clearSelection();
    41	  }
    42	
    43	  clearSelection(): void {
    44	    this.selectionStore.clearSelection();
    45	  }
    46	
    47	  selectAllInActivePlane(): void {
    48	    const activePlaneId = this.getActivePlaneId();
    49	    if (!activePlaneId) return;
    50	    const activePlane = this.world.getProjectionPlaneById(activePlaneId);
    51	    if (!activePlane) return;
    52	    const selectedIds: string[] = [];
    53	    for (const point of activePlane.getAllPoints()) selectedIds.push(point.id);
    54	    for (const line of activePlane.getAllLines()) selectedIds.push(line.id);
    55	    for (const circle of activePlane.getAllCircles()) selectedIds.push(circle.id);
    56	    if (selectedIds.length > 0) this.selectionStore.selectMultiple(selectedIds);
    57	  }
    58	
    59	  private updateCascadePreview(selectedIds: string[]): void {
    60	    if (selectedIds.length === 0) {
    61	      this.selectionStore.clearCascadeHighlight();
    62	      return;
    63	    }
    64	    const allElementsToDelete = this.world.getDependencyService().getElementsInDeletionOrder(selectedIds);
    65	    this.selectionStore.setCascadeHighlight(allElementsToDelete.filter((id) => !selectedIds.includes(id)));
    66	  }
    67	}
--- frontend/src/application/world/initializeWorld.ts
     1	import { Command } from '@/commands/Command';
     2	import type { CommandStack } from '@/commands/CommandStack';
     3	import { buildWorldInitialization } from '@/commands/factories/InitializationSequenceFactory';
     4	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
     5	import { PopSubprocessOp, PushSubprocessOp } from '@/commands/operations/processTree';
     6	import { createActionGroup } from '@/domain/processTree/ActionGroup';
     7	import type { World } from '@/domain/world/World';
     8	
     9	function createInitializationGroupId(): string {
    10	  return `group_init_${Date.now()}`;
    11	}
    12	
    13	/**
    14	 * Application use case for initializing the default Diedrico world.
    15	 *
    16	 * The domain World owns geometric state only; command construction and history
    17	 * recording belong at the application/command boundary.
    18	 */
    19	export function initializeWorld(world: World, commandStack: CommandStack): void {
    20	  if (world.getAllProjectionPlanes().length > 0) return;
    21	
    22	  const initCmd = new Command('Initialize World', world);
    23	
    24	  initCmd.addAndExecute(new PushSubprocessOp('World Initialization'));
    25	
    26	  const groupId = createInitializationGroupId();
    27	  const group = createActionGroup(groupId);
    28	  initCmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    29	
    30	  buildWorldInitialization(world, initCmd, groupId);
    31	
    32	  initCmd.addAndExecute(new PopSubprocessOp());
    33	  initCmd.commit();
    34	  commandStack.push(initCmd);
    35	  world.markDirty();
    36	}
--- frontend/src/application/appShell/AppShellRuntime.ts
     1	import { computed, ref } from 'vue';
     2	import { CommandStack } from '@/commands/CommandStack';
     3	import { World } from '@/domain/world/World';
     4	import { GoogleDriveService, type GoogleDriveConfig } from '@/services/GoogleDriveService';
     5	import { ProjectService } from '@/services/ProjectService';
     6	import { ActivePlaneUseCases } from './ActivePlaneUseCases';
     7	import { AutoSaveUseCases } from './AutoSaveUseCases';
     8	import { KeyboardShortcutRouter } from './KeyboardShortcutRouter';
     9	import type { AppShellCallbacks, AppShellRuntimePorts, SaveStatus } from './AppShellPorts';
    10	import { createBrowserScheduler } from './AppShellPorts';
    11	import { ProjectSessionUseCases } from './ProjectSessionUseCases';
    12	import { SelectionUseCases } from './SelectionUseCases';
    13	
    14	export interface AppShellRuntimeOptions {
    15	  googleConfig: GoogleDriveConfig;
    16	  hasGoogleCredentials: boolean;
    17	  ports: Omit<AppShellRuntimePorts, 'drive' | 'persistence' | 'storage' | 'scheduler' | 'callbacks'> & Partial<Pick<AppShellRuntimePorts, 'drive' | 'persistence' | 'storage' | 'scheduler'>>;
    18	  callbacks: AppShellCallbacks;
    19	}
    20	
    21	export function createAppShellRuntime(options: AppShellRuntimeOptions) {
    22	  const world = new World();
    23	  const commandStack = new CommandStack();
    24	  const drive = options.ports.drive ?? (options.hasGoogleCredentials ? new GoogleDriveService(options.googleConfig) : null);
    25	  const ports: AppShellRuntimePorts = {
    26	    drive,
    27	    persistence: options.ports.persistence ?? ProjectService,
    28	    storage: options.ports.storage ?? window.localStorage,
    29	    scheduler: options.ports.scheduler ?? createBrowserScheduler(),
    30	    authStore: options.ports.authStore,
    31	    selectionStore: options.ports.selectionStore,
    32	    toolStore: options.ports.toolStore,
    33	    viewStore: options.ports.viewStore,
    34	    callbacks: options.callbacks,
    35	  };
    36	
    37	  const activePlaneId = ref<string | undefined>(world.getActivePlaneId());
    38	  const activePlaneName = ref('');
    39	  const coordinates3D = ref<{ x: number; y: number; z: number } | null>(null);
    40	  const show3DView = ref(true);
    41	  const showStartupDialog = ref(false);
    42	  const isSignedIn = ref(false);
    43	  const currentProjectName = ref<string | null>(null);
    44	  const currentFileId = ref<string | null>(null);
    45	  const isRenamingProject = ref(false);
    46	  const saveStatus = ref<SaveStatus>('idle');
    47	  const startupDialog = {
    48	    files: ref([]),
    49	    loading: ref(false),
    50	    loadingFiles: ref(false),
    51	    error: ref<string | null>(null),
    52	  };
    53	
    54	  const activePlane = new ActivePlaneUseCases(world, { activePlaneId, activePlaneName });
    55	  const selection = new SelectionUseCases(world, commandStack, ports.selectionStore, () => activePlaneId.value);
    56	  const autoSave = new AutoSaveUseCases({
    57	    world,
    58	    commandStack,
    59	    drive,
    60	    persistence: ports.persistence,
    61	    storage: ports.storage,
    62	    scheduler: ports.scheduler,
    63	    currentFileId,
    64	    currentProjectName,
    65	    saveStatus,
    66	    showStartupDialog,
    67	    isSignedIn,
    68	    alert: ports.callbacks.alert,
    69	  });
    70	  const projectSession = new ProjectSessionUseCases({
    71	    world,
    72	    commandStack,
    73	    hasGoogleCredentials: options.hasGoogleCredentials,
    74	    showStartupDialog,
    75	    isSignedIn,
    76	    currentProjectName,
    77	    currentFileId,
    78	    isRenamingProject,
    79	    saveStatus,
    80	    startupDialog,
    81	    autoSave,
    82	    ports,
    83	  });
    84	  const keyboard = new KeyboardShortcutRouter({
    85	    commandStack,
    86	    toolStore: ports.toolStore,
    87	    viewStore: ports.viewStore,
    88	    projectSession,
    89	    selection,
    90	    activePlane,
    91	    fitToView: ports.callbacks.fitToView,
    92	    startRename: ports.callbacks.startRename,
    93	  });
    94	
    95	  let started = false;
    96	  function start(): void {
    97	    if (started) return;
    98	    started = true;
    99	    activePlane.start();
   100	    selection.start();
   101	    keyboard.install(window);
   102	    void projectSession.initialize();
   103	  }
   104	
   105	  function dispose(): void {
   106	    if (!started) return;
   107	    started = false;
   108	    keyboard.dispose();
   109	    autoSave.dispose();
   110	    activePlane.dispose();
   111	    selection.dispose();
   112	    projectSession.dispose();
   113	  }
   114	
   115	  return {
   116	    world,
   117	    commandStack,
   118	    state: {
   119	      activePlaneId,
   120	      activePlaneName,
   121	      coordinates3D,
   122	      show3DView,
   123	      showStartupDialog,
   124	      isSignedIn,
   125	      currentProjectName,
   126	      currentFileId,
   127	      isRenamingProject,
   128	      saveStatus,
   129	      startupFiles: computed(() => startupDialog.files.value),
   130	      startupLoading: computed(() => startupDialog.loading.value),
   131	      startupLoadingFiles: computed(() => startupDialog.loadingFiles.value),
   132	      startupError: computed(() => startupDialog.error.value),
   133	    },
   134	    actions: {
   135	      start,
   136	      dispose,
   137	      signIn: () => projectSession.signIn(),
   138	      toolbarSignIn: () => projectSession.toolbarSignIn(),
   139	      toolbarSignOut: () => projectSession.signOut(),
   140	      createProject: (name: string) => projectSession.createProject(name),
   141	      openProject: (fileId: string) => projectSession.openProject(fileId),
   142	      newProject: () => projectSession.newProject(),
   143	      showProjectChooser: () => projectSession.showStartupProjectChooser(),
   144	      renameProject: (name: string) => projectSession.renameProject(name),
   145	      requestFiles: () => projectSession.requestFiles(),
   146	      updateCoordinates: (coords: { x: number; y: number; z: number } | null) => { coordinates3D.value = coords; },
   147	      updateActivePlane: (planeInfo: { id: string; name: string }) => activePlane.updateActivePlane(planeInfo),
   148	    },
   149	    internals: { keyboard, activePlane, autoSave, selection, projectSession },
   150	  };
   151	}
   152	
   153	export type AppShellRuntime = ReturnType<typeof createAppShellRuntime>;
--- frontend/tests/e2e/wave010-app-shell-project-flow.spec.ts
     1	import { expect, test } from '@playwright/test';
     2	
     3	test.describe('Wave 010 app-shell project boundary', () => {
     4	  test('starts without Google credentials and opens the app-shell project chooser without backend project API calls', async ({ page }) => {
     5	    const staleBackendProjectRequests: string[] = [];
     6	
     7	    page.on('request', (request) => {
     8	      const url = request.url();
     9	      if (url.includes('localhost:3000/api/projects') || url.includes('/api/projects')) {
    10	        staleBackendProjectRequests.push(url);
    11	      }
    12	    });
    13	
    14	    await page.route('**/api/projects**', (route) => {
    15	      staleBackendProjectRequests.push(route.request().url());
    16	      return route.abort('failed');
    17	    });
    18	    await page.route('http://localhost:3000/**', (route) => {
    19	      staleBackendProjectRequests.push(route.request().url());
    20	      return route.abort('failed');
    21	    });
    22	
    23	    await page.goto('/');
    24	
    25	    await expect(page.getByText('Untitled Project')).toBeVisible();
    26	    await expect(page.getByRole('button', { name: 'Open Project' })).toBeVisible();
    27	    await expect(page.getByText('Diedrico - Project Selection')).toHaveCount(0);
    28	
    29	    await page.getByRole('button', { name: 'Open Project' }).click();
    30	
    31	    await expect(page.getByText('Diedrico - Project Selection')).toBeVisible();
    32	    await expect(page.getByText('Sign in with your Google account to access your projects')).toBeVisible();
    33	    await expect(page.getByRole('button', { name: 'Sign in with Google' })).toBeVisible();
    34	
    35	    expect(staleBackendProjectRequests).toEqual([]);
    36	  });
    37	});
