     1	import { describe, expect, it } from 'vitest';
     2	import { findContentMatches, findForbiddenImports, scanTextFiles, type ScannedFile } from './helpers/sourceScanner';
     3	
     4	const frontendSourceAndTests = () => scanTextFiles(['src', 'tests']);
     5	
     6	const staleBackendProjectTerms = new RegExp([
     7	  ['localhost:3000', 'api', 'projects'].join('/'),
     8	  '/api/' + 'projects',
     9	  'Project' + 'DTO',
    10	  'Project' + 'Metadata',
    11	  'Open' + 'Project' + 'Dialog',
    12	].join('|'));
    13	
    14	function isArchitectureSpec(file: ScannedFile): boolean {
    15	  return file.projectPath.startsWith('tests/unit/architecture/');
    16	}
    17	
    18	function isWave010NegativeE2EGuard(file: ScannedFile): boolean {
    19	  return file.projectPath === 'tests/e2e/wave010-app-shell-project-flow.spec.ts';
    20	}
    21	
    22	describe('Architecture: import boundaries', () => {
    23	  it('keeps UI components from importing command construction surfaces', () => {
    24	    const componentFiles = scanTextFiles(['src/components']);
    25	
    26	    expect(findForbiddenImports(componentFiles, [
    27	      /^@\/commands(\/|$)/,
    28	      /^@\/application\/commands(\/|$)/,
    29	      /commands\/operations/,
    30	      /CommandStack$/,
    31	      /CommandFactory$/,
    32	    ])).toEqual([]);
    33	  });
    34	
    35	  it('keeps command construction available to application/use-case modules', () => {
    36	    const applicationFiles = scanTextFiles(['src/application']);
    37	    const commandImports = applicationFiles.flatMap(file =>
    38	      file.imports
    39	        .filter(importSource => /^@\/commands(\/|$)/.test(importSource) || /commands\/operations/.test(importSource))
    40	        .map(importSource => `${file.projectPath} imports ${importSource}`),
    41	    );
    42	
    43	    expect(commandImports.length).toBeGreaterThan(0);
    44	  });
    45	
    46	  it('forbids frontend source and tests from importing backend implementation files', () => {
    47	    const files = frontendSourceAndTests();
    48	
    49	    expect(findForbiddenImports(files, [/backend\/src/, /^backend\/src/])).toEqual([]);
    50	    expect(findContentMatches(files, /backend\/src\//g, { exclude: isArchitectureSpec })).toEqual([]);
    51	  });
    52	
    53	  it('keeps stale backend project API and DTO terms out of active frontend code', () => {
    54	    const files = frontendSourceAndTests();
    55	
    56	    expect(findContentMatches(files, staleBackendProjectTerms, {
    57	      exclude: file => isArchitectureSpec(file) || isWave010NegativeE2EGuard(file),
    58	    })).toEqual([]);
    59	  });
    60	
    61	  it('does not reference the deleted debug examples setup surface from active source or tests', () => {
    62	    const files = frontendSourceAndTests();
    63	
    64	    expect(findContentMatches(files, /ExamplesMenu|AddExampleSetupOp|projection-plane-setup|basic-3d-point-setup/g, {
    65	      exclude: isArchitectureSpec,
    66	    })).toEqual([]);
    67	  });
    68	});

---
     1	import { describe, expect, it } from 'vitest';
     2	import { findContentMatches, scanTextFiles, type ScannedFile } from './helpers/sourceScanner';
     3	
     4	function isProductionSource(file: ScannedFile): boolean {
     5	  return file.projectPath.startsWith('src/');
     6	}
     7	
     8	function isCommentOrStringOnly(match: RegExpMatchArray): boolean {
     9	  const before = match.input?.slice(0, match.index).split('\n').pop() ?? '';
    10	  return before.trim().startsWith('//') || before.includes('*') || match[0].includes('"extends Command"') || match[0].includes("'extends Command'");
    11	}
    12	
    13	describe('Architecture: Command Pattern', () => {
    14	  it('does not subclass the generic Command container in production code', () => {
    15	    const productionFiles = scanTextFiles(['src']).filter(isProductionSource);
    16	    const violations = findContentMatches(productionFiles, /extends\s+Command\b/g, {
    17	      describe: (file, match) => `${file.projectPath}: ${match[0]}`,
    18	    }).filter(violation => {
    19	      const [projectPath] = violation.split(': ');
    20	      const file = productionFiles.find(candidate => candidate.projectPath === projectPath);
    21	      if (!file) {
    22	        return true;
    23	      }
    24	      const match = /extends\s+Command\b/g.exec(file.content);
    25	      return match ? !isCommentOrStringOnly(match) : true;
    26	    });
    27	
    28	    expect(violations).toEqual([]);
    29	  });
    30	
    31	  it('documents Command as sealed and operation-backed', () => {
    32	    const commandFile = scanTextFiles(['src/commands']).find(file => file.projectPath === 'src/commands/Command.ts');
    33	
    34	    expect(commandFile?.content).toContain('@sealed');
    35	    expect(commandFile?.content).toContain('MUST NOT be subclassed');
    36	    expect(commandFile?.content).toContain('All domain logic belongs in Operation classes');
    37	    expect(commandFile?.content).toContain('data-model.md');
    38	  });
    39	});

