--- frontend/tests/unit/architecture/deletedLegacyWorldStatePaths.spec.ts
     1	import { describe, expect, it } from 'vitest';
     2	
     3	const deletedPathTerms = [
     4	  'worldStore',
     5	  'useWorldStore',
     6	  'Workspace2D',
     7	  'ElementRenderer',
     8	  'ElementTypes',
     9	  'useSnapping',
    10	  'useElementGeometry',
    11	  'getWorld',
    12	];
    13	
    14	describe('Architecture: deleted legacy world-state paths', () => {
    15	  it('active source and tests do not reference deleted store/workspace geometry surfaces', () => {
    16	    const fs = require('fs');
    17	    const path = require('path');
    18	    const sourceRoots = ['src', 'tests'].map((sourceRoot: string) => path.join(process.cwd(), sourceRoot));
    19	    const ignoredPathFragments = [
    20	      path.join('tests', 'unit', 'architecture', 'deletedLegacyWorldStatePaths.spec.ts'),
    21	    ];
    22	
    23	    function listTextFiles(directory: string): string[] {
    24	      return fs.readdirSync(directory).flatMap((entry: string) => {
    25	        const filePath = path.join(directory, entry);
    26	        const stat = fs.statSync(filePath);
    27	
    28	        if (stat.isDirectory()) {
    29	          return listTextFiles(filePath);
    30	        }
    31	
    32	        if (/\.(ts|tsx|vue)$/.test(filePath)) {
    33	          return [filePath];
    34	        }
    35	
    36	        return [];
    37	      });
    38	    }
    39	
    40	    const violations = sourceRoots
    41	      .flatMap(listTextFiles)
    42	      .filter((filePath: string) => !ignoredPathFragments.some(fragment => filePath.endsWith(fragment)))
    43	      .flatMap((filePath: string) => {
    44	        const content = fs.readFileSync(filePath, 'utf-8');
    45	        return deletedPathTerms
    46	          .filter(term => content.includes(term))
    47	          .map(term => `${path.relative(process.cwd(), filePath)} contains ${term}`);
    48	      });
    49	
    50	    expect(violations).toEqual([]);
    51	  });
    52	});
--- frontend/tests/unit/architecture/noCommandSubclasses.spec.ts
     1	/**
     2	 * Architectural Test: No Command Subclasses
     3	 * 
     4	 * This test enforces the architectural principle that Command must NOT be subclassed.
     5	 * Per data-model.md §Command Pattern:
     6	 * - "Architecture: Single Command class (not subclasses) - the real logic is in Operation classes"
     7	 * - "No Subclasses Needed: Tools create operations directly and pass to generic Command"
     8	 * 
     9	 * WHY THIS MATTERS:
    10	 * Command is a generic container for Operations. All domain logic belongs in Operation
    11	 * classes (AddFreePoint2DOp, AddLine2DOp, UpdateElementStyleOp, etc.) that implement
    12	 * the IOperation interface.
    13	 * 
    14	 * Having Command subclasses violates the Command/Operation pattern and leads to
    15	 * inconsistent architecture where some logic is in Commands and some in Operations.
    16	 * 
    17	 * This test scans the codebase for any `extends Command` patterns and fails if found.
    18	 * Test files are excluded as they may contain mock subclasses for testing purposes.
    19	 * 
    20	 * Reference: specs/001-dihedral-learning-mvp/data-model.md §Command Pattern
    21	 * Reference: frontend/src/commands/Command.ts - @sealed documentation
    22	 */
    23	
    24	import { describe, it, expect } from 'vitest';
    25	import { execSync } from 'child_process';
    26	import path from 'path';
    27	
    28	describe('Architecture: Command Pattern', () => {
    29	  it('should NOT have any Command subclasses in production code', () => {
    30	    // Search for "extends Command" pattern in TypeScript files
    31	    // Exclude test files, node_modules, and dist
    32	    const projectRoot = path.resolve(__dirname, '../../..');
    33	    
    34	    try {
    35	      // Use grep to find "extends Command" pattern
    36	      // -r: recursive
    37	      // -n: show line numbers
    38	      // --include: only .ts and .vue files
    39	      // --exclude-dir: exclude test directories and build outputs
    40	      const command = `cd ${projectRoot} && grep -rn "extends Command" \
    41	        --include="*.ts" \
    42	        --include="*.vue" \
    43	        --exclude-dir=node_modules \
    44	        --exclude-dir=dist \
    45	        --exclude-dir=.vite \
    46	        --exclude-dir=playwright-report \
    47	        --exclude-dir=test-results \
    48	        src/ \
    49	        || echo "NO_MATCHES"`;
    50	      
    51	      const output = execSync(command, { encoding: 'utf-8' });
    52	      
    53	      // If grep found no matches, it returns "NO_MATCHES" (our echo)
    54	      if (output.trim() === 'NO_MATCHES') {
    55	        // Success: No Command subclasses found
    56	        expect(true).toBe(true);
    57	        return;
    58	      }
    59	      
    60	      // Parse grep output (format: file:line:content)
    61	      const matches = output.trim().split('\n').filter(line => line.length > 0);
    62	      
    63	      // Filter out false positives (comments, strings, etc.)
    64	      const realSubclasses = matches.filter(match => {
    65	        // Skip if it's just a comment or documentation
    66	        if (match.includes('//') || match.includes('*')) {
    67	          return false;
    68	        }
    69	        // Skip if it's in a string literal
    70	        if (match.includes('"extends Command"') || match.includes("'extends Command'")) {
    71	          return false;
    72	        }
    73	        return true;
    74	      });
    75	      
    76	      if (realSubclasses.length > 0) {
    77	        const filesList = realSubclasses.join('\n');
    78	        throw new Error(
    79	          `❌ ARCHITECTURAL VIOLATION: Found Command subclasses in production code!\n\n` +
    80	          `Per data-model.md §Command Pattern, Command must NOT be subclassed.\n` +
    81	          `All domain logic belongs in Operation classes (IOperation implementations).\n\n` +
    82	          `Found violations in:\n${filesList}\n\n` +
    83	          `HOW TO FIX:\n` +
    84	          `1. Create an Operation class (e.g., MyFeatureOp implements IOperation)\n` +
    85	          `2. Move logic from Command subclass to Operation's apply() and undo() methods\n` +
    86	          `3. In tool/UI code, create generic Command and add your Operation:\n` +
    87	          `   const cmd = new Command("My action", world);\n` +
    88	          `   cmd.addAndExecute(new MyFeatureOp(...));\n` +
    89	          `   cmd.commit();\n` +
    90	          `4. Delete the Command subclass\n\n` +
    91	          `See UpdateElementStyleOp as an example of correct pattern.\n` +
    92	          `See frontend/src/commands/Command.ts for detailed architecture documentation.`
    93	        );
    94	      }
    95	      
    96	      // Success: No real Command subclasses found
    97	      expect(true).toBe(true);
    98	      
    99	    } catch (error) {
   100	      if (error instanceof Error && error.message.includes('ARCHITECTURAL VIOLATION')) {
   101	        // Re-throw our architectural violation error
   102	        throw error;
   103	      }
   104	      // Other errors (e.g., grep not found) - just warn
   105	      console.warn('Could not run architectural check:', error);
   106	      // Don't fail the test if grep is not available
   107	      expect(true).toBe(true);
   108	    }
   109	  });
   110	  
   111	  it('should document Command as @sealed in source code', () => {
   112	    // Verify that Command.ts has proper @sealed annotation and documentation
   113	    const fs = require('fs');
   114	    const path = require('path');
   115	    const commandPath = path.resolve(__dirname, '../../../src/commands/Command.ts');
   116	    
   117	    try {
   118	      const content = fs.readFileSync(commandPath, 'utf-8');
   119	      
   120	      // Check for @sealed annotation
   121	      expect(content).toContain('@sealed');
   122	      
   123	      // Check for key documentation phrases
   124	      expect(content).toContain('MUST NOT be subclassed');
   125	      expect(content).toContain('All domain logic belongs in Operation classes');
   126	      
   127	      // Check that it references data-model.md
   128	      expect(content).toContain('data-model.md');
   129	      
   130	    } catch (error) {
   131	      throw new Error(
   132	        `Could not verify Command.ts documentation: ${error}\n` +
   133	        `Ensure Command.ts exists and has proper @sealed annotation.`
   134	      );
   135	    }
   136	  });
   137	});
--- frontend/tests/unit/architecture/worldBoundary.spec.ts
     1	import { describe, expect, it } from 'vitest';
     2	
     3	describe('Architecture: World boundary', () => {
     4	  it('World.ts should not import application, commands, services, UI, stores, or persistence layers', () => {
     5	    const fs = require('fs');
     6	    const content = fs.readFileSync('src/domain/world/World.ts', 'utf-8');
     7	    const importLines = content
     8	      .split('\n')
     9	      .filter(line => /^import\s/.test(line.trim()));
    10	
    11	    const forbiddenPatterns = [
    12	      /@\/application\//,
    13	      /@\/commands\//,
    14	      /@\/services\//,
    15	      /@\/components\//,
    16	      /@\/stores\//,
    17	      /@\/persistence\//,
    18	      /\.\.\/\.\.\/application\//,
    19	      /\.\.\/\.\.\/commands\//,
    20	      /\.\.\/\.\.\/services\//,
    21	      /\.\.\/\.\.\/components\//,
    22	      /\.\.\/\.\.\/stores\//,
    23	      /\.\.\/\.\.\/persistence\//,
    24	    ];
    25	
    26	    const violations = importLines.filter(line =>
    27	      forbiddenPatterns.some(pattern => pattern.test(line))
    28	    );
    29	
    30	    expect(violations).toEqual([]);
    31	  });
    32	});

