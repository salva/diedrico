--- frontend/tests/unit/application/appShell/AppShellBoundary.test.ts
     1	import { describe, expect, it } from 'vitest';
     2	import appVue from '@/App.vue?raw';
     3	import toolbarVue from '@/components/toolbars/Toolbar.vue?raw';
     4	import startupDialogVue from '@/components/dialogs/StartupDialog.vue?raw';
     5	import appShellRuntime from '@/application/appShell/AppShellRuntime.ts?raw';
     6	import appShellPorts from '@/application/appShell/AppShellPorts.ts?raw';
     7	import activePlane from '@/application/appShell/ActivePlaneUseCases.ts?raw';
     8	import autoSave from '@/application/appShell/AutoSaveUseCases.ts?raw';
     9	import keyboard from '@/application/appShell/KeyboardShortcutRouter.ts?raw';
    10	import projectSession from '@/application/appShell/ProjectSessionUseCases.ts?raw';
    11	import selection from '@/application/appShell/SelectionUseCases.ts?raw';
    12	
    13	const frontendSourceAndTests = import.meta.glob('/{src,tests}/**/*.{ts,tsx,vue,js,mjs,cjs}', {
    14	  eager: true,
    15	  query: '?raw',
    16	  import: 'default',
    17	}) as Record<string, string>;
    18	
    19	function findOffenders(pattern: RegExp): string[] {
    20	  return Object.entries(frontendSourceAndTests)
    21	    .filter(([file]) => !file.endsWith('/tests/unit/application/appShell/AppShellBoundary.test.ts'))
    22	    .flatMap(([file, content]) => pattern.test(content) ? [file] : []);
    23	}
    24	
    25	describe('Wave 009 app-shell boundaries', () => {
    26	  it('keeps App.vue free of moved shell orchestration imports and browser bridges', () => {
    27	    expect(appVue).not.toMatch(/DeletionSequenceFactory|ProjectService|GoogleDriveService|window as any|__autoSaveInterval|CustomEvent\('load-files'\)|Environment variables/);
    28	    expect(appVue).not.toMatch(/function handleKeyDown|addEventListener\('keydown'/);
    29	  });
    30	
    31	  it('keeps Toolbar and StartupDialog passive for global browser events', () => {
    32	    expect(toolbarVue).not.toMatch(/addEventListener\('keydown'|removeEventListener\('keydown'|function handleKeyDown|switch \(event\.key/);
    33	    expect(startupDialogVue).not.toMatch(/window\.dispatchEvent|CustomEvent\('load-files'\)|defineExpose/);
    34	  });
    35	
    36	  it('keeps appShell modules independent of Vue components', () => {
    37	    for (const content of [appShellRuntime, appShellPorts, activePlane, autoSave, keyboard, projectSession, selection]) {
    38	      expect(content).not.toMatch(/components\//);
    39	    }
    40	  });
    41	});
    42	
    43	describe('Wave 010 project persistence boundary', () => {
    44	  it('forbids frontend source and tests from importing backend implementation files', () => {
    45	    expect(findOffenders(/from ['\"][^'\"]*backend\/src|import\([^)]*backend\/src|backend\/src\//)).toEqual([]);
    46	  });
    47	
    48	  it('keeps stale backend project route assumptions out of frontend source and tests', () => {
    49	    expect(findOffenders(new RegExp([['localhost:3000', 'api', 'projects'].join('/'), '/api/' + 'projects', 'Project' + 'DTO', 'Project' + 'Metadata', 'Open' + 'Project' + 'Dialog'].join('|')))).toEqual([]);
    50	  });
    51	});
--- frontend/tests/unit/application/appShell/KeyboardShortcutRouter.test.ts
     1	import { describe, expect, it, vi } from 'vitest';
     2	import { KeyboardShortcutRouter } from '@/application/appShell/KeyboardShortcutRouter';
     3	
     4	function event(key: string, options: Partial<KeyboardEvent> = {}) {
     5	  return {
     6	    key,
     7	    ctrlKey: false,
     8	    metaKey: false,
     9	    shiftKey: false,
    10	    altKey: false,
    11	    target: document.body,
    12	    preventDefault: vi.fn(),
    13	    ...options,
    14	  } as unknown as KeyboardEvent & { preventDefault: ReturnType<typeof vi.fn> };
    15	}
    16	
    17	function deps() {
    18	  return {
    19	    commandStack: { canUndo: () => false, canRedo: () => false, undo: vi.fn(), redo: vi.fn() },
    20	    toolStore: { setTool: vi.fn(), selectSubTool: vi.fn() },
    21	    viewStore: { toggleProjectedElements: vi.fn() },
    22	    projectSession: { newProject: vi.fn(), showStartupProjectChooser: vi.fn() },
    23	    selection: { clearSelection: vi.fn(), deleteSelected: vi.fn(), selectAllInActivePlane: vi.fn() },
    24	    activePlane: { cycle: vi.fn() },
    25	    fitToView: vi.fn(),
    26	    startRename: vi.fn(),
    27	  } as any;
    28	}
    29	
    30	describe('KeyboardShortcutRouter', () => {
    31	  it('installs exactly one listener and removes it on dispose', () => {
    32	    const d = deps();
    33	    const router = new KeyboardShortcutRouter(d);
    34	    const target = { addEventListener: vi.fn(), removeEventListener: vi.fn() };
    35	    router.install(target as any);
    36	    router.install(target as any);
    37	    expect(target.addEventListener).toHaveBeenCalledTimes(1);
    38	    router.dispose();
    39	    router.dispose();
    40	    expect(target.removeEventListener).toHaveBeenCalledTimes(1);
    41	  });
    42	
    43	  it('routes Escape, Delete, D, Ctrl+A and Tab through shell actions', () => {
    44	    const d = deps();
    45	    const router = new KeyboardShortcutRouter(d);
    46	    router.handle(event('Escape'));
    47	    expect(d.toolStore.setTool).toHaveBeenCalledWith('select');
    48	    expect(d.selection.clearSelection).toHaveBeenCalled();
    49	    router.handle(event('Delete'));
    50	    expect(d.selection.deleteSelected).toHaveBeenCalled();
    51	    router.handle(event('D'));
    52	    expect(d.viewStore.toggleProjectedElements).toHaveBeenCalled();
    53	    router.handle(event('a', { ctrlKey: true }));
    54	    expect(d.selection.selectAllInActivePlane).toHaveBeenCalled();
    55	    router.handle(event('Tab', { shiftKey: true }));
    56	    expect(d.activePlane.cycle).toHaveBeenCalledWith(-1);
    57	  });
    58	
    59	  it('does not consume text input Delete or tool letters', () => {
    60	    const d = deps();
    61	    const router = new KeyboardShortcutRouter(d);
    62	    const input = document.createElement('input');
    63	    router.handle(event('Delete', { target: input }));
    64	    router.handle(event('p', { target: input }));
    65	    expect(d.selection.deleteSelected).not.toHaveBeenCalled();
    66	    expect(d.toolStore.setTool).not.toHaveBeenCalled();
    67	  });
    68	});

