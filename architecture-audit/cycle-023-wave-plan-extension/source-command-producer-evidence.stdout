     1	import type { Vector3 } from 'three';
     2	import { Command } from '@/commands/Command';
     3	import type { CommandStack } from '@/commands/CommandStack';
     4	import type { World } from '@/domain/world/World';
     5	import { UpdateFreePoint2DPositionOp } from '@/commands/operations/world/UpdateFreePoint2DPositionOp';
     6	import type { MoveFreePointRequest, FreePointMoveSession, ToolCommandResult } from '@/application/tools/ToolCommandIntents';
     7	
     8	export class CanvasPointMovementUseCase {
     9	  constructor(private readonly world: World, private readonly commandStack: CommandStack) {}
    10	
    11	  start(request: MoveFreePointRequest): FreePointMoveSession {
    12	    const cmd = new Command(`Move point ${request.label ?? request.pointId}`, this.world);
    13	    let hasPreview = false;
    14	
    15	    return {
    16	      preview: (position: Vector3): ToolCommandResult => {
    17	        try {
    18	          cmd.rollback();
    19	          cmd.addAndExecute(new UpdateFreePoint2DPositionOp(request.planeId, request.pointId, position));
    20	          hasPreview = true;
    21	          return { success: true };
    22	        } catch (error) {
    23	          cmd.rollback();
    24	          return { success: false, message: error instanceof Error ? error.message : String(error) };
    25	        }
    26	      },
    27	      commit: (): ToolCommandResult => {
    28	        if (!hasPreview) {
    29	          cmd.rollback();
    30	          return { success: true };
    31	        }
    32	        cmd.commit();
    33	        this.commandStack.push(cmd);
    34	        return { success: true };
    35	      },
    36	      cancel: (): void => {
    37	        cmd.rollback();
    38	      }
    39	    };
    40	  }
    41	}

