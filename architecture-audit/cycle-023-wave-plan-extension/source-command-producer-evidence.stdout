   310	
   311	function endPointDrag(commit: boolean): void {
   312	  if (!pointDrag.value.active) return;
   313	
   314	  const moveSession = pointDrag.value.moveSession;
   315	
   316	  try {
   317	    if (moveSession) {
   318	      if (commit) {
   319	        const result = moveSession.commit();
   320	        if (!result.success) console.error('[SvgCanvas] Point move commit failed:', result.message);
   321	      } else {
   322	        moveSession.cancel();
   323	      }
   324	    }
   325	  } finally {
   326	    pointDrag.value = {
   327	      active: false,
   328	      planeId: null,
   329	      pointId: null,
   330	      moveSession: null,
   331	      startClientX: 0,
   332	      startClientY: 0,
   333	      moved: false
   334	    };
   335	    renderTick.value++;
