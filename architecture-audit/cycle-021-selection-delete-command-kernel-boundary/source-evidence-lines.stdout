   181	export interface AppShellRuntimeOptions {
   182	  ports: AppShellRuntimePorts;
   183	}
   184	
   185	export function createAppShellRuntime(options: AppShellRuntimeOptions) {
   186	  const world = new World();
   187	  const commandStack = new CommandStack();
   188	  const ports = options.ports;
   189	  const drive = ports.drive;
   190	
   191	  const activePlaneId = ref<string | undefined>(world.getActivePlaneId());
   192	  const activePlaneName = ref('');
   193	  const coordinates3D = ref<{ x: number; y: number; z: number } | null>(null);
   194	  const show3DView = ref(true);
   195	  const showStartupDialog = ref(false);
   196	  const isSignedIn = ref(false);
   197	  const currentProjectName = ref<string | null>(null);
   198	  const currentFileId = ref<string | null>(null);
   199	  const isRenamingProject = ref(false);
   200	  const saveStatus = ref<SaveStatus>('idle');
   201	  const startupDialog = {
   202	    files: ref([]),
   203	    loading: ref(false),
   204	    loadingFiles: ref(false),
   205	    error: ref<string | null>(null),
   206	  };
   207	
   208	  const activePlane = new ActivePlaneUseCases(world, { activePlaneId, activePlaneName });
   209	  const selection = new SelectionUseCases(world, commandStack, ports.selectionStore, () => activePlaneId.value);
   210	  const autoSave = new AutoSaveUseCases({
   211	    world,
   212	    commandStack,
   213	    drive,
   214	    persistence: ports.persistence,
   215	    lastProjectRepository: ports.lastProjectRepository,
   216	    scheduler: ports.scheduler,
   217	    currentFileId,
   218	    currentProjectName,
   219	    saveStatus,
   220	    showStartupDialog,
   221	    isSignedIn,
   222	    alert: ports.callbacks.alert,
   223	  });
   224	  const projectSession = new ProjectSessionUseCases({
   225	    world,
   226	    commandStack,
   227	    hasGoogleCredentials: drive !== null,
   228	    showStartupDialog,
   229	    isSignedIn,
   230	    currentProjectName,
   231	    currentFileId,
   232	    isRenamingProject,
   233	    saveStatus,
   234	    startupDialog,
   235	    autoSave,
   236	    ports,
   237	  });
   238	  const keyboard = new KeyboardShortcutRouter({
   239	    commandStack,
   240	    toolStore: ports.toolStore,
   241	    viewStore: ports.viewStore,
   242	    projectSession,
   243	    selection,
   244	    activePlane,
   245	    fitToView: ports.callbacks.fitToView,
   246	    startRename: ports.callbacks.startRename,
   247	  });
   248	
   249	  let started = false;
   250	  function start(): void {
   251	    if (started) return;
   252	    started = true;
   253	    activePlane.start();
   254	    selection.start();
   255	    keyboard.install(ports.keyboardTarget);
   256	    void projectSession.initialize();
   257	  }
   258	
   259	  function dispose(): void {
   260	    if (!started) return;
