{
  "name": "diedrico",
  "version": "0.1.0",
  "description": "Educational web application for teaching dihedral/orthographic projection",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=frontend",
    "test:frontend": "npm run test --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:architecture": "npm run test:architecture --workspace=frontend",
    "test:e2e": "npm run test:e2e --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
{
  "name": "diedrico-frontend",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:architecture": "vitest run tests/unit/architecture",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "npm run test:architecture"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "d3": "^7.8.5",
    "katex": "^0.16.28",
    "pinia": "^2.1.7",
    "three": "^0.160.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/d3": "^7.4.3",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.drive-v3": "^0.0.5",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.0",
    "jsdom": "^27.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^2.2.12"
  }
}
