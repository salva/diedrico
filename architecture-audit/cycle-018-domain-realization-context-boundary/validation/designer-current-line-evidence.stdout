--- frontend/src/domain/world/Element2D.ts
     1	import type { ProjectionElementRealizationContext } from './projectionPlane/ProjectionPlaneContext';
     2	import { Point2DRealization2D } from './Point';
     3	import { Line2DRealization2D } from './Line';
     4	import { Circle2DRealization2D } from './Circle';
     5	import { validateElementId } from './ElementId';
     6	import { Element } from './Element';
     7	
     8	/**
     9	 * Union type for all possible 2D element realizations
    10	 */
    11	export type Element2DRealization = Point2DRealization2D | Line2DRealization2D | Circle2DRealization2D;
    12	
    13	/**
    14	 * Base class for all 2D geometric elements (points, lines, circles)
    15	 * 
    16	 * **Phase 44**: Originally introduced as standalone base class with id, planeId, label, visible, type properties.
    17	 * 
    18	 * **Phase 52 Refactoring**: Element2D now extends Element base class to share id and label properties
    19	 * with 3D elements. Element2D adds 2D-specific properties: planeId, visible, type.
    20	 * 
    21	 * **Architectural Principle: DRY and Uniform Interface**
    22	 * 
    23	 * Before Element2D (Phase 44), Point2D, Line2D, and Circle2D were three separate hierarchies
    24	 * with no common ancestor, despite sharing identical properties (id, planeId, label, visible).
    25	 * This caused:
    26	 * - Code duplication (same properties defined three times)
    27	 * - No uniform handling (couldn't write generic functions for all elements)
    28	 * - Inconsistent interfaces (each hierarchy evolved independently)
    29	 * 
    30	 * Element2D (Phase 44) provided:
    31	 * - Common properties: id, planeId, label, visible, type
    32	 * - Abstract methods: clone(), realize2D()
    33	 * - Uniform type guard: isElement2D() works for all types
    34	 * - Generic processing: Functions can work with Element2D regardless of specific type
    35	 * 
    36	 * Element2D (Phase 52) now extends Element:
    37	 * - Inherits id and label from Element base class
    38	 * - Adds 2D-specific properties: planeId, visible, type
    39	 * - Enables uniform handling with 3D elements via Element base type
    40	 * 
    41	 * **Usage**:
    42	 * ```typescript
    43	 * // Type guard works for all 2D elements
    44	 * function isElement2D(obj: any): obj is Element2D {
    45	 *   return obj instanceof Element2D;
    46	 * }
    47	 * 
    48	 * // Generic functions for 2D elements
    49	 * function hideElement(element: Element2D, world: World): void {
    50	 *   // Use resolveVisibility or modify visualStyle
    51	 * }
    52	 * 
    53	 * // Filter by plane
    54	 * function getElementsOnPlane(planeId: string, elements: Element2D[]): Element2D[] {
    55	 *   return elements.filter(el => el.planeId === planeId);
    56	 * }
    57	 * 
    58	 * // Generic functions for all elements (2D and 3D)
    59	 * function getElementLabel(element: Element): string {
    60	 *   return element.label || element.id;
    61	 * }
    62	 * ```
    63	 * 
    64	 * @sealed - Cannot be directly subclassed, only Point2D/Line2D/Circle2D extend it
    65	 */
    66	export abstract class Element2D extends Element {
    67	  /** Which projection plane this element belongs to */
    68	  readonly planeId: string;
    69	  
    70	  /**
    71	   * Construct a 2D element
    72	   * 
    73	   * @param id Element ID in hierarchical format: '{planeId}/{localId}' (e.g., 'proj_plane_1/point2d_5')
    74	   *           This ID must be generated by the containing plane's factory methods or ID generators.
    75	   *           NEVER pass hardcoded non-hierarchical IDs like 'p1' or 'point2d_5' - they will fail validation.
    76	   * @param planeId ID of the projection plane that contains this element
    77	   * @param label Optional user-friendly label for UI display
    78	   */
    79	  constructor(
    80	    id: string,
    81	    planeId: string,
    82	    label?: string
    83	  ) {
    84	    // Phase 52: Call Element base constructor with id and label
    85	    super(id, label);
    86	    
    87	    // Phase 45: Validate hierarchical ID format
    88	    // Ensure element ID starts with its container plane ID
    89	    // Throws error if ID doesn't match format '{planeId}/{localId}'
    90	    validateElementId(id, planeId);
    91	    
    92	    this.planeId = planeId;
    93	  }
    94	  
    95	  /**
    96	   * Clone this element
    97	   * Must be implemented by concrete subclasses
    98	   */
    99	  abstract clone(): Element2D;
   100	  
   101	  /**
   102	   * Calculate 2D realization (geometric position/shape) for this element
   103	   * Returns realization in the projection plane's intrinsic coordinates
   104	   * 
   105	   * @param world World instance to query parent element realizations
   106	   * @returns Element realization or null if computation fails
   107	   */
   108	  abstract realize2D(context: ProjectionElementRealizationContext): Element2DRealization | null;
   109	}
   110	
   111	/**
   112	 * Type guard to check if an object is an Element2D
   113	 * 
   114	 * @param obj Object to check
   115	 * @returns true if obj is an Element2D (Point2D, Line2D, or Circle2D), false otherwise
   116	 */
   117	export function isElement2D(obj: any): obj is Element2D {
   118	  return obj instanceof Element2D;
   119	}
--- frontend/src/domain/world/Element3D.ts
     1	/**
     2	 * Element3D - Abstract base class for 3D geometric elements
     3	 * 
     4	 * Extends Element with no additional properties.
     5	 * Serves as type marker and organizational structure for 3D elements.
     6	 * 
     7	 * **Phase 52**: Introduced as part of unified Element hierarchy to distinguish
     8	 * 3D elements from 2D elements in the type system.
     9	 * 
    10	 * **Current 3D element types**:
    11	 * - Plane3D (and subclasses: Plane3DFixed, Plane3DByTraces, Plane3DByPointAndNormal)
    12	 * - HingeLine
    13	 * 
    14	 * **Future 3D element types** (when needed):
    15	 * - Point3D (3D point in space)
    16	 * - Line3D (3D line in space)
    17	 * - Circle3D (3D circle in space)
    18	 * 
    19	 * **Design Note**: Element3D "probably adds nothing" (per planning notes) because
    20	 * 3D elements don't need:
    21	 * - `planeId` (they're not confined to a single projection plane)
    22	 * - `visible` (3D elements don't have direct UI visibility toggles; their 2D projections do)
    23	 * - `type` discriminator (handled by concrete subclass instanceof checks)
    24	 * 
    25	 * However, Element3D provides:
    26	 * - **Type Organization**: Clear distinction between 2D and 3D elements in type system
    27	 * - **Dependency Interface**: All 3D elements must implement getDependencies()
    28	 * - **Future Extensibility**: Common place to add 3D-specific functionality later
    29	 * 
    30	 */
    31	import { Element } from './Element';
    32	import type { Element3DRealization3D } from './Element3DRealization3D';
    33	import type { Element3DRealizationContext } from './projectionPlane/ProjectionPlaneContext';
    34	
    35	export abstract class Element3D extends Element {
    36	  /**
    37	   * Compute 3D geometric realization from defining data
    38	   * 
    39	   * @param context - Narrow realization context for resolving dependencies (2D projections, planes)
    40	   * @returns Element3DRealization3D with numeric coordinates, or infeasible if computation fails
    41	   */
    42	  abstract realize3D(context: Element3DRealizationContext): Element3DRealization3D;
    43	
    44	  /**
    45	   * Get dependencies - IDs of elements this 3D element depends on
    46	   * 
    47	   * Examples:
    48	   * - Plane3DFixed: [] (no dependencies)
    49	   * - Plane3DByTraces: [traceH, traceV] (depends on 2D trace lines)
    50	   * - HingeLine: [plane1, plane2] (depends on two planes)
    51	   * 
    52	   * @returns Array of element IDs that this element depends on
    53	   */
    54	  abstract getDependencies(): string[];
    55	  
    56	  /**
    57	   * Clone this 3D element
    58	   * Must be implemented by concrete subclasses
    59	   */
    60	  abstract clone(): Element3D;
    61	}
    62	
    63	/**
    64	 * Type guard to check if an object is an Element3D
    65	 * 
    66	 * @param obj Object to check
    67	 * @returns true if obj is an Element3D, false otherwise
    68	 */
    69	export function isElement3D(obj: any): obj is Element3D {
    70	  return obj instanceof Element3D;
    71	}
--- frontend/src/domain/world/Plane.ts
     1	/**
     2	 * Plane3D - 3D plane representation (abstract base)
     3	 * 
     4	 * Abstract base class for 3D planes. Concrete implementations provide
     5	 * specific construction rules:
     6	 * - Plane3DFixed: Hard-coded planes (P_H: z=0, P_V: y=0) for initialization
     7	 * - Plane3DByTraces: Computed from traces (future)
     8	 * 
     9	 * **Phase 52**: Refactored to extend Element3D, removing id and label properties
    10	 * which are now inherited from Element base class.
    11	 * 
    12	 * Per data-model.md §Plane3DByPointAndNormal:
    13	 * - Point on plane (P₀)
    14	 * - Normal vector (n)
    15	 * - Plane3D equation: n·(P - P₀) = 0
    16	 * 
    17	 */
    18	
    19	import { Vector3, Vector4 } from 'three';
    20	import { Element3D } from './Element3D';
    21	import { Plane3DRealization3D } from './Element3DRealization3D';
    22	import { applyMatrix4x3, crossVector3Homogeneous } from '@/utils/threeUtils';
    23	import { computeLineLineIntersection3D } from '@/utils/projectionPlaneUtils';
    24	import type { PlaneEquationRealizationContext } from './projectionPlane/ProjectionPlaneContext';
    25	
    26	export abstract class Plane3D extends Element3D {
    27	  /**
    28	   * Get plane equation [a, b, c, d] where ax + by + cz + d = 0
    29	   * Each concrete class computes this based on its representation
    30	   */
    31	  abstract getPlaneEquation(context: PlaneEquationRealizationContext): Vector4 | null;
    32	
    33	  /**
    34	   * Compute 3D realization (plane equation + rendering geometry)
    35	   * Uses getPlaneEquation() from concrete class
    36	   */
    37	  realize3D(context: PlaneEquationRealizationContext): Plane3DRealization3D {
    38	    const equation = this.getPlaneEquation(context);
    39	    
    40	    if (!equation) {
    41	      return Plane3DRealization3D.infeasible();
    42	    }
    43	    
    44	    const a = equation.x;
    45	    const b = equation.y;
    46	    const c = equation.z;
    47	    const d = equation.w;
    48	    
    49	    // Normal vector from plane equation
    50	    const normal = new Vector4(a, b, c, 0);
    51	    
    52	    // Compute origin point on the plane: P = -d * N (since |N| = 1)
    53	    const originPoint = new Vector4(-d * a, -d * b, -d * c, 1);
    54	    
    55	    // Compute quaternion for mesh orientation (aligns (0,0,1) with plane normal)
    56	    const defaultNormal = new Vector4(0, 0, 1, 0);
    57	    
    58	    // Compute rotation axis and angle using cross product and dot product
    59	    const axis = crossVector3Homogeneous(defaultNormal, normal);
    60	    const axisLength = Math.sqrt(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
    61	    const dotProduct = defaultNormal.x * normal.x + defaultNormal.y * normal.y + defaultNormal.z * normal.z;
    62	    
    63	    let quaternion: Vector4;
    64	    if (axisLength < 1e-10) {
    65	      // Normals are parallel or anti-parallel
    66	      if (dotProduct > 0) {
    67	        // Same direction - no rotation needed
    68	        quaternion = new Vector4(0, 0, 0, 1);
    69	      } else {
    70	        // Opposite direction - 180° rotation around any perpendicular axis
    71	        const perpAxis = Math.abs(a) < 0.9 ? new Vector4(1, 0, 0, 0) : new Vector4(0, 1, 0, 0);
    72	        const rotAxis = crossVector3Homogeneous(perpAxis, normal).normalize();
    73	        quaternion = new Vector4(rotAxis.x, rotAxis.y, rotAxis.z, 0);
    74	      }
    75	    } else {
    76	      // General case - compute quaternion from axis-angle
    77	      const halfAngle = 0.5 * Math.atan2(axisLength, dotProduct);
    78	      const sinHalf = Math.sin(halfAngle);
    79	      const cosHalf = Math.cos(halfAngle);
    80	      axis.normalize();
    81	      quaternion = new Vector4(
    82	        axis.x * sinHalf,
    83	        axis.y * sinHalf,
    84	        axis.z * sinHalf,
    85	        cosHalf
    86	      );
    87	    }
    88	    
    89	    return new Plane3DRealization3D(equation, true, quaternion, originPoint);
    90	  }
    91	
    92	  /**
    93	   * Get dependencies - IDs of elements this plane depends on
    94	   * Fixed planes have no dependencies, trace-based planes depend on traces
    95	   * Inherited from Element3D
    96	   */
    97	  abstract getDependencies(): string[];
    98	
    99	  protected constructor(id: string, label?: string) {
   100	    super(id, label);
   101	  }
   102	
   103	  /**
   104	   * Clone this plane
   105	   * Subclasses must implement their own cloning logic
   106	   */
   107	  abstract clone(): Plane3D;
   108	}
   109	
   110	/**
   111	 * Plane3DFixed - Fixed 3D plane defined by point and normal
   112	 * 
   113	 * Represents a plane with fixed geometric definition (no dependencies).
   114	 * The plane is fully defined by a point on the plane and a normal vector.
   115	 * 
   116	 * **Phase 52**: Updated constructor to pass id as required parameter to parent,
   117	 * and implements getDependencies() from Element3D.
   118	 * 
   119	 * @remarks This class is typically used during world initialization but can
   120	 * represent any plane defined by point and normal without dependencies.
   121	 */
   122	export class Plane3DFixed extends Plane3D {
   123	  point: Vector4;      // Point on the plane (x, y, z, 1)
   124	  normal: Vector4;     // Normal vector (normalized) (x, y, z, 0)
   125	  
   126	  // Boundary properties for plane extent in u,v coordinates
   127	  minU: number = -400;
   128	  maxU: number = 400;
   129	  minV: number = -400;
   130	  maxV: number = 400;
   131	  
   132	  // Coordinate system for plane (u,v coordinates)
   133	  coordinateSystem?: {
   134	    origin: Vector4;
   135	    uAxis: Vector4;
   136	    vAxis: Vector4;
   137	  };
   138	
   139	  constructor(
   140	    id: string,
   141	    point: Vector4,
   142	    normal: Vector4,
   143	    label?: string
   144	  ) {
   145	    super(id, label);
   146	    this.point = point.clone();
   147	    this.normal = this.normalizeVector(normal);
   148	  }
   149	
   150	  private normalizeVector(v: Vector4): Vector4 {
   151	    const vec3 = new Vector3(v.x, v.y, v.z);
   152	    const length = vec3.length();
   153	    if (length === 0) {
   154	      throw new Error('Cannot normalize zero vector');
   155	    }
   156	    vec3.normalize();
   157	    return new Vector4(vec3.x, vec3.y, vec3.z, v.w);
   158	  }
   159	
   160	  getPlaneEquation(_context: PlaneEquationRealizationContext): Vector4 {
   161	    // Return plane equation: ax + by + cz + d = 0
   162	    // d = -normal · point
   163	    const d = -(this.normal.x * this.point.x + this.normal.y * this.point.y + this.normal.z * this.point.z);
   164	    return new Vector4(this.normal.x, this.normal.y, this.normal.z, d);
   165	  }
   166	
   167	  getDependencies(): string[] {
   168	    // Phase 52: Fixed planes have no dependencies
   169	    return [];
   170	  }
   171	  
   172	  /**
   173	   * Set boundary limits for plane extent in u,v coordinates
   174	   */
   175	  setBoundaries(minU: number, maxU: number, minV: number, maxV: number): void {
   176	    this.minU = minU;
   177	    this.maxU = maxU;
   178	    this.minV = minV;
   179	    this.maxV = maxV;
   180	  }
   181	  
   182	  /**
   183	   * Set coordinate system for plane (origin and u,v axes in 3D)
   184	   */
   185	  setCoordinateSystem(system: { origin: Vector4; uAxis: Vector4; vAxis: Vector4 }): void {
   186	    this.coordinateSystem = {
   187	      origin: system.origin.clone(),
   188	      uAxis: system.uAxis.clone(),
   189	      vAxis: system.vAxis.clone()
   190	    };
   191	  }
   192	  
   193	  /**
   194	   * Check if a point lies on this plane (within tolerance)
   195	   */
   196	  containsPoint(point: Vector4 | { x: number; y: number; z: number }, tolerance: number = 1e-6): boolean {
   197	    // Compute distance from point to plane: |n·(P - P₀)|
   198	    const px = point.x;
   199	    const py = point.y;
   200	    const pz = point.z;
   201	    
   202	    const distance = Math.abs(
   203	      this.normal.x * (px - this.point.x) +
   204	      this.normal.y * (py - this.point.y) +
   205	      this.normal.z * (pz - this.point.z)
   206	    );
   207	    
   208	    return distance <= tolerance;
   209	  }
   210	
   211	  clone(): Plane3D {
   212	    const cloned = new Plane3DFixed(
   213	      this.id,
   214	      this.point.clone(),
   215	      this.normal.clone(),
   216	      this.label
   217	    );
   218	    
   219	    // Copy boundaries
   220	    cloned.minU = this.minU;
--- frontend/src/domain/world/HingeLine.ts
     1	/**
     2	 * HingeLine - Intersection line shared by two projection planes
     3	 * 
     4	 * A hinge line represents the physical fold between two projection planes
     5	 * (e.g., HL_HV between P_H and P_V). It is NOT used for broken hinge lines (BHLs),
     6	 * which are intersections between arbitrary 3D planes.
     7	 * 
     8	 * The hinge line exists in 3D space and automatically realizes on both planes it connects.
     9	 * Each plane gets a HingeLineRealization2D (the 2D view of the hinge line on that plane).
    10	 * 
    11	 * **Phase 52**: Refactored to extend Element3D, removing id and label properties
    12	 * which are now inherited from Element base class. Replaces `name` with `label`.
    13	 * 
    14	 */
    15	
    16	import type { ProjectionElementRealizationContext } from './projectionPlane/ProjectionPlaneContext';
    17	import { Vector3 } from 'three';
    18	import { Line2D } from './Line';
    19	import { Line3D } from './Line3D';
    20	import { Line3DRealization3D } from './Element3DRealization3D';
    21	import { HalfHingeLineRealization2D } from './HalfHingeLineRealization2D';
    22	import { applyMatrix4x3, applyMatrix3x4 } from '@/utils/threeUtils';
    23	
    24	/**
    25	 * HalfHingeLine2D - 2D representation of a hinge line on a specific projection plane
    26	 * 
    27	 * Each HingeLine has exactly 2 HalfHingeLine2D objects (one per plane).
    28	 * This represents how the hinge line appears in the plane's (u,v) coordinate system.
    29	 * 
    30	 * **Phase 84**: NO geometry storage - computed on demand from canonical coordinates.
    31	 * Hinge line is ALWAYS at v=0 along u-axis in plane intrinsic coordinates.
    32	 * 
    33	 * Design: HalfHingeLine2D extends Line2D so it can be used with all line operations.
    34	 * It's a fixed line (cannot be deleted) that represents the fold between planes.
    35	 * Guides reference HalfHingeLine2D (not HingeLine) because guides are perpendicular
    36	 * to the 2D representation.
    37	 * 
    38	 */
    39	export class HalfHingeLine2D extends Line2D {
    40	  readonly hingeLineId: string;  // Parent HingeLine
    41	  // Phase 84: NO geometry storage - computed via realize2D()
    42	
    43	  constructor(
    44	    id: string,
    45	    hingeLineId: string,
    46	    planeId: string,
    47	    label?: string
    48	  ) {
    49	    // Create a friendly label like "HHL_{8}" from "projPlane3/line2d8"
    50	    // Extract the line number after 'line2d' (not the plane number)
    51	    const numericPart = id.match(/line2d(\d+)/)?.[1] || id.match(/\d+$/)?.[0] || id;
    52	    super(id, planeId, label || `HHL_{${numericPart}}`);
    53	    this.hingeLineId = hingeLineId;
    54	  }
    55	
    56	  clone(): HalfHingeLine2D {
    57	    return new HalfHingeLine2D(
    58	      this.id,
    59	      this.hingeLineId,
    60	      this.planeId,
    61	      this.label
    62	    );
    63	  }
    64	
    65	  /**
    66	   * Get dependencies for this half hinge line
    67	   * 
    68	   * Dependencies:
    69	   * - Parent HingeLine (for 3D realization)
    70	   * - Projection plane (for transformation matrix in realize2D)
    71	   * 
    72	   * Phase 85 FIX: Must include planeId because realize2D() for plane2 calls:
    73	   *   world.getProjectionPlane3DRealization(this.planeId)
    74	   * 
    75	   * When projection plane transforms change (e.g., auxiliary plane's trace lines move),
    76	   * this half hinge line's realization must be recomputed.
    77	   */
    78	  getDependencies(): string[] {
    79	    // Depend on both the parent HingeLine AND the projection plane
    80	    // The plane dependency is critical for plane2 half-hinge lines that project back
    81	    return [this.hingeLineId, this.planeId];
    82	  }
    83	
    84	  /**
    85	   * Find the sibling HalfHingeLine2D in the other plane.
    86	   * 
    87	   * Static method for navigating from one HalfHingeLine2D to its sibling
    88	   * in the paired projection plane. Used when creating sibling elements
    89	   * (guides, intersection points, etc.)
    90	   * 
    91	   * Navigation: HalfHingeLine2D → HingeLine → getOtherPlane() → find matching HHL
    92	   * 
    93	   * @param world World instance to navigate
    94	   * @param halfHingeLineId ID of the HalfHingeLine2D in the current plane
    95	   * @param currentPlaneId ID of the current plane
    96	   * @returns Object with siblingPlaneId and siblingHalfHingeLineId, or undefined if not a HHL
    97	   */
    98	  static getSiblingInfo(
    99	    world: ProjectionElementRealizationContext,
   100	    halfHingeLineId: string,
   101	    currentPlaneId: string
   102	  ): { siblingPlaneId: string; siblingHalfHingeLineId: string } | undefined {
   103	    // Get current plane and HalfHingeLine2D
   104	    const currentPlane = world.getProjectionPlaneById(currentPlaneId)!;
   105	    const halfHingeLine = currentPlane.getLine(halfHingeLineId);
   106	    
   107	    if (!halfHingeLine || !(halfHingeLine instanceof HalfHingeLine2D)) {
   108	      return undefined;
   109	    }
   110	
   111	    // Get parent HingeLine and sibling plane
   112	    const hingeLine = world.getHingeLineById(halfHingeLine.hingeLineId)!;
   113	    const siblingPlaneId = hingeLine.getOtherPlane(currentPlaneId)!;
   114	    const siblingPlane = world.getProjectionPlaneById(siblingPlaneId)!;
   115	
   116	    // Find HalfHingeLine2D with same hingeLineId in sibling plane
   117	    const siblingHalfHingeLine = siblingPlane.getAllLines().find(
   118	      (line): line is HalfHingeLine2D => line instanceof HalfHingeLine2D && line.hingeLineId === halfHingeLine.hingeLineId
   119	    )!;
   120	
   121	    return {
   122	      siblingPlaneId,
   123	      siblingHalfHingeLineId: siblingHalfHingeLine.id
   124	    };
   125	  }
   126	
   127	  /**
   128	   * Realize this half-hinge line using canonical coordinates (Phase 84)
   129	   * 
   130	   * Returns HalfHingeLineRealization2D with line geometry and guideVector.
   131	   * guideVector is PERPENDICULAR to the hinge line (for regular hinge lines).
   132	   * 
   133	   * **Phase 84 Architecture**:
   134	   * - Plane1: Returns canonical coordinates (0,0,1) and (1,0,0) directly
   135	   * - Plane2: Projects 3D line back to plane2 using applyMatrix3x4()
   136	   * 
   137	   * **Phase 101**: Returns HalfHingeLineRealization2D with guideVector
   138	   * - guideVector is perpendicular to hinge line direction
   139	   * - Guide2D uses this vector to create guides
   140	   * 
   141	   * @param world World instance for accessing HingeLine and plane realizations
   142	   */
   143	  realize2D(world: ProjectionElementRealizationContext): HalfHingeLineRealization2D {
   144	    const hingeLine = world.getHingeLineById(this.hingeLineId)!;
   145	
   146	    // Plane1: Return canonical coordinates directly
   147	    if (this.planeId === hingeLine.plane1Id) {
   148	      // Check feasibility of underlying Plane3D (if projection plane has one)
   149	      const projPlane1 = world.getProjectionPlaneById(hingeLine.plane1Id)!;
   150	      if (projPlane1.plane3DId) {
   151	        const plane3DReal = world.get3DPlaneRealization(projPlane1.plane3DId)!;
   152	        if (!plane3DReal.isFeasible()) {
   153	          // Return infeasible realization instead of throwing
   154	          return HalfHingeLineRealization2D.createInfeasible();
   155	        }
   156	      }
   157	
   158	      const hingeDirection = new Vector3(1, 0, 0);  // Canonical u-axis direction
   159	      const guideVector = new Vector3(0, 1, 0);     // Perpendicular (v-axis direction)
   160	
   161	      return new HalfHingeLineRealization2D(
   162	        new Vector3(0, 0, 1),    // Canonical origin
   163	        hingeDirection,           // Hinge line direction
   164	        guideVector,              // Perpendicular for guides
   165	        true                      // feasible
   166	      );
   167	    }
   168	
   169	    // Plane2: Project 3D line back to plane2
   170	    const line3D = hingeLine.realize3D(world);
   171	    const plane2Real = world.getProjectionPlane3DRealization(this.planeId)!;
   172	
   173	    // Check feasibility of 3D line (depends on plane1)
   174	    if (!line3D.isFeasible()) {
   175	      // Return infeasible realization instead of throwing
   176	      return HalfHingeLineRealization2D.createInfeasible();
   177	    }
   178	
   179	    const origin2D = applyMatrix3x4(line3D.point, plane2Real.threeDToPlane);
   180	    const direction2D = applyMatrix3x4(line3D.direction, plane2Real.threeDToPlane);
   181	    
   182	    // Compute perpendicular guide vector
   183	    const guideVector = new Vector3(-direction2D.y, direction2D.x, 0).normalize();
   184	    
   185	    return new HalfHingeLineRealization2D(
   186	      origin2D,
   187	      direction2D,
   188	      guideVector,
   189	      true  // feasible
   190	    );
   191	  }
   192	}
   193	
   194	/**
   195	 * HingeLine - Physical fold between two projection planes
   196	 * 
   197	 * The hinge line is a 3D element that automatically appears on both planes it connects.
   198	 * It cannot be deleted and is not stored as Line2D entities - it's a fixed element.
   199	 * 
   200	 * Each HingeLine has exactly 2 HalfHingeLine2D objects (one per plane) that represent
   201	 * how the hinge line appears in each plane's (u,v) coordinate system. These HalfHingeLine2D
   202	 * objects are owned by their respective ProjectionPlane objects.
   203	 * 
   204	 * **Phase 52**: Refactored to extend Element3D. Inherits id and label from Element.
   205	 * **Phase 84**: NO geometry storage - computed on demand from canonical coordinates (0,0,1), (1,0,0).
   206	 * Extends Line3D base class to share realization pattern with other 3D lines.
   207	 */
   208	export class HingeLine extends Line3D {
   209	  readonly plane1Id: string;  // Reference plane (canonical coords source)
   210	  readonly plane2Id: string;  // Second projection plane
   211	
   212	  constructor(
   213	    id: string,
   214	    label: string,
   215	    plane1Id: string,
   216	    plane2Id: string
   217	  ) {
   218	    // Phase 52: Call Element3D constructor with id and label
   219	    super(id, label);
   220	    
--- frontend/src/domain/world/BrokenHingeLine.ts
     1	/**
     2	 * BrokenHingeLine - Represents traces that appear on different planes after a 3D plane is folded
     3	 * 
     4	 * A Broken Hinge Line (BHL) represents a 3D line that appears as two separate projections
     5	 * (T2 on plane P2, T2' on plane P1) after an auxiliary projection plane is created by folding
     6	 * plane Q using trace T1 as the hinge.
     7	 * 
     8	 * **Key Geometric Distinction from Regular HingeLine**:
     9	 * - Regular HingeLine: Guides are perpendicular (plane perpendicular to both projection planes)
    10	 * - Broken HingeLine: Guides are PARALLEL to the main hinge T1 (planes containing T1 intersecting plane Q)
    11	 * 
    12	 * **Phase 101**: Broken Hinge Lines and Distance Transport Guides
    13	 * - T2 and T2' are projections of the same 3D line (not two separate lines)
    14	 * - Only directions parallel to T1 preserve distance relationships between T2 and T2'
    15	 * - Used for distance transport operations in auxiliary plane constructions
    16	 * 
    17	 */
    18	
    19	import { HingeLine } from './HingeLine';
    20	import { Line3DRealization3D } from './Element3DRealization3D';
    21	import { AuxiliaryProjectionPlane } from './projectionPlane/AuxiliaryProjectionPlane';
    22	import type { Element3DRealizationContext } from './projectionPlane/ProjectionPlaneContext';
    23	import { applyMatrix4x3 } from '@/utils/threeUtils';
    24	
    25	/**
    26	 * BrokenHingeLine - Extends HingeLine with auxiliary plane context
    27	 * 
    28	 * Stores the reference to the main hinge (T1) used for folding and the
    29	 * auxiliary projection plane this BHL belongs to.
    30	 */
    31	export class BrokenHingeLine extends HingeLine {
    32	  readonly mainHingeId: string;       // ID of the HingeLine (T1) used for folding
    33	  readonly auxiliaryPlaneId: string;  // Auxiliary projection plane this BHL belongs to
    34	
    35	  constructor(
    36	    id: string,
    37	    label: string,
    38	    plane1Id: string,    // Base plane (contains T1 and T2')
    39	    plane2Id: string,    // Original plane (contains T2)
    40	    mainHingeId: string,
    41	    auxiliaryPlaneId: string
    42	  ) {
    43	    super(id, label, plane1Id, plane2Id);
    44	    this.mainHingeId = mainHingeId;
    45	    this.auxiliaryPlaneId = auxiliaryPlaneId;
    46	  }
    47	
    48	  /**
    49	   * Realize BHL in 3D using T2's geometry
    50	   * 
    51	   * Unlike regular HingeLine (which uses canonical coordinates), BrokenHingeLine
    52	   * must be positioned at the actual T2 location.
    53	   * 
    54	   * CRITICAL: The two BHHLs use DIFFERENT T2 traces:
    55	   * - BHHL on plane1 (auxiliary plane): uses T2' from the hinge plane
    56	   * - BHHL on plane2 (other plane): uses T2 from the other plane
    57	   * 
    58	   * This is because the BHHL on the auxiliary plane must align with T2' (which is
    59	   * visible on the hinge plane), while the BHHL on the other plane aligns with T2.
    60	   * 
    61	   * Context parameter determines which plane's BHHL is being realized.
    62	   * 
    63	   * Algorithm:
    64	   * 1. Get auxiliary plane to find appropriate T2 trace ID
    65	   * 2. Get T2/T2' line and realize it in 2D
    66	   * 3. Get source plane's 3D realization (planeToThreeD matrix)
    67	   * 4. Transform T2/T2' 2D geometry to 3D using the matrix
    68	   * 5. Return 3D line at T2/T2' position
    69	   */
    70	  realize3D(realizationContext: Element3DRealizationContext, options?: { planeId?: string }): Line3DRealization3D {
    71	    // Get auxiliary plane to derive T2 trace ID
    72	    const auxPlane = realizationContext.getProjectionPlaneById(this.auxiliaryPlaneId);
    73	    if (!(auxPlane instanceof AuxiliaryProjectionPlane)) {
    74	      console.error(`[BrokenHingeLine] Auxiliary plane not found or wrong type: ${this.auxiliaryPlaneId}`);
    75	      return Line3DRealization3D.createInfeasible();
    76	    }
    77	
    78	    // Determine which T2 trace to use based on which BHHL is being realized
    79	    // - If realizing for plane1 (auxiliary plane): use T2' from hinge plane
    80	    // - If realizing for plane2 (other plane): use T2 from other plane
    81	    const isAuxiliaryPlane = options?.planeId === this.plane1Id;
    82	    const t2TraceId = isAuxiliaryPlane 
    83	      ? auxPlane.t2PrimeLineId   // T2' on hinge plane (e.g., projPlane3)
    84	      : auxPlane.t2OtherTraceId; // T2 on other plane (e.g., projPlane4)
    85	    
    86	    const traceName = isAuxiliaryPlane ? 'T2\'' : 'T2';
    87	    
    88	    if (!t2TraceId) {
    89	      console.error(`[BrokenHingeLine] Auxiliary plane ${this.auxiliaryPlaneId} has no ${traceName} trace`);
    90	      return Line3DRealization3D.createInfeasible();
    91	    }
    92	
    93	    // Get T2/T2' line and realize it in 2D
    94	    const t2Line = realizationContext.getLine2D(t2TraceId);
    95	    if (!t2Line) {
    96	      console.error(`[BrokenHingeLine] ${traceName} line not found: ${t2TraceId}`);
    97	      return Line3DRealization3D.createInfeasible();
    98	    }
    99	
   100	    const t2Real2D = t2Line.realize2D(realizationContext);
   101	    if (!t2Real2D.feasible) {
   102	      return Line3DRealization3D.createInfeasible();
   103	    }
   104	
   105	    // Get source plane's 3D realization to transform from 2D to 3D
   106	    // Use the plane where the T2/T2' trace actually exists
   107	    const sourcePlaneReal3D = realizationContext.getProjectionPlane3DRealization(t2Line.planeId);
   108	    if (!sourcePlaneReal3D || !sourcePlaneReal3D.feasible) {
   109	      return Line3DRealization3D.createInfeasible();
   110	    }
   111	
   112	    // Transform T2/T2' 2D geometry to 3D
   113	    // point1 is a point on the line (Vector3), point2 is direction (Vector3, z=0)
   114	    // applyMatrix4x3 transforms Vector3 → Vector4 (homogeneous 3D coordinates)
   115	    const point3D = applyMatrix4x3(t2Real2D.point1, sourcePlaneReal3D.planeTo3D);
   116	    const direction3D = applyMatrix4x3(t2Real2D.point2, sourcePlaneReal3D.planeTo3D);
   117	
   118	    console.log(`[BHL ${this.label}] ${traceName} on ${t2Line.planeId}: (${t2Real2D.point1.x.toFixed(2)}, ${t2Real2D.point1.y.toFixed(2)})`);
   119	    console.log(`[BHL ${this.label}] 3D point: (${point3D.x.toFixed(2)}, ${point3D.y.toFixed(2)}, ${point3D.z.toFixed(2)}, ${point3D.w.toFixed(2)})`);
   120	
   121	    return new Line3DRealization3D(point3D, direction3D, true);
   122	  }
   123	
   124	  /**
   125	   * Get dependencies for this broken hinge line
   126	   * 
   127	   * Includes parent HingeLine dependencies plus mainHingeId
   128	   */
   129	  getDependencies(): string[] {
   130	    return [...super.getDependencies(), this.mainHingeId];
   131	  }
   132	
   133	  /**
   134	   * Clone this BrokenHingeLine
   135	   */
   136	  clone(): BrokenHingeLine {
   137	    return new BrokenHingeLine(
   138	      this.id,
   139	      this.label || '',
   140	      this.plane1Id,
   141	      this.plane2Id,
   142	      this.mainHingeId,
   143	      this.auxiliaryPlaneId
   144	    );
   145	  }
   146	}
--- frontend/src/application/canvasPresentation/CanvasWorldReadPort.ts
     1	import { Guide2D, SiblingGuide2D } from '@/domain/world/Guide';
     2	import { HalfHingeLine2D } from '@/domain/world/HingeLine';
     3	import { Segment2DByPoints } from '@/domain/world/Segment';
     4	import type { ProjectionElementRealizationContext, Element3DRealizationContext } from '@/domain/world/projectionPlane/ProjectionPlaneContext';
     5	import type { World } from '@/domain/world/World';
     6	import type { CanvasPlaneCanvasItems, CanvasPlaneItem, CanvasPlaneLineItem, CanvasPlaneTransformModel, CanvasRenderItem } from './CanvasPresentationModel';
     7	import { resolveVisibility } from '@/domain/world/styleService';
     8	import { Projected3DCanvasSelector } from './Projected3DCanvasSelector';
     9	import { createProjected3DCanvasReadPort } from './Projected3DCanvasReadPort';
    10	
    11	export interface CanvasWorldReadPort {
    12	  getCanvasPlaneTransforms(): CanvasPlaneTransformModel[];
    13	  getPlaneCanvasItems(): CanvasPlaneCanvasItems[];
    14	  getProjected3DCanvasItems(planeTransforms: Map<string, CanvasPlaneTransformModel>): CanvasRenderItem[];
    15	}
    16	
    17	function createCanvasRealizationContext(world: World): ProjectionElementRealizationContext & Element3DRealizationContext {
    18	  return {
    19	    getProjectionPlaneById: id => world.getProjectionPlaneById(id),
    20	    getPoint2D: id => world.getPoint2D(id),
    21	    getLine2D: id => world.getLine2D(id),
    22	    getCircle2D: id => world.getCircle2D(id),
    23	    getProjectionPlane2DRealization: id => world.getProjectionPlane2DRealization(id),
    24	    getProjectionPlane3DRealization: id => world.getProjectionPlane3DRealization(id),
    25	    get3DPlaneRealization: id => world.get3DPlaneRealization(id),
    26	    getHingeLineById: id => world.getHingeLineById(id),
    27	    getAllProjectionPlanes: () => world.getAllProjectionPlanes(),
    28	    getAllHingeLines: () => world.getAllHingeLines(),
    29	  };
    30	}
    31	
    32	function getCanvasPlaneTransforms(world: World): CanvasPlaneTransformModel[] {
    33	  return world.getAllProjectionPlanes().flatMap((plane) => {
    34	    const realization = world.getProjectionPlane2DRealization(plane.id);
    35	    if (!realization) return [];
    36	    return [{ planeId: plane.id, planeToPaper: realization.planeToPaper2D, paperToPlane: realization.paperToPlane2D }];
    37	  });
    38	}
    39	
    40	function getPlaneCanvasItems(world: World, context: ProjectionElementRealizationContext): CanvasPlaneCanvasItems[] {
    41	  return world.getAllProjectionPlanes().flatMap((plane) => {
    42	    const transform = getCanvasPlaneTransforms(world).find(item => item.planeId === plane.id);
    43	    if (!transform) return [];
    44	    const items: CanvasPlaneItem[] = [];
    45	
    46	    for (const point of plane.getAllPoints()) {
    47	      if (!resolveVisibility(point, world)) continue;
    48	      const realization = plane.realizePoint2D(point, context);
    49	      if (!realization) continue;
    50	      items.push({
    51	        kind: 'point',
    52	        elementId: point.id,
    53	        planeId: point.planeId,
    54	        position: realization.position.clone(),
    55	        pointRole: point.constructor.name === 'FreePoint2D' ? 'free' : 'dependent',
    56	      });
    57	    }
    58	
    59	    for (const line of plane.getAllLines()) {
    60	      if (!resolveVisibility(line, world)) continue;
    61	      const realization = plane.realizeLine2D(line, context);
    62	      if (!realization) continue;
    63	      const kind: CanvasPlaneLineItem['kind'] = line instanceof HalfHingeLine2D
    64	        ? 'half-hinge-line'
    65	        : line instanceof Segment2DByPoints
    66	          ? 'finite-segment'
    67	          : line instanceof SiblingGuide2D
    68	            ? 'sibling-guide'
    69	            : line instanceof Guide2D
    70	              ? 'guide'
    71	              : 'infinite-line';
    72	      items.push({
    73	        kind,
    74	        elementId: line.id,
    75	        planeId: line.planeId,
    76	        point: realization.point1.clone(),
    77	        direction: realization.getDirection(),
    78	        point1: kind === 'finite-segment' ? realization.point1.clone() : undefined,
    79	        point2: kind === 'finite-segment' ? realization.point2.clone() : undefined,
    80	        arcGeometry: optionalArcGeometry(line),
    81	      });
    82	    }
    83	
    84	    for (const circle of plane.getAllCircles()) {
    85	      if (!resolveVisibility(circle, world)) continue;
    86	      const realization = plane.realizeCircle2D(circle, context);
    87	      if (!realization) continue;
    88	      items.push({
    89	        kind: 'circle',
    90	        elementId: circle.id,
    91	        planeId: circle.planeId,
    92	        center: realization.center.clone(),
    93	        radius: realization.getRadius(),
    94	        radiusVector: realization.radiusVector.clone(),
    95	      });
    96	    }
    97	
    98	    return [{ planeId: plane.id, transform, items }];
    99	  });
   100	}
   101	
   102	export function createCanvasWorldReadPort(world: World): CanvasWorldReadPort {
   103	  const realizationContext = createCanvasRealizationContext(world);
   104	  const projected3DSelector = new Projected3DCanvasSelector();
   105	  return {
   106	    getCanvasPlaneTransforms: () => getCanvasPlaneTransforms(world),
   107	    getPlaneCanvasItems: () => getPlaneCanvasItems(world, realizationContext),
   108	    getProjected3DCanvasItems: planeTransforms => projected3DSelector.selectWorldProjection(createProjected3DCanvasReadPort(world, realizationContext), planeTransforms),
   109	  };
   110	}
   111	
   112	export type CanvasPlaneTransformMap = Map<string, CanvasPlaneTransformModel>;
   113	
   114	function optionalArcGeometry(line: object): CanvasPlaneLineItem['arcGeometry'] | undefined {
   115	  return 'arcGeometry' in line ? line.arcGeometry as CanvasPlaneLineItem['arcGeometry'] | undefined : undefined;
   116	}
--- frontend/src/application/canvasPresentation/Projected3DCanvasReadPort.ts
     1	import type { Element3DRealizationContext } from '@/domain/world/projectionPlane/ProjectionPlaneContext';
     2	import type { World } from '@/domain/world/World';
     3	import type { Projected3DCanvasReadPort } from './Projected3DCanvasSelector';
     4	
     5	export function createProjected3DCanvasReadPort(world: World, realizationContext: Element3DRealizationContext): Projected3DCanvasReadPort {
     6	  return {
     7	    getProjectionPlanes: () => world.getAllProjectionPlanes().map(plane => ({ id: plane.id })),
     8	    getProjectionPlane3DRealization: planeId => world.getProjectionPlane3DRealization(planeId),
     9	    get3DPoints: () => world.getAll3DPoints().map(point => ({ id: point.id, realization: point.realize3D(realizationContext) })),
    10	    get3DLines: () => world.getAll3DLines().map(line => ({ id: line.id, realization: line.realize3D(realizationContext) })),
    11	    get3DSegments: () => world.getAll3DSegments().map(segment => ({ id: segment.id, realization: segment.realize3D(realizationContext) })),
    12	  };
    13	}
