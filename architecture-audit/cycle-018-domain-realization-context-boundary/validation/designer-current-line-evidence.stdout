--- frontend/src/application/threePresentation/ThreeRealizationContext.ts
     1	import type { ProjectionElementRealizationContext, Element3DRealizationContext } from '@/domain/world/projectionPlane/ProjectionPlaneContext';
     2	import type { ProjectionPlane } from '@/domain/world/projectionPlane/ProjectionPlane';
     3	import type { HingeLine } from '@/domain/world/HingeLine';
     4	import type { World } from '@/domain/world/World';
     5	
     6	interface ThreeRealizationContextCollections {
     7	  getProjectionPlanes: () => ProjectionPlane[];
     8	  getHingeLines: () => HingeLine[];
     9	}
    10	
    11	export function createThreeRealizationContext(
    12	  world: World,
    13	  collections: ThreeRealizationContextCollections,
    14	): ProjectionElementRealizationContext & Element3DRealizationContext {
    15	  return {
    16	    getProjectionPlaneById: id => world.getProjectionPlaneById(id),
    17	    getPoint2D: id => world.getPoint2D(id),
    18	    getLine2D: id => world.getLine2D(id),
    19	    getCircle2D: id => world.getCircle2D(id),
    20	    getProjectionPlane2DRealization: id => world.getProjectionPlane2DRealization(id),
    21	    getProjectionPlane3DRealization: id => world.getProjectionPlane3DRealization(id),
    22	    get3DPlaneRealization: id => world.get3DPlaneRealization(id),
    23	    getHingeLineById: id => world.getHingeLineById(id),
    24	    getAllProjectionPlanes: collections.getProjectionPlanes,
    25	    getAllHingeLines: collections.getHingeLines,
    26	  };
    27	}
--- frontend/src/application/threePresentation/ThreePlanarElementReadPort.ts
     1	import type { Circle2DRealization2D } from '@/domain/world/Circle';
     2	import type { Line2DRealization2D } from '@/domain/world/Line';
     3	import type { Point2DRealization2D } from '@/domain/world/Point';
     4	import type { ProjectionPlaneRealization3D } from '@/domain/world/projectionPlane/ProjectionPlaneRealization';
     5	import { Segment2DByPoints } from '@/domain/world/Segment';
     6	import type { World } from '@/domain/world/World';
     7	import type { ThreeEntityPresentationData } from './ThreePresentationReadModel';
     8	import { createThreeRealizationContext } from './ThreeRealizationContext';
     9	
    10	export interface ThreePlanarPointReadModel extends ThreeEntityPresentationData { realization: Point2DRealization2D | undefined }
    11	export interface ThreePlanarLineReadModel extends ThreeEntityPresentationData { realization: Line2DRealization2D | undefined; isSegment: boolean }
    12	export interface ThreePlanarCircleReadModel extends ThreeEntityPresentationData { realization: Circle2DRealization2D | undefined | null }
    13	
    14	export interface ThreePlanarPlaneReadModel {
    15	  id: string;
    16	  realization: ProjectionPlaneRealization3D | undefined;
    17	  points: ThreePlanarPointReadModel[];
    18	  lines: ThreePlanarLineReadModel[];
    19	  circles: ThreePlanarCircleReadModel[];
    20	}
    21	
    22	export interface ThreePlanarElementReadPort {
    23	  getPlanarPlaneModels(): ThreePlanarPlaneReadModel[];
    24	}
    25	
    26	export function createThreePlanarElementReadPort(world: World): ThreePlanarElementReadPort {
    27	  const getProjectionPlanes = () => world.getAllProjectionPlanes();
    28	  const realizationContext = createThreeRealizationContext(world, {
    29	    getProjectionPlanes,
    30	    getHingeLines: () => [],
    31	  });
    32	  return {
    33	    getPlanarPlaneModels: () => getProjectionPlanes().map(plane => ({
    34	      id: plane.id,
    35	      realization: world.getProjectionPlane3DRealization(plane.id),
    36	      points: plane.getAllPoints().map(point => ({ id: point.id, visualStyle: point.visualStyle, realization: point.realize2D(realizationContext) })),
    37	      lines: plane.getAllLines().map(line => ({ id: line.id, visualStyle: line.visualStyle, realization: line.realize2D(realizationContext), isSegment: line instanceof Segment2DByPoints })),
    38	      circles: plane.getAllCircles().map(circle => ({ id: circle.id, visualStyle: circle.visualStyle, realization: circle.realize2D(realizationContext) })),
    39	    })),
    40	  };
    41	}
--- frontend/src/application/threePresentation/ThreeGuideReadPort.ts
     1	import type { Vector4 } from 'three';
     2	import type { Line2DRealization2D } from '@/domain/world/Line';
     3	import type { ProjectionPlaneRealization3D } from '@/domain/world/projectionPlane/ProjectionPlaneRealization';
     4	import type { World } from '@/domain/world/World';
     5	import { isGuide2D, isSiblingGuide2D } from '@/domain/world/Guide';
     6	import type { ThreeEntityPresentationData } from './ThreePresentationReadModel';
     7	import { createThreeRealizationContext } from './ThreeRealizationContext';
     8	
     9	export interface ThreeGuideReadModel extends ThreeEntityPresentationData {
    10	  planeId: string;
    11	  planeRealization: ProjectionPlaneRealization3D | undefined;
    12	  realization: Line2DRealization2D | undefined;
    13	}
    14	
    15	export interface ThreeGuideIntersectionReadModel {
    16	  points: Array<ThreeEntityPresentationData & { cartesian: [number, number, number] | undefined }>;
    17	  lines: Array<ThreeEntityPresentationData & { point: Vector4 | undefined; direction: Vector4 | undefined }>;
    18	  segments: Array<ThreeEntityPresentationData & { startPoint: Vector4 | undefined; endPoint: Vector4 | undefined }>;
    19	}
    20	
    21	export interface ThreeGuideReadPort {
    22	  getSelectedGuideModels(selectedIds: readonly string[]): ThreeGuideReadModel[];
    23	  getGuideIntersectionModels(): ThreeGuideIntersectionReadModel;
    24	}
    25	
    26	export function createThreeGuideReadPort(world: World): ThreeGuideReadPort {
    27	  const realizationContext = createThreeRealizationContext(world, {
    28	    getProjectionPlanes: () => [],
    29	    getHingeLines: () => [],
    30	  });
    31	  return {
    32	    getSelectedGuideModels: (selectedIds: readonly string[]) => selectedIds.flatMap(selectedId => {
    33	      try {
    34	        const line = world.getLine2D(selectedId);
    35	        if (!line || (!isGuide2D(line) && !isSiblingGuide2D(line))) return [];
    36	        return [{ id: line.id, visualStyle: line.visualStyle, planeId: line.planeId, planeRealization: world.getProjectionPlane3DRealization(line.planeId), realization: line.realize2D(realizationContext) }];
    37	      } catch {
    38	        return [];
    39	      }
    40	    }),
    41	    getGuideIntersectionModels: () => ({
    42	      points: world.getAll3DPoints().map(point => {
    43	        const realization = world.get3DPointRealization(point.id!);
    44	        return { id: point.id!, visualStyle: point.visualStyle, cartesian: realization?.isFeasible() ? realization.getCartesian() : undefined };
    45	      }),
    46	      lines: world.getAll3DLines().map(line => {
    47	        const realization = world.get3DLineRealization(line.id!);
    48	        return { id: line.id!, visualStyle: line.visualStyle, point: realization?.isFeasible() ? realization.point : undefined, direction: realization?.isFeasible() ? realization.getDirection() : undefined };
    49	      }),
    50	      segments: world.getAll3DSegments().map(segment => {
    51	        const realization = world.get3DSegmentRealization(segment.id!);
    52	        return { id: segment.id!, visualStyle: segment.visualStyle, startPoint: realization?.isFeasible() ? realization.startPoint : undefined, endPoint: realization?.isFeasible() ? realization.endPoint : undefined };
    53	      }),
    54	    }),
    55	  };
    56	}
--- frontend/src/application/threePresentation/ThreeHingeReadPort.ts
     1	import type { Line3DRealization3D } from '@/domain/world/Element3DRealization3D';
     2	import type { World } from '@/domain/world/World';
     3	import type { ThreeEntityPresentationData } from './ThreePresentationReadModel';
     4	import { createThreeRealizationContext } from './ThreeRealizationContext';
     5	
     6	export interface ThreeHingeReadModel extends ThreeEntityPresentationData { realization: Line3DRealization3D | undefined }
     7	
     8	export interface ThreeHingeReadPort {
     9	  getHingeModels(): ThreeHingeReadModel[];
    10	}
    11	
    12	export function createThreeHingeReadPort(world: World): ThreeHingeReadPort {
    13	  const getHingeLines = () => world.getAllHingeLines();
    14	  const realizationContext = createThreeRealizationContext(world, {
    15	    getProjectionPlanes: () => world.getAllProjectionPlanes(),
    16	    getHingeLines,
    17	  });
    18	  return {
    19	    getHingeModels: () => getHingeLines().map(hingeLine => ({ id: hingeLine.id, visualStyle: hingeLine.visualStyle, realization: hingeLine.realize3D(realizationContext) })),
    20	  };
    21	}
--- frontend/tests/unit/application/threePresentation/threePresentationArchitectureBoundary.spec.ts
     1	import { describe, expect, it } from 'vitest';
     2	import projectionPlaneSelectorSource from '../../../../src/application/threePresentation/ProjectionPlane3DSelector.ts?raw';
     3	import planarSelectorSource from '../../../../src/application/threePresentation/PlanarElement3DSelector.ts?raw';
     4	import reconstructedSelectorSource from '../../../../src/application/threePresentation/ReconstructedElement3DSelector.ts?raw';
     5	import guideSelectorSource from '../../../../src/application/threePresentation/Guide3DSelector.ts?raw';
     6	import hingeSelectorSource from '../../../../src/application/threePresentation/Hinge3DSelector.ts?raw';
     7	import presentationSelectorSource from '../../../../src/application/threePresentation/ThreePresentationSelector.ts?raw';
     8	import presentationReadPortsSource from '../../../../src/application/threePresentation/ThreeWorldReadPort.ts?raw';
     9	import projectionPlaneReadPortSource from '../../../../src/application/threePresentation/ThreeProjectionPlaneReadPort.ts?raw';
    10	import planarReadPortSource from '../../../../src/application/threePresentation/ThreePlanarElementReadPort.ts?raw';
    11	import reconstructedReadPortSource from '../../../../src/application/threePresentation/ThreeReconstructedElementReadPort.ts?raw';
    12	import guideReadPortSource from '../../../../src/application/threePresentation/ThreeGuideReadPort.ts?raw';
    13	import hingeReadPortSource from '../../../../src/application/threePresentation/ThreeHingeReadPort.ts?raw';
    14	import realizationContextSource from '../../../../src/application/threePresentation/ThreeRealizationContext.ts?raw';
    15	import runtimeViewPortsSource from '../../../../src/application/appShell/RuntimeViewPorts.ts?raw';
    16	import canvasReadPortSource from '../../../../src/application/canvasPresentation/CanvasWorldReadPort.ts?raw';
    17	import threeViewSource from '../../../../src/components/panels/ThreeView.vue?raw';
    18	
    19	const selectorSources = [projectionPlaneSelectorSource, planarSelectorSource, reconstructedSelectorSource, guideSelectorSource, hingeSelectorSource];
    20	const readPortSources = [presentationReadPortsSource, projectionPlaneReadPortSource, planarReadPortSource, reconstructedReadPortSource, guideReadPortSource, hingeReadPortSource, realizationContextSource];
    21	
    22	describe('three presentation architecture boundary', () => {
    23	  it('keeps selectors on named concern read ports instead of a broad ThreeWorldReadPort dependency', () => {
    24	    for (const source of selectorSources) {
    25	      expect(source).not.toMatch(/ThreeWorldReadPort|Pick<\s*ThreeWorldReadPort/);
    26	    }
    27	    expect(presentationSelectorSource).toContain('readPorts.projectionPlanes');
    28	    expect(presentationSelectorSource).toContain('readPorts.planarElements');
    29	    expect(presentationSelectorSource).toContain('readPorts.reconstructedElements');
    30	    expect(presentationSelectorSource).toContain('readPorts.guides');
    31	    expect(presentationSelectorSource).toContain('readPorts.hinges');
    32	  });
    33	
    34	  it('keeps World imports localized to runtime-created three read-port adapters and realization context helper', () => {
    35	    for (const source of selectorSources) {
    36	      expect(source).not.toMatch(/@\/domain\/world\/World/);
    37	    }
    38	    for (const source of readPortSources) {
    39	      expect(source).not.toMatch(new RegExp(['RuntimeWorld', 'WorldReadModel', 'PresentationWorld', 'get' + 'World\\s*\\('].join('|')));
    40	    }
    41	  });
    42	
    43	  it('keeps realization context helper free of broad world collection traversal', () => {
    44	    expect(realizationContextSource).not.toMatch(/world\.getAllProjectionPlanes|world\.getAllHingeLines/);
    45	    expect(planarReadPortSource).toContain('const getProjectionPlanes = () => world.getAllProjectionPlanes()');
    46	    expect(hingeReadPortSource).toContain('const getHingeLines = () => world.getAllHingeLines()');
    47	  });
    48	
    49	  it('does not introduce generic world/read-model facades or canvas raw seams', () => {
    50	    const searchedSources = [presentationSelectorSource, runtimeViewPortsSource, canvasReadPortSource, ...readPortSources].join('\n');
    51	    expect(searchedSources).not.toMatch(new RegExp(['RuntimeWorld', 'WorldReadModel', 'PresentationWorld', 'get' + 'World\\s*\\('].join('|')));
    52	    expect(canvasReadPortSource).not.toMatch(new RegExp(['getProcessTree', 'get' + 'World', 'getRealizationContext'].join('|')));
    53	  });
    54	
    55	  it('keeps production Vue components free of concrete World imports and injection', () => {
    56	    expect(threeViewSource).not.toMatch(new RegExp(['@/domain/world/World', 'WorldInjectionKey', 'get' + 'World\\s*\\('].join('|')));
    57	    expect(threeViewSource).toContain('getReadPorts()');
    58	  });
    59	});
--- frontend/tests/e2e/current-ui-contract.spec.ts
     1	import { expect, test } from '@playwright/test';
     2	
     3	const canvas = (page: import('@playwright/test').Page) => page.getByTestId('svg-canvas');
     4	
     5	async function openApp(page: import('@playwright/test').Page) {
     6	  await page.goto('/');
     7	  await expect(canvas(page)).toBeVisible();
     8	  await expect(page.getByTestId('status-bar')).toBeVisible();
     9	}
    10	
    11	test.describe('Current Diedrico UI contract', () => {
    12	  test('renders the current app shell, canvas, toolbar, status bar, and plane selector', async ({ page }) => {
    13	    await openApp(page);
    14	
    15	    await expect(page.getByTestId('tool-select')).toBeVisible();
    16	    await expect(page.getByTestId('tool-point')).toBeVisible();
    17	    await expect(page.getByTestId('tool-line')).toBeVisible();
    18	    await expect(page.getByTestId('tool-circle')).toBeVisible();
    19	    await expect(page.getByTestId('toolbar-undo')).toBeVisible();
    20	    await expect(page.getByTestId('toolbar-redo')).toBeVisible();
    21	    await expect(page.getByTestId('active-plane-status')).toContainText(/P_[HV]/);
    22	    await expect(page.getByTestId('active-tool-status')).toContainText('Select');
    23	    await expect(page.getByTestId('coordinates-3d')).toContainText('---');
    24	  });
    25	
    26	  test('creates a free point through stable tool and canvas test IDs', async ({ page }) => {
    27	    await openApp(page);
    28	
    29	    const svg = canvas(page);
    30	    const initialPointCount = await svg.locator('circle').count();
    31	
    32	    await page.getByTestId('tool-point').click();
    33	    await expect(page.getByTestId('active-tool-status')).toContainText('Point');
    34	
    35	    await svg.click({ position: { x: 80, y: 80 } });
    36	    await expect.poll(async () => svg.locator('circle').count()).toBeGreaterThan(initialPointCount);
    37	    await expect(page.getByTestId('toolbar-undo')).toBeEnabled();
    38	  });
    39	
    40	  test('plane selector exposes current projection planes and switches active plane', async ({ page }) => {
    41	    await openApp(page);
    42	
    43	    await page.getByTestId('plane-selector-button').click();
    44	    await expect(page.locator('[role="listbox"]')).toBeVisible();
    45	    await expect(page.locator('[data-testid^="plane-selector-"]').first()).toBeVisible();
    46	
    47	    const pvOption = page.getByTestId('plane-selector-P_V');
    48	    if (await pvOption.count()) {
    49	      await pvOption.click();
    50	      await expect(page.getByTestId('active-plane-status')).toContainText('P_V');
    51	    } else {
    52	      await page.locator('[data-testid^="plane-selector-"]').first().click();
    53	      await expect(page.locator('[role="listbox"]')).toHaveCount(0);
    54	    }
    55	  });
    56	
    57	  test('selection masks allow free-point creation and point-only line argument collection', async ({ page }) => {
    58	    await openApp(page);
    59	
    60	    const svg = canvas(page);
    61	    const constructionPoints = svg.locator('circle').filter({ hasNot: svg.locator('.snap-indicator') });
    62	    const initialPointCount = await constructionPoints.count();
    63	    const initialLineCount = await svg.locator('line').count();
    64	
    65	    await page.getByTestId('tool-point').click();
    66	    await expect(page.getByTestId('active-tool-status')).toContainText('Point');
    67	    await svg.click({ position: { x: 40, y: 60 } });
    68	    await svg.click({ position: { x: 80, y: 90 } });
    69	    await expect.poll(async () => constructionPoints.count()).toBeGreaterThanOrEqual(initialPointCount + 2);
    70	
    71	    await page.getByTestId('tool-line').click();
    72	    await expect(page.getByTestId('active-tool-status')).toContainText('Line');
    73	    await svg.click({ position: { x: 40, y: 60 } });
    74	    await svg.click({ position: { x: 80, y: 90 } });
    75	    await expect.poll(async () => svg.locator('line').count()).toBeGreaterThan(initialLineCount);
    76	  });
    77	
    78	  test('updates 3D coordinate status through the current canvas mouse contract', async ({ page }) => {
    79	    await openApp(page);
    80	
    81	    const svg = canvas(page);
    82	    const box = await svg.boundingBox();
    83	    if (!box) throw new Error('SVG canvas bounding box unavailable');
    84	
    85	    await page.mouse.move(box.x + box.width / 2, box.y + box.height / 2);
    86	    await expect.poll(async () => page.getByTestId('coordinates-3d').textContent()).toMatch(/---|\(-?\d+\.\d{2}, -?\d+\.\d{2}, -?\d+\.\d{2}\)/);
    87	  });
    88	
    89	  test('3D overlay owns pointer interaction and does not pass drag gestures through to the 2D canvas', async ({ page }) => {
    90	    await openApp(page);
    91	
    92	    const overlay = page.getByTestId('three-view-overlay');
    93	    await expect(overlay).toBeVisible();
    94	
    95	    const overlayBox = await overlay.boundingBox();
    96	    if (!overlayBox) throw new Error('3D overlay bounding box unavailable');
    97	
    98	    const testPoint = {
    99	      x: overlayBox.x + overlayBox.width / 2,
   100	      y: overlayBox.y + overlayBox.height / 2,
   101	    };
   102	
   103	    await expect.poll(async () => overlay.evaluate(el => getComputedStyle(el).pointerEvents)).toBe('auto');
   104	    await expect.poll(async () => page.evaluate(({ x, y }) => {
   105	      const el = document.elementFromPoint(x, y);
   106	      return Boolean(el?.closest('[data-testid="three-view-overlay"]'));
   107	    }, testPoint)).toBe(true);
   108	
   109	    const svg = canvas(page);
   110	    const viewBoxBefore = await svg.getAttribute('viewBox');
   111	    await page.mouse.move(testPoint.x, testPoint.y);
   112	    await page.mouse.down();
   113	    await page.mouse.move(testPoint.x - 80, testPoint.y - 40, { steps: 6 });
   114	    await page.mouse.up();
   115	
   116	    await expect.poll(async () => svg.getAttribute('viewBox')).toBe(viewBoxBefore);
   117	  });
   118	
   119	});
