    15	export interface CanvasWorldReadPort {
    16	  getAllProjectionPlanes(): ProjectionPlane[];
    17	  getProjectionPlane2DTransform(planeId: string): CanvasPlaneTransformModel | undefined;
    18	  getProjectionPlane3DRealization(planeId: string): ProjectionPlaneRealization3D | undefined;
    19	  getAll3DPoints(): Point3D[];
    20	  getAll3DLines(): Line3D[];
    21	  getAll3DSegments(): Segment3D[];
    22	  realizePoint2D(plane: ProjectionPlane, point: Point2D): Point2DRealization2D | undefined;
    23	  realizeLine2D(plane: ProjectionPlane, line: Line2D): Line2DRealization2D | undefined;
    24	  realizeCircle2D(plane: ProjectionPlane, circle: Circle2D): Circle2DRealization2D | undefined | null;
    25	  realizePoint3D(point: Point3D): Point3DRealization3D;
    26	  realizeLine3D(line: Line3D): Line3DRealization3D;
    27	  realizeSegment3D(segment: Segment3D): Segment3DRealization3D;
    28	  getProcessTree(): ProcessTree;
    29	}
    30	
    31	function createCanvasRealizationContext(world: World): ProjectionElementRealizationContext & Element3DRealizationContext {
    32	  return {
    33	    getProjectionPlaneById: id => world.getProjectionPlaneById(id),
    34	    getPoint2D: id => world.getPoint2D(id),
    35	    getLine2D: id => world.getLine2D(id),
    36	    getCircle2D: id => world.getCircle2D(id),
    37	    getProjectionPlane2DRealization: id => world.getProjectionPlane2DRealization(id),
    38	    getProjectionPlane3DRealization: id => world.getProjectionPlane3DRealization(id),
    39	    get3DPlaneRealization: id => world.get3DPlaneRealization(id),
    40	    getHingeLineById: id => world.getHingeLineById(id),
    41	    getAllProjectionPlanes: () => world.getAllProjectionPlanes(),
    42	    getAllHingeLines: () => world.getAllHingeLines(),
    43	  };
    44	}
    45	
    46	export function createCanvasWorldReadPort(world: World): CanvasWorldReadPort {
    47	  const realizationContext = createCanvasRealizationContext(world);
    48	  return {
    49	    getAllProjectionPlanes: () => world.getAllProjectionPlanes(),
    50	    getProjectionPlane2DTransform: (planeId: string) => {
    51	      const realization = world.getProjectionPlane2DRealization(planeId);
    52	      if (!realization) return undefined;
    53	      return {
    54	        planeId,
    55	        planeToPaper: realization.planeToPaper2D,
    56	        paperToPlane: realization.paperToPlane2D,
    57	      };
    58	    },
    59	    getProjectionPlane3DRealization: (planeId: string) => world.getProjectionPlane3DRealization(planeId),
    60	    getAll3DPoints: () => world.getAll3DPoints(),
    61	    getAll3DLines: () => world.getAll3DLines(),
    62	    getAll3DSegments: () => world.getAll3DSegments(),
    63	    realizePoint2D: (plane, point) => plane.realizePoint2D(point, realizationContext),
    64	    realizeLine2D: (plane, line) => plane.realizeLine2D(line, realizationContext),
    65	    realizeCircle2D: (plane, circle) => plane.realizeCircle2D(circle, realizationContext),
    66	    realizePoint3D: point => point.realize3D(realizationContext),
    67	    realizeLine3D: line => line.realize3D(realizationContext),
    68	    realizeSegment3D: segment => segment.realize3D(realizationContext),
    69	    getProcessTree: () => world.getProcessTree(),
    70	  };
    71	}
