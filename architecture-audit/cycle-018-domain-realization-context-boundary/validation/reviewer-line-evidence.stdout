    51	  projection1: string;  // Line2D ID on first plane
    52	  projection2: string;  // Line2D ID on second plane (must be different)
    53	  plane1Id: string;     // Which plane projection1 is on
    54	  plane2Id: string;     // Which plane projection2 is on (must be different)
    55	
    56	  constructor(
    57	    id: string,
    58	    label: string,
    59	    projection1: string,
