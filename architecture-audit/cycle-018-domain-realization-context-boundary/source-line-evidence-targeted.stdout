   204	 * **Phase 52**: Refactored to extend Element3D. Inherits id and label from Element.
   205	 * **Phase 84**: NO geometry storage - computed on demand from canonical coordinates (0,0,1), (1,0,0).
   206	 * Extends Line3D base class to share realization pattern with other 3D lines.
   207	 */
   208	export class HingeLine extends Line3D {
   209	  readonly plane1Id: string;  // Reference plane (canonical coords source)
   210	  readonly plane2Id: string;  // Second projection plane
   211	
   212	  constructor(
   213	    id: string,
   214	    label: string,
   215	    plane1Id: string,
   216	    plane2Id: string
   217	  ) {
   218	    // Phase 52: Call Element3D constructor with id and label
   219	    super(id, label);
