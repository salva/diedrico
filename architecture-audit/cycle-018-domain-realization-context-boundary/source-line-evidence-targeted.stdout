### frontend/src/domain/world/BrokenHingeLine.ts
     1	/**
     2	 * BrokenHingeLine - Represents traces that appear on different planes after a 3D plane is folded
     3	 * 
     4	 * A Broken Hinge Line (BHL) represents a 3D line that appears as two separate projections
     5	 * (T2 on plane P2, T2' on plane P1) after an auxiliary projection plane is created by folding
     6	 * plane Q using trace T1 as the hinge.
     7	 * 
     8	 * **Key Geometric Distinction from Regular HingeLine**:
     9	 * - Regular HingeLine: Guides are perpendicular (plane perpendicular to both projection planes)
    10	 * - Broken HingeLine: Guides are PARALLEL to the main hinge T1 (planes containing T1 intersecting plane Q)
    11	 * 
    12	 * **Phase 101**: Broken Hinge Lines and Distance Transport Guides
    13	 * - T2 and T2' are projections of the same 3D line (not two separate lines)
    14	 * - Only directions parallel to T1 preserve distance relationships between T2 and T2'
    15	 * - Used for distance transport operations in auxiliary plane constructions
    16	 * 
    17	 */
    18	
    19	import { HingeLine } from './HingeLine';
    20	import { Line3DRealization3D } from './Element3DRealization3D';
    21	import type { World } from './World';
    22	import { applyMatrix4x3 } from '@/utils/threeUtils';
    23	
    24	/**
    25	 * BrokenHingeLine - Extends HingeLine with auxiliary plane context
    26	 * 
    27	 * Stores the reference to the main hinge (T1) used for folding and the
    28	 * auxiliary projection plane this BHL belongs to.
    29	 */
    30	export class BrokenHingeLine extends HingeLine {
    31	  readonly mainHingeId: string;       // ID of the HingeLine (T1) used for folding
    32	  readonly auxiliaryPlaneId: string;  // Auxiliary projection plane this BHL belongs to
    33	
    34	  constructor(
    35	    id: string,
    36	    label: string,
    37	    plane1Id: string,    // Base plane (contains T1 and T2')
    38	    plane2Id: string,    // Original plane (contains T2)
    39	    mainHingeId: string,
    40	    auxiliaryPlaneId: string
    41	  ) {
    42	    super(id, label, plane1Id, plane2Id);
    43	    this.mainHingeId = mainHingeId;
    44	    this.auxiliaryPlaneId = auxiliaryPlaneId;
    45	  }
    46	
    47	  /**
    48	   * Realize BHL in 3D using T2's geometry
    49	   * 
    50	   * Unlike regular HingeLine (which uses canonical coordinates), BrokenHingeLine
    51	   * must be positioned at the actual T2 location.
    52	   * 
    53	   * CRITICAL: The two BHHLs use DIFFERENT T2 traces:
    54	   * - BHHL on plane1 (auxiliary plane): uses T2' from the hinge plane
    55	   * - BHHL on plane2 (other plane): uses T2 from the other plane
    56	   * 
    57	   * This is because the BHHL on the auxiliary plane must align with T2' (which is
    58	   * visible on the hinge plane), while the BHHL on the other plane aligns with T2.
    59	   * 
    60	   * Context parameter determines which plane's BHHL is being realized.
    61	   * 
    62	   * Algorithm:
    63	   * 1. Get auxiliary plane to find appropriate T2 trace ID
    64	   * 2. Get T2/T2' line and realize it in 2D
    65	   * 3. Get source plane's 3D realization (planeToThreeD matrix)
    66	   * 4. Transform T2/T2' 2D geometry to 3D using the matrix
    67	   * 5. Return 3D line at T2/T2' position
    68	   */
    69	  realize3D(world: World, context?: { planeId?: string }): Line3DRealization3D {
    70	    // Get auxiliary plane to derive T2 trace ID
    71	    const auxPlane = world.getProjectionPlaneById(this.auxiliaryPlaneId);
    72	    if (!auxPlane || auxPlane.type !== 'auxiliary') {
    73	      console.error(`[BrokenHingeLine] Auxiliary plane not found or wrong type: ${this.auxiliaryPlaneId}`);
    74	      return Line3DRealization3D.createInfeasible();
    75	    }
    76	
    77	    // Determine which T2 trace to use based on which BHHL is being realized
    78	    // - If realizing for plane1 (auxiliary plane): use T2' from hinge plane
    79	    // - If realizing for plane2 (other plane): use T2 from other plane
    80	    const isAuxiliaryPlane = context?.planeId === this.plane1Id;
    81	    const t2TraceId = isAuxiliaryPlane 
    82	      ? (auxPlane as any).t2PrimeLineId   // T2' on hinge plane (e.g., projPlane3)
    83	      : (auxPlane as any).t2OtherTraceId; // T2 on other plane (e.g., projPlane4)
    84	    
    85	    const traceName = isAuxiliaryPlane ? 'T2\'' : 'T2';
    86	    
    87	    if (!t2TraceId) {
    88	      console.error(`[BrokenHingeLine] Auxiliary plane ${this.auxiliaryPlaneId} has no ${traceName} trace`);
    89	      return Line3DRealization3D.createInfeasible();
    90	    }
    91	
    92	    // Get T2/T2' line and realize it in 2D
    93	    const t2Line = world.getLine2D(t2TraceId);
    94	    if (!t2Line) {
    95	      console.error(`[BrokenHingeLine] ${traceName} line not found: ${t2TraceId}`);
    96	      return Line3DRealization3D.createInfeasible();
    97	    }
    98	
    99	    const t2Real2D = t2Line.realize2D(world);
   100	    if (!t2Real2D.feasible) {
   101	      return Line3DRealization3D.createInfeasible();
   102	    }
   103	
   104	    // Get source plane's 3D realization to transform from 2D to 3D
   105	    // Use the plane where the T2/T2' trace actually exists
   106	    const sourcePlaneReal3D = world.getProjectionPlane3DRealization(t2Line.planeId);
   107	    if (!sourcePlaneReal3D || !sourcePlaneReal3D.feasible) {
   108	      return Line3DRealization3D.createInfeasible();
   109	    }
   110	
   111	    // Transform T2/T2' 2D geometry to 3D
   112	    // point1 is a point on the line (Vector3), point2 is direction (Vector3, z=0)
   113	    // applyMatrix4x3 transforms Vector3 → Vector4 (homogeneous 3D coordinates)
   114	    const point3D = applyMatrix4x3(t2Real2D.point1, sourcePlaneReal3D.planeTo3D);
   115	    const direction3D = applyMatrix4x3(t2Real2D.point2, sourcePlaneReal3D.planeTo3D);
   116	
   117	    console.log(`[BHL ${this.label}] ${traceName} on ${t2Line.planeId}: (${t2Real2D.point1.x.toFixed(2)}, ${t2Real2D.point1.y.toFixed(2)})`);
   118	    console.log(`[BHL ${this.label}] 3D point: (${point3D.x.toFixed(2)}, ${point3D.y.toFixed(2)}, ${point3D.z.toFixed(2)}, ${point3D.w.toFixed(2)})`);
   119	
   120	    return new Line3DRealization3D(point3D, direction3D, true);
   121	  }
   122	
   123	  /**
   124	   * Get dependencies for this broken hinge line
   125	   * 
   126	   * Includes parent HingeLine dependencies plus mainHingeId
   127	   */
   128	  getDependencies(): string[] {
   129	    return [...super.getDependencies(), this.mainHingeId];
   130	  }
   131	
   132	  /**
   133	   * Clone this BrokenHingeLine
   134	   */
   135	  clone(): BrokenHingeLine {
   136	    return new BrokenHingeLine(
   137	      this.id,
   138	      this.label || '',
   139	      this.plane1Id,
   140	      this.plane2Id,
   141	      this.mainHingeId,
   142	      this.auxiliaryPlaneId
   143	    );
   144	  }
   145	}
### frontend/src/domain/world/projectionPlane/ProjectionPlane.ts
     1	import { Matrix3, Vector3 } from 'three';
     2	import { Matrix4x3, Matrix3x4 } from '@/utils/threeUtils';
     3	import { buildElementId } from '../ElementId';
     4	import { Element } from '../Element';
     5	import type { Point2D, Point2DRealization2D } from '../Point';
     6	import { FreePoint2D, Point2DLineLineIntersection, Point2DLineCircleIntersection, Point2DCircleCircleIntersection, SiblingIntersectionPoint2D } from '../Point';
     7	import type { Line2D, Line2DRealization2D } from '../Line';
     8	import { Line2DByTwoPoints, Line2DParallel, Line2DPerpendicularToLine, Line2DTangentToCircleThroughPoint, Line2DTangentToCircleParallelToLine } from '../Line';
