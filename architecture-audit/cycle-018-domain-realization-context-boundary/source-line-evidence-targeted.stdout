    36	  lines: Array<ThreeEntityPresentationData & { realization: Line3DRealization3D | undefined }>;
    37	  segments: Array<ThreeEntityPresentationData & { realization: Segment3DRealization3D | undefined }>;
    38	  planes: Array<ThreeEntityPresentationData & { realization: Plane3DRealization3D | undefined }>;
    39	}
