    17	
    18	export const PROJECTION_PLANE_TYPE = {
    19	  BASE: 'base',
    20	  AUXILIARY: 'auxiliary',
    21	} as const;
    22	export type ProjectionPlaneType = typeof PROJECTION_PLANE_TYPE[keyof typeof PROJECTION_PLANE_TYPE];
    23	
    24	export abstract class ProjectionPlane extends Element {
    25	  abstract readonly type: ProjectionPlaneType;
    26	  name: string;
    27	  isActive: boolean;
    28	  isVisible: boolean;
    29	  color: string;  // Hex color (#RRGGBB)
    30	  plane3DId?: string;  // Reference to Plane3D element (geometric definition)
    31	
    32	  /**
    33	   * Get dependency IDs for this plane
    34	   * Used by DependencyService to build the dependency graph
    35	   */
    36	  abstract getDependencies(): string[];
    37	
    38	  private readonly elementStore: ProjectionPlaneElementStore;
    39	
    40	  constructor(
    41	    id: string,
    42	    name: string,
    43	    isActive: boolean = false,
    44	    isVisible: boolean = true,
    45	    color: string = '#000000',
    46	    plane3DId?: string
    47	  ) {
    48	    super(id, name);
    49	    this.name = name;
    50	    this.isActive = isActive;
    51	    this.isVisible = isVisible;
    52	    this.color = color;
    53	    this.plane3DId = plane3DId;
    54	    this.elementStore = new ProjectionPlaneElementStore();
    55	  }
    56	
    57	  /**
    58	   * Clear all elements and realizations from this plane
    59	   * Used when loading projects or resetting the world
    60	   */
    61	  clear(): void {
    62	    this.elementStore.clear();
    63	  }
    64	
    65	  // ==================== Point Methods ====================
    66	
    67	  /**
    68	   * Add a point to this plane
    69	   */
    70	  addPoint(point: Point2D, context?: ProjectionPlaneMutationContext): void {
    71	    this.elementStore.addPoint(point, context);
    72	  }
    73	
    74	  /**
    75	   * Get a point by ID
    76	   */
    77	  getPoint(id: string): Point2D | undefined {
    78	    return this.elementStore.getPoint(id);
    79	  }
    80	
    81	  /**
    82	   * Get a point by label (semantic access)
    83	   * Phase 53: Enable label-based point lookup for semantic references
    84	   * 
    85	   * @param label - Point label (e.g., 'O_H', 'O_V', 'A', 'B')
    86	   * @returns Point with matching label
    87	   * @throws Error if no point found with given label
    88	   * 
    89	   * @example
    90	   * const originH = plane.getPoint2DByLabel('O_H');
    91	   */
    92	  getPoint2DByLabel(label: string): Point2D {
    93	    for (const point of this.elementStore.getAllPoints()) {
    94	      if (point.label === label) {
    95	        return point;
    96	      }
    97	    }
    98	    throw new Error(`Point not found on plane ${this.name} with label: ${label}`);
    99	  }
   100	
   101	  /**
   102	   * Get all points on this plane
   103	   */
   104	  getAllPoints(): Point2D[] {
   105	    return this.elementStore.getAllPoints();
   106	  }
   107	
   108	  /**
   109	   * Remove a point from this plane
   110	   */
   111	  removePoint(id: string, context?: ProjectionPlaneMutationContext): boolean {
   112	    return this.elementStore.removePoint(id, context);
   113	  }
   114	
   115	  /**
   116	   * Get point realization (cached 2D position)
   117	   * Phase 22.5: Consistent naming - all 2D realization methods end with "2D"
   118	   */
   119	  getPointRealization2D(id: string): Point2DRealization2D | undefined {
   120	    return this.elementStore.getPointRealization2D(id);
   121	  }
   122	
   123	  /**
   124	   * Set/cache point realization
   125	   */
   126	  setPointRealization2D(id: string, realization: Point2DRealization2D): void {
   127	    this.elementStore.setPointRealization2D(id, realization);
   128	  }
   129	
   130	  /**
   131	   * Clear point realization cache
   132	   */
   133	  clearPointRealization2D(id: string): void {
   134	    this.elementStore.clearPointRealization2D(id);
   135	  }
   136	
   137	  // ==================== Line Methods ====================
   138	
   139	  /**
   140	   * Add a line to this plane
   141	   */
   142	  addLine(line: Line2D, context?: ProjectionPlaneMutationContext): void {
   143	    this.elementStore.addLine(line, context);
   144	  }
   145	
   146	  /**
   147	   * Get a line by ID
   148	   */
   149	  getLine(id: string): Line2D | undefined {
   150	    return this.elementStore.getLine(id);
   151	  }
   152	
   153	  /**
   154	   * Get all lines on this plane
   155	   */
   156	  getAllLines(): Line2D[] {
   157	    return this.elementStore.getAllLines();
   158	  }
   159	
   160	  /**
   161	   * Remove a line from this plane
   162	   */
   163	  removeLine(id: string, context?: ProjectionPlaneMutationContext): boolean {
   164	    return this.elementStore.removeLine(id, context);
   165	  }
   166	
   167	  /**
   168	   * Get line realization (cached 2D equation)
   169	   * Phase 22.5: Consistent naming - all 2D realization methods end with "2D"
   170	   * Note: This includes segments, guides, and all Line2D subtypes
   171	   */
   172	  getLineRealization2D(id: string): Line2DRealization2D | undefined {
   173	    return this.elementStore.getLineRealization2D(id);
   174	  }
   175	
   176	  /**
   177	   * Set/cache line realization
   178	   */
   179	  setLineRealization2D(id: string, realization: Line2DRealization2D): void {
   180	    this.elementStore.setLineRealization2D(id, realization);
   181	  }
   182	
   183	  /**
   184	   * Clear line realization cache
   185	   */
   186	  clearLineRealization2D(id: string): void {
   187	    this.elementStore.clearLineRealization2D(id);
   188	  }
   189	
   190	  // ==================== Circle Methods ====================
   191	
   192	  /**
   193	   * Add a circle to this plane
   194	   */
   195	  addCircle(circle: Circle2D, context?: ProjectionPlaneMutationContext): void {
   196	    this.elementStore.addCircle(circle, context);
   197	  }
   198	
   199	  /**
   200	   * Get a circle by ID
   201	   */
   202	  getCircle(id: string): Circle2D | undefined {
   203	    return this.elementStore.getCircle(id);
   204	  }
   205	
   206	  /**
   207	   * Get all circles on this plane
   208	   */
   209	  getAllCircles(): Circle2D[] {
   210	    return this.elementStore.getAllCircles();
   211	  }
   212	
   213	  /**
   214	   * Remove a circle from this plane
   215	   */
   216	  removeCircle(id: string, context?: ProjectionPlaneMutationContext): boolean {
   217	    return this.elementStore.removeCircle(id, context);
   218	  }
