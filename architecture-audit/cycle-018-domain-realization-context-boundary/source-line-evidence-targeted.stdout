    44	  realization: Line2DRealization2D | undefined;
    45	}
    46	
    47	export interface ThreeGuideIntersectionReadModel {
    48	  points: Array<ThreeEntityPresentationData & { cartesian: [number, number, number] | undefined }>;
    49	  lines: Array<ThreeEntityPresentationData & { point: Vector4 | undefined; direction: Vector4 | undefined }>;
    50	  segments: Array<ThreeEntityPresentationData & { startPoint: Vector4 | undefined; endPoint: Vector4 | undefined }>;
    51	}
    52	
    53	export interface ThreeHingeReadModel extends ThreeEntityPresentationData { realization: Line3DRealization3D | undefined }
    54	
    55	export interface ThreeWorldReadPort {
    56	  getProjectionPlaneModels(): ThreeProjectionPlaneReadModel[];
    57	  getProjectionPlaneGridSource(planeId: string): { plane3DRealization: Plane3DRealization3D | undefined; projectionRealization: ProjectionPlaneRealization3D | undefined };
    58	  getPlanarPlaneModels(): ThreePlanarPlaneReadModel[];
    59	  getReconstructedModels(): ThreeReconstructedReadModel;
    60	  getSelectedGuideModels(selectedIds: readonly string[]): ThreeGuideReadModel[];
    61	  getGuideIntersectionModels(): ThreeGuideIntersectionReadModel;
    62	  getHingeModels(): ThreeHingeReadModel[];
    63	}
    64	
    65	export function createThreeWorldReadPort(world: World): ThreeWorldReadPort {
    66	  return {
    67	    getProjectionPlaneModels: () => world.getAllProjectionPlanes().map(plane => ({
    68	      id: plane.id,
    69	      kind: plane instanceof AuxiliaryProjectionPlane ? 'auxiliary' : 'fixed',
    70	      plane3DId: plane instanceof AuxiliaryProjectionPlane ? plane.plane3DId : plane.id,
    71	      realization: world.getProjectionPlane3DRealization(plane.id),
    72	    })),
    73	    getProjectionPlaneGridSource: (planeId: string) => {
    74	      const plane = world.getProjectionPlaneById(planeId);
    75	      const plane3DId = plane instanceof AuxiliaryProjectionPlane ? plane.plane3DId : plane?.id;
    76	      return {
    77	        plane3DRealization: plane3DId ? world.get3DPlaneRealization(plane3DId) : undefined,
    78	        projectionRealization: world.getProjectionPlane3DRealization(planeId),
    79	      };
    80	    },
    81	    getPlanarPlaneModels: () => world.getAllProjectionPlanes().map(plane => ({
    82	      id: plane.id,
    83	      realization: world.getProjectionPlane3DRealization(plane.id),
    84	      points: plane.getAllPoints().map(point => ({ id: point.id, visualStyle: point.visualStyle, realization: point.realize2D(world) })),
    85	      lines: plane.getAllLines().map(line => ({ id: line.id, visualStyle: line.visualStyle, realization: line.realize2D(world), isSegment: line instanceof Segment2DByPoints })),
    86	      circles: plane.getAllCircles().map(circle => ({ id: circle.id, visualStyle: circle.visualStyle, realization: circle.realize2D(world) })),
    87	    })),
    88	    getReconstructedModels: () => ({
    89	      points: world.getAll3DPoints().map(point => ({ id: point.id!, visualStyle: point.visualStyle, realization: world.get3DPointRealization(point.id!) })),
    90	      lines: world.getAll3DLines().map(line => ({ id: line.id!, visualStyle: line.visualStyle, realization: world.get3DLineRealization(line.id!) })),
    91	      segments: world.getAll3DSegments().map(segment => ({ id: segment.id!, visualStyle: segment.visualStyle, realization: world.get3DSegmentRealization(segment.id!) })),
    92	      planes: world.getAllPlanes().map(plane => ({ id: plane.id!, visualStyle: plane.visualStyle, realization: world.get3DPlaneRealization(plane.id!) })),
    93	    }),
    94	    getSelectedGuideModels: (selectedIds: readonly string[]) => selectedIds.flatMap(selectedId => {
    95	      try {
    96	        const line = world.getLine2D(selectedId);
    97	        if (!line || (!isGuide2D(line) && !isSiblingGuide2D(line))) return [];
    98	        return [{ id: line.id, visualStyle: line.visualStyle, planeId: line.planeId, planeRealization: world.getProjectionPlane3DRealization(line.planeId), realization: line.realize2D(world) }];
    99	      } catch {
   100	        return [];
   101	      }
   102	    }),
   103	    getGuideIntersectionModels: () => ({
   104	      points: world.getAll3DPoints().map(point => {
   105	        const realization = world.get3DPointRealization(point.id!);
   106	        return { id: point.id!, visualStyle: point.visualStyle, cartesian: realization?.isFeasible() ? realization.getCartesian() : undefined };
   107	      }),
   108	      lines: world.getAll3DLines().map(line => {
   109	        const realization = world.get3DLineRealization(line.id!);
   110	        return { id: line.id!, visualStyle: line.visualStyle, point: realization?.isFeasible() ? realization.point : undefined, direction: realization?.isFeasible() ? realization.getDirection() : undefined };
   111	      }),
   112	      segments: world.getAll3DSegments().map(segment => {
   113	        const realization = world.get3DSegmentRealization(segment.id!);
   114	        return { id: segment.id!, visualStyle: segment.visualStyle, startPoint: realization?.isFeasible() ? realization.startPoint : undefined, endPoint: realization?.isFeasible() ? realization.endPoint : undefined };
   115	      }),
   116	    }),
   117	    getHingeModels: () => world.getAllHingeLines().map(hingeLine => ({ id: hingeLine.id, visualStyle: hingeLine.visualStyle, realization: hingeLine.realize3D(world) })),
   118	  };
   119	}
### frontend/src/domain/world/Element3D.ts
     1	/**
     2	 * Element3D - Abstract base class for 3D geometric elements
     3	 * 
     4	 * Extends Element with no additional properties.
     5	 * Serves as type marker and organizational structure for 3D elements.
     6	 * 
     7	 * **Phase 52**: Introduced as part of unified Element hierarchy to distinguish
     8	 * 3D elements from 2D elements in the type system.
     9	 * 
    10	 * **Current 3D element types**:
    11	 * - Plane3D (and subclasses: Plane3DFixed, Plane3DByTraces, Plane3DByPointAndNormal)
    12	 * - HingeLine
    13	 * 
    14	 * **Future 3D element types** (when needed):
    15	 * - Point3D (3D point in space)
    16	 * - Line3D (3D line in space)
    17	 * - Circle3D (3D circle in space)
    18	 * 
    19	 * **Design Note**: Element3D "probably adds nothing" (per planning notes) because
    20	 * 3D elements don't need:
    21	 * - `planeId` (they're not confined to a single projection plane)
    22	 * - `visible` (3D elements don't have direct UI visibility toggles; their 2D projections do)
    23	 * - `type` discriminator (handled by concrete subclass instanceof checks)
    24	 * 
    25	 * However, Element3D provides:
    26	 * - **Type Organization**: Clear distinction between 2D and 3D elements in type system
    27	 * - **Dependency Interface**: All 3D elements must implement getDependencies()
    28	 * - **Future Extensibility**: Common place to add 3D-specific functionality later
    29	 * 
    30	 */
    31	import { Element } from './Element';
    32	
    33	export abstract class Element3D extends Element {
    34	  /**
    35	   * Compute 3D geometric realization from defining data
    36	   * 
    37	   * @param world - World context for resolving dependencies (2D projections, planes)
    38	   * @returns Element3DRealization3D with numeric coordinates, or infeasible if computation fails
    39	   */
    40	  abstract realize3D(world: any): any;  // Using any to avoid circular dependencies
    41	
    42	  /**
    43	   * Get dependencies - IDs of elements this 3D element depends on
    44	   * 
    45	   * Examples:
    46	   * - Plane3DFixed: [] (no dependencies)
    47	   * - Plane3DByTraces: [traceH, traceV] (depends on 2D trace lines)
    48	   * - HingeLine: [plane1, plane2] (depends on two planes)
    49	   * 
    50	   * @returns Array of element IDs that this element depends on
    51	   */
    52	  abstract getDependencies(): string[];
    53	  
    54	  /**
    55	   * Clone this 3D element
    56	   * Must be implemented by concrete subclasses
    57	   */
    58	  abstract clone(): Element3D;
    59	}
    60	
    61	/**
    62	 * Type guard to check if an object is an Element3D
    63	 * 
    64	 * @param obj Object to check
    65	 * @returns true if obj is an Element3D, false otherwise
    66	 */
    67	export function isElement3D(obj: any): obj is Element3D {
    68	  return obj instanceof Element3D;
    69	}
### frontend/src/domain/world/Point3D.ts
     1	/**
     2	 * Point3D - 3D point classes (domain layer - definitions)
     3	 * 
     4	 * Contains high-level definitions and relationships (IDs of source 2D elements).
     5	 * NO numeric coordinates - those are computed and stored in Point3DRealization3D.
     6	 * 
     7	 * Types:
     8	 * - Point3DByCoordinates: System element with fixed coordinates (e.g., origin O)
     9	 * - Point3DFromProjections: User-created point from two 2D projections (Phase 78)
    10	 * 
    11	 * Architecture:
    12	 * - Element3D classes store WHAT the element is (definition/rules)
    13	 * - realize3D() computes numeric geometry → Point3DRealization3D
    14	 * - Lazy evaluation with caching in World.pointRealizations3D
    15	 * 
    16	 */
    17	import { Vector4 } from 'three';
    18	import { Element3D } from './Element3D';
    19	import { Point3DRealization3D } from './Element3DRealization3D';
    20	import type { World } from './World';
    21	import type { VisualStyle } from './VisualStyle';
    22	import { createVisualStyle } from './VisualStyle';
    23	import { reconstruct3DPointFromProjections } from '@/utils/threeUtils';
    24	
    25	/**
    26	 * Point3DByCoordinates - Point with explicit 3D coordinates
    27	 * System element with fixed position (e.g., origin O)
    28	 */
    29	export class Point3DByCoordinates extends Element3D {
    30	  readonly kind = 'Point3DByCoordinates';
    31	  name: string;
    32	  coordinates: Vector4;  // Position [x, y, z, 1] - stored as Vector4
    33	  projectionH?: string;  // ID of projection on P_H
    34	  projectionV?: string;  // ID of projection on P_V
    35	
    36	  constructor(
    37	    id: string,
    38	    name: string,
    39	    coordinates: Vector4,
    40	    visualStyle: VisualStyle,
    41	    projectionH?: string,
    42	    projectionV?: string
    43	  ) {
    44	    super(id, undefined, visualStyle);  // Pass visualStyle to Element base constructor
    45	    this.name = name;
    46	    this.coordinates = coordinates;
    47	    this.projectionH = projectionH;
    48	    this.projectionV = projectionV;
    49	  }
    50	
    51	  realize3D(_world: World): Point3DRealization3D {
    52	    // Return fixed coordinates as realization
    53	    return new Point3DRealization3D(this.coordinates.clone());
    54	  }
    55	
    56	  getDependencies(): string[] {
    57	    return [];  // No dependencies - coordinates are fixed
    58	  }
    59	
    60	  clone(): Point3DByCoordinates {
    61	    return new Point3DByCoordinates(
    62	      this.id!,
    63	      this.name,
    64	      this.coordinates.clone(),
    65	      this.visualStyle ? { ...this.visualStyle } : createVisualStyle(),
    66	      this.projectionH,
    67	      this.projectionV
    68	    );
    69	  }
    70	}
    71	
    72	/**
    73	 * Point3DFromProjections - Point derived from two 2D projections
    74	 * User-created element (Phase 78)
    75	 * 
    76	 * Stores ONLY IDs of defining elements, no numeric data.
    77	 * realize3D() reconstructs 3D position from 2D projection coordinates.
    78	 */
    79	export class Point3DFromProjections extends Element3D {
    80	  readonly kind = 'Point3DFromProjections';
    81	  label: string;
    82	  
    83	  // Defining relations (ONLY IDs, no numeric data)
    84	  projection1: string;  // Point2D ID on first plane
    85	  projection2: string;  // Point2D ID on second plane (must be different)
    86	  plane1Id: string;     // Which plane projection1 is on
    87	  plane2Id: string;     // Which plane projection2 is on (must be different)
    88	
    89	  constructor(
    90	    id: string,
    91	    label: string,
    92	    projection1: string,
    93	    projection2: string,
    94	    plane1Id: string,
    95	    plane2Id: string,
    96	    visualStyle: VisualStyle
    97	  ) {
    98	    super(id, label, visualStyle);  // Pass label and visualStyle to Element base constructor
    99	    this.label = label;
   100	    this.projection1 = projection1;
   101	    this.projection2 = projection2;
   102	    this.plane1Id = plane1Id;
   103	    this.plane2Id = plane2Id;
   104	  }
   105	
   106	  realize3D(world: World): Point3DRealization3D {
   107	    try {
   108	      // 1. Get 2D projections and their planes
   109	      const plane1 = world.getProjectionPlaneById(this.plane1Id);
   110	      const plane2 = world.getProjectionPlaneById(this.plane2Id);
   111	      
   112	      if (!plane1 || !plane2) {
   113	        return new Point3DRealization3D(new Vector4(0, 0, 0, 1), false);
   114	      }
   115	
   116	      const proj1Element = plane1.getPoint(this.projection1);
   117	      const proj2Element = plane2.getPoint(this.projection2);
   118	      
   119	      if (!proj1Element || !proj2Element) {
   120	        return new Point3DRealization3D(new Vector4(0, 0, 0, 1), false);
   121	      }
   122	
   123	      // 2. Realize 2D projections to get coordinates
   124	      const proj1Realization = proj1Element.realize2D(world);
   125	      const proj2Realization = proj2Element.realize2D(world);
   126	
   127	      if (!proj1Realization.isFeasible() || !proj2Realization.isFeasible()) {
   128	        return new Point3DRealization3D(new Vector4(0, 0, 0, 1), false);
   129	      }
   130	
   131	      // 3. Get plane realizations for projection matrices
   132	      const plane1Real = world.getProjectionPlane3DRealization(this.plane1Id);
   133	      const plane2Real = world.getProjectionPlane3DRealization(this.plane2Id);
   134	
   135	      if (!plane1Real || !plane2Real) {
   136	        return new Point3DRealization3D(new Vector4(0, 0, 0, 1), false);
   137	      }
   138	
   139	      // 4. Reconstruct 3D point using shared utility
   140	      const result = reconstruct3DPointFromProjections(
   141	        proj1Realization.position,
   142	        proj2Realization.position,
   143	        plane1Real.threeDToPlane,
   144	        plane2Real.threeDToPlane
   145	      );
   146	
   147	      if (!result.feasible) {
   148	        return new Point3DRealization3D(new Vector4(0, 0, 0, 1), false);
   149	      }
   150	
   151	      return new Point3DRealization3D(result.point);
   152	    } catch (error) {
   153	      console.error('[Point3DFromProjections] realize3D failed:', error);
   154	      return new Point3DRealization3D(new Vector4(0, 0, 0, 1), false);
   155	    }
   156	  }
   157	
   158	  getDependencies(): string[] {
   159	    return [this.projection1, this.projection2, this.plane1Id, this.plane2Id];
   160	  }
   161	
   162	  clone(): Point3DFromProjections {
   163	    return new Point3DFromProjections(
   164	      this.id!,
   165	      this.label,
   166	      this.projection1,
   167	      this.projection2,
   168	      this.plane1Id,
   169	      this.plane2Id,
   170	      this.visualStyle ? { ...this.visualStyle } : createVisualStyle()
   171	    );
   172	  }
   173	
   174	  /**
   175	   * Validate that projections are on different planes
   176	   * Called during creation to enforce Phase 78 requirement
   177	   */
   178	  static validateDifferentPlanes(plane1Id: string, plane2Id: string): boolean {
   179	    return plane1Id !== plane2Id;
   180	  }
   181	
   182	  /**
   183	   * Validate geometric compatibility of projections
   184	   * (perpendicular to hinge line requirement)
   185	   * TODO: Implement proper validation in GeometryValidator
   186	   */
   187	  validateProjectionCompatibility(_world: World): boolean {
   188	    // Placeholder - will be implemented with GeometryValidator
   189	    return true;
   190	  }
   191	}
   192	
   193	/**
   194	 * Type union for all Point3D types
   195	 */
   196	export type Point3D = Point3DByCoordinates | Point3DFromProjections;
### frontend/src/domain/world/Line3D.ts
     1	/**
     2	 * Line3D - 3D line classes (domain layer - definitions)
     3	 * 
     4	 * Contains high-level definitions and relationships (IDs of source 2D elements).
     5	 * NO numeric coordinates - those are computed and stored in Line3DRealization3D.
     6	 * 
     7	 * Types:
     8	 * - HingeLine: System line representing fold between projection planes (Phase 84)
     9	 * - Line3DFromProjections: User-created line from two 2D line projections (Phase 78)
    10	 * 
    11	 * Architecture:
    12	 * - Element3D classes store WHAT the element is (definition/rules)
    13	 * - realize3D() computes numeric geometry → Line3DRealization3D
    14	 * - Lazy evaluation with caching in World.lineRealizations3D
    15	 * 
    16	 */
    17	import { Vector4 } from 'three';
    18	import { Element3D } from './Element3D';
    19	import { Line3DRealization3D } from './Element3DRealization3D';
    20	import type { World } from './World';
    21	import type { VisualStyle } from './VisualStyle';
    22	import { createVisualStyle } from './VisualStyle';
    23	
    24	/**
    25	 * Line3D - Abstract base class for all 3D line types
    26	 * 
    27	 * All 3D lines must implement realize3D() to compute their geometric realization.
    28	 * Subclasses store only defining relationships (IDs), never numeric coordinates.
    29	 */
    30	export abstract class Line3D extends Element3D {
    31	  /**
    32	   * Compute 3D geometric realization of this line
    33	   * @param world World instance for accessing related elements
    34	   * @returns Line3DRealization3D with point and direction in 3D space
    35	   */
    36	  abstract realize3D(world: World): Line3DRealization3D;
    37	}
    38	
    39	/**
    40	 * Line3DFromProjections - Line derived from two 2D line projections
    41	 * User-created element (Phase 78)
    42	 * 
    43	 * Stores ONLY IDs of defining elements, no numeric data.
    44	 * realize3D() reconstructs 3D line from 2D projection coordinates.
    45	 */
    46	export class Line3DFromProjections extends Line3D {
    47	  readonly kind = 'Line3DFromProjections';
    48	  label: string;
    49	  
    50	  // Defining relations (ONLY IDs, no numeric data)
    51	  projection1: string;  // Line2D ID on first plane
    52	  projection2: string;  // Line2D ID on second plane (must be different)
    53	  plane1Id: string;     // Which plane projection1 is on
    54	  plane2Id: string;     // Which plane projection2 is on (must be different)
    55	
    56	  constructor(
    57	    id: string,
    58	    label: string,
    59	    projection1: string,
    60	    projection2: string,
    61	    plane1Id: string,
    62	    plane2Id: string,
    63	    visualStyle: VisualStyle
    64	  ) {
    65	    super(id, label, visualStyle);  // Pass label and visualStyle to Element base constructor
    66	    this.label = label;
    67	    this.projection1 = projection1;
    68	    this.projection2 = projection2;
    69	    this.plane1Id = plane1Id;
    70	    this.plane2Id = plane2Id;
    71	  }
    72	
    73	  realize3D(world: World): Line3DRealization3D {
    74	    try {
    75	      // 1. Get 2D projections and their planes
    76	      const plane1 = world.getProjectionPlaneById(this.plane1Id);
    77	      const plane2 = world.getProjectionPlaneById(this.plane2Id);
    78	      
    79	      if (!plane1 || !plane2) {
    80	        return new Line3DRealization3D(
    81	          new Vector4(0, 0, 0, 1),
    82	          new Vector4(1, 0, 0, 0),
    83	          false
    84	        );
    85	      }
    86	
    87	      const line1Element = plane1.getLine(this.projection1);
    88	      const line2Element = plane2.getLine(this.projection2);
    89	      
    90	      if (!line1Element || !line2Element) {
    91	        return new Line3DRealization3D(
    92	          new Vector4(0, 0, 0, 1),
    93	          new Vector4(1, 0, 0, 0),
    94	          false
    95	        );
    96	      }
    97	
    98	      // 2. Realize 2D projections to get coordinates
    99	      const line1Real = line1Element.realize2D(world);
   100	      const line2Real = line2Element.realize2D(world);
   101	
   102	      if (!line1Real || !line2Real || !line1Real.isFeasible() || !line2Real.isFeasible()) {
   103	        return new Line3DRealization3D(
   104	          new Vector4(0, 0, 0, 1),
   105	          new Vector4(1, 0, 0, 0),
   106	          false
   107	        );
   108	      }
   109	
   110	      // 3. Reconstruct 3D line from two 2D projections
   111	      // Strategy: Each 2D line defines a 3D plane perpendicular to its projection plane
   112	      // The 3D line is the intersection of these two 3D planes
   113	      
   114	      console.log('[Line3DFromProjections] Reconstructing 3D line from projections:', {
   115	        line1Id: this.projection1,
   116	        line2Id: this.projection2,
   117	        plane1Id: this.plane1Id,
   118	        plane2Id: this.plane2Id
   119	      });
   120	
   121	      // Get plane realizations for transformations
   122	      const plane1Real = plane1.realize3D(world);
   123	      const plane2Real = plane2.realize3D(world);
   124	      
   125	      if (!plane1Real || !plane2Real) {
   126	        console.error('[Line3DFromProjections] Could not realize projection planes');
   127	        return new Line3DRealization3D(
   128	          new Vector4(0, 0, 0, 1),
   129	          new Vector4(1, 0, 0, 0),
   130	          false
   131	        );
   132	      }
   133	
   134	      // Get a point and direction from each 2D line
   135	      const p1_2d = line1Real.point1;  // Point on line 1 (in 2D plane coords)
   136	      const d1_2d = line1Real.getDirection();  // Direction of line 1
   137	      
   138	      const p2_2d = line2Real.point1;  // Point on line 2 (in 2D plane coords)
   139	      const d2_2d = line2Real.getDirection();  // Direction of line 2
   140	
   141	      console.log('[Line3DFromProjections] 2D line data:', {
   142	        line1: { point: [p1_2d.x, p1_2d.y], direction: [d1_2d.x, d1_2d.y] },
   143	        line2: { point: [p2_2d.x, p2_2d.y], direction: [d2_2d.x, d2_2d.y] }
   144	      });
   145	
   146	      // Lift 2D lines to 3D planes
   147	      // A 2D line (point + direction) in a projection plane defines a 3D plane
   148	      // The 3D plane contains all 3D points that project onto the 2D line
   149	      
   150	      // For plane 1: Get the 3D line direction by lifting the 2D line
   151	      // Matrix4x3 is stored row-major: [m11,m12,m13, m21,m22,m23, m31,m32,m33, m41,m42,m43]
   152	      // Row 1 (x): M[0]*u + M[1]*v + M[2]*w
   153	      // Row 2 (y): M[3]*u + M[4]*v + M[5]*w
   154	      // Row 3 (z): M[6]*u + M[7]*v + M[8]*w
   155	      // Row 4 (w): M[9]*u + M[10]*v + M[11]*w
   156	      const M1 = plane1Real.planeTo3D.elements;  // Matrix4x3 stored row-major
   157	      const P1_3d = new Vector4(
   158	        M1[0] * p1_2d.x + M1[1] * p1_2d.y + M1[2],
   159	        M1[3] * p1_2d.x + M1[4] * p1_2d.y + M1[5],
   160	        M1[6] * p1_2d.x + M1[7] * p1_2d.y + M1[8],
   161	        M1[9] * p1_2d.x + M1[10] * p1_2d.y + M1[11]
   162	      );
   163	      
   164	      const p1_plus_d1 = { x: p1_2d.x + d1_2d.x, y: p1_2d.y + d1_2d.y };
   165	      const P2_3d = new Vector4(
   166	        M1[0] * p1_plus_d1.x + M1[1] * p1_plus_d1.y + M1[2],
   167	        M1[3] * p1_plus_d1.x + M1[4] * p1_plus_d1.y + M1[5],
   168	        M1[6] * p1_plus_d1.x + M1[7] * p1_plus_d1.y + M1[8],
   169	        M1[9] * p1_plus_d1.x + M1[10] * p1_plus_d1.y + M1[11]
   170	      );
   171	      
   172	      // Direction of the 2D line lifted to 3D
   173	      const lineDir1_3d = new Vector4(
   174	        P2_3d.x - P1_3d.x,
   175	        P2_3d.y - P1_3d.y,
   176	        P2_3d.z - P1_3d.z,
   177	        0
   178	      );
   179	      
   180	      // To find the normal to the 3D plane containing this line:
   181	      // Extract the u-direction and v-direction from the projection plane matrix
   182	      // In homogeneous coordinates:
   183	      // - u-direction: what happens when u increases by 1 (keeping v=0, w=1)
   184	      // - v-direction: what happens when v increases by 1 (keeping u=0, w=1)
   185	      // Matrix is stored row-major: [m11,m12,m13, m21,m22,m23, m31,m32,m33, m41,m42,m43]
   186	      // u-dir = [m11, m21, m31, m41] (first column)
   187	      // v-dir = [m12, m22, m32, m42] (second column)
   188	      const uDir1 = new Vector4(M1[0], M1[3], M1[6], M1[9]);
   189	      const vDir1 = new Vector4(M1[1], M1[4], M1[7], M1[10]);
   190	      
   191	      // Perpendicular to projection plane = u × v
   192	      const projPlanePerp1 = new Vector4(
   193	        uDir1.y * vDir1.z - uDir1.z * vDir1.y,
   194	        uDir1.z * vDir1.x - uDir1.x * vDir1.z,
   195	        uDir1.x * vDir1.y - uDir1.y * vDir1.x,
   196	        0
   197	      );
   198	      
   199	      // Normal to the 3D plane = lineDir × projPlanePerp
   200	      const N1 = new Vector4(
   201	        lineDir1_3d.y * projPlanePerp1.z - lineDir1_3d.z * projPlanePerp1.y,
   202	        lineDir1_3d.z * projPlanePerp1.x - lineDir1_3d.x * projPlanePerp1.z,
   203	        lineDir1_3d.x * projPlanePerp1.y - lineDir1_3d.y * projPlanePerp1.x,
   204	        0
   205	      );
   206	      
   207	      console.log('[Line3DFromProjections] Plane 1 (3D):', {
   208	        point1: [P1_3d.x, P1_3d.y, P1_3d.z],
   209	        point2: [P2_3d.x, P2_3d.y, P2_3d.z],
   210	        lineDir: [lineDir1_3d.x, lineDir1_3d.y, lineDir1_3d.z],
   211	        uDir: [uDir1.x, uDir1.y, uDir1.z],
   212	        vDir: [vDir1.x, vDir1.y, vDir1.z],
   213	        projPlanePerp: [projPlanePerp1.x, projPlanePerp1.y, projPlanePerp1.z],
   214	        normal: [N1.x, N1.y, N1.z]
   215	      });
   216	
   217	      // Similarly for plane 2
   218	      const M2 = plane2Real.planeTo3D.elements;
   219	      const Q1_3d = new Vector4(
   220	        M2[0] * p2_2d.x + M2[1] * p2_2d.y + M2[2],
### frontend/src/domain/world/Segment3D.ts
     1	/**
     2	 * Segment3D - 3D segment classes (domain layer - definitions)
     3	 * 
     4	 * Contains high-level definitions and relationships (IDs of source 2D elements).
     5	 * NO numeric coordinates - those are computed and stored in Segment3DRealization3D.
     6	 * 
     7	 * Types:
     8	 * - Segment3DFromProjections: User-created segment from two 2D segment projections (Phase 78)
     9	 * 
    10	 * Architecture:
    11	 * - Element3D classes store WHAT the element is (definition/rules)
    12	 * - realize3D() computes numeric geometry → Segment3DRealization3D
    13	 * - Lazy evaluation with caching in World.segmentRealizations3D
    14	 * 
    15	 */
    16	import { Vector4 } from 'three';
    17	import { Element3D } from './Element3D';
    18	import { Segment3DRealization3D } from './Element3DRealization3D';
    19	import type { World } from './World';
    20	import type { VisualStyle } from './VisualStyle';
    21	import { createVisualStyle } from './VisualStyle';
    22	import { reconstruct3DPointFromProjections } from '@/utils/threeUtils';
    23	
    24	/**
    25	 * Segment3DFromProjections - Segment derived from two 2D segment projections
    26	 * User-created element (Phase 78)
    27	 * 
    28	 * Stores ONLY IDs of defining elements, no numeric data.
    29	 * realize3D() reconstructs 3D segment from 2D projection coordinates.
    30	 */
    31	export class Segment3DFromProjections extends Element3D {
    32	  readonly kind = 'Segment3DFromProjections';
    33	  label: string;
    34	  
    35	  // Defining relations (ONLY IDs, no numeric data)
    36	  projection1: string;  // Segment2D ID on first plane
    37	  projection2: string;  // Segment2D ID on second plane (must be different)
    38	  plane1Id: string;     // Which plane projection1 is on
    39	  plane2Id: string;     // Which plane projection2 is on (must be different)
    40	
    41	  constructor(
    42	    id: string,
    43	    label: string,
    44	    projection1: string,
    45	    projection2: string,
    46	    plane1Id: string,
    47	    plane2Id: string,
    48	    visualStyle: VisualStyle
    49	  ) {
    50	    super(id, label, visualStyle);  // Pass label and visualStyle to Element base constructor
    51	    this.label = label;
    52	    this.projection1 = projection1;
    53	    this.projection2 = projection2;
    54	    this.plane1Id = plane1Id;
    55	    this.plane2Id = plane2Id;
    56	  }
    57	
    58	  realize3D(world: World): Segment3DRealization3D {
    59	    try {
    60	      // 1. Get 2D projections and their planes
    61	      const plane1 = world.getProjectionPlaneById(this.plane1Id);
    62	      const plane2 = world.getProjectionPlaneById(this.plane2Id);
    63	      
    64	      if (!plane1 || !plane2) {
    65	        return new Segment3DRealization3D(
    66	          new Vector4(0, 0, 0, 1),
    67	          new Vector4(1, 0, 0, 1),
    68	          false
    69	        );
    70	      }
    71	
    72	      const seg1Element = plane1.getLine(this.projection1);  // Segments are stored as Line2D
    73	      const seg2Element = plane2.getLine(this.projection2);
    74	      
    75	      if (!seg1Element || !seg2Element) {
    76	        return new Segment3DRealization3D(
    77	          new Vector4(0, 0, 0, 1),
    78	          new Vector4(1, 0, 0, 1),
    79	          false
    80	        );
    81	      }
    82	
    83	      // 2. Realize 2D projections to get endpoint coordinates
    84	      const seg1Real = seg1Element.realize2D(world);
    85	      const seg2Real = seg2Element.realize2D(world);
    86	
    87	      if (!seg1Real || !seg2Real || !seg1Real.isFeasible() || !seg2Real.isFeasible()) {
    88	        return new Segment3DRealization3D(
    89	          new Vector4(0, 0, 0, 1),
    90	          new Vector4(1, 0, 0, 1),
    91	          false
    92	        );
    93	      }
    94	
    95	      // 3. Get plane 3D realizations for projection matrices
    96	      const plane1Real = world.getProjectionPlane3DRealization(this.plane1Id);
    97	      const plane2Real = world.getProjectionPlane3DRealization(this.plane2Id);
    98	
    99	      if (!plane1Real || !plane2Real) {
   100	        return new Segment3DRealization3D(
   101	          new Vector4(0, 0, 0, 1),
   102	          new Vector4(1, 0, 0, 1),
   103	          false
   104	        );
   105	      }
   106	
   107	      // 4. Get segment endpoints (point1 and point2 from Line2DRealization2D)
   108	      const p1_seg1 = seg1Real.point1;  // First endpoint of segment on plane1
   109	      const p2_seg1 = seg1Real.point2;  // Second endpoint of segment on plane1
   110	      const p1_seg2 = seg2Real.point1;  // First endpoint of segment on plane2
   111	      const p2_seg2 = seg2Real.point2;  // Second endpoint of segment on plane2
   112	
   113	      // 5. Try both possible endpoint pairings
   114	      // Pairing A: seg1.p1 ↔ seg2.p1, seg1.p2 ↔ seg2.p2
   115	      const pairA_start = reconstruct3DPointFromProjections(
   116	        p1_seg1, p1_seg2, plane1Real.threeDToPlane, plane2Real.threeDToPlane
   117	      );
   118	      const pairA_end = reconstruct3DPointFromProjections(
   119	        p2_seg1, p2_seg2, plane1Real.threeDToPlane, plane2Real.threeDToPlane
   120	      );
   121	      const pairA_valid = pairA_start.feasible && pairA_end.feasible;
   122	      const pairA_error = pairA_start.error + pairA_end.error;
   123	
   124	      // Pairing B: seg1.p1 ↔ seg2.p2, seg1.p2 ↔ seg2.p1
   125	      const pairB_start = reconstruct3DPointFromProjections(
   126	        p1_seg1, p2_seg2, plane1Real.threeDToPlane, plane2Real.threeDToPlane
   127	      );
   128	      const pairB_end = reconstruct3DPointFromProjections(
   129	        p2_seg1, p1_seg2, plane1Real.threeDToPlane, plane2Real.threeDToPlane
   130	      );
   131	      const pairB_valid = pairB_start.feasible && pairB_end.feasible;
   132	      const pairB_error = pairB_start.error + pairB_end.error;
   133	
   134	      // 6. Select valid pairing
   135	      if (pairA_valid && pairB_valid) {
   136	        // Both valid — use the one with smaller total error
   137	        if (pairA_error <= pairB_error) {
   138	          return new Segment3DRealization3D(pairA_start.point, pairA_end.point);
   139	        } else {
   140	          return new Segment3DRealization3D(pairB_start.point, pairB_end.point);
   141	        }
   142	      } else if (pairA_valid) {
   143	        return new Segment3DRealization3D(pairA_start.point, pairA_end.point);
   144	      } else if (pairB_valid) {
   145	        return new Segment3DRealization3D(pairB_start.point, pairB_end.point);
   146	      } else {
   147	        // Neither pairing is consistent — infeasible
   148	        return new Segment3DRealization3D(
   149	          new Vector4(0, 0, 0, 1),
   150	          new Vector4(1, 0, 0, 1),
   151	          false
   152	        );
   153	      }
   154	    } catch (error) {
   155	      console.error('[Segment3DFromProjections] realize3D failed:', error);
   156	      return new Segment3DRealization3D(
   157	        new Vector4(0, 0, 0, 1),
   158	        new Vector4(1, 0, 0, 1),
   159	        false
   160	      );
   161	    }
   162	  }
   163	
   164	  getDependencies(): string[] {
   165	    return [this.projection1, this.projection2, this.plane1Id, this.plane2Id];
   166	  }
   167	
   168	  clone(): Segment3DFromProjections {
   169	    return new Segment3DFromProjections(
   170	      this.id!,
   171	      this.label,
   172	      this.projection1,
   173	      this.projection2,
   174	      this.plane1Id,
   175	      this.plane2Id,
   176	      this.visualStyle ? { ...this.visualStyle } : createVisualStyle()
   177	    );
   178	  }
   179	
   180	  /**
   181	   * Validate that projections are on different planes
   182	   * Called during creation to enforce Phase 78 requirement
   183	   */
   184	  static validateDifferentPlanes(plane1Id: string, plane2Id: string): boolean {
   185	    return plane1Id !== plane2Id;
   186	  }
   187	}
   188	
   189	/**
   190	 * Type union for all Segment3D types
   191	 */
   192	export type Segment3D = Segment3DFromProjections;
### frontend/src/domain/world/Plane.ts
     1	/**
     2	 * Plane3D - 3D plane representation (abstract base)
     3	 * 
     4	 * Abstract base class for 3D planes. Concrete implementations provide
     5	 * specific construction rules:
     6	 * - Plane3DFixed: Hard-coded planes (P_H: z=0, P_V: y=0) for initialization
     7	 * - Plane3DByTraces: Computed from traces (future)
     8	 * 
     9	 * **Phase 52**: Refactored to extend Element3D, removing id and label properties
    10	 * which are now inherited from Element base class.
    11	 * 
    12	 * Per data-model.md §Plane3DByPointAndNormal:
    13	 * - Point on plane (P₀)
    14	 * - Normal vector (n)
    15	 * - Plane3D equation: n·(P - P₀) = 0
    16	 * 
    17	 */
    18	
    19	import { Vector3, Vector4 } from 'three';
    20	import { Element3D } from './Element3D';
    21	import { Plane3DRealization3D } from './Element3DRealization3D';
    22	import { applyMatrix4x3, crossVector3Homogeneous } from '@/utils/threeUtils';
    23	import { computeLineLineIntersection3D } from '@/utils/projectionPlaneUtils';
    24	
    25	export abstract class Plane3D extends Element3D {
    26	  /**
    27	   * Get plane equation [a, b, c, d] where ax + by + cz + d = 0
    28	   * Each concrete class computes this based on its representation
    29	   */
    30	  abstract getPlaneEquation(world: any): Vector4 | null;
    31	
    32	  /**
    33	   * Compute 3D realization (plane equation + rendering geometry)
    34	   * Uses getPlaneEquation() from concrete class
    35	   */
    36	  realize3D(world: any): Plane3DRealization3D {
    37	    const equation = this.getPlaneEquation(world);
    38	    
    39	    if (!equation) {
    40	      return Plane3DRealization3D.infeasible();
    41	    }
    42	    
    43	    const a = equation.x;
    44	    const b = equation.y;
    45	    const c = equation.z;
    46	    const d = equation.w;
    47	    
    48	    // Normal vector from plane equation
    49	    const normal = new Vector4(a, b, c, 0);
    50	    
    51	    // Compute origin point on the plane: P = -d * N (since |N| = 1)
    52	    const originPoint = new Vector4(-d * a, -d * b, -d * c, 1);
    53	    
    54	    // Compute quaternion for mesh orientation (aligns (0,0,1) with plane normal)
    55	    const defaultNormal = new Vector4(0, 0, 1, 0);
    56	    
    57	    // Compute rotation axis and angle using cross product and dot product
    58	    const axis = crossVector3Homogeneous(defaultNormal, normal);
    59	    const axisLength = Math.sqrt(axis.x * axis.x + axis.y * axis.y + axis.z * axis.z);
    60	    const dotProduct = defaultNormal.x * normal.x + defaultNormal.y * normal.y + defaultNormal.z * normal.z;
    61	    
    62	    let quaternion: Vector4;
    63	    if (axisLength < 1e-10) {
    64	      // Normals are parallel or anti-parallel
    65	      if (dotProduct > 0) {
    66	        // Same direction - no rotation needed
    67	        quaternion = new Vector4(0, 0, 0, 1);
    68	      } else {
    69	        // Opposite direction - 180° rotation around any perpendicular axis
    70	        const perpAxis = Math.abs(a) < 0.9 ? new Vector4(1, 0, 0, 0) : new Vector4(0, 1, 0, 0);
    71	        const rotAxis = crossVector3Homogeneous(perpAxis, normal).normalize();
    72	        quaternion = new Vector4(rotAxis.x, rotAxis.y, rotAxis.z, 0);
    73	      }
    74	    } else {
    75	      // General case - compute quaternion from axis-angle
    76	      const halfAngle = 0.5 * Math.atan2(axisLength, dotProduct);
    77	      const sinHalf = Math.sin(halfAngle);
    78	      const cosHalf = Math.cos(halfAngle);
    79	      axis.normalize();
    80	      quaternion = new Vector4(
    81	        axis.x * sinHalf,
    82	        axis.y * sinHalf,
    83	        axis.z * sinHalf,
    84	        cosHalf
    85	      );
    86	    }
    87	    
    88	    return new Plane3DRealization3D(equation, true, quaternion, originPoint);
    89	  }
    90	
    91	  /**
    92	   * Get dependencies - IDs of elements this plane depends on
    93	   * Fixed planes have no dependencies, trace-based planes depend on traces
    94	   * Inherited from Element3D
    95	   */
    96	  abstract getDependencies(): string[];
    97	
    98	  protected constructor(id: string, label?: string) {
    99	    super(id, label);
   100	  }
   101	
   102	  /**
   103	   * Clone this plane
   104	   * Subclasses must implement their own cloning logic
   105	   */
   106	  abstract clone(): Plane3D;
   107	}
   108	
   109	/**
   110	 * Plane3DFixed - Fixed 3D plane defined by point and normal
   111	 * 
   112	 * Represents a plane with fixed geometric definition (no dependencies).
   113	 * The plane is fully defined by a point on the plane and a normal vector.
   114	 * 
   115	 * **Phase 52**: Updated constructor to pass id as required parameter to parent,
   116	 * and implements getDependencies() from Element3D.
   117	 * 
   118	 * @remarks This class is typically used during world initialization but can
   119	 * represent any plane defined by point and normal without dependencies.
   120	 */
   121	export class Plane3DFixed extends Plane3D {
   122	  point: Vector4;      // Point on the plane (x, y, z, 1)
   123	  normal: Vector4;     // Normal vector (normalized) (x, y, z, 0)
   124	  
   125	  // Boundary properties for plane extent in u,v coordinates
   126	  minU: number = -400;
   127	  maxU: number = 400;
   128	  minV: number = -400;
   129	  maxV: number = 400;
   130	  
   131	  // Coordinate system for plane (u,v coordinates)
   132	  coordinateSystem?: {
   133	    origin: Vector4;
   134	    uAxis: Vector4;
   135	    vAxis: Vector4;
   136	  };
   137	
   138	  constructor(
   139	    id: string,
   140	    point: Vector4,
   141	    normal: Vector4,
   142	    label?: string
   143	  ) {
   144	    super(id, label);
   145	    this.point = point.clone();
   146	    this.normal = this.normalizeVector(normal);
   147	  }
   148	
   149	  private normalizeVector(v: Vector4): Vector4 {
   150	    const vec3 = new Vector3(v.x, v.y, v.z);
   151	    const length = vec3.length();
   152	    if (length === 0) {
   153	      throw new Error('Cannot normalize zero vector');
   154	    }
   155	    vec3.normalize();
   156	    return new Vector4(vec3.x, vec3.y, vec3.z, v.w);
   157	  }
   158	
   159	  getPlaneEquation(_world: any): Vector4 {
   160	    // Return plane equation: ax + by + cz + d = 0
   161	    // d = -normal · point
   162	    const d = -(this.normal.x * this.point.x + this.normal.y * this.point.y + this.normal.z * this.point.z);
   163	    return new Vector4(this.normal.x, this.normal.y, this.normal.z, d);
   164	  }
   165	
   166	  getDependencies(): string[] {
   167	    // Phase 52: Fixed planes have no dependencies
   168	    return [];
   169	  }
   170	  
   171	  /**
   172	   * Set boundary limits for plane extent in u,v coordinates
   173	   */
   174	  setBoundaries(minU: number, maxU: number, minV: number, maxV: number): void {
   175	    this.minU = minU;
   176	    this.maxU = maxU;
   177	    this.minV = minV;
   178	    this.maxV = maxV;
   179	  }
   180	  
   181	  /**
   182	   * Set coordinate system for plane (origin and u,v axes in 3D)
   183	   */
   184	  setCoordinateSystem(system: { origin: Vector4; uAxis: Vector4; vAxis: Vector4 }): void {
   185	    this.coordinateSystem = {
   186	      origin: system.origin.clone(),
   187	      uAxis: system.uAxis.clone(),
   188	      vAxis: system.vAxis.clone()
   189	    };
   190	  }
   191	  
   192	  /**
   193	   * Check if a point lies on this plane (within tolerance)
   194	   */
   195	  containsPoint(point: Vector4 | { x: number; y: number; z: number }, tolerance: number = 1e-6): boolean {
   196	    // Compute distance from point to plane: |n·(P - P₀)|
   197	    const px = point.x;
   198	    const py = point.y;
   199	    const pz = point.z;
   200	    
   201	    const distance = Math.abs(
   202	      this.normal.x * (px - this.point.x) +
   203	      this.normal.y * (py - this.point.y) +
   204	      this.normal.z * (pz - this.point.z)
   205	    );
   206	    
   207	    return distance <= tolerance;
   208	  }
   209	
   210	  clone(): Plane3D {
   211	    const cloned = new Plane3DFixed(
   212	      this.id,
   213	      this.point.clone(),
   214	      this.normal.clone(),
   215	      this.label
   216	    );
   217	    
   218	    // Copy boundaries
   219	    cloned.minU = this.minU;
   220	    cloned.maxU = this.maxU;
### frontend/src/domain/world/HingeLine.ts
     1	/**
     2	 * HingeLine - Intersection line shared by two projection planes
     3	 * 
     4	 * A hinge line represents the physical fold between two projection planes
     5	 * (e.g., HL_HV between P_H and P_V). It is NOT used for broken hinge lines (BHLs),
     6	 * which are intersections between arbitrary 3D planes.
     7	 * 
     8	 * The hinge line exists in 3D space and automatically realizes on both planes it connects.
     9	 * Each plane gets a HingeLineRealization2D (the 2D view of the hinge line on that plane).
    10	 * 
    11	 * **Phase 52**: Refactored to extend Element3D, removing id and label properties
    12	 * which are now inherited from Element base class. Replaces `name` with `label`.
    13	 * 
    14	 */
    15	
    16	import type { ProjectionElementRealizationContext } from './projectionPlane/ProjectionPlaneContext';
    17	import { Vector3 } from 'three';
    18	import { Line2D } from './Line';
    19	import { Line3D } from './Line3D';
    20	import { Line3DRealization3D } from './Element3DRealization3D';
    21	import { HalfHingeLineRealization2D } from './HalfHingeLineRealization2D';
    22	import { applyMatrix4x3, applyMatrix3x4 } from '@/utils/threeUtils';
    23	
    24	/**
    25	 * HalfHingeLine2D - 2D representation of a hinge line on a specific projection plane
    26	 * 
    27	 * Each HingeLine has exactly 2 HalfHingeLine2D objects (one per plane).
    28	 * This represents how the hinge line appears in the plane's (u,v) coordinate system.
    29	 * 
    30	 * **Phase 84**: NO geometry storage - computed on demand from canonical coordinates.
    31	 * Hinge line is ALWAYS at v=0 along u-axis in plane intrinsic coordinates.
    32	 * 
    33	 * Design: HalfHingeLine2D extends Line2D so it can be used with all line operations.
    34	 * It's a fixed line (cannot be deleted) that represents the fold between planes.
    35	 * Guides reference HalfHingeLine2D (not HingeLine) because guides are perpendicular
    36	 * to the 2D representation.
    37	 * 
    38	 */
    39	export class HalfHingeLine2D extends Line2D {
    40	  readonly hingeLineId: string;  // Parent HingeLine
    41	  // Phase 84: NO geometry storage - computed via realize2D()
    42	
    43	  constructor(
    44	    id: string,
    45	    hingeLineId: string,
    46	    planeId: string,
    47	    label?: string
    48	  ) {
    49	    // Create a friendly label like "HHL_{8}" from "projPlane3/line2d8"
    50	    // Extract the line number after 'line2d' (not the plane number)
    51	    const numericPart = id.match(/line2d(\d+)/)?.[1] || id.match(/\d+$/)?.[0] || id;
    52	    super(id, planeId, label || `HHL_{${numericPart}}`);
    53	    this.hingeLineId = hingeLineId;
    54	  }
    55	
    56	  clone(): HalfHingeLine2D {
    57	    return new HalfHingeLine2D(
    58	      this.id,
    59	      this.hingeLineId,
    60	      this.planeId,
    61	      this.label
    62	    );
    63	  }
    64	
    65	  /**
    66	   * Get dependencies for this half hinge line
    67	   * 
    68	   * Dependencies:
    69	   * - Parent HingeLine (for 3D realization)
    70	   * - Projection plane (for transformation matrix in realize2D)
    71	   * 
    72	   * Phase 85 FIX: Must include planeId because realize2D() for plane2 calls:
    73	   *   world.getProjectionPlane3DRealization(this.planeId)
    74	   * 
    75	   * When projection plane transforms change (e.g., auxiliary plane's trace lines move),
    76	   * this half hinge line's realization must be recomputed.
    77	   */
    78	  getDependencies(): string[] {
    79	    // Depend on both the parent HingeLine AND the projection plane
    80	    // The plane dependency is critical for plane2 half-hinge lines that project back
    81	    return [this.hingeLineId, this.planeId];
    82	  }
    83	
    84	  /**
    85	   * Find the sibling HalfHingeLine2D in the other plane.
    86	   * 
    87	   * Static method for navigating from one HalfHingeLine2D to its sibling
    88	   * in the paired projection plane. Used when creating sibling elements
    89	   * (guides, intersection points, etc.)
    90	   * 
    91	   * Navigation: HalfHingeLine2D → HingeLine → getOtherPlane() → find matching HHL
    92	   * 
    93	   * @param world World instance to navigate
    94	   * @param halfHingeLineId ID of the HalfHingeLine2D in the current plane
    95	   * @param currentPlaneId ID of the current plane
    96	   * @returns Object with siblingPlaneId and siblingHalfHingeLineId, or undefined if not a HHL
    97	   */
    98	  static getSiblingInfo(
    99	    world: ProjectionElementRealizationContext,
   100	    halfHingeLineId: string,
   101	    currentPlaneId: string
   102	  ): { siblingPlaneId: string; siblingHalfHingeLineId: string } | undefined {
   103	    // Get current plane and HalfHingeLine2D
   104	    const currentPlane = world.getProjectionPlaneById(currentPlaneId)!;
   105	    const halfHingeLine = currentPlane.getLine(halfHingeLineId);
   106	    
   107	    if (!halfHingeLine || !(halfHingeLine instanceof HalfHingeLine2D)) {
   108	      return undefined;
   109	    }
   110	
   111	    // Get parent HingeLine and sibling plane
   112	    const hingeLine = world.getHingeLineById(halfHingeLine.hingeLineId)!;
   113	    const siblingPlaneId = hingeLine.getOtherPlane(currentPlaneId)!;
   114	    const siblingPlane = world.getProjectionPlaneById(siblingPlaneId)!;
   115	
   116	    // Find HalfHingeLine2D with same hingeLineId in sibling plane
   117	    const siblingHalfHingeLine = siblingPlane.getAllLines().find(
   118	      (line): line is HalfHingeLine2D => line instanceof HalfHingeLine2D && line.hingeLineId === halfHingeLine.hingeLineId
   119	    )!;
   120	
   121	    return {
   122	      siblingPlaneId,
   123	      siblingHalfHingeLineId: siblingHalfHingeLine.id
   124	    };
   125	  }
   126	
   127	  /**
   128	   * Realize this half-hinge line using canonical coordinates (Phase 84)
   129	   * 
   130	   * Returns HalfHingeLineRealization2D with line geometry and guideVector.
   131	   * guideVector is PERPENDICULAR to the hinge line (for regular hinge lines).
   132	   * 
   133	   * **Phase 84 Architecture**:
   134	   * - Plane1: Returns canonical coordinates (0,0,1) and (1,0,0) directly
   135	   * - Plane2: Projects 3D line back to plane2 using applyMatrix3x4()
   136	   * 
   137	   * **Phase 101**: Returns HalfHingeLineRealization2D with guideVector
   138	   * - guideVector is perpendicular to hinge line direction
   139	   * - Guide2D uses this vector to create guides
   140	   * 
   141	   * @param world World instance for accessing HingeLine and plane realizations
   142	   */
   143	  realize2D(world: ProjectionElementRealizationContext): HalfHingeLineRealization2D {
   144	    const hingeLine = world.getHingeLineById(this.hingeLineId)!;
   145	
   146	    // Plane1: Return canonical coordinates directly
   147	    if (this.planeId === hingeLine.plane1Id) {
   148	      // Check feasibility of underlying Plane3D (if projection plane has one)
   149	      const projPlane1 = world.getProjectionPlaneById(hingeLine.plane1Id)!;
   150	      if (projPlane1.plane3DId) {
   151	        const plane3DReal = world.get3DPlaneRealization(projPlane1.plane3DId)!;
   152	        if (!plane3DReal.isFeasible()) {
   153	          // Return infeasible realization instead of throwing
   154	          return HalfHingeLineRealization2D.createInfeasible();
   155	        }
   156	      }
   157	
   158	      const hingeDirection = new Vector3(1, 0, 0);  // Canonical u-axis direction
   159	      const guideVector = new Vector3(0, 1, 0);     // Perpendicular (v-axis direction)
   160	
   161	      return new HalfHingeLineRealization2D(
   162	        new Vector3(0, 0, 1),    // Canonical origin
   163	        hingeDirection,           // Hinge line direction
   164	        guideVector,              // Perpendicular for guides
   165	        true                      // feasible
   166	      );
   167	    }
   168	
   169	    // Plane2: Project 3D line back to plane2
   170	    const line3D = hingeLine.realize3D(world);
   171	    const plane2Real = world.getProjectionPlane3DRealization(this.planeId)!;
   172	
   173	    // Check feasibility of 3D line (depends on plane1)
   174	    if (!line3D.isFeasible()) {
   175	      // Return infeasible realization instead of throwing
   176	      return HalfHingeLineRealization2D.createInfeasible();
   177	    }
   178	
   179	    const origin2D = applyMatrix3x4(line3D.point, plane2Real.threeDToPlane);
   180	    const direction2D = applyMatrix3x4(line3D.direction, plane2Real.threeDToPlane);
   181	    
   182	    // Compute perpendicular guide vector
   183	    const guideVector = new Vector3(-direction2D.y, direction2D.x, 0).normalize();
   184	    
   185	    return new HalfHingeLineRealization2D(
   186	      origin2D,
   187	      direction2D,
   188	      guideVector,
   189	      true  // feasible
   190	    );
   191	  }
   192	}
   193	
   194	/**
   195	 * HingeLine - Physical fold between two projection planes
   196	 * 
   197	 * The hinge line is a 3D element that automatically appears on both planes it connects.
