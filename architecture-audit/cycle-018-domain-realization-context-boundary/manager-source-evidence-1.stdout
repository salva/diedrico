     1	import type { ProjectionElementRealizationContext } from './projectionPlane/ProjectionPlaneContext';
     2	import { Point2DRealization2D } from './Point';
     3	import { Line2DRealization2D } from './Line';
     4	import { Circle2DRealization2D } from './Circle';
     5	import { validateElementId } from './ElementId';
     6	import { Element } from './Element';
     7	
     8	/**
     9	 * Union type for all possible 2D element realizations
    10	 */
    11	export type Element2DRealization = Point2DRealization2D | Line2DRealization2D | Circle2DRealization2D;
    12	
    13	/**
    14	 * Base class for all 2D geometric elements (points, lines, circles)
    15	 * 
    16	 * **Phase 44**: Originally introduced as standalone base class with id, planeId, label, visible, type properties.
    17	 * 
    18	 * **Phase 52 Refactoring**: Element2D now extends Element base class to share id and label properties
    19	 * with 3D elements. Element2D adds 2D-specific properties: planeId, visible, type.
    20	 * 
    21	 * **Architectural Principle: DRY and Uniform Interface**
    22	 * 
    23	 * Before Element2D (Phase 44), Point2D, Line2D, and Circle2D were three separate hierarchies
    24	 * with no common ancestor, despite sharing identical properties (id, planeId, label, visible).
    25	 * This caused:
    26	 * - Code duplication (same properties defined three times)
    27	 * - No uniform handling (couldn't write generic functions for all elements)
    28	 * - Inconsistent interfaces (each hierarchy evolved independently)
    29	 * 
    30	 * Element2D (Phase 44) provided:
    31	 * - Common properties: id, planeId, label, visible, type
    32	 * - Abstract methods: clone(), realize2D()
    33	 * - Uniform type guard: isElement2D() works for all types
    34	 * - Generic processing: Functions can work with Element2D regardless of specific type
    35	 * 
    36	 * Element2D (Phase 52) now extends Element:
    37	 * - Inherits id and label from Element base class
    38	 * - Adds 2D-specific properties: planeId, visible, type
    39	 * - Enables uniform handling with 3D elements via Element base type
    40	 * 
    41	 * **Usage**:
    42	 * ```typescript
    43	 * // Type guard works for all 2D elements
    44	 * function isElement2D(obj: any): obj is Element2D {
    45	 *   return obj instanceof Element2D;
    46	 * }
    47	 * 
    48	 * // Generic functions for 2D elements
    49	 * function hideElement(element: Element2D, world: World): void {
    50	 *   // Use resolveVisibility or modify visualStyle
    51	 * }
    52	 * 
    53	 * // Filter by plane
    54	 * function getElementsOnPlane(planeId: string, elements: Element2D[]): Element2D[] {
    55	 *   return elements.filter(el => el.planeId === planeId);
    56	 * }
    57	 * 
    58	 * // Generic functions for all elements (2D and 3D)
    59	 * function getElementLabel(element: Element): string {
    60	 *   return element.label || element.id;
    61	 * }
    62	 * ```
    63	 * 
    64	 * @sealed - Cannot be directly subclassed, only Point2D/Line2D/Circle2D extend it
    65	 */
    66	export abstract class Element2D extends Element {
    67	  /** Which projection plane this element belongs to */
    68	  readonly planeId: string;
    69	  
    70	  /**
    71	   * Construct a 2D element
    72	   * 
    73	   * @param id Element ID in hierarchical format: '{planeId}/{localId}' (e.g., 'proj_plane_1/point2d_5')
    74	   *           This ID must be generated by the containing plane's factory methods or ID generators.
    75	   *           NEVER pass hardcoded non-hierarchical IDs like 'p1' or 'point2d_5' - they will fail validation.
    76	   * @param planeId ID of the projection plane that contains this element
    77	   * @param label Optional user-friendly label for UI display
    78	   */
    79	  constructor(
    80	    id: string,
    81	    planeId: string,
    82	    label?: string
    83	  ) {
    84	    // Phase 52: Call Element base constructor with id and label
    85	    super(id, label);
    86	    
    87	    // Phase 45: Validate hierarchical ID format
    88	    // Ensure element ID starts with its container plane ID
    89	    // Throws error if ID doesn't match format '{planeId}/{localId}'
    90	    validateElementId(id, planeId);
    91	    
    92	    this.planeId = planeId;
    93	  }
    94	  
    95	  /**
    96	   * Clone this element
    97	   * Must be implemented by concrete subclasses
    98	   */
    99	  abstract clone(): Element2D;
   100	  
   101	  /**
   102	   * Calculate 2D realization (geometric position/shape) for this element
   103	   * Returns realization in the projection plane's intrinsic coordinates
   104	   * 
   105	   * @param world World instance to query parent element realizations
   106	   * @returns Element realization or null if computation fails
   107	   */
   108	  abstract realize2D(context: ProjectionElementRealizationContext): Element2DRealization | null;
   109	}
   110	
   111	/**
   112	 * Type guard to check if an object is an Element2D
   113	 * 
   114	 * @param obj Object to check
   115	 * @returns true if obj is an Element2D (Point2D, Line2D, or Circle2D), false otherwise
   116	 */
   117	export function isElement2D(obj: any): obj is Element2D {
   118	  return obj instanceof Element2D;
   119	}
   120	/**
   121	 * Point2D - Geometric point in 2D projection plane
   122	 * 
   123	 * Points are the fundamental building blocks of the dihedral system.
   124	 * This class represents the DEFINITION/RULE of a point, not its coordinates.
   125	 * Actual coordinates are stored in Point2DRealization2D objects.
   126	 * 
   127	 * Two types of 2D points:
   128	 * - Free points: defined by their position inside the projection plane
   129	 * - Intersection points: defined as intersection of two objects, with index for multiple intersections
   130	 * 
   131	 * Design principles:
   132	 * - Principle V: Coordinates computed and cached in realizations
   133	 * 
   134	 */
   135	
   136	import { Vector3, Vector4 } from 'three';
   137	import type { ProjectionElementRealizationContext } from './projectionPlane/ProjectionPlaneContext';
   138	import { intersectLineLine, intersectLineCircle, intersectCircleCircle } from '@/domain/calculations/Intersections';
   139	import { Element2DRealization2D } from './Element2DRealization2D';
   140	import { Element2D } from './Element2D';
   141	import { BrokenHalfHingeLine2D } from './elements/BrokenHalfHingeLine2D';
   142	import { applyMatrix4x3, applyMatrix3x4 } from '@/utils/threeUtils';
   143	import { assert } from '@/utils/assert';
   144	
   145	export const POINT_2D_TYPE = {
   146	  FREE: 'free',
   147	  INTERSECTION: 'intersection',  // Kept temporarily for backward compatibility
   148	  LINE_LINE_INTERSECTION: 'line-line-intersection',
   149	  LINE_CIRCLE_INTERSECTION: 'line-circle-intersection',
   150	  CIRCLE_CIRCLE_INTERSECTION: 'circle-circle-intersection',
   151	  SIBLING_INTERSECTION: 'sibling-intersection',
   152	} as const;
   153	export type Point2DType = typeof POINT_2D_TYPE[keyof typeof POINT_2D_TYPE];
   154	
   155	/**
   156	 * Point2DRealization2D - Stores computed 2D position for a Point2D
   157	 * 
   158	 * @sealed - This class must not be subclassed
   159	 * 
   160	 * Architectural principle: Realization classes contain ONLY geometric data.
   161	 * All behavioral differences belong in domain classes (FreePoint2D, Point2DLineLineIntersection,
   162	 * etc.), not in realization classes. Type distinction happens at domain level, not realization level.
   163	 * 
   164	 * Contains ONLY numeric data. Structural information (id, planeId) stays in domain objects.
   165	 */
   166	export class Point2DRealization2D extends Element2DRealization2D {
   167	  position: Vector3;  // Position in plane coordinates (u, v, 1) - ONLY NUMERIC DATA
   168	
   169	  constructor(position: Vector3, feasible: boolean = true) {
   170	    super(feasible);
   171	    this.position = position;
   172	  }
   173	
   174	  /**
   175	   * Get position as Vector3
   176	   */
   177	  getPosition(): Vector3 {
   178	    return this.position;
   179	  }
   180	}
   181	
   182	/**
   183	 * Point3DRealization3D - Stores computed 3D position for a point
   184	 * Reconstructed from 2D projections or defined directly in 3D space.
   185	 * Contains ONLY numeric data. Structural information (id) stays in domain objects.
   186	 */
   187	export class Point3DRealization3D {
   188	  position: Vector4;  // Position in 3D space (x, y, z, 1) - ONLY NUMERIC DATA
   189	  feasible: boolean;  // Whether the geometric computation succeeded
   190	
   191	  constructor(position: Vector4, feasible: boolean = true) {
   192	    this.position = position;
   193	    this.feasible = feasible;
   194	  }
   195	
   196	  /**
   197	   * Get position as Vector4
   198	   */
   199	  getPosition(): Vector4 {
   200	    return this.position;
   201	  }
   202	}
   203	
   204	/**
   205	 * Base Point2D class - represents the rule/definition of a point
   206	 * Extends Element2D to provide common properties and interface for all 2D elements
   207	 */
   208	export abstract class Point2D extends Element2D {
   209	  constructor(
   210	    id: string,
   211	    planeId: string,
   212	    label?: string
   213	  ) {
   214	    super(id, planeId, label);
   215	  }
   216	
   217	  /**
   218	   * Clone this point
   219	   */
   220	  abstract clone(): Point2D;
   221	
   222	  /**
   223	   * Calculate the 2D realization (position) for this point
   224	   * Returns position in the projection plane's intrinsic coordinates
   225	   * 
   226	   * @param world World instance to query parent realizations
   227	   */
   228	  abstract realize2D(world: ProjectionElementRealizationContext): Point2DRealization2D;
   229	}
   230	
   231	/**
   232	 * Free Point2D - defined by its position inside the projection plane
   233	 * The rule is: "user placed it at this position"
   234	 */
   235	export class FreePoint2D extends Point2D {
   236	  readonly position: Vector3;  // The defining position in plane coordinates (u, v, 1) - IMMUTABLE RULE
   237	  locked?: boolean;  // If true, point cannot be moved or deleted
   238	
   239	  constructor(
   240	    id: string,
   241	    position: Vector3,
   242	    planeId: string,
   243	    label?: string
   244	  ) {
   245	    super(id, planeId, label);
   246	    this.position = position;
   247	    this.locked = false;
   248	  }
   249	
   250	  clone(): FreePoint2D {
   251	    const cloned = new FreePoint2D(
   252	      this.id,
   253	      this.position.clone(),
   254	      this.planeId,
   255	      this.label
   256	    );
   257	    if (this.locked !== undefined) {
   258	      cloned.locked = this.locked;
   259	    }
   260	    return cloned;
