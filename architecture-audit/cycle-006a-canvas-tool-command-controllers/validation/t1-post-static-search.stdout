### Quick3DSegmentTool.ts
0001: /**
0002:  * Quick3DSegmentTool - Automatic 3D segment creation using geometrically constrained construction
0003:  * 
0004:  * Creates a complete 3D segment using the correct dihedral geometry construction:
0005:  * 1. Create line projections L_H and L_V (the containing line on each plane)
0006:  * 2. Use guides perpendicular to the hinge line through the P_H endpoints
0007:  * 3. Find intersection of sibling guides with L_V → constrained P_V endpoints
0008:  * 4. Create segments on both planes and the 3D segment
0009:  * 
0010:  * Coordinates:
0011:  * - P_H line/segment endpoints: (2, 3) and (8, 7)
0012:  * - P_V line definition points: (2, 4) and (8, 6)
0013:  * - P_V segment endpoints: intersection of sibling guides with L_V (constrained)
0014:  * - 3D segment: From approximately (2, 3, 4) to (8, 7, 6)
0015:  * 
0016:  * Constraint mechanism:
0017:  * - The guide on P_H at x=u creates a sibling guide on P_V also at x=u
0018:  * - The sibling guide intersects L_V, giving a constrained point on P_V
0019:  * - Moving a P_H point moves its guide → moves sibling → moves P_V intersection
0020:  * - The 3D segment stays feasible because correspondence is enforced by guides
0021:  * 
0022:  * Pattern: Same as Quick3DLineTool (Phase 105) — immediate execution
0023:  * Related: Create3DSegmentTool (interactive, user selects existing segments)
0024:  * 
0025:  * Phase 109
0026:  */
0027: 
0028: import type { ITool, ToolContext, ToolResult } from './ITool';
0029: import type { SelectionMask } from '@/types/SelectionMask';
0030: import { Command } from '@/commands/Command';
0031: import { Vector3 } from 'three';
0032: import { PointSequenceFactory } from '@/commands/factories/PointSequenceFactory';
0033: import { LineSequenceFactory } from '@/commands/factories/LineSequenceFactory';
0034: import { GuideSequenceFactory } from '@/commands/factories/GuideSequenceFactory';
0035: import { IntersectionSequenceFactory } from '@/commands/factories/IntersectionSequenceFactory';
0036: import { AddSegment2DByPointsOp } from '@/commands/operations/world/AddSegmentOp';
0037: import { Add3DSegmentOp } from '@/commands/operations/world/Add3DSegmentOp';
0038: import { createAdd3DSegmentAction } from '@/domain/processTree/actions/Element3DActions';
0039: import { createSegmentAction } from '@/domain/processTree/actions/CreateSegmentAction';

