### ArgumentCollectorTool.ts
0001: /**
0002:  * ArgumentCollectorTool.ts - Base class for multi-argument tool construction (Phase 64)
0003:  * 
0004:  * Provides automated argument collection workflow for tools that need multiple geometric elements.
0005:  * Subclasses declare argument specifications; base class handles collection, validation, and UI feedback.
0006:  * 
0007:  * Key Features:
0008:  * - Any-order collection: Users can select arguments in any sequence
0009:  * - Automatic viable set tracking: Framework prunes incompatible argument sets as arguments are collected
0010:  * - Dynamic selection masks: Computed as union of all viable next arguments
0011:  * - Automatic UI feedback: Status messages show progress and next expected arguments
0012:  * - Three-layer validation: Type (SelectionMask), argument-level (validator), set-level (setValidator)
0013:  * - Automatic execution: Emits construction intent when exactly one complete set is found
0014:  * 
0015:  * Usage Pattern:
0016:  * ```typescript
0017:  * class CircleTool extends ArgumentCollectorTool {
0018:  *   readonly name = 'circle';
0019:  *   
0020:  *   getArgumentSets(): ToolArgumentSet[] {
0021:  *     return [{
0022:  *       arguments: [
0023:  *         { name: 'center', mask: SelectionMask.point() },
0024:  *         { name: 'circumferencePoint', mask: SelectionMask.point() }
0025:  *       ]
0026:  *     }];
0027:  *   }
0028:  *   
0029:  *   execute(setIndex: number, args: Map<string, Element2D>): ToolResult {
0030:  *     const center = args.get('center') as Point2D;
0031:  *     const circum = args.get('circumferencePoint') as Point2D;
0032:  *     // Create circle...
0033:  *   }
0034:  * }
0035:  * ```
0036:  * 
0037:  * Reference: data-model.md §Tool Argument Collection Framework (Phase 64)
0038:  */
0039: 
0055:  * - getArgumentSets(): Define all possible argument combinations (mutually exclusive)
0070:   private viableSets: number[] = []; // Indices into getArgumentSets()
0087:   protected abstract getArgumentSets(): ToolArgumentSet[];
0094:   protected buildConstructionIntent(
0116:    * @param setIndex - Index of the completed argument set in getArgumentSets()
0127:       this.buildConstructionIntent(args, context)
0160:       const argumentSets = this.getArgumentSets();
0222:       const argumentSets = this.getArgumentSets();
0261:       const argumentSets = this.getArgumentSets();
0293:     const argumentSets = this.getArgumentSets();
0370:     const argumentSets = this.getArgumentSets();
0428:     const argumentSets = this.getArgumentSets();
0477:     const argumentSets = this.getArgumentSets();
0502:     const argumentSets = this.getArgumentSets();

### BaseTool.ts
0001: /**
0002:  * BaseTool - Abstract base class for tools with common functionality
0003:  * 
0004:  * Provides helper methods for:
0005:  * - Completion behavior (stay-active vs return-to-selection)
0006:  * 
0007:  * Subclasses override handleClick() to implement specific tool behavior.
0008:  * Subclasses must declare completionBehavior to control post-operation behavior.
0009:  * 
0010:  * Reference: specs/001-dihedral-learning-mvp/data-model.md - Phase 67
0011:  */
0012: 
0013: import type { ToolContext, ToolResult } from './ITool';
0014: import type { useToolStore } from '@/stores/toolStore';
0015: 
0016: export abstract class BaseTool {
0017:   abstract readonly name: string;
0018: 
0019:   /**
0020:    * Completion behavior: what happens after tool completes its operation
0021:    * - 'stay-active': Tool remains active for repeated use (primitives: Point, Line, Segment, Circle)
0022:    * - 'return-to-selection': Tool deactivates to selection mode (complex: Tangent, Intersection, etc.)
0023:    */
0024:   abstract readonly completionBehavior: 'stay-active' | 'return-to-selection';
0025: 
0026:   /**
0027:    * Abstract method: subclasses implement specific tool behavior
0028:    */
0029:   abstract handleClick(context: ToolContext): ToolResult;
0030: 
0031:   /**
0032:    * Handle tool completion: switch tool or stay active based on completionBehavior
0033:    * Should be called after successful operation, before returning success result
0034:    * 
0035:    * @param toolStore Tool store for switching active tool
0036:    */
0037:   protected handleCompletion(toolStore: ReturnType<typeof useToolStore>): void {
0038:     if (this.completionBehavior === 'return-to-selection') {
0039:       toolStore.setTool('select');

