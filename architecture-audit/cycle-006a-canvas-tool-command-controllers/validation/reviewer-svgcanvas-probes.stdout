}>({
  active: false,
  startX: 0,
  startY: 0
});

let ignoreNextClick = false;

function isMovableFreePoint(point: any): point is FreePoint2D {
  return point instanceof FreePoint2D && !point.locked;
}

function endPointDrag(commit: boolean): void {
  if (!pointDrag.value.active) return;

  const moveSession = pointDrag.value.moveSession;

  try {
    if (moveSession) {
      if (commit) {
        const result = moveSession.commit();
        if (!result.success) console.error('[SvgCanvas] Point move commit failed:', result.message);
      } else {
        moveSession.cancel();
      }
    }
  } finally {
    pointDrag.value = {
      active: false,
      planeId: null,
      pointId: null,
      moveSession: null,
      startClientX: 0,
      startClientY: 0,
      moved: false
    };
