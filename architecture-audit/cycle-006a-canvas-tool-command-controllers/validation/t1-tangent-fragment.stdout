0001: /**
0002:  * TangentLineToCircleThroughPointTool - Tangent lines to circle through point (ArgumentCollectorTool Migration)
0003:  * 
0004:  * Migrated to ArgumentCollectorTool framework.
0005:  * 
0006:  * Two-argument workflow with automatic angle-based indexing:
0007:  * 1. Collect circle and external point (any order)
0008:  * 2. Determine tangent index based on mouse position angle
0009:  * 3. Create tangent line
0010:  * 
0011:  * Code reduction: ~276 lines → ~190 lines (31% reduction)
0012:  * 
0013:  * Reference: specs/001-dihedral-learning-mvp/spec.md §FR-045
0014:  */
0015: 
0016: import { ArgumentCollectorTool } from './ArgumentCollectorTool';
0017: import type { ToolArgumentSet, CollectionContext } from '@/types/ToolArgumentCollector';
0018: import { SelectionMask } from '@/types/SelectionMask';
0019: 
0020: /**
0021:  * TangentLineToCircleThroughPointTool using ArgumentCollectorTool framework
0022:  * 
0023:  * Framework handles:
0024:  * - Any-order argument collection (circle + point)
0025:  * - Selection mask computation
0026:  * - UI feedback
0027:  * - Automatic execution when both elements collected
0028:  * 
0029:  * Custom behavior:
0030:  * - Determines tangent index based on mouse position (which of 2 tangents is closer)
0031:  */
0032: export class TangentLineToCircleThroughPointTool extends ArgumentCollectorTool {
0033:   readonly name = 'tangent-line-to-circle-through-point';
0034:   readonly completionBehavior = 'stay-active' as const;
0035: 
0036:   /**
0037:    * Define argument specification
0038:    * Single set with circle and point
0039:    */
0040:   protected getArgumentSets(): ToolArgumentSet[] {
0041:     return [
0042:       {
0043:         arguments: [
0044:           { 
0045:             name: 'circle', 
0046:             mask: SelectionMask.circle()
0047:           },
0048:           { 
0049:             name: 'throughPoint', 
0050:             mask: SelectionMask.point()
0051:           }
0052:         ],
0053:         // Phase 113: Validate point is outside or on the circle
0054:         setValidator: (args, context: CollectionContext) => {
0055:           const circleEl = args.get('circle')?.element;
0056:           const pointEl = args.get('throughPoint')?.element;
0057:           if (circleEl && pointEl) {
0058:             const circleRealization = context.world.getCircle2D(circleEl.id)?.realize2D(context.world);
0059:             const pointRealization = context.world.getPoint2D(pointEl.id)?.realize2D(context.world);
0060:             if (circleRealization && circleRealization.feasible && pointRealization && pointRealization.feasible) {
0061:               const dist = pointRealization.position.distanceTo(circleRealization.center);
0062:               const radius = circleRealization.getRadius();
0063:               if (dist < radius - 1e-3) {
0064:                 return { valid: false, error: 'Cannot create tangent: point is inside the circle' };
0065:               }
0066:             }
0067:           }
0068:           return { valid: true };
0069:         }
0070:       }
0071:     ];
0072:   }
0073: 
0074:   /**
0075:    * Execute tangent line creation operations
0076:    * Uses mouse position from second click to determine which tangent to create
0077:    */
0078: 
0079: 
0080:   protected getCommandDescription(): string {
0081:     return "Create tangent line to circle through point";
0082:   }
0083: 
0084:   /**
0085:    * Determine which tangent line to create based on mouse position
0086:    * Returns 0 or 1 for the tangent point closest to mouse
0087:    */
0088: 
0089: 
0090:   /**
0091:    * Compute angular distance between two angles (always positive, in [0, π])
0092:    */
0093:   private angularDistance(angle1: number, angle2: number): number {
0094:     let diff = Math.abs(angle1 - angle2);
0095:     if (diff > Math.PI) {
0096:       diff = 2 * Math.PI - diff;
0097:     }
0098:     return diff;
0099:   }
0100: }
