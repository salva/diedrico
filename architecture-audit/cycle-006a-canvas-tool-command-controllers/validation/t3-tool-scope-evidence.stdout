528: // Watch for tool changes and create new tool instance
529: // This prevents state leakage by creating fresh instances instead of reusing singletons
530: watch(() => toolStore.currentTool.value, (newTool) => {
531:   const factory = toolFactories[newTool];
532:   if (factory) {
533:     currentToolInstance.value = factory();
534:     console.log(`[SvgCanvas] Created new tool instance: ${newTool}`);
535:     // Show initial tool feedback (e.g. "Creating line: pick point1, point2")
536:     if (currentToolInstance.value && 'getStatusMessage' in currentToolInstance.value) {
537:       const msg = (currentToolInstance.value as any).getStatusMessage();
538:       if (msg) toolStore.setToolStepMessage(msg);
539:     }
540:   } else {
541:     currentToolInstance.value = null;
542:     if (newTool !== 'select') {
543:       console.warn(`[SvgCanvas] No tool factory for: ${newTool}`);
