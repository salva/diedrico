0903:   // Helper: Find where grid line with constant v intersects a horizontal line (y_paper = constant)
0904:   // Returns screen x position
0905:   const findVLineIntersectionWithHorizontal = (v: number, y_paper: number): number | null => {
0906:     // Line: origin_paper + u*u_paper + v*v_paper
0907:     // Want: origin_paper.y + u*u_paper.y + v*v_paper.y = y_paper
0908:     // Solve for u: u = (y_paper - origin_paper.y - v*v_paper.y) / u_paper.y
0909:     if (Math.abs(u_paper.y) < 1e-10) return null; // Grid line parallel to horizontal
0910:     const u = (y_paper - origin_paper.y - v * v_paper.y) / u_paper.y;
0911:     const x_paper = origin_paper.x + u * u_paper.x + v * v_paper.x;
0912:     return (x_paper + viewport.value.panX) * zoom;
0913:   };
0914:   
0915:   // Helper: Find where grid line with constant u intersects a vertical line (x_paper = constant)
0916:   // Returns screen y position
0917:   const findULineIntersectionWithVertical = (u: number, x_paper: number): number | null => {
0918:     // Line: origin_paper + u*u_paper + v*v_paper
0919:     // Want: origin_paper.x + u*u_paper.x + v*v_paper.x = x_paper
0920:     // Solve for v: v = (x_paper - origin_paper.x - u*u_paper.x) / v_paper.x
0921:     if (Math.abs(v_paper.x) < 1e-10) return null; // Grid line parallel to vertical
0922:     const v = (x_paper - origin_paper.x - u * u_paper.x) / v_paper.x;
0923:     const y_paper = origin_paper.y + u * u_paper.y + v * v_paper.y;
0924:     return (y_paper + viewport.value.panY) * zoom;
0925:   };
0926:   
