
--- 1440-1470 ---
1440: function handleSaveProperties(changes: any) {
1441:   console.log('[SvgCanvas] Saving property changes:', changes);
1442:   
1443:   // Create command using base Command + Operation pattern per data-model.md
1444:   const cmd = new Command(`Update style: ${changes.elementId}`, world);
1445:   
1446:   try {
1447:     // Create and execute style update operation
1448:     const styleOp = new UpdateElementStyleOp(
1449:       changes.elementId,
1450:       activePlane.value, // TODO: Get actual planeId from element
1451:       {
1452:         color: changes.color,
1453:         lineWidth: changes.lineWidth,
1454:         lineStyle: changes.lineStyle,
1455:         opacity: changes.opacity,
1456:         visible: changes.visible
1457:       }
1458:     );
1459:     
1460:     cmd.addAndExecute(styleOp);
1461:     cmd.commit();
1462:     commandStack.push(cmd);
1463:     
1464:     // Trigger reactivity
1465:     renderTick.value++;
1466:     console.log('[SvgCanvas] Style updated and command added to stack');
1467:   } catch (error) {
1468:     console.error('[SvgCanvas] Style update failed:', error);
1469:     cmd.rollback();
1470:   }

