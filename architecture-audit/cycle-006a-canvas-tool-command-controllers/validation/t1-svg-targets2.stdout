0931:     // Want: origin_paper.x + u*u_paper.x + v*v_paper.x = x_paper
0932:     // Solve for u: u = (x_paper - origin_paper.x - v*v_paper.x) / u_paper.x
0933:     if (Math.abs(u_paper.x) < 1e-10) return null; // Grid line parallel to vertical
