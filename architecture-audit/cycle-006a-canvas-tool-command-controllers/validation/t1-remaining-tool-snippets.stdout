### TangentLineToCircleParallelToLineTool.ts
0001: /**
0002:  * TangentLineToCircleParallelToLineTool - Tangent to circle parallel to line (ArgumentCollectorTool Migration)
0003:  * 
0004:  * Migrated to ArgumentCollectorTool framework.
0005:  * 
0006:  * Two-argument workflow with automatic angle-based indexing:
0007:  * 1. Collect circle and reference line (any order)
0008:  * 2. Determine tangent index based on mouse position
0009:  * 3. Create tangent line parallel to reference
0010:  * 
0011:  * Code reduction: ~282 lines → ~190 lines (33% reduction)
0012:  * 
0013:  * Reference: specs/001-dihedral-learning-mvp/spec.md §FR-046, §FR-047
0014:  */
0015: 
0016: import { Vector3 } from 'three';
0017: import { ArgumentCollectorTool } from './ArgumentCollectorTool';
0018: import type { ToolArgumentSet, CollectionContext } from '@/types/ToolArgumentCollector';
0019: import { SelectionMask } from '@/types/SelectionMask';
0020: import { Line2D } from '@/domain/world/Line';
0021: 
0022: /**
0023:  * TangentLineToCircleParallelToLineTool using ArgumentCollectorTool framework
0024:  * 
0025:  * Framework handles:
0026:  * - Any-order argument collection (circle + line)
0027:  * - Selection mask computation (circle + anyLine)
0028:  * - UI feedback
0029:  * - Automatic execution when both elements collected
0030:  * 
0031:  * Custom behavior:
0032:  * - Determines tangent index based on mouse position (which of 2 tangents is closer)
0033:  * - Accepts any Line2D subtype as reference (line, segment, guide, half-hinge-line)
0034:  */
0035: export class TangentLineToCircleParallelToLineTool extends ArgumentCollectorTool {
0036:   readonly name = 'tangent-line-to-circle-parallel';
0037:   readonly completionBehavior = 'stay-active' as const;
0038: 
0039:   /**
0040:    * Define argument specification
0041:    * Single set with circle and any line type
0042:    */
0043:   protected getArgumentSets(): ToolArgumentSet[] {
0044:     return [
0045:       {
0046:         arguments: [
0047:           { 
0048:             name: 'circle', 
0049:             mask: SelectionMask.circle()
0050:           },
0051:           { 
0052:             name: 'referenceLine', 
0053:             mask: SelectionMask.anyLine()  // Accepts all Line2D subtypes
0054:           }
0055:         ],
0056:         // Phase 113: Validate reference line is feasible
0057:         setValidator: (args, context: CollectionContext) => {
0058:           const refLine = args.get('referenceLine')?.element as Line2D | undefined;
0059:           if (refLine) {
0060:             const realization = refLine.realize2D(context.world);
0061:             if (realization && !realization.feasible) {
0062:               return { valid: false, error: 'Cannot create tangent: reference line is infeasible' };
0063:             }
0064:           }
0065:           return { valid: true };
0066:         }
0067:       }
0068:     ];
0069:   }
0070: 
0071:   /**
0072:    * Execute tangent line creation operations
0073:    * Uses mouse position from second click to determine which tangent to create
0074:    */
0075: 
0076: 
0077:   protected getCommandDescription(): string {
0078:     return "Create tangent line to circle parallel to line";
0079:   }
0080: 
0081:   /**
0082:    * Determine which tangent line to create based on mouse position
0083:    * Returns 0 or 1 for the tangent point closest to mouse
0084:    */
0085:   private determineTangentIndex(
0086:     planeId: string,
0087:     circleId: string,
0088:     referenceLineId: string,
0089:     mousePos: Vector3,
0090:     world: import('@/domain/world/World').World
0091:   ): 0 | 1 {
0092:     const plane = world.getProjectionPlaneById(planeId);
0093:     if (!plane) throw new Error(`Plane not found: ${planeId}`);
0094: 
0095:     // Get circle realization
0096:     const circle = plane.getCircle(circleId);
0097:     if (!circle) throw new Error(`Circle not found: ${circleId}`);
0098:     const circleReal = circle.realize2D(world);
0099:     if (!circleReal || !circleReal.feasible) throw new Error(`Circle infeasible: ${circleId}`);
0100: 
0101:     // Get reference line realization (may be on any plane)
0102:     const refLineElement = world.getLine2D(referenceLineId);
0103:     if (!refLineElement) throw new Error(`Reference line not found: ${referenceLineId}`);
0104:     const refLine = refLineElement.realize2D(world);
0105:     if (!refLine || !refLine.feasible) throw new Error(`Reference line infeasible: ${referenceLineId}`);
0106: 
0107:     const center = circleReal.center;
0108:     const radius = circleReal.getRadius();
0109: 
0110:     // Reference line direction (normalized)
0111:     const refDirection = refLine.point2.clone().normalize();
0112: 
0113:     // Perpendicular direction (90° CCW rotation)
0114:     const perpDirection = new Vector3(-refDirection.y, refDirection.x, 0);
0115: 
0116:     // Compute signed distance from center to reference line
0117:     const refPoint = refLine.point1;
0118:     const a = -refDirection.y;
0119:     const b = refDirection.x;
0120:     const c = refDirection.y * refPoint.x - refDirection.x * refPoint.y;
