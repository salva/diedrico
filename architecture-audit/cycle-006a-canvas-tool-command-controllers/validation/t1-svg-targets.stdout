0313: 
0314: function endPointDrag(commit: boolean): void {
0315:   if (!pointDrag.value.active) return;
0316: 
0317:   const cmd = pointDrag.value.cmd;
0318: 
0319:   try {
0320:     if (cmd) {
0321:       if (commit && cmd.getOperations().length > 0) {
0322:         cmd.commit();
0323:         commandStack.push(cmd);
0324:       } else {
0325:         cmd.rollback();
0326:       }
0327:     }
0328:   } finally {
0329:     pointDrag.value = {
0330:       active: false,
0331:       planeId: null,
0332:       pointId: null,
0333:       cmd: null,
0334:       startClientX: 0,
0335:       startClientY: 0,
0336:       moved: false
0337:     };
0338:     renderTick.value++;
0339:   }
0340: }

