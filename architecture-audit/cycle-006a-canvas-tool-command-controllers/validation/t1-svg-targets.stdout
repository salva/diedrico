1401: /**
1402:  * Handle double-click to show properties dialog
1403:  * T188: Show properties dialog when user double-clicks an element
1404:  */
1405: function handleDoubleClick(event: MouseEvent) {
1406:   // Get SVG element for coordinate conversion
1407:   if (!svgElement.value) return;
1408:   
1409:   // Transform screen coordinates to SVG coordinates
1410:   const svg = svgElement.value;
1411:   const pt = svg.createSVGPoint();
1412:   pt.x = event.clientX;
1413:   pt.y = event.clientY;
1414:   
1415:   const ctm = svg.getScreenCTM();
1416:   if (!ctm) return;
1417:   
1418:   const canvasPoint = pt.matrixTransform(ctm.inverse());
1419:   const canvasPos = new Vector3(canvasPoint.x, canvasPoint.y, 1);
1420:   
1421:   // Get plane transform for hit testing
1422:   const planeTransforms = getPlaneTransformsForInput();
1423:   const paperToPlane = planeTransforms.get(activePlane.value);
1424:   
1425:   // Hit test to find element under cursor
1426:   const hit = paper.hitTest(canvasPos, 20, activePlane.value, paperToPlane, world);
1427:   
1428:   if (hit) {
1429:     // Element found - show properties dialog
1430:     propertiesElementId.value = hit.elementId;
1431:     showPropertiesDialog.value = true;
1432:     console.log('[SvgCanvas] Opening properties dialog for:', hit.elementId);
1433:   }
1434: }
