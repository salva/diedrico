1337: /**
1338:  * Handle mouse down for select-mode drag-to-move of free points.
1339:  * T954: Check if clicking on movable point, start drag if so
1340:  * T965: Otherwise, prepare for viewport pan
1341:  */
1342: function handleMouseDown(event: MouseEvent) {
1343:   if (!svgElement.value) return;
1344: 
1345:   const activeToolName = toolStore.currentTool.value;
1346:   if (activeToolName !== 'select') return;
1347: 
1348:   // Only left button drag, no modifiers (Shift is handled by useViewport)
1349:   if (event.button !== 0) return;
1350:   if (event.shiftKey || event.altKey || event.metaKey || event.ctrlKey) return;
1351: 
1352:   const svg = svgElement.value;
1353:   const pt = svg.createSVGPoint();
1354:   pt.x = event.clientX;
1355:   pt.y = event.clientY;
1356: 
1357:   const ctm = svg.getScreenCTM();
1358:   if (!ctm) return;
1359:   const canvasPoint = pt.matrixTransform(ctm.inverse());
1360: 
1361:   const planeTransforms = getPlaneTransformsForInput();
1362:   const paperToPlane = planeTransforms.get(activePlane.value);
1363:   if (!paperToPlane) return;
1364: 
1365:   const canvasPos = new Vector3(canvasPoint.x, canvasPoint.y, 1);
1366:   const hit = paper.hitTest(canvasPos, 20, activePlane.value, paperToPlane, world);
1367:   
1368:   // Check if we hit a movable point
1369:   if (hit && hit.elementType === 'point') {
1370:     const plane = world.getProjectionPlaneById(activePlane.value);
1371:     if (!plane) throw new Error(`Active plane not found: ${activePlane.value}`);
1372:     const point = plane.getPoint(hit.elementId);
1373:     
1374:     if (point && isMovableFreePoint(point)) {
1375:       // Start point drag (T954)
1376:       selectionStore.selectSingle(hit.elementId);
1377: 
1378:       pointDrag.value = {
1379:         active: true,
1380:         planeId: activePlane.value,
1381:         pointId: hit.elementId,
1382:         cmd: new Command(`Move point ${point.label ?? hit.elementId}`, world),
1383:         startClientX: event.clientX,
1384:         startClientY: event.clientY,
1385:         moved: false
1386:       };
1387:       return;
1388:     }
1389:   }
1390:   
1391:   // No movable point hit - start viewport pan (T965: Drag empty space pans)
1392:   // Note: useViewport composable handles Shift+drag pan automatically
1393:   // Here we handle non-Shift drag when selection tool is active
1394:   viewportPan.value = {
1395:     active: true,
1396:     startX: event.clientX,
1397:     startY: event.clientY
1398:   };
1399: }
