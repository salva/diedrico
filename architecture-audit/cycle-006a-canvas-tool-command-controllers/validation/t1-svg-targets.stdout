0473: // Update canvas dimensions based on container size
0474: function updateCanvasDimensions() {
0475:   if (!svgElement.value) return;
0476:   
0477:   const rect = svgElement.value.getBoundingClientRect();
0478:   // Use container dimensions as logical coordinates (1:1 mapping)
0479:   canvasWidth.value = rect.width;
0480:   canvasHeight.value = rect.height;
0481: }
0482: 
0483: // Initialize canvas on mount
0484: const resizeHandler = () => updateCanvasDimensions();
