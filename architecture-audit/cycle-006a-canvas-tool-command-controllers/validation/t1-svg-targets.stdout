1645: // Commit point move on global mouseup (even if mouseup happens outside SVG)
1646: // T957: Handle viewport pan end
1647: function handleGlobalMouseUp() {
1648:   // Check if viewport pan via useViewport (Shift+drag or middle-click drag) was active
1649:   // If so, suppress next click to prevent unwanted tool actions
1650:   if (viewportComposable.isPanning.value) {
1651:     ignoreNextClick = true;
1652:   }
1653:   
1654:   // End viewport pan
1655:   if (viewportPan.value.active) {
1656:     viewportPan.value = {
1657:       active: false,
1658:       startX: 0,
1659:       startY: 0
1660:     };
1661:     return;
1662:   }
1663:   
1664:   // End point drag
1665:   if (!pointDrag.value.active) return;
1666:   if (pointDrag.value.moved) {
1667:     ignoreNextClick = true;
1668:     endPointDrag(true);
1669:   } else {
1670:     endPointDrag(false);
1671:   }
1672: }
1673: 
1674: onMounted(() => {
1675:   window.addEventListener('mouseup', handleGlobalMouseUp);
1676: });
1677: 
1678: onUnmounted(() => {
1679:   window.removeEventListener('mouseup', handleGlobalMouseUp);
1680: });
