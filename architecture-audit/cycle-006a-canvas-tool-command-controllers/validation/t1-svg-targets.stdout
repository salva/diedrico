1473: /**
1474:  * Handle mouse movement for hover feedback and 3D coordinate display
1475:  * Uses Paper.hitTest() to detect elements near cursor
1476:  * Computes 3D coordinates from cursor position with debouncing
1477:  * T955: Continuous feedback for point dragging
1478:  * T965: Viewport pan when dragging empty space
1479:  */
1480: function handleMouseMove(event: MouseEvent) {
1481:   if (!svgElement.value) return;
1482: 
1483:   // T965: Handle viewport pan in select mode (drag empty space)
1484:   if (viewportPan.value.active) {
1485:     const dx = event.clientX - viewportPan.value.startX;
1486:     const dy = event.clientY - viewportPan.value.startY;
1487:     
1488:     // Adjust pan by dividing by zoom - at high zoom, screen pixels translate to smaller world movement
1489:     const zoom = viewport.value.zoom;
1490:     viewStore.adjustPan(dx / zoom, dy / zoom);
1491:     
1492:     viewportPan.value.startX = event.clientX;
1493:     viewportPan.value.startY = event.clientY;
1494:     return;
1495:   }
1496: 
1497:   // T955: Live preview for point dragging (Select mode)
1498:   if (pointDrag.value.active && pointDrag.value.planeId && pointDrag.value.pointId && pointDrag.value.cmd) {
1499:     // Small drag threshold to avoid turning clicks into moves
1500:     const dx = event.clientX - pointDrag.value.startClientX;
1501:     const dy = event.clientY - pointDrag.value.startClientY;
1502:     if (!pointDrag.value.moved && (dx * dx + dy * dy) < 9) {
1503:       return;
1504:     }
1505:     pointDrag.value.moved = true;
1506: 
1507:     const svg = svgElement.value;
1508:     const pt = svg.createSVGPoint();
1509:     pt.x = event.clientX;
1510:     pt.y = event.clientY;
1511:     const ctm = svg.getScreenCTM();
1512:     if (!ctm) return;
1513:     const canvasPoint = pt.matrixTransform(ctm.inverse());
1514: 
1515:     const planeTransforms = getPlaneTransformsForInput();
1516:     const paperToPlane = planeTransforms.get(pointDrag.value.planeId);
1517:     if (!paperToPlane) return;
1518: 
1519:     const planePos = inputService.canvasToPlaneCoordinates(
1520:       canvasPoint.x,
1521:       canvasPoint.y,
1522:       paperToPlane,
1523:       viewport.value
1524:     );
1525:     if (!planePos) return;
1526: 
1527:     // Preview update: rollback previous op and apply the new one.
1528:     pointDrag.value.cmd.rollback();
1529:     pointDrag.value.cmd.addAndExecute(
1530:       new UpdateFreePoint2DPositionOp(pointDrag.value.planeId, pointDrag.value.pointId, planePos)
1531:     );
1532:     renderTick.value++;
1533:     return;
1534:   }
1535:   
1536:   // Update tooltip position (offset from cursor)
1537:   tooltipPosition.value = {
1538:     x: event.clientX + 15,
1539:     y: event.clientY + 15
1540:   };
1541:   
1542:   // Get canvas position (in SVG user space)
1543:   const svg = svgElement.value;
1544:   const pt = svg.createSVGPoint();
1545:   pt.x = event.clientX;
1546:   pt.y = event.clientY;
1547:   
1548:   const ctm = svg.getScreenCTM();
1549:   if (!ctm) return;
1550:   
1551:   const canvasPoint = pt.matrixTransform(ctm.inverse());
1552:   
1553:   // Get paperToPlane transform for active plane
1554:   const planeTransformsInput = getPlaneTransformsForInput();
1555:   const paperToPlane = planeTransformsInput.get(activePlane.value);
1556:   
1557:   // Get active tool's selection mask
1558:   const activeToolName = toolStore.currentTool.value;
1559:   const activeTool = currentToolInstance.value;
1560:   // 'select' is a special mode (not a tool), allow hover on all elements
1561:   const selectionMask = activeTool ? activeTool.getSelectionMask() : undefined;
1562:   
1563:   // Use Paper.hitTest() to find element near cursor (filtered by selection mask)
1564:   const canvasPos = new Vector3(canvasPoint.x, canvasPoint.y, 1);
1565:   const hit = paper.hitTest(canvasPos, 20, activePlane.value, paperToPlane, world, selectionMask); // FR-002: Hit test in plane space
1566:   
1567:   // Update snap target if hovering over a point within snap radius
1568:   // Per ui-spec.md: "Point Snap: When cursor within snap radius of existing point: bright outline or glow"
1569:   if (hit && hit.elementType === 'point') {
1570:     // Point is within snap radius - show snap preview indicator
1571:     snapTarget.value = {
1572:       pointId: hit.elementId,
1573:       position: { x: canvasPoint.x, y: canvasPoint.y }
1574:     };
1575:   } else {
1576:     // No point nearby - clear snap indicator
1577:     snapTarget.value = {
1578:       pointId: null,
1579:       position: null
1580:     };
1581:   }
1582:   
1583:   // Update hover state in Paper only if it changed
1584:   const previousHovered = paper.getHoveredElement();
1585:   const newHovered = hit ? hit.elementId : undefined;
1586:   
1587:   if (previousHovered !== newHovered) {
1588:     paper.setHoveredElement(newHovered);
1589:     
1590:     // Update global hover state for UI feedback
1591:     if (newHovered && hit) {
1592:       const label = getElementLabel(newHovered, hit.elementType, activePlane.value);
1593:       hoverHighlight.setHoveredElement(
1594:         newHovered,
1595:         hit.elementType,
1596:         label,
1597:         false // Not temporary - show tooltip
1598:       );
1599:     } else {
1600:       hoverHighlight.clearHover();
1601:     }
1602:     
1603:     // Trigger re-render only when hover state actually changes
1604:     renderTick.value++;
1605:   }
1606:   
1607:   // Compute 3D coordinates with throttling (limits update frequency)
1608:   const now = Date.now();
1609:   if (now - lastCoordinateUpdate < COORDINATE_UPDATE_THROTTLE_MS) {
1610:     return; // Skip this update, too soon since last one
1611:   }
1612:   lastCoordinateUpdate = now;
1613:   
1614:   // Get viewport transform matrix
1615:   const viewportState = viewport.value;
1616:   
1617:   // Convert ViewportTransform to Matrix3
1618:   const s = 1 / viewportState.zoom;
1619:   const tx = -viewportState.panX;
1620:   const ty = -viewportState.panY;
1621:   const viewportMatrix = new Matrix3().set(
1622:     s,  0,  tx,
1623:     0,  s,  ty,
1624:     0,  0,  1
1625:   );
1626:   
1627:   // Compute 3D coordinates through full transformation pipeline
1628:   const result = screenTo3D(
1629:     event.clientX,
1630:     event.clientY,
1631:     svg,
1632:     viewportMatrix,
1633:     activePlane.value,
1634:     world
1635:   );
1636:   
1637:   if (result.success && result.coordinates) {
1638:     emit('update-3d-coordinates', result.coordinates);
1639:   } else {
1640:     // Cursor not over plane or error - emit null
1641:     emit('update-3d-coordinates', null);
1642:   }
1643: }
