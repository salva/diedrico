    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    cmd.addAndExecute(new AddProcessTreeActionOp(primaryAction, group.id));
      cmd.addAndExecute(new AddProcessTreeActionOp(siblingAction, group.id));

