
### frontend/tests/unit/tools/pointTool.spec.ts
0001: /**
0002:  * Unit Tests: PointTool
0003:  * 
0004:  * Tests the tool for creating free points:
0005:  * - handleClick() builds generic Command with AddFreePoint2DOp
0006:  * - Coordinate validation (Vector3 homogeneous)
0007:  * - Plane existence validation in World
0008:  * - Tool returns success/failure correctly
0009:  * 
0010:  * Reference: specs/001-dihedral-learning-mvp/tasks.md - R019
0011:  */
0012: 
0013: import { describe, it, expect, beforeEach, vi } from 'vitest';
0014: import { PointTool } from '@/tools/PointTool';
0015: import type { World } from '@/domain/world/World';
0016: import type { CommandStack } from '@/commands/CommandStack';
0017: import type { ToolContext } from '@/tools/ITool';
0018: import { CanvasToolController } from '@/application/tools/CanvasToolController';
0019: import { Vector3 } from 'three';
0020: import { Paper } from '@/domain/presentation/Paper';
0021: import { FreePoint2D } from '@/domain/world/Point';
0022: import { createTestWorld } from '../../helpers/worldHelpers';
0023: 
0024: describe('PointTool', () => {
0025:   let tool: PointTool;
0026:   let world: World;
0027:   let commandStack: CommandStack;
0028:   let horizontalPlaneId: string;
0029:   let verticalPlaneId: string;
0030:   let paper: Paper;
0031: 
0032:   // Helper to create complete ToolContext
0033:   const createToolContext = (planeId: string, planeCoords: Vector3, canvasCoords = { x: 100, y: 100 }): ToolContext => ({
0034:     planeId,
0035:     planeCoords,
0036:     canvasCoords,
0037:     commandSink: new CanvasToolController({ world, commandStack, toolStore }),
0038:     world,
0039:     paper,
0040:     paperToPlaneTransform: undefined,
0041:     toolStore: {} as any, // Mock tool store
0042:   });
0043: 
0044:   let initialUndoDepth: number;
0045: 
0046:   beforeEach(() => {
0047:     tool = new PointTool();
0048:     const { world: w, commandStack: cs } = createTestWorld();
0049:     world = w;
0050:     commandStack = cs;
0051:     paper = new Paper();
0052:     // Get actual plane IDs from initialized world
0053:     horizontalPlaneId = world.getProjectionPlaneByLabel('P_H').id!;
0054:     verticalPlaneId = world.getProjectionPlaneByLabel('P_V').id!;
0055:     // Record initial undo count after initialization
0056:     // Use a trick: undo until we can't, then count how many we did, then redo them all
0057:     let undoCount = 0;
0058:     while (commandStack.canUndo()) {
0059:       commandStack.undo();
0060:       undoCount++;
0061:     }
0062:     for (let i = 0; i < undoCount; i++) {
0063:       commandStack.redo();
0064:     }
0065:     initialUndoDepth = undoCount;
0066:   });
0067: 
0068:   describe('Tool Identity', () => {
0069:     it('should have correct name', () => {
0070:       expect(tool.name).toBe('point');
0071:     });
0072:   });
0073: 
0074:   describe('Click Handling', () => {
0075:     it('should create free point on valid click', () => {
0076:       const context = createToolContext(
0077:         horizontalPlaneId,
0078:         new Vector3(100, 200, 1)
0079:       );
0080: 
0240:   describe('Error Handling', () => {
0241:     it('should return failure for invalid coordinates', () => {
0242:       const context = createToolContext(
0243:         horizontalPlaneId,
0244:         new Vector3(NaN, NaN, 1)
0245:       );
0246: 
0247:       const result = tool.handleClick(context);
0248: 
0249:       expect(result.success).toBe(false);
0250:       expect(result.message).toBeTruthy();
0251:     });
0252: 
