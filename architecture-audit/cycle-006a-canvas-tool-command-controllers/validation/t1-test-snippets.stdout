### frontend/tests/unit/tools/CircleTool.spec.ts
0001: /**
0002:  * Unit Tests: CircleTool
0003:  * 
0004:  * Tests the tool for creating circles by center and circumference points:
0005:  * - Two-click workflow (center → circumference → circle)
0006:  * - Point snapping behavior for both clicks
0007:  * - No duplicate points created when snapping
0008:  * - Minimum radius validation
0009:  * - Success/failure messages
0010:  * 
0011:  * Reference: specs/001-dihedral-learning-mvp/tasks.md - Phase 56 (T983-T985)
0012:  */
0013: 
0014: import { describe, it, expect, beforeEach } from 'vitest';
0015: import { CircleTool } from '@/tools/CircleTool';
0016: import type { World } from '@/domain/world/World';
0017: import type { CommandStack } from '@/commands/CommandStack';
0018: import { Command } from '@/commands/Command';
0019: import { createTestWorld } from '../../helpers/worldHelpers';
0020: import { AddFreePoint2DOp } from '@/commands/operations/world/AddFreePointOp';
0021: import { UpdateFreePoint2DPositionOp } from '@/commands/operations/world/UpdateFreePoint2DPositionOp';
0022: import type { ToolContext } from '@/tools/ITool';
0023: import { CanvasToolController } from '@/application/tools/CanvasToolController';
0024: import { Vector3, Matrix3 } from 'three';
0025: import { Paper } from '@/domain/presentation/Paper';
0026: 
0027: describe('CircleTool', () => {
0028:   let tool: CircleTool;
0029:   let world: World;
0030:   let commandStack: CommandStack;
0031:   let horizontalPlaneId: string;
0032:   let paper: Paper;
0033: 
0034:   beforeEach(() => {
0035:     tool = new CircleTool();
0036:     const { world: w, commandStack: cs } = createTestWorld();
0037:     world = w;
0038:     commandStack = cs;
0039:     paper = new Paper();
0040:     
0041:     // Get actual plane ID from initialized world
0042:     horizontalPlaneId = world.getProjectionPlaneByLabel('P_H').id!;
0043:   });
0044: 
0045:   describe('Tool Identity', () => {
0046:     it('should have correct name', () => {
0047:       expect(tool.name).toBe('circle');
0048:     });
0049:   });
0050: 
0051:   describe('Two-Click Workflow', () => {
0052:     it('should require two clicks to create circle', () => {
0053:       // Create both center and circumference points
0054:       const setupCmd = new Command('Create test points', world);
0055:       const centerOp = new AddFreePoint2DOp(horizontalPlaneId, new Vector3(100, 100, 1));
0056:       setupCmd.addAndExecute(centerOp);
0057:       const centerPointId = centerOp.outputs.pointId as string;
0058:       
0059:       const circumferenceOp = new AddFreePoint2DOp(horizontalPlaneId, new Vector3(200, 100, 1));
0060:       setupCmd.addAndExecute(circumferenceOp);
0061:       const circumferencePointId = circumferenceOp.outputs.pointId as string;
0062:       
0063:       setupCmd.commit();
0064:       commandStack.push(setupCmd);
0065: 
0066:       // First click - select center
0067:       const firstClickContext: ToolContext = {
0068:         planeId: horizontalPlaneId,
0069:         planeCoords: new Vector3(100, 100, 1),
0070:         canvasCoords: new Vector3(100, 100, 1),
0071:         commandSink: new CanvasToolController({ world, commandStack, toolStore }),
0072:         world,
0073:         paper,
0074:         paperToPlaneTransform: new Matrix3().identity()
0075:       };
0076: 
0077:       const firstResult = tool.handleClick(firstClickContext);
0078:       expect(firstResult.success).toBe(true);
0079:       expect(firstResult.message).toContain('Creating circle');
0080: 
0240: 
0241:       const firstResult = tool.handleClick(firstClickContext);
0242:       expect(firstResult.success).toBe(true);
0243: 
0244:       // Second click - snap to valid point
0245:       const secondClickContext: ToolContext = {
0246:         planeId: horizontalPlaneId,
0247:         planeCoords: new Vector3(100.002, 100, 1),
0248:         canvasCoords: new Vector3(100.002, 100, 1),
0249:         commandSink: new CanvasToolController({ world, commandStack, toolStore }),
0250:         world,
0251:         paper,
0252:         paperToPlaneTransform: new Matrix3().identity()
0253:       };
0254: 
0255:       const secondResult = tool.handleClick(secondClickContext);
0256:       expect(secondResult.success).toBe(true);
0257:       expect(secondResult.message).toContain('completed successfully');  // ArgumentCollectorTool completion message
0258: 
0259:       // Verify circle was created
0260:       const plane = world.getProjectionPlaneById(horizontalPlaneId);

### frontend/tests/unit/tools/toolValidation.spec.ts
0001: /**
0002:  * Unit tests for tool argument validation
0003:  * Phase 113: Verify tools reject invalid arguments
0004:  * 
0005:  * Tests:
0006:  * - LineTool rejects same point twice
0007:  * - SegmentTool rejects same point twice
0008:  * - CircleTool rejects zero-radius circle
0009:  * - ParallelLineTool rejects infeasible reference line
0010:  * - PerpendicularLineTool rejects infeasible reference line
0011:  * - TangentLineToCircleThroughPointTool rejects point inside circle
0012:  * 
0013:  * Tasks: T1869-T1874
0014:  */
0015: 
0016: import { describe, it, expect, beforeEach } from 'vitest';
0017: import { LineTool } from '@/tools/LineTool';
0018: import { SegmentTool } from '@/tools/SegmentTool';
0019: import { CircleTool } from '@/tools/CircleTool';
0020: import { ParallelLineTool } from '@/tools/ParallelLineTool';
0021: import { PerpendicularLineTool } from '@/tools/PerpendicularLineTool';
0022: import { TangentLineToCircleThroughPointTool } from '@/tools/TangentLineToCircleThroughPointTool';
0023: import type { World } from '@/domain/world/World';
0024: import type { CommandStack } from '@/commands/CommandStack';
0025: import { Command } from '@/commands/Command';
0026: import { createTestWorld } from '../../helpers/worldHelpers';
0027: import { AddFreePoint2DOp } from '@/commands/operations/world/AddFreePointOp';
0028: import type { ToolContext } from '@/tools/ITool';
0029: import { CanvasToolController } from '@/application/tools/CanvasToolController';
0030: import { Vector3, Matrix3 } from 'three';
0031: import { Paper } from '@/domain/presentation/Paper';
0032: 
0033: describe('Tool Argument Validation', () => {
0034:   let world: World;
0035:   let commandStack: CommandStack;
0036:   let planeId: string;
0037:   let paper: Paper;
0038: 
0039:   function makeContext(coords: Vector3): ToolContext {
0040:     return {
0041:       planeId,
0042:       planeCoords: coords.clone(),
0043:       canvasCoords: coords.clone(),
0044:       commandSink: new CanvasToolController({ world, commandStack, toolStore }),
0045:       world,
0046:       paper,
0047:       paperToPlaneTransform: new Matrix3().identity()
0048:     };
0049:   }
0050: 
0051:   function addPoint(x: number, y: number): string {
0052:     const cmd = new Command('Add point', world);
0053:     const op = new AddFreePoint2DOp(planeId, new Vector3(x, y, 1));
0054:     cmd.addAndExecute(op);
0055:     cmd.commit();
0056:     commandStack.push(cmd);
0057:     return op.outputs.pointId as string;
0058:   }
0059: 
0060:   beforeEach(() => {
0061:     const { world: w, commandStack: cs } = createTestWorld();
0062:     world = w;
0063:     commandStack = cs;
0064:     paper = new Paper();
0065:     planeId = world.getProjectionPlaneByLabel('P_H').id!;
0066:   });
0067: 
0068:   describe('LineTool', () => {
0069:     it('should reject selecting the same point twice', () => {
0070:       const tool = new LineTool();
0071:       addPoint(100, 100);
0072: 
0073:       // Click same point twice
0074:       const ctx = makeContext(new Vector3(100, 100, 1));
0075:       const r1 = tool.handleClick(ctx);
0076:       expect(r1.success).toBe(true);
0077: 
0078:       const r2 = tool.handleClick(ctx);
0079:       // Rejection: either success=false or doesn't complete
0080:       if (r2.success) {
