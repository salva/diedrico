457: // Update canvas dimensions based on container size
458: function updateCanvasDimensions() {
459:   if (!svgElement.value) return;
460:   
461:   const rect = svgElement.value.getBoundingClientRect();
462:   // Use container dimensions as logical coordinates (1:1 mapping)
463:   canvasWidth.value = rect.width;
464:   canvasHeight.value = rect.height;
465: }
466: 
467: // Initialize canvas on mount
468: const resizeHandler = () => updateCanvasDimensions();
469: 
470: onMounted(() => {
471:   // World is already initialized by initialization factory in constructor
472:   // Just trigger initial render
473:   renderTick.value++;
474: 
475:   // Set initial canvas dimensions
476:   updateCanvasDimensions();
477: 
478:   // Update dimensions on window resize
479:   window.addEventListener('resize', resizeHandler);
480: 
481:   // Poll World version so UI reacts to domain changes (e.g. active plane switching)
482:   lastWorldVersion = world.getVersion();
483:   worldVersion.value = lastWorldVersion;
484:   versionPollId = window.setInterval(() => {
485:     const current = world.getVersion();
486:     if (current !== lastWorldVersion) {
487:       lastWorldVersion = current;
488:       worldVersion.value = current;
489:       renderTick.value++;
490:     }
491:   }, 100);
492: 
493:   console.log('World initialized');
494:   const allPlanes = world.getAllProjectionPlanes();
495:   const totalPoints = allPlanes.reduce((sum, plane) => sum + plane.getAllPoints().length, 0);
496:   console.log('Points in world:', totalPoints);
497: });
498: 
499: onUnmounted(() => {
500:   window.removeEventListener('resize', resizeHandler);
501:   window.removeEventListener('keydown', handleGlobalKeyDown);
502:   if (versionPollId !== null) {
503:     clearInterval(versionPollId);
504:   }
505: });
506: 
507: // Global key handling (Esc cancels point-drag)
508: onMounted(() => {
509:   window.addEventListener('keydown', handleGlobalKeyDown);
510: });
511: 
512: // Watch for tool changes and create new tool instance
513: // This prevents state leakage by creating fresh instances instead of reusing singletons
514: watch(() => toolStore.currentTool.value, (newTool) => {
