425: // Tool factory registry - map tool names to factory functions
426: // Creates new instances instead of reusing singletons to avoid state leakage
427: const toolFactories: Record<string, () => ITool> = {
428:   'point': () => new PointTool(),
429:   'line': () => new LineTool(),
430:   'segment': () => new SegmentTool(),
431:   'circle': () => new CircleTool(),
432:   'guide': () => new GuideTool(),
433:   'intersection': () => new IntersectionTool(),
434:   'parallel-line': () => new ParallelLineTool(),
