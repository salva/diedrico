437:   'tangent-line-to-circle-parallel': () => new TangentLineToCircleParallelToLineTool(),
438:   // Phase 78: 3D Element Creation Tools
439:   'create3dpoint': () => new Create3DPointTool(),
440:   'create3dline': () => new Create3DLineTool(),
441:   'create3dsegment': () => new Create3DSegmentTool(),
442:   'create3dplane': () => new Create3DPlaneTool(),
443:   // Phase 82: Auxiliary Projection Plane Tool
444:   'createprojectionplane': () => new CreateProjectionPlaneTool(),
445: };
446: 
447: // Current tool instance - created fresh when tool is selected
448: const currentToolInstance = ref<ITool | null>(null);
449: 
450: // Reactivity trigger - increment this to force re-render when non-reactive state changes (e.g. Paper hover)
451: const renderTick = ref(0);
452: 
453: // Throttle for coordinate updates (limits update frequency)
454: let lastCoordinateUpdate = 0;
455: const COORDINATE_UPDATE_THROTTLE_MS = 50; // 20fps for coordinate updates
