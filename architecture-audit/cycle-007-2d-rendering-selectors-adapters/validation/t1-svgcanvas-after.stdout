517:     currentToolInstance.value = factory();
518:     console.log(`[SvgCanvas] Created new tool instance: ${newTool}`);
519:     // Show initial tool feedback (e.g. "Creating line: pick point1, point2")
520:     if (currentToolInstance.value && 'getStatusMessage' in currentToolInstance.value) {
521:       const msg = (currentToolInstance.value as any).getStatusMessage();
522:       if (msg) toolStore.setToolStepMessage(msg);
523:     }
524:   } else {
525:     currentToolInstance.value = null;
526:     if (newTool !== 'select') {
527:       console.warn(`[SvgCanvas] No tool factory for: ${newTool}`);
528:     }
529:   }
530: }, { immediate: true }); // Create initial tool instance
