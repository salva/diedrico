59:   beforeEach(() => {
60:     tool = new PointTool();
61:     const { world: w, commandStack: cs } = createTestWorld();
62:     world = w;
63:     commandStack = cs;
64:     interactionQuery = liveInteractionQuery(() => world, () => horizontalPlaneId);
65:     // Get actual plane IDs from initialized world
66:     horizontalPlaneId = world.getProjectionPlaneByLabel('P_H').id!;
67:     verticalPlaneId = world.getProjectionPlaneByLabel('P_V').id!;
68:     // Record initial undo count after initialization
69:     // Use a trick: undo until we can't, then count how many we did, then redo them all
70:     let undoCount = 0;
71:     while (commandStack.canUndo()) {
72:       commandStack.undo();
73:       undoCount++;
74:     }
75:     for (let i = 0; i < undoCount; i++) {
76:       commandStack.redo();
77:     }
78:     initialUndoDepth = undoCount;
79:   });
