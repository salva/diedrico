356: /**
357:  * Get display label for an element
358:  * @param elementId - ID of the element
359:  * @param elementType - Type of the element (point, line, segment, etc.)
360:  * @param planeId - ID of the plane containing the element (optional, will search all planes if not provided)
361:  */
362: function getElementLabel(elementId: string, elementType: string, planeId?: string): string {
363:   let element: any;
364:   
365:   // If planeId is provided, only search that plane
366:   if (planeId) {
367:     const plane = world.getProjectionPlaneById(planeId);
368:     if (plane) {
369:       switch (elementType) {
370:         case 'point':
371:           element = plane.getPoint(elementId);
372:           break;
373:         case 'line':
374:         case 'half-hinge-line':
375:         case 'segment':  // Segments are Line2D objects, use getLine
376:         case 'guide':  // Guides are Line2D objects, use getLine
377:           element = plane.getLine(elementId);
378:           break;
379:         case 'circle':
380:           element = plane.getCircle(elementId);
381:           break;
382:         case 'arc':
383:           element = plane.getArc(elementId);
384:           break;
385:       }
386:     }
387:   } else {
388:     // Search all planes if no planeId provided
389:     for (const plane of world.projectionPlanes.values()) {
390:       switch (elementType) {
391:         case 'point':
392:           element = plane.getPoint(elementId);
393:           break;
394:         case 'line':
395:         case 'half-hinge-line':
396:         case 'segment':  // Segments are Line2D objects, use getLine
397:         case 'guide':  // Guides are Line2D objects, use getLine
398:           element = plane.getLine(elementId);
399:           break;
400:         case 'circle':
401:           element = plane.getCircle(elementId);
402:           break;
403:         case 'arc':
404:           element = plane.getArc(elementId);
405:           break;
406:       }
407:       if (element) break; // Found it
408:     }
409:   }
410:   
411:   return element ? element.label || elementId : elementId;
412: }
