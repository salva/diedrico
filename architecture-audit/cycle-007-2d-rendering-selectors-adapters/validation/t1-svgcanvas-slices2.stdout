1041:     const uEnd_left = Math.ceil(uMax_left / majorSpacing) * majorSpacing;
1042:     
1043:     for (let u = uStart_left; u <= uEnd_left; u += majorSpacing) {
1044:       const screenY = findULineIntersectionWithVertical(u, x_paper_left);
1045:       if (screenY !== null && screenY >= -10 && screenY <= canvasHeight.value + 10) {
1046:         leftLabels.push({ key: `left-${u}`, value: u, position: screenY, edge: 'left' });
1047:       }
1048:     }
1049:     
1050:     // RIGHT EDGE
1051:     const x_paper_right = canvasWidth.value / zoom - viewport.value.panX;
1052:     const rightTop_uv = paperToUV(screenToPaper(canvasWidth.value, 0));
1053:     const rightBottom_uv = paperToUV(screenToPaper(canvasWidth.value, canvasHeight.value));
1054:     const uMin_right = Math.min(rightTop_uv.u, rightBottom_uv.u);
1055:     const uMax_right = Math.max(rightTop_uv.u, rightBottom_uv.u);
1056:     const uStart_right = Math.floor(uMin_right / majorSpacing) * majorSpacing;
1057:     const uEnd_right = Math.ceil(uMax_right / majorSpacing) * majorSpacing;
1058:     
1059:     for (let u = uStart_right; u <= uEnd_right; u += majorSpacing) {
1060:       const screenY = findULineIntersectionWithVertical(u, x_paper_right);
1061:       if (screenY !== null && screenY >= -10 && screenY <= canvasHeight.value + 10) {
1062:         rightLabels.push({ key: `right-${u}`, value: u, position: screenY, edge: 'right' });
1063:       }
1064:     }
1065:   }
1066: 
1067:   return {
1068:     top: topLabels,
1069:     bottom: bottomLabels,
1070:     left: leftLabels,
