536: // Get plane transforms for INPUT (canvas click → plane coordinates)
537: function getPlaneTransformsForInput(): Map<string, Matrix3> {
538:   const transforms = new Map<string, Matrix3>();
539:   
540:   // Get all projection planes dynamically
541:   for (const plane of world.getAllProjectionPlanes()) {
542:     const realization = world.getProjectionPlane2DRealization(plane.id);
543:     if (realization) {
544:       transforms.set(plane.id, realization.paperToPlane2D);
545:     }
546:   }
547:   
548:   return transforms;
549: }
550: 
551: // Get plane transforms for RENDERING (plane coordinates → paper coordinates)
552: function getPlaneTransformsForRendering(): Map<string, Matrix3> {
553:   const transforms = new Map<string, Matrix3>();
554:   
555:   // Get all projection planes dynamically
556:   for (const plane of world.getAllProjectionPlanes()) {
557:     const realization = world.getProjectionPlane2DRealization(plane.id);
558:     if (realization) {
559:       transforms.set(plane.id, realization.planeToPaper2D);
560:     }
561:   }
562:   
563:   return transforms;
564: }
