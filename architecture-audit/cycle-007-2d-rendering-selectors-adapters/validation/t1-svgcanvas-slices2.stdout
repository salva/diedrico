461: // Update canvas dimensions based on container size
462: function updateCanvasDimensions() {
463:   if (!svgElement.value) return;
464:   
465:   const rect = svgElement.value.getBoundingClientRect();
466:   // Use container dimensions as logical coordinates (1:1 mapping)
467:   canvasWidth.value = rect.width;
468:   canvasHeight.value = rect.height;
469: }
470: 
471: // Initialize canvas on mount
472: const resizeHandler = () => updateCanvasDimensions();
473: 
474: onMounted(() => {
475:   // World is already initialized by initialization factory in constructor
476:   // Just trigger initial render
477:   renderTick.value++;
478: 
479:   // Set initial canvas dimensions
480:   updateCanvasDimensions();
481: 
482:   // Update dimensions on window resize
483:   window.addEventListener('resize', resizeHandler);
484: 
485:   // Poll World version so UI reacts to domain changes (e.g. active plane switching)
486:   lastWorldVersion = world.getVersion();
487:   worldVersion.value = lastWorldVersion;
488:   versionPollId = window.setInterval(() => {
489:     const current = world.getVersion();
490:     if (current !== lastWorldVersion) {
491:       lastWorldVersion = current;
492:       worldVersion.value = current;
493:       renderTick.value++;
494:     }
495:   }, 100);
496: 
497:   console.log('World initialized');
498:   const allPlanes = world.getAllProjectionPlanes();
499:   const totalPoints = allPlanes.reduce((sum, plane) => sum + plane.getAllPoints().length, 0);
500:   console.log('Points in world:', totalPoints);
501: });
502: 
503: onUnmounted(() => {
504:   window.removeEventListener('resize', resizeHandler);
505:   window.removeEventListener('keydown', handleGlobalKeyDown);
506:   if (versionPollId !== null) {
507:     clearInterval(versionPollId);
508:   }
509: });
