566: // Generate primitives from World using PaperService
567: const primitives = computed(() => {
568:   // Access renderTick to make this computed reactive to non-reactive sources (World + Paper)
569:   renderTick.value;
570:   
571:   // PaperService uses plane-to-paper transforms for rendering
572:   const planeTransforms = getPlaneTransformsForRendering();
573:   
574:   // Get hovered and selected elements for visual highlighting
575:   // Per ui-spec.md: Hover = #4A90E2 (lighter), Selection = #0066CC (bold)
576:   const hoveredId = paper.getHoveredElement();
577:   const hoveredIds = hoveredId ? new Set([hoveredId]) : undefined;
578:   
579:   const selectedIds = selectionStore.selectedIdsArray;
580:   const selectedIdsSet = selectedIds.length > 0 ? new Set(selectedIds) : undefined;
581:   
582:   const cascadeHighlightIds = selectionStore.cascadeHighlightIdsArray;
583:   const cascadeHighlightIdsSet = cascadeHighlightIds.length > 0 ? new Set(cascadeHighlightIds) : undefined;
584:   
585:   const context: PrimitiveContext = {
586:     world,
587:     planeTransforms,
588:     hoveredIds,              // Hover state (lighter highlight)
589:     selectedIds: selectedIdsSet,  // Selection state (bold highlight)
590:     cascadeHighlightIds: cascadeHighlightIdsSet,  // Cascade delete preview (orange warning)
591:     activePlaneId: activePlane.value,  // FR-002: Active plane visual emphasis
592:     showProjectedElements: viewStore.showProjectedElements.value,  // Phase 106: 3D element projection display
593:   };
594:   
595:   const prims = paperService.generatePrimitives(context);
596:   // console.log('Generated primitives:', prims.length, prims);
597:   
598:   // Sort primitives by layer first, then z-index (same as Paper.getPrimitives())
599:   prims.sort((a, b) => {
600:     if (a.layer !== b.layer) {
601:       return a.layer - b.layer;
602:     }
603:     return a.style.zIndex - b.style.zIndex;
604:   });
605:   
606:   // Update Paper with primitives for spatial queries (hit testing)
607:   paper.setPrimitives(prims);
608:   
609:   return prims;
610: });
