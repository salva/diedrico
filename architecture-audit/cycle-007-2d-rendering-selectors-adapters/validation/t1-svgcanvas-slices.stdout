1325: /**
1326:  * Handle mouse down for select-mode drag-to-move of free points.
1327:  * T954: Check if clicking on movable point, start drag if so
1328:  * T965: Otherwise, prepare for viewport pan
1329:  */
1330: function handleMouseDown(event: MouseEvent) {
1331:   if (!svgElement.value) return;
1332: 
1333:   const activeToolName = toolStore.currentTool.value;
1334:   if (activeToolName !== 'select') return;
1335: 
1336:   // Only left button drag, no modifiers (Shift is handled by useViewport)
1337:   if (event.button !== 0) return;
1338:   if (event.shiftKey || event.altKey || event.metaKey || event.ctrlKey) return;
1339: 
1340:   const svg = svgElement.value;
1341:   const pt = svg.createSVGPoint();
1342:   pt.x = event.clientX;
1343:   pt.y = event.clientY;
1344: 
1345:   const ctm = svg.getScreenCTM();
1346:   if (!ctm) return;
1347:   const canvasPoint = pt.matrixTransform(ctm.inverse());
1348: 
1349:   const planeTransforms = getPlaneTransformsForInput();
1350:   const paperToPlane = planeTransforms.get(activePlane.value);
1351:   if (!paperToPlane) return;
1352: 
1353:   const canvasPos = new Vector3(canvasPoint.x, canvasPoint.y, 1);
1354:   const hit = paper.hitTest(canvasPos, 20, activePlane.value, paperToPlane, world);
1355:   
1356:   // Check if we hit a movable point
1357:   if (hit && hit.elementType === 'point') {
1358:     const plane = world.getProjectionPlaneById(activePlane.value);
1359:     if (!plane) throw new Error(`Active plane not found: ${activePlane.value}`);
1360:     const point = plane.getPoint(hit.elementId);
1361:     
1362:     if (point && isMovableFreePoint(point)) {
1363:       // Start point drag (T954)
1364:       selectionStore.selectSingle(hit.elementId);
1365: 
1366:       pointDrag.value = {
1367:         active: true,
1368:         planeId: activePlane.value,
1369:         pointId: hit.elementId,
1370:         moveSession: canvasToolController.startFreePointMove({ planeId: activePlane.value, pointId: hit.elementId, label: point.label ?? hit.elementId }),
