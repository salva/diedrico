--- 620-730 ---
620:  * - Power of 10 chosen based on zoom level to keep reasonable density
621:  * 
622:  * Subdivisions (2, 5, or 10):
623:  * - Minor lines divide each major interval by 2, 5, or 10
624:  * - Subdivision chosen to keep minor cells >= minimum pixel threshold (15px)
625:  * - Preference: smallest subdivision that meets threshold (10 > 5 > 2)
626:  * 
627:  * Algorithm:
628:  * - Calculate minimum spacing in plane units: minSpacing = minPixelsPerCell / zoom
629:  * - Find smallest value from sequence: 10^n/10, 10^n/5, 10^n/2 that is >= minSpacing
630:  * - This determines both minor spacing and major spacing (10^n)
631:  * - Example at zoom=1.0: minSpacing=15, chooses 20 (=100/5), major=100, subdivision=5
632:  * - Example at zoom=0.1: minSpacing=150, chooses 200 (=1000/5), major=1000, subdivision=5
633:  */
634: 
635: /**
636:  * Compute adaptive grid parameters based on zoom level
637:  * Major lines at powers of 10, subdivisions are 2, 5, or 10
638:  */
639: function computeAdaptiveGridParams(zoom: number): {
640:   spacing: number;
641:   subdivision: number;
642:   majorSpacing: number;
643: } {
644:   const minPixelsPerCell = 15; // Minimum pixels per minor grid cell
645:   const minSpacing = minPixelsPerCell / zoom; // Minimum spacing in plane units
646:   
647:   // Find the smallest spacing from sequence: ..., 0.1, 0.2, 0.5, 1, 2, 5, 10, 20, 50, 100, ...
648:   // These are 10^n/10, 10^n/5, 10^n/2 for integer n
649:   
650:   const logMin = Math.log10(minSpacing);
651:   const basePower = Math.floor(logMin);
652:   
653:   // Try powers of 10 starting from basePower
654:   for (let n = basePower; n < basePower + 3; n++) {
655:     const base = Math.pow(10, n);
656:     
657:     // Try subdivisions in order of preference (10 > 5 > 2 gives smallest cells)
658:     for (const subdivision of [10, 5, 2]) {
659:       const spacing = base / subdivision; // Minor line spacing
660:       if (spacing >= minSpacing) {
661:         return {
662:           spacing,           // Minor line spacing (spacing between all lines)
663:           subdivision,       // Number of minor intervals per major interval
664:           majorSpacing: base // Major line spacing (10^n)
665:         };
666:       }
667:     }
668:   }
669:   
670:   // Fallback (shouldn't reach here)
671:   return { spacing: 1, subdivision: 10, majorSpacing: 10 };
672: }
673: 
