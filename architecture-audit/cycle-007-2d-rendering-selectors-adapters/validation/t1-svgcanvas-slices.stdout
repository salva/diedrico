1158: /**
1159:  * Handle canvas click - delegate to active tool
1160:  * Phase 6.5: Unified tool delegation for all tools (point, line, circle, etc.)
1161:  */
1162: function handleCanvasClick(event: MouseEvent) {
1163:   if (ignoreNextClick) {
1164:     ignoreNextClick = false;
1165:     return;
1166:   }
1167: 
1168:   // Get SVG element for coordinate conversion
1169:   if (!svgElement.value) return;
1170:   
1171:   // T030: Transform coordinates: Screen → Canvas using SVG's native methods
1172:   // Use SVG's built-in coordinate transformation
1173:   const svg = svgElement.value;
1174:   const pt = svg.createSVGPoint();
1175:   pt.x = event.clientX;
1176:   pt.y = event.clientY;
1177:   
1178:   // Transform screen coordinates to SVG coordinates
1179:   const ctm = svg.getScreenCTM();
1180:   if (!ctm) return;
1181:   
1182:   const canvasPoint = pt.matrixTransform(ctm.inverse());
1183:   
1184:   // console.log('[SvgCanvas] Click at canvas coords:', { x: canvasPoint.x, y: canvasPoint.y });
1185:   
1186:   // Step 2-3: Canvas → Paper → Plane using InputService
1187:   const activePlaneId = activePlane.value;
1188:   const planeTransforms = getPlaneTransformsForInput();
1189:   const planeTransform = planeTransforms.get(activePlaneId);
1190:   
1191:   if (!planeTransform) {
1192:     console.error('[SvgCanvas] No transform for active plane:', activePlaneId);
1193:     return;
1194:   }
1195:   
1196:   const planePos = inputService.canvasToPlaneCoordinates(
1197:     canvasPoint.x,
1198:     canvasPoint.y,
1199:     planeTransform,
1200:     viewport.value
1201:   );
1202:   
1203:   if (!planePos) {
1204:     console.error('[SvgCanvas] Failed to convert canvas to plane coordinates');
1205:     return;
1206:   }
1207:   
1208:   // console.log('[SvgCanvas] Plane coords (u,v,w):', planePos);
1209:   
1210:   // Debug: Check what Paper.hitTest() would return for this click
1211:   const canvasPos = new Vector3(canvasPoint.x, canvasPoint.y, 1);
1212:   const paperToPlane = planeTransforms.get(activePlane.value);
1213:   const hit = paper.hitTest(canvasPos, 20, activePlane.value, paperToPlane, world);  // FR-002: Hit test in plane space
1214:   // console.log('[SvgCanvas] Paper.hitTest() result:', hit);
1215:   // console.log('[SvgCanvas] Paper has', paper.size, 'primitives');
1216:   
1217:   // Phase 20: Handle selection mode when 'select' tool is active
1218:   const activeToolName = toolStore.currentTool.value;
1219:   
1220:   if (activeToolName === 'select') {
1221:     // Selection mode per ui-spec.md §Element Interaction
1222:     // Click element: Select (Shift+click: add to selection)
1223:     // Click empty: Deselect all
1224:     
1225:     const hit = paper.hitTest(canvasPos, 20, activePlane.value, paperToPlane, world);
1226:     
1227:     if (hit) {
1228:       // Element clicked - handle selection
1229:       if (event.shiftKey) {
1230:         // Shift+click: Add to selection (multi-select)
1231:         selectionStore.addToSelection(hit.elementId);
1232:         // console.log('[SvgCanvas] Added to selection:', hit.elementId);
1233:       } else {
1234:         // Regular click: Single selection (replaces current selection)
1235:         selectionStore.selectSingle(hit.elementId);
1236:         // console.log('[SvgCanvas] Selected:', hit.elementId);
1237:       }
1238:     } else {
1239:       // Clicked empty space - clear selection
1240:       selectionStore.clearSelection();
