678:   const _ = worldVersion.value;
679:   
680:   const activePlaneId = world.getActivePlaneId();
681:   const plane = world.getProjectionPlaneById(activePlaneId);
682:   if (!plane) return [];
683: 
684:   // Get plane realization which contains transformation matrices
685:   const planeRealization = plane.realize2D(world);
686: 
687:   const zoom = viewport.value.zoom;
688:   const { spacing, subdivision, majorSpacing } = computeAdaptiveGridParams(zoom);
689: 
690:   const lines: Array<{
691:     key: string;
692:     x1: number;
693:     y1: number;
694:     x2: number;
695:     y2: number;
696:     major: boolean;
697:   }> = [];
698: 
699:   // Phase 82.2: Transform intrinsic basis to paper space
700:   // This approach works for both base planes (identity-like) and auxiliary planes (rotated)
701:   const origin_paper = new Vector3(0, 0, 1).applyMatrix3(planeRealization.planeToPaper2D);
702:   const u_paper = new Vector3(1, 0, 0).applyMatrix3(planeRealization.planeToPaper2D);
703:   const v_paper = new Vector3(0, 1, 0).applyMatrix3(planeRealization.planeToPaper2D);
704: 
705:   // DEBUG: Log the transformed basis vectors and viewport state
706:   // console.log('[gridLines] origin_paper:', origin_paper);
707:   // console.log('[gridLines] u_paper:', u_paper);
708:   // console.log('[gridLines] v_paper:', v_paper);
709:   // console.log('[gridLines] viewport.panX:', viewport.value.panX, 'panY:', viewport.value.panY);
710:   // console.log('[gridLines] viewport.zoom:', viewport.value.zoom);
711:   // console.log('[gridLines] canvasWidth:', canvasWidth.value, 'canvasHeight:', canvasHeight.value);
712: 
713:   // Calculate viewport bounds in paper coordinates
714:   const viewportWidth = canvasWidth.value / zoom;
715:   const viewportHeight = canvasHeight.value / zoom;
716:   const offsetX = -viewport.value.panX;
717:   const offsetY = -viewport.value.panY;
718:   
719:   // console.log('[gridLines] viewportWidth:', viewportWidth, 'viewportHeight:', viewportHeight);
720:   // console.log('[gridLines] offsetX:', offsetX, 'offsetY:', offsetY);
721:   // console.log('[gridLines] viewport top-left corner in paper:', offsetX, offsetY);
722:   // console.log('[gridLines] viewport center in paper:', offsetX + viewportWidth/2, offsetY + viewportHeight/2);
723: 
724:   // Viewport corners in paper coordinates
725:   const viewport_corners_paper = [
726:     new Vector3(offsetX, offsetY, 1),
727:     new Vector3(offsetX + viewportWidth, offsetY, 1),
728:     new Vector3(offsetX, offsetY + viewportHeight, 1),
729:     new Vector3(offsetX + viewportWidth, offsetY + viewportHeight, 1)
730:   ];
