841:   if (!plane) {
842:     return { top: [], bottom: [], left: [], right: [] };
843:   }
844: 
845:   // Get plane realization which contains transformation matrices
846:   const planeRealization = plane.realize2D(world);
847: 
848:   const zoom = viewport.value.zoom;
849:   const { majorSpacing } = computeAdaptiveGridParams(zoom);
850: 
851:   // Phase 82.2: Transform intrinsic basis to paper space
852:   const origin_paper = new Vector3(0, 0, 1).applyMatrix3(planeRealization.planeToPaper2D);
853:   const u_paper = new Vector3(1, 0, 0).applyMatrix3(planeRealization.planeToPaper2D);
854:   const v_paper = new Vector3(0, 1, 0).applyMatrix3(planeRealization.planeToPaper2D);
855: 
856:   // Step 1: Determine which coordinate is more aligned with horizontal/vertical
857:   // If |u_paper.x| / |u_paper.y| > 1, u is more horizontal
858:   const uHorizontalRatio = Math.abs(u_paper.x) / (Math.abs(u_paper.y) + 1e-10);
859:   const uIsHorizontal = uHorizontalRatio > 1;
860:   
861:   // Helper: Convert screen coordinates to paper coordinates
862:   const screenToPaper = (screenX: number, screenY: number): Vector3 => {
863:     return new Vector3(
864:       screenX / zoom - viewport.value.panX,
865:       screenY / zoom - viewport.value.panY,
866:       1
867:     );
868:   };
869:   
870:   // Helper: Project paper point onto (u,v) basis
871:   const paperToUV = (p_paper: Vector3): { u: number; v: number } => {
872:     const offset = new Vector3().subVectors(p_paper, origin_paper);
873:     return {
874:       u: offset.dot(u_paper) / u_paper.lengthSq(),
875:       v: offset.dot(v_paper) / v_paper.lengthSq()
876:     };
877:   };
878:   
879:   // Helper: Find where grid line with constant u intersects a horizontal line (y_paper = constant)
880:   // Returns screen x position
