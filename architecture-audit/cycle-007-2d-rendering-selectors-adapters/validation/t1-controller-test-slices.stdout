23: function makeToolContext(overrides: Partial<ToolContext>): ToolContext {
24:   return {
25:     planeId: overrides.planeId!,
26:     planeCoords: overrides.planeCoords ?? new Vector3(0, 0, 1),
27:     canvasCoords: overrides.canvasCoords ?? { x: 0, y: 0 },
28:     commandSink: overrides.commandSink!,
29:     world: overrides.world!,
30:     interactionQuery: overrides.paper ?? new CanvasInteractionQuery([]) as any,
31:     paperToPlaneTransform: undefined,
32:     toolStore: {} as any,
33:   };
34: }
35: 
36: function arg(element: any, planeCoords = new Vector3(0, 0, 1)): ArgumentValue {
37:   return { element, planeCoords };
38: }
