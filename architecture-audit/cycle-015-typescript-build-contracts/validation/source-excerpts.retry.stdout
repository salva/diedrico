     1	/**
     2	 * HingeLine - Intersection line shared by two projection planes
     3	 * 
     4	 * A hinge line represents the physical fold between two projection planes
     5	 * (e.g., HL_HV between P_H and P_V). It is NOT used for broken hinge lines (BHLs),
     6	 * which are intersections between arbitrary 3D planes.
     7	 * 
     8	 * The hinge line exists in 3D space and automatically realizes on both planes it connects.
     9	 * Each plane gets a HingeLineRealization2D (the 2D view of the hinge line on that plane).
    10	 * 
    11	 * **Phase 52**: Refactored to extend Element3D, removing id and label properties
    12	 * which are now inherited from Element base class. Replaces `name` with `label`.
    13	 * 
    14	 */
    15	
    16	import type { ProjectionPlaneElementRealizationContext } from './projectionPlane/ProjectionPlaneContext';
    17	import { Vector3 } from 'three';
    18	import { Line2D, Line2DRealization2D } from './Line';
    19	import { Line3D } from './Line3D';
    20	import { Line3DRealization3D } from './Element3DRealization3D';
    21	import { HalfHingeLineRealization2D } from './HalfHingeLineRealization2D';
    22	import { applyMatrix4x3, applyMatrix3x4 } from '@/utils/threeUtils';
    23	
    24	/**
    25	 * HalfHingeLine2D - 2D representation of a hinge line on a specific projection plane
    26	 * 
    27	 * Each HingeLine has exactly 2 HalfHingeLine2D objects (one per plane).
    28	 * This represents how the hinge line appears in the plane's (u,v) coordinate system.
    29	 * 
    30	 * **Phase 84**: NO geometry storage - computed on demand from canonical coordinates.
    31	 * Hinge line is ALWAYS at v=0 along u-axis in plane intrinsic coordinates.
    32	 * 
    33	 * Design: HalfHingeLine2D extends Line2D so it can be used with all line operations.
    34	 * It's a fixed line (cannot be deleted) that represents the fold between planes.
    35	 * Guides reference HalfHingeLine2D (not HingeLine) because guides are perpendicular
    36	 * to the 2D representation.
    37	 * 
    38	 */
    39	export class HalfHingeLine2D extends Line2D {
    40	  readonly hingeLineId: string;  // Parent HingeLine
    41	  // Phase 84: NO geometry storage - computed via realize2D()
    42	
    43	  constructor(
    44	    id: string,
    45	    hingeLine: HingeLine,
    46	    planeId: string,
    47	    label?: string
    48	  ) {
    49	    // Create a friendly label like "HHL_{8}" from "projPlane3/line2d8"
    50	    // Extract the line number after 'line2d' (not the plane number)
    51	    const numericPart = id.match(/line2d(\d+)/)?.[1] || id.match(/\d+$/)?.[0] || id;
    52	    super(id, planeId, label || `HHL_{${numericPart}}`);
    53	    this.hingeLineId = hingeLine.id;
    54	  }
    55	
    56	  clone(): HalfHingeLine2D {
    57	    // Note: Cloning requires looking up hingeLine from world, which isn't available here
    58	    // This is a limitation of the current clone() signature
    59	    // For now, keep the ID-based approach for clone()
    60	    return new HalfHingeLine2D(
    61	      this.id,
    62	      { id: this.hingeLineId } as HingeLine,  // Minimal object with just ID
    63	      this.planeId
    64	    );
    65	  }
    66	
    67	  /**
    68	   * Get dependencies for this half hinge line
    69	   * 
    70	   * Dependencies:
    71	   * - Parent HingeLine (for 3D realization)
    72	   * - Projection plane (for transformation matrix in realize2D)
    73	   * 
    74	   * Phase 85 FIX: Must include planeId because realize2D() for plane2 calls:
    75	   *   world.getProjectionPlane3DRealization(this.planeId)
    76	   * 
    77	   * When projection plane transforms change (e.g., auxiliary plane's trace lines move),
    78	   * this half hinge line's realization must be recomputed.
    79	   */
    80	  getDependencies(): string[] {
    81	    // Depend on both the parent HingeLine AND the projection plane
    82	    // The plane dependency is critical for plane2 half-hinge lines that project back
    83	    return [this.hingeLineId, this.planeId];
    84	  }
    85	
    86	  /**
    87	   * Find the sibling HalfHingeLine2D in the other plane.
    88	   * 
    89	   * Static method for navigating from one HalfHingeLine2D to its sibling
    90	   * in the paired projection plane. Used when creating sibling elements
    91	   * (guides, intersection points, etc.)
    92	   * 
    93	   * Navigation: HalfHingeLine2D → HingeLine → getOtherPlane() → find matching HHL
    94	   * 
    95	   * @param world World instance to navigate
    96	   * @param halfHingeLineId ID of the HalfHingeLine2D in the current plane
    97	   * @param currentPlaneId ID of the current plane
    98	   * @returns Object with siblingPlaneId and siblingHalfHingeLineId, or undefined if not a HHL
    99	   */
   100	  static getSiblingInfo(
   101	    world: ProjectionPlaneElementRealizationContext,
   102	    halfHingeLineId: string,
   103	    currentPlaneId: string
   104	  ): { siblingPlaneId: string; siblingHalfHingeLineId: string } | undefined {
   105	    // Get current plane and HalfHingeLine2D
   106	    const currentPlane = world.getProjectionPlaneById(currentPlaneId)!;
   107	    const halfHingeLine = currentPlane.getLine(halfHingeLineId);
   108	    
   109	    if (!halfHingeLine || !(halfHingeLine instanceof HalfHingeLine2D)) {
   110	      return undefined;
   111	    }
   112	
   113	    // Get parent HingeLine and sibling plane
   114	    const hingeLine = world.getHingeLineById(halfHingeLine.hingeLineId)!;
   115	    const siblingPlaneId = hingeLine.getOtherPlane(currentPlaneId)!;
   116	    const siblingPlane = world.getProjectionPlaneById(siblingPlaneId)!;
   117	
   118	    // Find HalfHingeLine2D with same hingeLineId in sibling plane
   119	    const siblingHalfHingeLine = siblingPlane.getAllLines().find(
   120	      (line): line is HalfHingeLine2D => line instanceof HalfHingeLine2D && line.hingeLineId === halfHingeLine.hingeLineId
   121	    )!;
   122	
   123	    return {
   124	      siblingPlaneId,
   125	      siblingHalfHingeLineId: siblingHalfHingeLine.id
   126	    };
   127	  }
   128	
   129	  /**
   130	   * Realize this half-hinge line using canonical coordinates (Phase 84)
   131	   * 
   132	   * Returns HalfHingeLineRealization2D with line geometry and guideVector.
   133	   * guideVector is PERPENDICULAR to the hinge line (for regular hinge lines).
   134	   * 
   135	   * **Phase 84 Architecture**:
   136	   * - Plane1: Returns canonical coordinates (0,0,1) and (1,0,0) directly
   137	   * - Plane2: Projects 3D line back to plane2 using applyMatrix3x4()
   138	   * 
   139	   * **Phase 101**: Returns HalfHingeLineRealization2D with guideVector
   140	   * - guideVector is perpendicular to hinge line direction
   141	   * - Guide2D uses this vector to create guides
   142	   * 
   143	   * @param world World instance for accessing HingeLine and plane realizations
   144	   */
   145	  realize2D(world: ProjectionPlaneElementRealizationContext): HalfHingeLineRealization2D {
   146	    const hingeLine = world.getHingeLineById(this.hingeLineId)!;
   147	
   148	    // Plane1: Return canonical coordinates directly
   149	    if (this.planeId === hingeLine.plane1Id) {
   150	      // Check feasibility of underlying Plane3D (if projection plane has one)
   151	      const projPlane1 = world.getProjectionPlaneById(hingeLine.plane1Id)!;
   152	      if (projPlane1.plane3DId) {
   153	        const plane3DReal = world.get3DPlaneRealization(projPlane1.plane3DId)!;
   154	        if (!plane3DReal.isFeasible()) {
   155	          // Return infeasible realization instead of throwing
   156	          return HalfHingeLineRealization2D.createInfeasible();
   157	        }
   158	      }
   159	
   160	      const hingeDirection = new Vector3(1, 0, 0);  // Canonical u-axis direction
   161	      const guideVector = new Vector3(0, 1, 0);     // Perpendicular (v-axis direction)
   162	
   163	      return new HalfHingeLineRealization2D(
   164	        new Vector3(0, 0, 1),    // Canonical origin
   165	        hingeDirection,           // Hinge line direction
   166	        guideVector,              // Perpendicular for guides
   167	        true                      // feasible
   168	      );
   169	    }
   170	
   171	    // Plane2: Project 3D line back to plane2
   172	    const line3D = hingeLine.realize3D(world);
   173	    const plane2Real = world.getProjectionPlane3DRealization(this.planeId)!;
   174	
   175	    // Check feasibility of 3D line (depends on plane1)
   176	    if (!line3D.isFeasible()) {
   177	      // Return infeasible realization instead of throwing
   178	      return HalfHingeLineRealization2D.createInfeasible();
   179	    }
   180	
   181	    const origin2D = applyMatrix3x4(line3D.point, plane2Real.threeDToPlane);
   182	    const direction2D = applyMatrix3x4(line3D.direction, plane2Real.threeDToPlane);
   183	    
   184	    // Compute perpendicular guide vector
   185	    const guideVector = new Vector3(-direction2D.y, direction2D.x, 0).normalize();
   186	    
   187	    return new HalfHingeLineRealization2D(
   188	      origin2D,
   189	      direction2D,
   190	      guideVector,
   191	      true  // feasible
   192	    );
   193	  }
   194	}
   195	
   196	/**
   197	 * HingeLine - Physical fold between two projection planes
   198	 * 
   199	 * The hinge line is a 3D element that automatically appears on both planes it connects.
   200	 * It cannot be deleted and is not stored as Line2D entities - it's a fixed element.
   201	 * 
   202	 * Each HingeLine has exactly 2 HalfHingeLine2D objects (one per plane) that represent
   203	 * how the hinge line appears in each plane's (u,v) coordinate system. These HalfHingeLine2D
   204	 * objects are owned by their respective ProjectionPlane objects.
   205	 * 
   206	 * **Phase 52**: Refactored to extend Element3D. Inherits id and label from Element.
   207	 * **Phase 84**: NO geometry storage - computed on demand from canonical coordinates (0,0,1), (1,0,0).
   208	 * Extends Line3D base class to share realization pattern with other 3D lines.
   209	 */
   210	export class HingeLine extends Line3D {
   211	  readonly plane1Id: string;  // Reference plane (canonical coords source)
   212	  readonly plane2Id: string;  // Second projection plane
   213	
   214	  constructor(
   215	    id: string,
   216	    label: string,
   217	    plane1Id: string,
   218	    plane2Id: string
   219	  ) {
   220	    // Phase 52: Call Element3D constructor with id and label
   221	    super(id, label);
   222	    
   223	    if (plane1Id === plane2Id) {
   224	      throw new Error('HingeLine: plane1 and plane2 must be distinct');
   225	    }
   226	
   227	    this.plane1Id = plane1Id;
   228	    this.plane2Id = plane2Id;
   229	  }
   230	
   231	  /**
   232	   * Compute 3D realization using canonical coordinates (Phase 84)
   233	   * 
   234	   * Transforms canonical coordinates (0,0,1) origin and (1,0,0) u-axis direction
   235	   * from plane1 to 3D using applyMatrix4x3().
   236	   * 
   237	   * Returns Line3DRealization3D with point and direction in 3D domain coordinates (Vector4).
   238	   */
   239	  realize3D(world: ProjectionPlaneElementRealizationContext): Line3DRealization3D {
   240	    const projPlane1 = world.getProjectionPlaneById(this.plane1Id);
   241	    const projPlane2 = world.getProjectionPlaneById(this.plane2Id);
   242	
   243	    // Check that both planes exist (structural integrity)
   244	    if (!projPlane1 || !projPlane2) {
   245	      const errorInfo = {
   246	        hingeLineId: this.id,
   247	        hingeLineLabel: this.label,
   248	        plane1Id: this.plane1Id,
   249	        plane2Id: this.plane2Id,
   250	        projPlane1Exists: !!projPlane1,
   251	        projPlane2Exists: !!projPlane2,
   252	        allProjectionPlanes: world.getAllProjectionPlanes().map(p => ({ id: p.id })),
   253	        allHingeLines: world.getAllHingeLines().map(hl => ({ 
   254	          id: hl.id, 
   255	          label: hl.label, 
   256	          plane1Id: hl.plane1Id, 
   257	          plane2Id: hl.plane2Id 
   258	        }))
   259	      };
   260	      console.error(`[HingeLine.realize3D] CRITICAL: HingeLine references non-existent projection plane(s)`, errorInfo);
--- frontend/src/commands/operations/world/UpdateElementStyleOp.ts
     1	/**
     2	 * UpdateElementStyleOp - Operation to update visual style properties of an element
     3	 * 
     4	 * Updates style properties (color, lineWidth, lineStyle, visibility) of a geometric element.
     5	 * Style changes are undoable by storing previous values.
     6	 * 
     7	 * Phase 83: Now actually updates element.visualStyle property
     8	 * 
     9	 */
    10	
    11	import type { IOperation, OperationResult } from '../IOperation';
    12	import type { World } from '@/domain/world/World';
    13	import type { VisualStyle } from '@/domain/world/VisualStyle';
    14	import { createVisualStyle } from '@/domain/world/VisualStyle';
    15	
    16	/**
    17	 * Style properties that can be updated
    18	 */
    19	interface StyleProperties {
    20	  color?: string;
    21	  lineWidth?: number;
    22	  lineStyle?: 'solid' | 'dashed' | 'dotted';
    23	  opacity?: number;
    24	  visible?: boolean;
    25	}
    26	
    27	/**
    28	 * UpdateElementStyleOp - Updates element visual style
    29	 * 
    30	 * Per data-model.md Command Pattern: All logic belongs in Operations, not Command subclasses.
    31	 * This operation implements the apply/undo pattern for style updates.
    32	 */
    33	export class UpdateElementStyleOp implements IOperation {
    34	  readonly type = 'UpdateElementStyle';
    35	  readonly parameters: Record<string, any>;
    36	  outputs: Record<string, any> = {};
    37	  
    38	  private previousStyle: VisualStyle | undefined = undefined;
    39	
    40	  constructor(
    41	    private elementId: string,
    42	    private planeId: string,
    43	    private newStyle: StyleProperties
    44	  ) {
    45	    this.parameters = { elementId, planeId, newStyle };
    46	  }
    47	
    48	  apply(world: World): OperationResult {
    49	    try {
    50	      // Get the plane containing the element
    51	      const plane = world.getProjectionPlaneById(this.planeId);
    52	      if (!plane) {
    53	        throw new Error(`Plane not found: ${this.planeId}`);
    54	      }
    55	
    56	      // Try to find element (could be point, line, circle, etc.)
    57	      let element = plane.getPoint(this.elementId);
    58	      if (!element) {
    59	        element = plane.getLine(this.elementId);
    60	      }
    61	      if (!element) {
    62	        element = plane.getCircle(this.elementId);
    63	      }
    64	      
    65	      if (!element) {
    66	        throw new Error(`Element not found: ${this.elementId}`);
    67	      }
    68	
    69	      // Store previous style for undo (clone it)
    70	      this.previousStyle = element.visualStyle ? { ...element.visualStyle } : undefined;
    71	      
    72	      // Create or update visualStyle
    73	      if (!element.visualStyle) {
    74	        // Element has no style yet, create one with defaults
    75	        element.visualStyle = createVisualStyle();
    76	      }
    77	      
    78	      // Apply new style properties (only update provided properties)
    79	      if (this.newStyle.color !== undefined) {
    80	        element.visualStyle.color = this.newStyle.color;
    81	      }
    82	      if (this.newStyle.lineWidth !== undefined) {
    83	        element.visualStyle.lineWidth = this.newStyle.lineWidth;
    84	      }
    85	      if (this.newStyle.lineStyle !== undefined) {
    86	        element.visualStyle.lineStyle = this.newStyle.lineStyle;
    87	      }
    88	      if (this.newStyle.opacity !== undefined) {
    89	        element.visualStyle.opacity = this.newStyle.opacity;
    90	      }
    91	      if (this.newStyle.visible !== undefined) {
    92	        element.visualStyle.visible = this.newStyle.visible;
    93	      }
    94	      
    95	      return {
    96	        success: true,
    97	        outputs: { elementId: this.elementId }
    98	      };
    99	    } catch (error) {
   100	      return {
   101	        success: false,
   102	        outputs: {},
   103	        error: error instanceof Error ? error.message : String(error)
   104	      };
   105	    }
   106	  }
   107	
   108	  undo(world: World): void {
   109	    try {
   110	      // Get the plane and element
   111	      const plane = world.getProjectionPlaneById(this.planeId);
   112	      if (!plane) {
   113	        console.error('[UpdateElementStyleOp] Cannot undo: Plane not found:', this.planeId);
   114	        return;
   115	      }
   116	
   117	      let element = plane.getPoint(this.elementId);
   118	      if (!element) {
   119	        element = plane.getLine(this.elementId);
   120	      }
   121	      if (!element) {
   122	        element = plane.getCircle(this.elementId);
   123	      }
   124	      
   125	      if (!element) {
   126	        console.error('[UpdateElementStyleOp] Cannot undo: Element not found:', this.elementId);
   127	        return;
   128	      }
   129	
   130	      // Restore previous style
   131	      element.visualStyle = this.previousStyle ? { ...this.previousStyle } : undefined;
   132	      
   133	    } catch (error) {
   134	      console.error('[UpdateElementStyleOp] Undo failed:', error);
   135	    }
   136	  }
   137	
   138	  serialize() {
   139	    return {
   140	      opType: this.type,
   141	      elementId: this.elementId,
   142	      planeId: this.planeId,
   143	      newStyle: this.newStyle,
   144	      outputs: this.outputs
   145	    };
   146	  }
   147	}
--- frontend/src/commands/operations/world/AddLineOp.ts
     1	/**
     2	 * AddLine2DByTwoPointsOp - Operation to add a Line2DByTwoPoints using ProjectionPlane factory method
     3	 * 
     4	 * Wraps ProjectionPlane.addLine2DBetweenTwoPoints() in the Operation interface.
     5	 */
     6	
     7	import type { IOperation, OperationResult } from '../IOperation';
     8	import type { World } from '@/domain/world/World';
     9	
    10	export class AddLine2DByTwoPointsOp implements IOperation {
    11	  readonly type = 'AddLine2DByTwoPoints';
    12	  readonly parameters: Record<string, any>;
    13	  outputs: Record<string, any> = {};
    14	
    15	  constructor(
    16	    private planeId: string,
    17	    private point1Id: string,
    18	    private point2Id: string
    19	  ) {
    20	    this.parameters = { planeId, point1Id, point2Id };
    21	  }
    22	
    23	  apply(world: World): OperationResult {
    24	    try {
    25	      const plane = world.getProjectionPlaneById(this.planeId);
    26	      if (!plane) {
    27	        throw new Error(`Plane not found: ${this.planeId}`);
    28	      }
    29	      
    30	      // Pass stored ID if available (for redo), otherwise let plane generate new one
    31	      const line = plane.addLine2DBetweenTwoPoints(
    32	        this.point1Id,
    33	        this.point2Id,
    34	        world,
    35	        this.outputs.lineId
    36	      );
    37	      this.outputs = { lineId: line.id };
    38	      return {
    39	        success: true,
    40	        outputs: this.outputs
    41	      };
    42	    } catch (error) {
    43	      return {
    44	        success: false,
    45	        outputs: {},
    46	        error: error instanceof Error ? error.message : String(error)
    47	      };
    48	    }
    49	  }
    50	
    51	  undo(world: World): void {
    52	    if (this.outputs.lineId) {
    53	      const plane = world.getProjectionPlaneById(this.planeId);
    54	      if (plane) {
    55	        plane.removeLine(this.outputs.lineId);
    56	      }
    57	    }
    58	  }
    59	
    60	  serialize() {
    61	    return {
    62	      opType: this.type,
    63	      planeId: this.planeId,
    64	      point1Id: this.point1Id,
    65	      point2Id: this.point2Id,
    66	      lineId: this.outputs.lineId
    67	    };
    68	  }
    69	}
    70	
    71	/**
    72	 * AddLine2DParallelToLineOp - Operation to add a Line2DParallel using ProjectionPlane factory method
    73	 * 
    74	 * Wraps ProjectionPlane.addLine2DParallelToLine() in the Operation interface.
    75	 */
    76	export class AddLine2DParallelToLineOp implements IOperation {
    77	  readonly type = 'AddLine2DParallelToLine';
    78	  readonly parameters: Record<string, any>;
    79	  outputs: Record<string, any> = {};
    80	
    81	  constructor(
    82	    private planeId: string,
    83	    private referenceLineId: string,
    84	    private throughPointId: string
    85	  ) {
    86	    this.parameters = { planeId, referenceLineId, throughPointId };
    87	  }
    88	
    89	  apply(world: World): OperationResult {
    90	    try {
    91	      const plane = world.getProjectionPlaneById(this.planeId);
    92	      if (!plane) {
    93	        throw new Error(`Plane not found: ${this.planeId}`);
    94	      }
    95	      
    96	      // Pass stored ID if available (for redo), otherwise let plane generate new one
