--- frontend/src/components/panels/ActionItem.vue
     1	<template>
     2	  <div
     3	    class="action-item"
     4	    :class="{
     5	      'infeasible': action.infeasible
     6	    }"
     7	    :title="action.infeasible ? `Infeasible: ${action.infeasibilityReason || 'Constraint violation'}` : ''"
     8	  >
     9	    <div class="action-header">
    10	      <span class="action-type">{{ formatActionType(action.actionType) }}</span>
    11	      <span class="timestamp">{{ formatTime(action.timestamp) }}</span>
    12	    </div>
    13	    <!-- Phase 92: Display elementId instead of outputs array -->
    14	    <div v-if="action.elementId" class="action-outputs">
    15	      <span class="label">Element:</span>
    16	      <span class="outputs">{{ action.elementId }}</span>
    17	    </div>
    18	    <div class="action-description">
    19	      <span class="description">{{ action.description }}</span>
    20	    </div>
    21	  </div>
    22	</template>
    23	
    24	<script setup lang="ts">
    25	import type { Action } from '../../domain/processTree/Action';
    26	import { ActionType } from '../../domain/processTree/Action';
    27	
    28	interface Props {
    29	  action: Action;
    30	}
    31	
    32	const props = defineProps<Props>();
    33	
    34	/**
    35	 * Format ActionType enum to readable string
    36	 */
    37	function formatActionType(actionType: ActionType): string {
    38	  // Convert CamelCase to Title Case with spaces
    39	  return actionType
    40	    .replace(/([A-Z])/g, ' $1')
    41	    .trim();
    42	}
    43	
    44	/**
    45	 * Format timestamp to time string
    46	 */
    47	function formatTime(date: Date): string {
    48	  return date.toLocaleTimeString('en-US', {
    49	    hour: '2-digit',
    50	    minute: '2-digit',
    51	    second: '2-digit'
    52	  });
    53	}
    54	</script>
    55	
    56	<style scoped>
    57	.action-item {
    58	  padding: 6px 8px;
    59	  background-color: var(--color-background);
    60	  border: 1px solid var(--color-border);
    61	  border-radius: 3px;
    62	  margin-bottom: 2px;
    63	  font-size: 12px;
    64	  transition: background-color 0.2s ease;
    65	}
    66	
    67	.action-item:hover {
    68	  background-color: var(--color-background-soft);
    69	}
    70	
    71	.action-item.infeasible {
    72	  border-color: var(--color-error);
    73	  background-color: rgba(255, 0, 0, 0.05);
    74	}
    75	
    76	.action-header {
    77	  display: flex;
    78	  justify-content: space-between;
    79	  align-items: center;
    80	  margin-bottom: 4px;
    81	}
    82	
    83	.action-type {
    84	  font-weight: 600;
    85	  color: var(--color-heading);
    86	}
    87	
    88	.action-item.infeasible .action-type {
    89	  color: var(--color-error);
    90	}
    91	
    92	.timestamp {
    93	  font-size: 11px;
    94	  color: var(--color-text-muted);
    95	  font-family: monospace;
    96	}
    97	
    98	.action-outputs,
    99	.action-inputs {
   100	  display: flex;
   101	  gap: 4px;
   102	  font-size: 11px;
   103	  margin-top: 2px;
   104	}
   105	
   106	.label {
   107	  color: var(--color-text-muted);
   108	  font-weight: 500;
   109	}
   110	
   111	.outputs,
   112	.inputs {
   113	  color: var(--color-text);
   114	  font-family: monospace;
   115	}
   116	</style>
--- frontend/src/components/panels/ActionGroupItem.vue
     1	<template>
     2	  <div class="action-group-item">
     3	    <!-- Subprocess -->
     4	    <div v-if="node.type === 'subprocess'" class="subprocess-item">
     5	      <div class="subprocess-header" @click="toggleExpanded">
     6	        <span class="expand-icon" :class="{ expanded: isExpanded }">▶</span>
     7	        <span class="subprocess-name">{{ node.name }}</span>
     8	        <span class="subprocess-count">({{ childCount }})</span>
     9	      </div>
    10	      <div v-if="isExpanded" class="subprocess-children">
    11	        <ActionGroupItem
    12	          v-for="child in node.children"
    13	          :key="child.id"
    14	          :node="child"
    15	        />
    16	      </div>
    17	    </div>
    18	
    19	    <!-- Action Group -->
    20	    <div v-else-if="node.type === 'actionGroup'" class="action-group">
    21	      <div class="action-group-header" @click="toggleExpanded">
    22	        <span class="expand-icon" :class="{ expanded: isExpanded }">▶</span>
    23	        <span class="action-group-label">Group</span>
    24	        <span class="action-count">({{ node.children.length }} actions)</span>
    25	        <span class="timestamp">{{ formatTime(node.created) }}</span>
    26	      </div>
    27	      <div v-if="isExpanded" class="action-group-children">
    28	        <ActionItem
    29	          v-for="action in node.children"
    30	          :key="action.id"
    31	          :action="action"
    32	        />
    33	      </div>
    34	    </div>
    35	
    36	    <!-- Single Action (if passed directly) -->
    37	    <ActionItem
    38	      v-else-if="node.type === 'action'"
    39	      :action="node"
    40	    />
    41	  </div>
    42	</template>
    43	
    44	<script setup lang="ts">
    45	import { ref, computed } from 'vue';
    46	import type { Subprocess } from '../../domain/processTree/Subprocess';
    47	import type { ActionGroup } from '../../domain/processTree/ActionGroup';
    48	import type { ConstructiveAction } from '../../domain/processTree/Action';
    49	import ActionItem from './ActionItem.vue';
    50	
    51	// Allow recursive component
    52	import ActionGroupItem from './ActionGroupItem.vue';
    53	
    54	interface Props {
    55	  node: Subprocess | ActionGroup | ConstructiveAction;
    56	}
    57	
    58	const props = defineProps<Props>();
    59	
    60	const isExpanded = ref(true);
    61	
    62	/**
    63	 * Count children for subprocess
    64	 */
    65	const childCount = computed(() => {
    66	  if (props.node.type === 'subprocess') {
    67	    return props.node.children.length;
    68	  }
    69	  return 0;
    70	});
    71	
    72	/**
    73	 * Toggle expanded/collapsed state
    74	 */
    75	function toggleExpanded() {
    76	  isExpanded.value = !isExpanded.value;
    77	}
    78	
    79	/**
    80	 * Format timestamp to time string
    81	 */
    82	function formatTime(date: Date): string {
    83	  return date.toLocaleTimeString('en-US', {
    84	    hour: '2-digit',
    85	    minute: '2-digit',
    86	    second: '2-digit'
    87	  });
    88	}
    89	</script>
    90	
    91	<style scoped>
    92	.action-group-item {
    93	  width: 100%;
    94	}
    95	
    96	/* Subprocess styling */
    97	.subprocess-item {
    98	  margin-bottom: 8px;
    99	}
   100	
   101	.subprocess-header {
