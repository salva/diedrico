     1	<template>
     2	  <div v-if="isOpen" class="dialog-overlay" @click="handleOverlayClick">
     3	    <div class="dialog-content" @click.stop>
     4	      <h2 class="dialog-title">New Project</h2>
     5	      
     6	      <form @submit.prevent="handleSubmit">
     7	        <div class="form-group">
     8	          <label for="project-name">Project Name</label>
     9	          <input
    10	            id="project-name"
    11	            v-model="projectName"
    12	            type="text"
    13	            placeholder="Enter project name..."
    14	            class="form-input"
    15	            autofocus
    16	            required
    17	          />
    18	        </div>
    19	
    20	        <div class="dialog-actions">
    21	          <button type="button" class="btn btn-secondary" @click="handleCancel">
    22	            Cancel
    23	          </button>
    24	          <button
    25	            type="submit"
    26	            class="btn btn-primary"
    27	            :disabled="!projectName.trim() || isCreating"
    28	          >
    29	            {{ isCreating ? 'Creating...' : 'Create Project' }}
    30	          </button>
    31	        </div>
    32	      </form>
    33	
    34	      <div v-if="error" class="error-message">
    35	        {{ error }}
    36	      </div>
    37	    </div>
    38	  </div>
    39	</template>
    40	
    41	<script setup lang="ts">
    42	import { ref, watch } from 'vue';
    43	import { ProjectService } from '../../services/ProjectService';
    44	
    45	const props = defineProps<{
    46	  isOpen: boolean;
    47	}>();
    48	
    49	const emit = defineEmits<{
    50	  close: [];
    51	  created: [projectId: string];
    52	}>();
    53	
    54	const projectName = ref('');
    55	const isCreating = ref(false);
    56	const error = ref('');
    57	
    58	// Reset form when dialog opens
    59	watch(() => props.isOpen, (isOpen) => {
    60	  if (isOpen) {
    61	    projectName.value = '';
    62	    error.value = '';
    63	    isCreating.value = false;
    64	  }
    65	});
    66	
    67	async function handleSubmit() {
    68	  if (!projectName.value.trim() || isCreating.value) return;
    69	
    70	  isCreating.value = true;
    71	  error.value = '';
    72	
    73	  try {
    74	    const project = await new ProjectService().createProject(projectName.value.trim());
    75	    emit('created', project.id);
    76	    emit('close');
    77	  } catch (err: any) {
    78	    error.value = err.message || 'Failed to create project';
    79	    isCreating.value = false;
    80	  }
    81	}
    82	
    83	function handleCancel() {
    84	  emit('close');
    85	}
    86	
    87	function handleOverlayClick() {
    88	  if (!isCreating.value) {
    89	    emit('close');
    90	  }
    91	}
    92	</script>
