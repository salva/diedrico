    44	<script setup lang="ts">
    45	import { ref, computed } from 'vue';
    46	import type { Subprocess } from '../../domain/processTree/Subprocess';
    47	import type { ActionGroup } from '../../domain/processTree/ActionGroup';
    48	import type { ConstructiveAction } from '../../domain/processTree/Action';
    49	import ActionItem from './ActionItem.vue';
    50	
    51	// Allow recursive component
    52	import ActionGroupItem from './ActionGroupItem.vue';
    53	
    54	interface Props {
    55	  node: Subprocess | ActionGroup | ConstructiveAction;
    56	}
    57	
    58	const props = defineProps<Props>();
    59	
    60	const isExpanded = ref(true);
    61	
    62	/**
    63	 * Count children for subprocess
    64	 */
    65	const childCount = computed(() => {
    66	  if (props.node.type === 'subprocess') {
    67	    return props.node.children.length;
    68	  }
    69	  return 0;
    70	});
    71	
    72	/**
    73	 * Toggle expanded/collapsed state
    74	 */
    75	function toggleExpanded() {
    76	  isExpanded.value = !isExpanded.value;
    77	}
    78	
    79	/**
    80	 * Format timestamp to time string
    81	 */
    82	function formatTime(date: Date): string {
    83	  return date.toLocaleTimeString('en-US', {
    84	    hour: '2-digit',
    85	    minute: '2-digit',
    86	    second: '2-digit'
    87	  });
    88	}
    89	</script>
    90	
