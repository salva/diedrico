   192	<script setup lang="ts">
   193	import { ref, computed, nextTick } from 'vue';
   194	import type { ProcessNode } from '@/domain/processTree/ProcessTree';
   195	import type { World } from '@/domain/world/World';
   196	import { formatElementLabel } from '@/utils/formatUtils';
   197	import { getActionDescriptionParts } from '@/domain/processTree/Action';
