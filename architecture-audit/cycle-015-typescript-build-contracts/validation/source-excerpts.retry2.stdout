---frontend/src/commands/factories/DeletionSequenceFactory.ts
     1	/**
     2	 * DeletionSequenceFactory - Factory for cascade deletion sequences
     3	 * 
     4	 * Encapsulates the complex cascade deletion logic:
     5	 * 1. Compute dependency cascade (dependents before dependencies)
     6	 * 2. Sort elements in proper deletion order (reverse topological)
     7	 * 3. Add type-specific RemoveElementOp for each element
     8	 * 4. Remove corresponding ProcessTree actions
     9	 * 
    10	 * Design: This factory follows the Open Command pattern:
    11	 * - Receives open Command object
    12	 * - Adds operations via cmd.addAndExecute()
    13	 * - Returns void (caller handles commit/push/feedback)
    14	 * - Encapsulates complex cascade logic
    15	 * 
    16	 * CRITICAL: Elements must be deleted in reverse topological order to maintain
    17	 * referential integrity (dependents first, roots last).
    18	 * 
    19	 */
    20	
    21	import type { Command } from '@/commands/Command';
    22	import type { World } from '@/domain/world/World';
    23	import { 
    24	  RemovePoint2DOp, 
    25	  RemoveLine2DOp, 
    26	  RemoveSegment2DOp, 
    27	  RemoveCircle2DOp, 
    28	  RemoveGuide2DOp 
    29	} from '@/commands/operations/world/RemoveElementOps';
    30	import { RemoveActionFromProcessTreeOp } from '@/commands/operations/processTree/ProcessTreeOperations';
    31	import { Segment2DByPoints } from '@/domain/world/Segment';
    32	import { Guide2D, SiblingGuide2D } from '@/domain/world/Guide';
    33	
    34	/**
    35	 * DeletionSequenceFactory - Factory for cascade deletion sequences
    36	 * 
    37	 * Encapsulates multi-element deletion logic extracted from App.vue lines 660-760.
    38	 * Handles cascade computation, topological sorting, and operation sequencing.
    39	 */
    40	export class DeletionSequenceFactory {
    41	  /**
    42	   * Create cascade deletion sequence for selected elements
    43	   * 
    44	   * Algorithm:
    45	   * 1. Compute cascade using dependency service (get all dependent elements)
    46	   * 2. Sort elements in deletion order (dependents first, roots last)
    47	   * 3. Add type-specific RemoveElementOp for each element
    48	   * 4. Add RemoveActionFromProcessTreeOp for each producing action
    49	   * 
    50	   * @param cmd - Open command to add operations to
    51	   * @param selectedIds - IDs of elements user wants to delete
    52	   * @param world - World instance for element lookup and dependency analysis
    53	   */
    54	  static createCascadeDeletion(
    55	    cmd: Command,
    56	    selectedIds: string[],
    57	    world: World
    58	  ): void {
    59	    // Step 1: Compute cascade and get elements in proper deletion order
    60	    const dependencyService = world.getDependencyService();
    61	    const allElementsToDelete = dependencyService.getElementsInDeletionOrder(selectedIds);
    62	    
    63	    const cascadedElements = allElementsToDelete.filter(id => !selectedIds.includes(id));
    64	    
    65	    console.log('[DeletionSequenceFactory] Cascade deletion:', {
    66	      direct: selectedIds,
    67	      cascaded: cascadedElements,
    68	      total: allElementsToDelete,
    69	      order: 'dependents-first (proper deletion order)'
    70	    });
    71	    
    72	    // Step 2: Find all actions that produce these elements
    73	    const processTree = world.getProcessTree();
    74	    const actionsToDelete = new Map<string, string[]>();
    75	    
    76	    for (const elementId of allElementsToDelete) {
    77	      const actions = processTree.getActionsProducingElement(elementId);
    78	      if (actions.length === 0) {
    79	        console.warn(`[DeletionSequenceFactory] Element ${elementId} has no producing action - skipping`);
    80	        continue;
    81	      }
    82	      
    83	      for (const action of actions) {
    84	        const actionNode = processTree.getActionsProducingElement(elementId).find(a => a.elementId === elementId);
    85	        const actionKey = actionNode?.elementId ?? elementId;
    86	        if (!actionsToDelete.has(actionKey)) {
    87	          actionsToDelete.set(actionKey, []);
    88	        }
    89	        actionsToDelete.get(actionKey)!.push(elementId);
    90	      }
    91	    }
    92	    
    93	    // Step 3: Add operations to command in proper order
    94	    // Search through projection planes to find each element and determine its type
    95	    for (const elementId of allElementsToDelete) {
    96	      let found = false;
    97	      
    98	      // Search in all projection planes
    99	      for (const [planeId, plane] of world.projectionPlanes.entries()) {
   100	        // Check if it's a point
   101	        const point = plane.getPoint(elementId);
   102	        if (point) {
   103	          cmd.addAndExecute(new RemovePoint2DOp(planeId, elementId));
   104	          found = true;
   105	          break;
   106	        }
   107	        
   108	        // Check if it's a line (includes segments and guides)
   109	        const line = plane.getLine(elementId);
   110	        if (line) {
   111	          // Determine specific line subtype using instanceof for type-safe dispatch
   112	          if (line instanceof Segment2DByPoints) {
   113	            cmd.addAndExecute(new RemoveSegment2DOp(planeId, elementId));
   114	          } else if (line instanceof Guide2D || line instanceof SiblingGuide2D) {
   115	            cmd.addAndExecute(new RemoveGuide2DOp(planeId, elementId));
   116	          } else {
   117	            cmd.addAndExecute(new RemoveLine2DOp(planeId, elementId));
   118	          }
   119	          found = true;
   120	          break;
   121	        }
   122	        
   123	        // Check if it's a circle
   124	        const circle = plane.getCircle(elementId);
   125	        if (circle) {
   126	          cmd.addAndExecute(new RemoveCircle2DOp(planeId, elementId));
   127	          found = true;
   128	          break;
   129	        }
   130	      }
   131	      
   132	      if (!found) {
   133	        console.warn(`[DeletionSequenceFactory] Element ${elementId} not found in any plane`);
   134	      }
   135	    }
   136	    
   137	    // Step 4: Remove actions from ProcessTree (creates tombstones for undo)
   138	    for (const [actionId, _] of actionsToDelete) {
   139	      cmd.addAndExecute(new RemoveActionFromProcessTreeOp(actionId));
   140	    }
   141	  }
   142	}
---frontend/src/commands/operations/processTree/PushSubprocessOp.ts
     1	/**
     2	 * PushSubprocessOp - Push subprocess onto ProcessTree stack
     3	 * 
     4	 * Creates a new subprocess and pushes it onto the ProcessTree subprocess stack.
     5	 * All subsequent actions will be added to this subprocess until it is popped.
     6	 * 
     7	 * Phase 85: ProcessTree Subprocess Stack Architecture
     8	 */
     9	
    10	import type { IOperation, OperationResult } from '../IOperation';
    11	import type { World } from '@/domain/world/World';
    12	
    13	export class PushSubprocessOp implements IOperation {
    14	  readonly type = 'PushSubprocess';
    15	  parameters: Record<string, any>;
    16	  outputs: Record<string, any> = {};
    17	
    18	  constructor(private readonly subprocessName: string, private subprocessId?: string) {
    19	    this.parameters = { subprocessName };
    20	    // If subprocessId provided (during deserialization), store it in outputs
    21	    if (subprocessId) {
    22	      this.outputs = { subprocessId };
    23	    }
    24	  }
    25	
    26	  apply(world: World): OperationResult {
    27	    // On replay (deserialization), reuse the stored subprocessId from outputs
    28	    // This ensures toggle operations can find the correct subprocess
    29	    const existingId = this.outputs.subprocessId;
    30	    const subprocess = world.getProcessTree().pushSubprocess(this.subprocessName, existingId);
    31	    this.outputs = { subprocessId: subprocess.id };
    32	    return { success: true, outputs: this.outputs };
    33	  }
    34	
    35	  undo(world: World): void {
    36	    // Undo by popping the subprocess from the stack
    37	    world.getProcessTree().popSubprocess();
    38	  }
    39	
    40	  serialize() {
    41	    return { opType: this.type, subprocessName: this.parameters.subprocessName, subprocessId: this.outputs.subprocessId, outputs: this.outputs };
    42	  }
    43	}
---frontend/src/commands/operations/processTree/RenameSubprocessOp.ts
     1	/**
     2	 * RenameSubprocessOp - Rename a subprocess in the ProcessTree
     3	 */
     4	
     5	import type { IOperation, OperationResult } from '../IOperation';
     6	import type { World } from '@/domain/world/World';
     7	
     8	export class RenameSubprocessOp implements IOperation {
     9	  readonly type = 'RenameSubprocess';
    10	  parameters: Record<string, any>;
    11	  outputs: Record<string, any> = {};
    12	  private oldName: string | null = null;
    13	
    14	  constructor(private readonly subprocessId: string, private readonly newName: string) {
    15	    this.parameters = { subprocessId, newName };
    16	  }
    17	
    18	  apply(world: World): OperationResult {
    19	    const processTree = world.getProcessTree();
    20	    const subprocess = processTree.findSubprocessById(this.subprocessId);
    21	    
    22	    if (!subprocess) {
    23	      return { success: false, error: `Subprocess not found: ${this.subprocessId}` };
    24	    }
    25	
    26	    if (this.oldName === null) {
    27	      this.oldName = subprocess.name;
    28	    }
    29	
    30	    processTree.renameSubprocess(this.subprocessId, this.newName);
    31	    return { success: true, outputs: this.outputs };
    32	  }
    33	
    34	  undo(world: World): void {
    35	    if (this.oldName !== null) {
    36	      const processTree = world.getProcessTree();
    37	      processTree.renameSubprocess(this.subprocessId, this.oldName);
    38	    }
    39	  }
    40	
    41	  redo(world: World): void {
    42	    const processTree = world.getProcessTree();
    43	    processTree.renameSubprocess(this.subprocessId, this.newName);
    44	  }
    45	
    46	  serialize() {
    47	    return { opType: this.type, subprocessId: this.parameters.subprocessId, newName: this.parameters.newName };
    48	  }
    49	}
---frontend/src/stores/processStore.ts
     1	import { defineStore } from 'pinia';
     2	import type { Process } from '../domain/processTree/Process';
     3	import type { Subprocess } from '../domain/processTree/Subprocess';
     4	import type { ActionGroup } from '../domain/processTree/ActionGroup';
     5	import { createProcess } from '../domain/processTree/Process';
     6	import { CommandStack } from '../commands/CommandStack';
     7	
     8	interface ProcessState {
     9	  root: Process;
    10	  commandHistory: CommandStack;
    11	}
    12	
    13	export const useProcessStore = defineStore('process', {
    14	  state: (): ProcessState => ({
    15	    root: createProcess(),
    16	    commandHistory: new CommandStack()
    17	  }),
    18	
    19	  getters: {
    20	    /**
    21	     * Get node by path (e.g., "/subprocess/sp1/actionGroup/ag1")
    22	     */
    23	    getNodeByPath: (state) => (path: string): Subprocess | ActionGroup | ConstructiveAction | null => {
    24	      const parts = path.split('/').filter(Boolean);
    25	      let current: any = state.root;
    26	
    27	      for (let i = 0; i < parts.length; i += 2) {
    28	        const type = parts[i];
    29	        const id = parts[i + 1];
    30	
    31	        if (type === 'subprocess') {
    32	          current = current.children?.find((c: any) => c.id === id);
    33	        } else if (type === 'actionGroup') {
    34	          current = current.children?.find((c: any) => c.id === id);
    35	        } else if (type === 'action') {
    36	          current = current.children?.find((c: any) => c.id === id);
    37	        }
    38	
    39	        if (!current) return null;
    40	      }
    41	
    42	      return current;
    43	    },
    44	
    45	    /**
    46	     * Get all subprocesses (recursive)
    47	     */
    48	    visibleSubprocesses: (state) => {
    49	      const result: Subprocess[] = [];
    50	      const traverse = (subprocess: Subprocess) => {
    51	        result.push(subprocess);
    52	        subprocess.children.forEach(child => {
    53	          if (child?.type === 'subprocess') {
    54	            traverse(child as Subprocess);
    55	          }
    56	        });
    57	      };
    58	      
    59	      if (state.root) {
    60	        // Cast Process to Subprocess for traversal
    61	        traverse(state.root as unknown as Subprocess);
    62	      }
    63	      return result;
    64	    },
    65	
    66	    /**
    67	     * Get all actions (flat array)
    68	     */
    69	    allActions: (state) => {
    70	      const result: ConstructiveAction[] = [];
    71	      const traverse = (node: Subprocess | ActionGroup) => {
    72	        node.children.forEach(child => {
    73	          if ('type' in child && child?.type === 'action') {
    74	            result.push(child as ConstructiveAction);
    75	          } else if ('children' in child) {
    76	            traverse(child as Subprocess | ActionGroup);
    77	          }
    78	        });
    79	      };
    80	      // Start from root's children (which are Subprocess or ActionGroup)
    81	      state.root.children.forEach(child => {
    82	        if ('children' in child) {
    83	          traverse(child as Subprocess | ActionGroup);
    84	        }
    85	      });
    86	      return result;
    87	    }
    88	  },
    89	
    90	  actions: {
    91	    /**
    92	     * Add subprocess to parent path
    93	     */
    94	    addSubprocess(parentPath: string, subprocess: Subprocess): void {
    95	      const parent = this.getNodeByPath(parentPath) as Subprocess;
    96	      if (parent && 'children' in parent) {
    97	        parent.children.push(subprocess);
    98	      } else if (parentPath === '/') {
    99	        this.root.children.push(subprocess);
   100	      }
   101	    },
   102	
   103	    /**
   104	     * Add action group to subprocess
   105	     */
   106	    addActionGroup(subprocessPath: string, actionGroup: ActionGroup): void {
   107	      const subprocess = this.getNodeByPath(subprocessPath) as Subprocess;
   108	      if (subprocess && 'children' in subprocess) {
   109	        subprocess.children.push(actionGroup);
   110	      }
   111	    },
   112	
   113	    /**
   114	     * Add action to action group
   115	     */
   116	    addAction(actionGroupPath: string, action: ConstructiveAction): void {
   117	      const actionGroup = this.getNodeByPath(actionGroupPath) as ActionGroup;
   118	      if (actionGroup && 'children' in actionGroup) {
   119	        actionGroup.children.push(action);
   120	      }
   121	    },
   122	
   123	    /**
   124	     * Remove subprocess by path
   125	     */
   126	    removeSubprocess(subprocessPath: string): Subprocess | null {
   127	      const parts = subprocessPath.split('/').filter(Boolean);
   128	      const id = parts[parts.length - 1];
   129	      const parentPath = '/' + parts.slice(0, -2).join('/');
   130	
   131	      const parent = parentPath === '/' ? this.root : this.getNodeByPath(parentPath) as Subprocess;
   132	      if (parent && 'children' in parent) {
   133	        const index = parent.children.findIndex((c: any) => c.id === id);
   134	        if (index !== -1) {
   135	          const removed = parent.children.splice(index, 1)[0];
   136	          return removed as Subprocess;
   137	        }
   138	      }
   139	      return null;
   140	    },
   141	
   142	    /**
   143	     * Remove action group by path
   144	     */
   145	    removeActionGroup(actionGroupPath: string): ActionGroup | null {
   146	      const parts = actionGroupPath.split('/').filter(Boolean);
   147	      const id = parts[parts.length - 1];
   148	      const parentPath = '/' + parts.slice(0, -2).join('/');
   149	
   150	      const parent = this.getNodeByPath(parentPath) as Subprocess;
   151	      if (parent && 'children' in parent) {
   152	        const index = parent.children.findIndex((c: any) => c.id === id);
   153	        if (index !== -1) {
   154	          const removed = parent.children.splice(index, 1)[0];
   155	          return removed as ActionGroup;
   156	        }
   157	      }
   158	      return null;
   159	    },
   160	
   161	    /**
   162	     * Remove action by path
   163	     */
   164	    removeAction(actionPath: string): ConstructiveAction | null {
   165	      const parts = actionPath.split('/').filter(Boolean);
   166	      const id = parts[parts.length - 1];
   167	      const parentPath = '/' + parts.slice(0, -2).join('/');
   168	
   169	      const parent = this.getNodeByPath(parentPath) as ActionGroup;
   170	      if (parent && 'children' in parent) {
   171	        const index = parent.children.findIndex((c: any) => c.id === id);
   172	        if (index !== -1) {
   173	          const removed = parent.children.splice(index, 1)[0];
   174	          return removed as ConstructiveAction;
   175	        }
   176	      }
   177	      return null;
   178	    },
   179	
   180	    /**
   181	     * Clear process tree (for testing or reset)
   182	     */
   183	    clear(): void {
   184	      this.root = createProcess();
   185	      this.commandHistory.clear();
   186	    }
   187	  }
   188	});
---frontend/src/services/ProjectService.ts
     1	/**
     2	 * ProjectService - current-schema command-stream persistence orchestration.
     3	 */
     4	
     5	import { World } from '@/domain/world/World';
     6	import type { CommandStack } from '@/commands/CommandStack';
     7	import { Command, type CommandSnapshot } from '@/commands/Command';
     8	import type { OperationDescriptor } from '@/commands/operations/IOperation';
     9	import { deserializeOperation } from '@/commands/operations/OperationRegistry';
    10	
    11	export interface ProjectData {
    12	  id: string;
    13	  name: string;
    14	  schemaVersion: string;
    15	  created: string;
    16	  modified: string;
    17	  nextElementId: number;
    18	  commands: SerializedCommand[];
    19	}
    20	
    21	type SerializedCommand = CommandSnapshot;
    22	type SerializedOperation = OperationDescriptor;
    23	
    24	export class ProjectService {
    25	  private static readonly SCHEMA_VERSION = '6.0.0';
    26	
    27	  static serializeCommands(commandStack: CommandStack, nextElementId: number, projectName: string): ProjectData {
    28	    if (!Number.isInteger(nextElementId) || nextElementId < 1) {
    29	      throw new Error(`Invalid next element ID: ${nextElementId}`);
    30	    }
    31	    const now = new Date().toISOString();
    32	    const commands = commandStack.getCommittedCommands().map(command => command.toSnapshot());
    33	
    34	    return {
    35	      id: this.generateProjectId(),
    36	      name: projectName,
    37	      schemaVersion: this.SCHEMA_VERSION,
    38	      created: now,
    39	      modified: now,
    40	      nextElementId,
    41	      commands
    42	    };
    43	  }
    44	
    45	  static deserializeCommands(data: ProjectData, world: World, commandStack: CommandStack): void {
    46	    this.validateProjectData(data);
    47	    commandStack.clear();
    48	    world.restoreNextId(data.nextElementId);
    49	
    50	    const restoredCommands: Command[] = [];
    51	    for (const serializedCommand of data.commands) {
    52	      const operations = serializedCommand.operations.map((descriptor: SerializedOperation) => deserializeOperation(descriptor));
    53	      for (const operation of operations) {
    54	        const result = operation.apply(world);
    55	        if (!result.success) {
    56	          throw new Error(`Failed to replay operation ${operation.type}: ${result.error}`);
    57	        }
    58	      }
    59	      restoredCommands.push(Command.restore({
    60	        id: serializedCommand.id,
    61	        timestamp: serializedCommand.timestamp,
    62	        description: serializedCommand.description,
    63	        operations
    64	      }, world));
    65	    }
    66	
    67	    commandStack.restoreCommittedCommands(restoredCommands);
    68	
    69	    if (!world.getActivePlaneId()) {
    70	      const planes = world.getAllProjectionPlanes();
    71	      const ph = planes.find(p => p.id === 'projPlaneH' || p.name === 'P_H');
    72	      if (ph) {
    73	        world.setActivePlaneId(ph.id);
    74	      } else if (planes.length > 0) {
    75	        world.setActivePlaneId(planes[0].id);
    76	      }
    77	    }
    78	  }
    79	
    80	  static validateProjectData(data: unknown): asserts data is ProjectData {
    81	    if (!data || typeof data !== 'object' || Array.isArray(data)) {
    82	      throw new Error('Invalid project file - not a valid JSON object');
    83	    }
    84	    const record = data as Partial<ProjectData>;
    85	    if (record.schemaVersion !== this.SCHEMA_VERSION) {
    86	      throw new Error(`Unsupported project schema version: ${String(record.schemaVersion)}`);
    87	    }
    88	    for (const field of ['id', 'name', 'created', 'modified'] as const) {
    89	      if (typeof record[field] !== 'string' || record[field]!.length === 0) {
    90	        throw new Error(`Invalid project file - missing required field: ${field}`);
    91	      }
    92	    }
    93	    if (!Number.isInteger(record.nextElementId) || record.nextElementId < 1) {
    94	      throw new Error('Invalid project file - nextElementId must be a positive integer');
    95	    }
    96	    if (!Array.isArray(record.commands)) {
    97	      throw new Error('Invalid project file - commands must be an array');
    98	    }
    99	    for (const command of record.commands) {
   100	      this.validateSerializedCommand(command);
   101	    }
   102	  }
   103	
   104	  private static validateSerializedCommand(command: unknown): asserts command is SerializedCommand {
   105	    if (!command || typeof command !== 'object' || Array.isArray(command)) {
   106	      throw new Error('Invalid project file - command must be an object');
   107	    }
   108	    const record = command as Partial<SerializedCommand>;
   109	    if (typeof record.id !== 'string' || record.id.length === 0) {
   110	      throw new Error('Invalid project file - command missing id');
   111	    }
   112	    if (typeof record.timestamp !== 'string' || Number.isNaN(Date.parse(record.timestamp))) {
   113	      throw new Error(`Invalid project file - command ${record.id} has invalid timestamp`);
   114	    }
   115	    if (typeof record.description !== 'string' || record.description.length === 0) {
   116	      throw new Error(`Invalid project file - command ${record.id} missing description`);
   117	    }
   118	    if (record.status !== 'committed') {
   119	      throw new Error(`Invalid project file - command ${record.id} must be committed`);
   120	    }
   121	    if (!Array.isArray(record.operations) || record.operations.length === 0) {
   122	      throw new Error(`Invalid project file - command ${record.id} must contain operations`);
   123	    }
   124	    for (const operation of record.operations) {
   125	      if (!operation || typeof operation !== 'object' || Array.isArray(operation) || typeof (operation as { opType?: unknown }).opType !== 'string') {
   126	        throw new Error(`Invalid project file - command ${record.id} has invalid operation descriptor`);
   127	      }
   128	    }
   129	  }
   130	
   131	  private static generateProjectId(): string {
   132	    return `proj_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`;
   133	  }
   134	}
---frontend/src/services/GoogleDriveService.ts
     1	/**
     2	 * GoogleDriveService
     3	 * 
     4	 * Service for interacting with Google Drive API to store and retrieve project files.
     5	 * Projects are stored in a "diedrico" folder in the user's Google Drive as .diedrico files.
     6	 * 
     7	 * Architecture:
     8	 * - Direct browser-to-Drive communication using gapi.client
     9	 * - OAuth2 authentication with scope: drive.file (app-created files only)
    10	 * - No backend server required
    11	 * 
    12	 */
    13	
    14	/// <reference types="gapi" />
    15	/// <reference types="gapi.client.drive-v3" />
    16	
    17	export interface GoogleDriveFile {
    18	  id: string;
    19	  name: string;
    20	  modifiedTime: string;
    21	}
    22	
    23	export interface GoogleDriveConfig {
    24	  clientId: string;
    25	  apiKey?: string;  // Optional: recommended for quota tracking but not required for OAuth
    26	  appId: string;
    27	}
    28	
    29	export interface GoogleUserProfile {
    30	  name: string;       // Display name (e.g., "John Doe")
    31	  email: string;      // Email address
    32	  picture?: string;   // Avatar URL (if available)
    33	  sub: string;        // Google user ID (unique identifier)
    34	}
    35	
    36	/**
    37	 * Service for Google Drive operations
    38	 */
    39	export class GoogleDriveService {
    40	  private static readonly DISCOVERY_DOCS = [
    41	    'https://www.googleapis.com/discovery/v1/apis/drive/v3/rest',
    42	  ];
    43	  
    44	  // T400: Add profile and email scopes for user profile information
    45	  private static readonly SCOPES = 'https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/userinfo.email';
    46	  
    47	  private static readonly FOLDER_NAME = 'diedrico';
    48	  private static readonly FILE_EXTENSION = '.diedrico';
    49	  
    50	  private config: GoogleDriveConfig;
    51	  private initialized = false;
    52	  private initializing = false; // Prevent multiple simultaneous initializations
    53	  private folderId: string | null = null;
    54	  private tokenClient: any = null;
    55	  private accessToken: string | null = null;
    56	
    57	  constructor(config: GoogleDriveConfig) {
    58	    this.config = config;
    59	  }
    60	
    61	  /**
    62	   * Initialize Google API client with new Google Identity Services
    63	   */
    64	  async initialize(): Promise<void> {
    65	    if (this.initialized) {
    66	      return;
    67	    }
    68	    
    69	    // Prevent multiple simultaneous initializations
    70	    if (this.initializing) {
    71	      return;
    72	    }
    73	    
    74	    this.initializing = true;
    75	
    76	    return new Promise((resolve, reject) => {
    77	      // Load gapi client
    78	      gapi.load('client', async () => {
    79	        try {
    80	          // Initialize gapi client (for Drive API calls)
    81	          const initConfig: any = {
    82	            discoveryDocs: GoogleDriveService.DISCOVERY_DOCS,
    83	          };
    84	          
    85	          if (this.config.apiKey) {
    86	            initConfig.apiKey = this.config.apiKey;
    87	          }
    88	          
    89	          await gapi.client.init(initConfig);
    90	          
    91	          // Initialize Token Client (new GIS auth)
    92	          this.tokenClient = (window as any).google.accounts.oauth2.initTokenClient({
    93	            client_id: this.config.clientId,
    94	            scope: GoogleDriveService.SCOPES,
    95	            callback: '', // Will be set during signIn
    96	          });
    97	          
    98	          this.initialized = true;
    99	          this.initializing = false;
   100	          // Try to restore previous session AFTER initialization is complete
   101	          await this.tryRestoreSession();
   102	          resolve();
   103	        } catch (error: any) {
   104	          console.error('[GoogleDrive] Initialization failed:', error);
   105	          console.error('[GoogleDrive] Error details:', JSON.stringify(error, null, 2));
   106	          reject(new Error(`Failed to initialize Google API: ${error.error || error.message || JSON.stringify(error)}`));
   107	        }
   108	      });
   109	    });
   110	  }
   111	
   112	  /**
   113	   * Try to restore previous session (silent sign-in)
   114	   */
   115	  private async tryRestoreSession(): Promise<void> {
   116	    const wasSignedIn = localStorage.getItem('diedrico_was_signed_in');
   117	    if (wasSignedIn === 'true') {
   118	      try {
   119	        // Try silent sign-in (no popup if user is still signed in to Google)
   120	        await this.signInSilently();
   121	      } catch (error) {
   122	        localStorage.removeItem('diedrico_was_signed_in');
   123	      }
   124	    }
   125	  }
   126	
   127	  /**
   128	   * Check if user is signed in (has valid access token)
   129	   */
   130	  isSignedIn(): boolean {
   131	    // Check if we have an access token, or if gapi client has a token
   132	    const token = gapi.client.getToken();
   133	    return this.accessToken !== null || (token !== null && token.access_token !== undefined);
   134	  }
   135	
   136	  /**
   137	   * Sign in silently (no popup) if user is already signed in to Google
   138	   */
   139	  private async signInSilently(): Promise<void> {
   140	    // Don't call initialize again - we should already be initialized
   141	    if (!this.initialized) {
   142	      throw new Error('Service not initialized');
   143	    }
   144	
   145	    return new Promise((resolve, reject) => {
   146	      try {
   147	        this.tokenClient.callback = (response: any) => {
   148	          if (response.error) {
   149	            reject(new Error(response.error));
   150	            return;
   151	          }
   152	          
   153	          this.accessToken = response.access_token;
   154	          gapi.client.setToken({ access_token: this.accessToken });
   155	          localStorage.setItem('diedrico_was_signed_in', 'true');
   156	          resolve();
   157	        };
   158	        
   159	        // Request access token silently (no popup if already signed in)
   160	        this.tokenClient.requestAccessToken({ prompt: '' });
   161	      } catch (error: any) {
   162	        reject(error);
   163	      }
   164	    });
   165	  }
   166	
   167	  /**
   168	   * Sign in with Google using new GIS library (shows popup)
   169	   */
   170	  async signIn(): Promise<void> {
   171	    if (!this.initialized) {
   172	      await this.initialize();
   173	    }
   174	
   175	    return new Promise((resolve, reject) => {
   176	      try {
   177	        this.tokenClient.callback = (response: any) => {
   178	          if (response.error) {
   179	            if (response.error === 'popup_closed_by_user') {
   180	              reject(new Error('Sign-in cancelled by user'));
   181	            } else if (response.error === 'access_denied') {
   182	              reject(new Error('Access denied. Please grant permission to access Google Drive.'));
   183	            } else {
   184	              reject(new Error(`Sign-in failed: ${response.error}`));
   185	            }
   186	            return;
   187	          }
   188	          
   189	          this.accessToken = response.access_token;
   190	          gapi.client.setToken({ access_token: this.accessToken });
   191	          localStorage.setItem('diedrico_was_signed_in', 'true');
   192	          resolve();
   193	        };
   194	        
   195	        // Request access token (will show popup)
   196	        this.tokenClient.requestAccessToken({ prompt: 'consent' });
   197	      } catch (error: any) {
   198	        reject(new Error(`Sign-in failed: ${error.message}`));
   199	      }
   200	    });
   201	  }
   202	
   203	  /**
   204	   * Sign out from Google (revoke access token)
   205	   */
   206	  async signOut(): Promise<void> {
   207	    if (!this.initialized) {
   208	      return;
   209	    }
   210	
   211	    try {
   212	      if (this.accessToken) {
   213	        await (window as any).google.accounts.oauth2.revoke(this.accessToken);
   214	        this.accessToken = null;
   215	        gapi.client.setToken(null);
   216	      }
   217	      localStorage.removeItem('diedrico_was_signed_in');
   218	      this.folderId = null;
   219	    } catch (error) {
   220	      throw new Error(`Failed to sign out: ${error}`);
   221	    }
   222	  }
   223	
   224	  /**
   225	   * T401: Fetch user profile information from Google
   226	   * Uses the OAuth2 userinfo endpoint to get profile data
   227	   */
   228	  async fetchUserProfile(): Promise<GoogleUserProfile> {
   229	    if (!this.isSignedIn()) {
   230	      throw new Error('User not signed in');
   231	    }
