    24	<script setup lang="ts">
    25	import type { Action } from '../../domain/processTree/Action';
    26	import { ActionType } from '../../domain/processTree/Action';
    27	
    28	interface Props {
    29	  action: Action;
    30	}
    31	
    32	const props = defineProps<Props>();
    33	
    34	/**
    35	 * Format ActionType enum to readable string
    36	 */
    37	function formatActionType(actionType: ActionType): string {
    38	  // Convert CamelCase to Title Case with spaces
    39	  return actionType
    40	    .replace(/([A-Z])/g, ' $1')
    41	    .trim();
    42	}
    43	
    44	/**
    45	 * Format timestamp to time string
    46	 */
    47	function formatTime(date: Date): string {
    48	  return date.toLocaleTimeString('en-US', {
    49	    hour: '2-digit',
    50	    minute: '2-digit',
    51	    second: '2-digit'
    52	  });
    53	}
    54	</script>
