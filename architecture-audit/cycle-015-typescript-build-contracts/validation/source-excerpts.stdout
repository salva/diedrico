   153	          Save
   154	        </button>
   155	      </div>
   156	    </div>
   157	  </div>
   158	</template>
   159	
   160	<script setup lang="ts">
   161	import { ref, computed, watch } from 'vue';
   162	import type { World } from '@/domain/world/World';
   163	
   164	interface Props {
   165	  isOpen: boolean;
   166	  elementId: string | null;
   167	  world: World | null;
   168	}
   169	
   170	interface StyleChanges {
   171	  elementId: string;
   172	  color?: string;
   173	  lineWidth?: number;
   174	  lineStyle?: string;
   175	  visible?: boolean;
   176	}
   177	
   178	const props = defineProps<Props>();
   179	const emit = defineEmits<{
   180	  close: [];
   181	  save: [changes: StyleChanges];
   182	}>();
   183	
   184	// Editable state
   185	const editableColor = ref<string>('#000000');
   186	const editableLineWidth = ref<number>(1.0);
   187	const editableLineStyle = ref<string>('solid');
   188	const editableVisible = ref<boolean>(true);
   189	
   190	// Override flags
   191	const colorOverride = ref<boolean>(false);
   192	const lineWidthOverride = ref<boolean>(false);
   193	const lineStyleOverride = ref<boolean>(false);
   194	const visibilityOverride = ref<boolean>(false);
   195	
   196	// Validation state
   197	const colorError = ref<string>('');
   198	const lineWidthError = ref<string>('');
   199	const lineStyleError = ref<string>('');
   200	
   201	// Computed properties for display
   202	const elementLabel = computed(() => {
   203	  if (!props.elementId || !props.world) return 'Unknown';
   204	  
   205	  // Get element label/ID
   206	  return props.elementId;
   207	});
   208	
   209	const elementType = computed(() => {
   210	  if (!props.elementId || !props.world) return 'Unknown';
   211	  
   212	  // Determine element type by checking which collection contains it
   213	  const point = props.world.getPoint2D(props.elementId);
   214	  if (point) return '2D Point';
   215	  
   216	  const line = props.world.getLine2D(props.elementId);
   217	  if (line) return '2D Line';
   218	  
   219	  const segment = props.world.getSegment2D(props.elementId);
   220	  if (segment) return '2D Segment';
