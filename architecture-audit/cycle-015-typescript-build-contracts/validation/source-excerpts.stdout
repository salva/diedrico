   158	<script setup lang="ts">
   159	/**
   160	 * SvgCanvas.vue - Main 2D drawing canvas component
   161	 * 
   162	 * This is the primary workspace where all 2D geometric elements are rendered.
   163	 * Uses SVG for crisp, scalable vector graphics per Constitution Principle IV.
   164	 * 
   165	 * Rendering Pipeline:
   166	 * 1. World (domain objects + realizations) 
   167	 * 2. → CanvasPresentationSelector (generates read-model primitives in paper coordinates)
   168	 * 3. → SVGRenderer (applies viewport transform, generates SVG attributes)
   169	 * 4. → SVG elements
   170	 * 
   171	 * Key requirements:
   172	 * - SVG element, not HTML Canvas
   173	 * - Rendering consumes the canvas presentation read model
   174	 * - Generic rendering algorithms, with fixed elements represented by selectors
   175	 * - Pan/zoom viewport transformations remain view state
   176	 * - Element drawing policy comes from presentation selectors and SVGRenderer
   177	 */
   178	
   179	import { ref, computed, watch, onMounted, onUnmounted, inject, provide } from 'vue';
   180	import { Matrix3, Vector3 } from 'three';
   181	import { World } from '@/domain/world/World';
   182	import { SVGRenderer, type ViewportTransform } from '@/services/SVGRenderer';
   183	import { InputService } from '@/services/InputService';
   184	import { PointTool } from '@/tools/PointTool';
   185	import { LineTool } from '@/tools/LineTool';
   186	import { SegmentTool } from '@/tools/SegmentTool';
   187	import { CircleTool } from '@/tools/CircleTool';
   188	import { GuideTool } from '@/tools/GuideTool';
   189	import { IntersectionTool } from '@/tools/IntersectionTool';
   190	import { ParallelLineTool } from '@/tools/ParallelLineTool';
   191	import { PerpendicularLineTool } from '@/tools/PerpendicularLineTool';
   192	import { TangentLineToCircleThroughPointTool } from '@/tools/TangentLineToCircleThroughPointTool';
   193	import { TangentLineToCircleParallelToLineTool } from '@/tools/TangentLineToCircleParallelToLineTool';
   194	import { Create3DPointTool } from '@/tools/Create3DPointTool';
   195	import { Create3DLineTool } from '@/tools/Create3DLineTool';
   196	import { Create3DSegmentTool } from '@/tools/Create3DSegmentTool';
   197	import { Create3DPlaneTool } from '@/tools/Create3DPlaneTool';
   198	import { CreateProjectionPlaneTool } from '@/tools/CreateProjectionPlaneTool';
   199	import { FreePoint2D } from '@/domain/world/Point';
   200	import { useToolStore } from '@/stores/toolStore';
   201	import { useViewStore } from '@/stores/viewStore';
   202	import { useSelectionStore } from '@/stores/selectionStore';
   203	import { useViewport } from '@/composables/useViewport';
   204	import { useGlobalHoverHighlight } from '@/composables/useHoverHighlight';
   205	import { screenTo3D } from '@/utils/coordinateTransform';
   206	import PropertiesDialog from '@/components/dialogs/PropertiesDialog.vue';
   207	import type { ITool } from '@/tools/ITool';
   208	import { createCanvasToolController } from '@/application/tools/CanvasToolController';
   209	import type { FreePointMoveSession } from '@/application/tools/ToolCommandIntents';
   210	import { CanvasPresentationController } from '@/application/canvasPresentation/CanvasPresentationController';
   211	import { CanvasInteractionQuery } from '@/application/canvasPresentation/CanvasInteractionQuery';
   212	
   213	// Define emits
   214	const emit = defineEmits<{
   215	  'update-3d-coordinates': [coords: { x: number; y: number; z: number } | null];
   216	  'update-active-plane': [planeInfo: { id: string; name: string }];
   217	}>();
   218	
   219	const svgElement = ref<SVGSVGElement | null>(null);
