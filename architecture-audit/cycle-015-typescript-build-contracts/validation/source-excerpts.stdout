--- frontend/src/commands/factories/GuideSequenceFactory.ts
     1	import type { Command } from '../Command';
     2	import { World } from '../../domain/world/World';
     3	import { AddGuide2DPerpendicularToLineOp, AddSiblingGuide2DOp } from '../operations/world/AddGuideOp';
     4	import { HalfHingeLine2D } from '../../domain/world/HingeLine';
     5	import { BrokenHalfHingeLine2D } from '../../domain/world/elements/BrokenHalfHingeLine2D';
     6	import { computeArcGeometry } from '../../utils/arcGeometry';
     7	import { Guide2D, SiblingGuide2D } from '../../domain/world/Guide';
     8	
     9	/**
    10	 * Factory for creating guide operation sequences.
    11	 * 
    12	 * Encapsulates the logic for:
    13	 * - Creating primary guide perpendicular to reference line
    14	 * - Detecting HalfHingeLine reference lines
    15	 * - Creating sibling guides on complementary planes
    16	 * - Updating bidirectional sibling links
    17	 * 
    18	 * @see GuideTool for usage example
    19	 * @see README.md for factory pattern documentation
    20	 */
    21	export class GuideSequenceFactory {
    22	  /**
    23	   * Creates a guide with its sibling on the complementary plane.
    24	   * 
    25	   * Guides MUST be perpendicular to HalfHingeLines. The sibling guide is
    26	   * automatically created in the paired plane using coordinate correspondence.
    27	   * 
    28	   * @param cmd - Open Command to add operations to
    29	   * @param planeId - ID of plane where primary guide is created
    30	   * @param referenceLineId - ID of HalfHingeLine2D to create perpendicular guide to
    31	   * @param throughPointId - ID of point guide should pass through
    32	   * @param world - World instance for navigation
    33	   * 
    34	   * @returns Object with guideId and siblingGuideId (both always present)
    35	   * 
    36	   * @example
    37	   * ```typescript
    38	   * const cmd = new Command('Create guide', world);
    39	   * const result = GuideSequenceFactory.createGuideWithSibling(
    40	   *   cmd, 
    41	   *   planeId, 
    42	   *   referenceLineId, 
    43	   *   throughPointId, 
    44	   *   world
    45	   * );
    46	   * // Tool handles: process tree action, commit, push to stack
    47	   * cmd.commit();
    48	   * commandStack.push(cmd);
    49	   * ```
    50	   */
    51	  static createGuideWithSibling(
    52	    cmd: Command,
    53	    planeId: string,
    54	    referenceLineId: string,
    55	    throughPointId: string,
    56	    world: World
    57	  ): { guideId: string; siblingGuideId?: string } {
    58	    console.log(`[GuideSequenceFactory] createGuideWithSibling called: plane=${planeId}, refLine=${referenceLineId}, point=${throughPointId}`);
    59	    
    60	    // Create primary guide
    61	    const result = cmd.addAndExecute(
    62	      new AddGuide2DPerpendicularToLineOp(planeId, referenceLineId, throughPointId)
    63	    );
    64	    const guideId = result.outputs.guideId;
    65	    
    66	    console.log(`[GuideSequenceFactory] Primary guide created: ${guideId}`);
    67	    
    68	    console.log(`[GuideSequenceFactory] Getting sibling plane info...`);
    69	    
    70	    // Check if reference line is a HalfHingeLine (regular or broken)
    71	    // Try HalfHingeLine2D first
    72	    let siblingInfo = HalfHingeLine2D.getSiblingInfo(world, referenceLineId, planeId);
    73	    
    74	    // If not regular HHL, try BrokenHalfHingeLine2D
    75	    if (!siblingInfo) {
    76	      siblingInfo = BrokenHalfHingeLine2D.getSiblingInfo(world, referenceLineId, planeId);
    77	    }
    78	    
    79	    if (!siblingInfo) {
    80	      console.log(`[GuideSequenceFactory] No sibling info - reference line is not a HalfHingeLine or BrokenHalfHingeLine2D`);
    81	      return { guideId };
    82	    }
    83	    
    84	    console.log(`[GuideSequenceFactory] Sibling plane: ${siblingInfo.siblingPlaneId}, HHL: ${siblingInfo.siblingHalfHingeLineId}`);
    85	    
    86	    // Create sibling guide using coordinate correspondence
    87	    const siblingResult = cmd.addAndExecute(
    88	      new AddSiblingGuide2DOp(
    89	        siblingInfo.siblingPlaneId,
    90	        guideId,
    91	        siblingInfo.siblingHalfHingeLineId
    92	      )
    93	    );
    94	    const siblingGuideId = siblingResult.outputs.siblingGuideId;
    95	    
    96	    // Update bidirectional links
    97	    const primaryGuide = world.getLine2D(guideId)!;
    98	    (primaryGuide as any).siblingGuideId = siblingGuideId;
    99	    
   100	    console.log(
   101	      `[GuideSequenceFactory] Created sibling guide ${siblingGuideId} ` +
   102	      `in plane ${siblingInfo.siblingPlaneId}`
   103	    );
   104	    
   105	    // Phase 101: If reference line is BrokenHalfHingeLine2D, compute arc geometry
   106	    const referenceLine = world.getLine2D(referenceLineId);
   107	    if (referenceLine instanceof BrokenHalfHingeLine2D) {
   108	      console.log(`[GuideSequenceFactory] Reference is BrokenHalfHingeLine2D - computing arc geometry`);
   109	      
   110	      const primaryGuideTyped = primaryGuide as Guide2D;
   111	      const siblingGuide = world.getLine2D(siblingGuideId) as SiblingGuide2D;
   112	      
   113	      // Compute arc geometry connecting the two guides
   114	      const arcGeometry = computeArcGeometry(world, primaryGuideTyped, siblingGuide);
   115	      
   116	      if (arcGeometry) {
   117	        // Store arc in BOTH guides for rendering
   118	        primaryGuideTyped.arcGeometry = arcGeometry;
   119	        siblingGuide.arcGeometry = arcGeometry;
   120	        
   121	        console.log(`[GuideSequenceFactory] Arc geometry computed and stored`);
   122	      } else {
   123	        console.warn(`[GuideSequenceFactory] Failed to compute arc geometry`);
   124	      }
   125	    }
   126	    
   127	    return { guideId, siblingGuideId };
   128	  }
   129	}
--- frontend/src/commands/factories/IntersectionSequenceFactory.ts
     1	/**
     2	 * IntersectionSequenceFactory - Factory for creating intersection point sequences
     3	 * 
     4	 * Phase 74: Refactored to eliminate IntersectionData string discriminator.
     5	 * Instead of one method with type string dispatch, provides 3 type-specific methods.
     6	 * Callers use instanceof checks to determine which method to call.
     7	 * 
     8	 * Encapsulates the operation sequence for creating intersection points between:
     9	 * - Line-Line intersections
    10	 * - Line-Circle intersections (with index for multiple intersections)
    11	 * - Circle-Circle intersections (with index for multiple intersections)
    12	 * 
    13	 * Phase 42: Handles HalfHingeLine2D intersections by creating sibling points
    14	 * on the complementary plane (follows same pattern as SiblingGuide2D from Phase 36).
    15	 * 
    16	 * Pattern: Open Command - Receives an open Command, adds operations to it.
    17	 * 
    18	 * Benefits:
    19	 * - No string discriminator round-trip (instanceof → string → dispatch)
    20	 * - Type-safe: each method knows exactly what it handles
    21	 * - Callers use instanceof directly, matching Phase 73 architectural principle
    22	 * - Testable without tool infrastructure
    23	 * - Reusable across different UIs or automation contexts
    24	 * 
    25	 * Example:
    26	 * ```typescript
    27	 * const cmd = new Command('Create intersection', world);
    28	 * const element1 = world.getLine2D(id1);
    29	 * const element2 = world.getLine2D(id2);
    30	 * 
    31	 * // Caller uses instanceof to select method
    32	 * let result;
    33	 * if (element1 instanceof Line2D && element2 instanceof Line2D) {
    34	 *   result = IntersectionSequenceFactory.createLineLineIntersection(
    35	 *     cmd, planeId, id1, id2, world
    36	 *   );
    37	 * }
    38	 * ```
    39	 * 
    40	 * @see frontend/src/commands/factories/README.md
    41	 * @see data-model.md §HalfHingeLine2D Intersection Sibling Behavior
    42	 */
    43	
    44	import type { Command } from '../Command';
    45	import { AddLineLineIntersectionPoint2DOp } from '../operations/world/AddLineLineIntersectionPoint2DOp';
    46	import { AddLineCircleIntersectionPoint2DOp } from '../operations/world/AddLineCircleIntersectionPoint2DOp';
    47	import { AddCircleCircleIntersectionPoint2DOp } from '../operations/world/AddCircleCircleIntersectionPoint2DOp';
    48	import { AddSiblingIntersectionPoint2DOp } from '../operations/world/AddSiblingIntersectionPoint2DOp';
    49	import { AddProcessTreeActionOp } from '../operations/processTree/AddProcessTreeActionOp';
    50	import { createLineLineIntersectionPointAction } from '@/domain/processTree/actions/CreateLineLineIntersectionPointAction';
    51	import { createLineCircleIntersectionPointAction } from '@/domain/processTree/actions/CreateLineCircleIntersectionPointAction';
    52	import { createCircleCircleIntersectionPointAction } from '@/domain/processTree/actions/CreateCircleCircleIntersectionPointAction';
    53	import { createSiblingIntersectionPointAction } from '@/domain/processTree/actions/CreateSiblingIntersectionPointAction';
    54	import type { World } from '@/domain/world/World';
    55	
    56	/**
    57	 * Result of intersection creation with optional sibling point
    58	 */
    59	export interface IntersectionResult {
    60	  pointId: string;
    61	  siblingPointId?: string;
    62	}
    63	
    64	/**
    65	 * Factory for creating intersection point operation sequences
    66	 */
    67	export class IntersectionSequenceFactory {
    68	  /**
    69	   * Create a line-line intersection point.
    70	   * 
    71	   * If either line is a HalfHingeLine2D, automatically creates a sibling
    72	   * intersection point on the complementary plane.
    73	   * 
    74	   * @param cmd - Open Command to add operations to
    75	   * @param planeId - ID of the projection plane
    76	   * @param line1Id - ID of first line
    77	   * @param line2Id - ID of second line
    78	   * @param world - World instance for HHL detection and sibling plane resolution
    79	   * @returns Object with pointId and optional siblingPointId
    80	   * @throws Error if operation fails
    81	   */
    82	  static createLineLineIntersection(
    83	    cmd: Command,
    84	    planeId: string,
    85	    line1Id: string,
    86	    line2Id: string,
    87	    world: World,
    88	    groupId: string
    89	  ): IntersectionResult {
    90	    const operation = new AddLineLineIntersectionPoint2DOp(planeId, line1Id, line2Id);
    91	    const result = this.executeWithSiblingSupport(cmd, operation, planeId, world);
    92	    
    93	    // Record ProcessTree action for primary intersection
    94	    const action = createLineLineIntersectionPointAction(result.pointId, planeId, line1Id, line2Id);
    95	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
    96	    
    97	    // Record ProcessTree action for sibling if created
    98	    if (result.siblingPointId) {
    99	      const primaryPoint = world.getPoint2D(result.pointId);
   100	      if (primaryPoint) {
   101	        const siblingPlaneId = world.getSiblingPlaneForIntersection(primaryPoint);
   102	        if (siblingPlaneId) {
   103	          const siblingAction = createSiblingIntersectionPointAction(
   104	            result.siblingPointId,
   105	            siblingPlaneId,
   106	            result.pointId
   107	          );
   108	          cmd.addAndExecute(new AddProcessTreeActionOp(siblingAction, groupId));
   109	        }
   110	      }
   111	    }
   112	    
   113	    return result;
   114	  }
   115	
   116	  /**
   117	   * Create a line-circle intersection point.
   118	   * 
   119	   * If the line is a HalfHingeLine2D, automatically creates a sibling
   120	   * intersection point on the complementary plane.
   121	   * 
   122	   * @param cmd - Open Command to add operations to
   123	   * @param planeId - ID of the projection plane
   124	   * @param lineId - ID of the line
   125	   * @param circleId - ID of the circle
   126	   * @param index - Which intersection point (0 or 1) when two exist
   127	   * @param world - World instance for HHL detection and sibling plane resolution
   128	   * @returns Object with pointId and optional siblingPointId
   129	   * @throws Error if operation fails
   130	   */
   131	  static createLineCircleIntersection(
   132	    cmd: Command,
   133	    planeId: string,
   134	    lineId: string,
   135	    circleId: string,
   136	    index: number,
   137	    world: World,
   138	    groupId: string
   139	  ): IntersectionResult {
   140	    const operation = new AddLineCircleIntersectionPoint2DOp(planeId, lineId, circleId, index);
   141	    const result = this.executeWithSiblingSupport(cmd, operation, planeId, world);
   142	    
   143	    // Record ProcessTree action for primary intersection
   144	    const action = createLineCircleIntersectionPointAction(result.pointId, planeId, lineId, circleId, index);
   145	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
   146	    
   147	    // Record ProcessTree action for sibling if created
   148	    if (result.siblingPointId) {
   149	      const primaryPoint = world.getPoint2D(result.pointId);
   150	      if (primaryPoint) {
   151	        const siblingPlaneId = world.getSiblingPlaneForIntersection(primaryPoint);
   152	        if (siblingPlaneId) {
   153	          const siblingAction = createSiblingIntersectionPointAction(
   154	            result.siblingPointId,
   155	            siblingPlaneId,
   156	            result.pointId
   157	          );
   158	          cmd.addAndExecute(new AddProcessTreeActionOp(siblingAction, groupId));
   159	        }
   160	      }
   161	    }
   162	    
   163	    return result;
   164	  }
   165	
   166	  /**
   167	   * Create a circle-circle intersection point.
   168	   * 
   169	   * Circles do not create sibling intersections (circles cannot be HalfHingeLines).
   170	   * 
   171	   * @param cmd - Open Command to add operations to
   172	   * @param planeId - ID of the projection plane
   173	   * @param circle1Id - ID of first circle
   174	   * @param circle2Id - ID of second circle
   175	   * @param index - Which intersection point (0 or 1) when two exist
   176	   * @param world - World instance for validation
   177	   * @returns Object with pointId and optional siblingPointId
   178	   * @throws Error if operation fails
   179	   */
   180	  static createCircleCircleIntersection(
   181	    cmd: Command,
   182	    planeId: string,
   183	    circle1Id: string,
   184	    circle2Id: string,
   185	    index: number,
   186	    world: World,
   187	    groupId: string
   188	  ): IntersectionResult {
   189	    const operation = new AddCircleCircleIntersectionPoint2DOp(planeId, circle1Id, circle2Id, index);
   190	    const result = this.executeWithSiblingSupport(cmd, operation, planeId, world);
   191	    
   192	    // Record ProcessTree action for primary intersection
   193	    const action = createCircleCircleIntersectionPointAction(result.pointId, planeId, circle1Id, circle2Id, index);
   194	    
   195	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
   196	    
   197	    // Note: Circles never create siblings, so no sibling action needed
   198	    
   199	    return result;
   200	  }
   201	
   202	  /**
   203	   * Execute intersection operation and create sibling if needed (shared logic)
   204	   */
   205	  private static executeWithSiblingSupport(
   206	    cmd: Command,
   207	    operation: AddLineLineIntersectionPoint2DOp | AddLineCircleIntersectionPoint2DOp | AddCircleCircleIntersectionPoint2DOp,
   208	    planeId: string,
   209	    world: World
   210	  ): IntersectionResult {
   211	    // Execute primary operation and extract outputs
   212	    const result = cmd.addAndExecute(operation);
   213	    const pointId = result.outputs.pointId;
   214	    
   215	    let siblingPointId: string | undefined;
   216	    
   217	    try {
   218	      // Check if either element is HalfHingeLine2D and get sibling plane
   219	      const plane = world.getProjectionPlaneById(planeId);
   220	      if (!plane) {
--- frontend/src/domain/processTree/Action.ts
     1	/**
     2	 * Action - Base interface for construction actions in the process tree
     3	 * 
     4	 * Phase 93: Minimal Action interface - only 3 fields
     5	 * - elementId: The created element (type derivable from element itself)
     6	 * - description: Human-readable narrative (static for now, dynamic later)
     7	 * - isOutput: Black box visibility flag (defaults to true)
     8	 * 
     9	 * Phase 98: Dynamic Action Descriptions
    10	 * - Added getDescriptionParts() helper function (not a method on interface)
    11	 * - Descriptions computed dynamically from current world state
    12	 * - Uses Descriptor pattern for separation of concerns
    13	 * 
    14	 * Removed fields (all redundant):
    15	 * - id: Actions tied to elements, use elementId
    16	 * - type: Always 'action', unnecessary discriminator
    17	 * - actionType: Derivable from element.type
    18	 * - timestamp: Can be derived from element.created if needed
    19	 * 
    20	 * Dependencies: Query world.dependencyService.getDependencies(elementId)
    21	 * Element properties: Direct access (element.planeId, line.point1Id, etc.)
    22	 * 
    23	 */
    24	
    25	import type { World } from '@/domain/world/World';
    26	import type { DescriptionPart } from '@/domain/world/descriptors/DescriptionPart';
    27	import { DescriptorRegistry } from '@/domain/world/descriptors/DescriptorRegistry';
    28	
    29	export interface Action {
    30	  elementId: string;             // Element created by this action
    31	  description: string;           // Human-readable action narrative
    32	  isOutput: boolean;             // Phase 87: Output flag (Show in black box stack)
    33	}
    34	
    35	/**
    36	 * Generate dynamic description parts for an action
    37	 * 
    38	 * Format: "{ElementType} {CurrentLabel}: {ConstructionMethod}"
    39	 * Example: "Point A_5: Intersection of line L_2 and line L_3"
    40	 * 
    41	 * Returns array of text and label parts for selective KaTeX rendering.
    42	 * 
    43	 * @param action The action to describe
    44	 * @param world Current world instance for element/label lookup
    45	 * @returns Array of text and label parts
    46	 */
    47	export function getActionDescriptionParts(action: Action, world: World): DescriptionPart[] {
    48	  // Try projection plane first (simple ID format without '/')
    49	  if (!action.elementId.includes('/')) {
    50	    const plane = world.getProjectionPlaneById(action.elementId);
    51	    if (plane) {
    52	      const descriptor = DescriptorRegistry.get(plane);
    53	      const typeName = descriptor.getTypeName(plane).toLowerCase();
    54	      const label = plane.label || plane.name;
    55	      const constructionParts = descriptor.getConstructionDescription(plane, world);
    56	      
    57	      return [
    58	        { type: 'label', content: label, elementId: action.elementId },
    59	        { type: 'text', content: `: ${typeName} ` },
    60	        ...constructionParts
    61	      ];
    62	    }
    63	  }
    64	  
    65	  // Try 2D element
    66	  try {
    67	    const element = world.getElement2D(action.elementId);
    68	    if (element) {
    69	      const descriptor = DescriptorRegistry.get(element);
    70	      const typeName = descriptor.getTypeName(element).toLowerCase();
    71	      const label = element.label || action.elementId;
    72	      const constructionParts = descriptor.getConstructionDescription(element, world);
    73	      
    74	      return [
    75	        { type: 'label', content: label, elementId: action.elementId },
    76	        { type: 'text', content: `: ${typeName} ` },
    77	        ...constructionParts
    78	      ];
    79	    }
    80	  } catch (e) {
    81	    // Not a 2D element, continue to 3D
    82	  }
    83	  
    84	  // Try 3D element
    85	  const element3d = world.getElement3DById(action.elementId);
    86	  if (element3d) {
    87	    const descriptor = DescriptorRegistry.get(element3d);
    88	    const typeName = descriptor.getTypeName(element3d).toLowerCase();
    89	    const label = element3d.label || action.elementId;
    90	    const constructionParts = descriptor.getConstructionDescription(element3d, world);
    91	    
    92	    return [
    93	      { type: 'label', content: label, elementId: action.elementId },
    94	      { type: 'text', content: `: ${typeName} ` },
    95	      ...constructionParts
    96	    ];
    97	  }
    98	  
    99	  // Element deleted - return empty to hide from UI
   100	  return [];
   101	}
   102	
   103	/**
   104	 * Generic action factory - replaces 30+ specialized functions
   105	 * 
   106	 * @param elementId - The created element ID
   107	 * @param description - Optional description (defaults to "Created {elementId}")
   108	 * @returns Action with isOutput=true by default
   109	 */
   110	export function createAction(
   111	  elementId: string,
   112	  description?: string
   113	): Action {
   114	  return {
   115	    elementId,
   116	    description: description ?? `Created ${elementId}`,
   117	    isOutput: true  // Default to true (user correction from Phase 93 planning)
   118	  };
   119	}
--- frontend/src/domain/processTree/ProcessTree.ts
     1	/**
     2	 * ProcessTree - Hierarchical construction history
     3	 * 
     4	 * Tracks all construction actions in a tree structure. Actions are grouped
     5	 * into ActionGroups which can be organized into Subprocesses.
     6	 * 
     7	 */
     8	
     9	import type { Action } from './Action';
    10	
    11	export const PROCESS_NODE_TYPE = {
    12	  SUBPROCESS: 'subprocess',
    13	  ACTION_GROUP: 'actionGroup',
    14	  ACTION: 'action',
    15	} as const;
    16	export type ProcessNodeType = typeof PROCESS_NODE_TYPE[keyof typeof PROCESS_NODE_TYPE];
    17	
    18	export interface ProcessNodeBase {
    19	  id: string;
    20	  type: ProcessNodeType;
    21	  created: Date;
    22	}
    23	
    24	export interface Subprocess extends ProcessNodeBase {
    25	  type: 'subprocess';
    26	  name: string;
    27	  children: (Subprocess | ActionGroup)[];  // Mixed children, no direct actions
    28	  showIntermediates: boolean;              // Phase 87: Encapsulation (Positive Logic)
    29	  isOutput: boolean;                       // Phase 87: Output flag (punches through encapsulation)
    30	}
    31	
    32	export interface ActionGroup extends ProcessNodeBase {
    33	  type: 'actionGroup';
    34	  children: (ActionNode | null)[];         // Actions or tombstones (null = deleted)
    35	  isAuxiliary: boolean;                    // Auxiliary actions (lighter styling)
    36	  isOutput: boolean;                       // Phase 87: Output flag
    37	}
    38	
    39	// ActionNode wraps Action to fit the tree structure
    40	export interface ActionNode extends ProcessNodeBase, Action {
    41	  type: 'action';
    42	}
    43	
    44	export type ProcessNode = Subprocess | ActionGroup | ActionNode;
    45	
    46	type ChangeListener = (version: number) => void;
    47	
    48	export class ProcessTree {
    49	  root: Subprocess;
    50	  private _version: number = 0;
    51	  private subprocessStack: Subprocess[] = [];  // Phase 85: Subprocess stack
    52	  private listeners: ChangeListener[] = [];
    53	
    54	  constructor() {
    55	    // Initialize with root subprocess
    56	    // Phase 95: Use fixed ID for root so toggle operations work across sessions
    57	    this.root = {
    58	      id: 'root',
    59	      type: 'subprocess',
    60	      name: 'Root Process',
    61	      children: [],
    62	      showIntermediates: true,
    63	      isOutput: true, // Root is implicitly an output
    64	      created: new Date()
    65	    };
    66	    // Initialize stack with root
    67	    this.subprocessStack = [this.root];
    68	  }
    69	
    70	  /**
    71	   * Get current version for reactivity tracking
    72	   */
    73	  getVersion(): number {
    74	    return this._version;
    75	  }
    76	
    77	  subscribe(listener: ChangeListener): () => void {
    78	    this.listeners.push(listener);
    79	    return () => {
    80	      this.listeners = this.listeners.filter(l => l !== listener);
    81	    };
    82	  }
    83	
    84	  /**
    85	   * Increment version to notify of changes
    86	   */
    87	  private notifyChange(): void {
    88	    this._version++;
    89	    this.listeners.forEach(l => l(this._version));
    90	  }
    91	
    92	  /**
    93	   * Get the current active subprocess (top of stack)
    94	   * Phase 85: Stack-based subprocess management
    95	   */
    96	  getCurrentSubprocess(): Subprocess {
    97	    return this.subprocessStack[this.subprocessStack.length - 1];
    98	  }
    99	
   100	  /**
   101	   * Push a new subprocess onto the stack
   102	   * All subsequent actions will be added to this subprocess
   103	   * Phase 85: Stack-based subprocess management
   104	   * @param id - Optional ID to use (for deserialization), otherwise generates new ID
   105	   */
   106	  pushSubprocess(name: string, id?: string): Subprocess {
   107	    const subprocess: Subprocess = {
   108	      id: id || this.generateId(),
   109	      type: 'subprocess',
   110	      name,
   111	      children: [],
   112	      showIntermediates: true,
   113	      isOutput: true,
   114	      created: new Date()
   115	    };
   116	
   117	    // Add to current subprocess's children
   118	    const parent = this.getCurrentSubprocess();
   119	    parent.children.push(subprocess);
   120	    
   121	    // Push onto stack
   122	    this.subprocessStack.push(subprocess);
   123	    this.notifyChange();
   124	
   125	    return subprocess;
   126	  }
   127	
   128	  /**
   129	   * Pop the current subprocess from the stack
   130	   * Returns to parent subprocess
   131	   * The subprocess remains in the tree as a child of its parent
   132	   * Phase 85: Stack-based subprocess management
   133	   */
   134	  popSubprocess(): void {
   135	    if (this.subprocessStack.length <= 1) {
   136	      throw new Error('Cannot pop root subprocess');
   137	    }
   138	    this.subprocessStack.pop();
   139	    this.notifyChange();
   140	  }
   141	
   142	  findSubprocessById(subprocessId: string): Subprocess | undefined {
   143	    let found: Subprocess | undefined;
   144	    this.traverseSubprocesses(this.root, (subprocess) => {
   145	      if (subprocess.id === subprocessId) {
   146	        found = subprocess;
   147	      }
   148	    });
   149	    return found;
   150	  }
   151	
   152	  /**
   153	   * Add a subprocess to organize actions
   154	   */
   155	  addSubprocess(name: string, parent?: Subprocess): Subprocess {
   156	    const subprocess: Subprocess = {
   157	      id: this.generateId(),
   158	      type: 'subprocess',
   159	      name,
   160	      children: [],
   161	      showIntermediates: true,
   162	      isOutput: true,
   163	      created: new Date()
   164	    };
   165	
   166	    const targetParent = parent || this.root;
   167	    targetParent.children.push(subprocess);
   168	    this.notifyChange();
   169	
   170	    return subprocess;
   171	  }
   172	
   173	  /**
   174	   * Add a complete ActionGroup to the tree (Phase 81 Refactor)
   175	   * Adds to the current subprocess on top of the stack.
   176	   */
   177	  addActionGroup(group: ActionGroup): void {
   178	     const currentSubprocess = this.getCurrentSubprocess();
   179	     currentSubprocess.children.push(group);
   180	     this.notifyChange();
   181	  }
   182	
   183	  /**
   184	   * Add an action to an existing group
   185	   * @param action The action to add
   186	   * @param groupId The ID of the target ActionGroup
   187	   * @returns The index where the action was added
   188	   */
   189	  addActionToGroup(action: Action, groupId: string): number {
   190	    let groupFound: ActionGroup | undefined;
   191	    
   192	    // Find group
   193	    this.traverseGroups(this.root, (group) => {
   194	      if (group.id === groupId) {
   195	        groupFound = group;
   196	      }
   197	    });
   198	
   199	    if (!groupFound) {
   200	      throw new Error(`ActionGroup ${groupId} not found`);
   201	    }
   202	
   203	    // Phase 93: Wrap Action (3 fields) in ActionNode (adds id, type, created)
   204	    const actionNode: ActionNode = {
   205	      ...action,
   206	      id: this.generateId(),  // Generate ID for tree node
   207	      type: 'action',
   208	      isOutput: action.isOutput !== undefined ? action.isOutput : true,
   209	      created: new Date()
   210	    };
   211	    
   212	    const index = groupFound.children.push(actionNode) - 1;
   213	    this.notifyChange();
   214	    return index;
   215	  }
   216	
   217	  /**
   218	   * Rename a subprocess
   219	   */
   220	  renameSubprocess(subprocessId: string, newName: string): void {
--- frontend/src/domain/world/World.ts
     1	/**
     2	 * World - Root container for all geometric elements
     3	 * 
     4	 * The World class stores all geometric entities (points, lines, segments, circles, planes, etc.)
     5	 * in the dihedral drawing system. It serves as the central data structure that holds the 
     6	 * complete state of a construction.
     7	 * 
     8	 * Design principles (from Constitution):
     9	 * - Principle I: Domain layer - pure business logic, no UI dependencies
    10	 * - Principle V: All points stored in plane intrinsic coordinates (homogeneous)
    11	 * 
    12	 * ## Architecture: Element Access Patterns (Phase 48)
    13	 * 
    14	 * **Ownership Hierarchy**: World → ProjectionPlane → Element2D
    15	 * - 2D elements (points, lines, circles, etc.) are stored in and owned by ProjectionPlane
    16	 * - World provides high-level access methods but does NOT store 2D elements directly
    17	 * - This ensures proper encapsulation and clear ownership boundaries
    18	 * 
    19	 * **How to Access Elements**:
    20	 * 
    21	 * 1. **Via Hierarchical ID** (Phase 45 - preferred for known IDs):
    22	 *    ```typescript
    23	 *    const point = world.getPoint2D(pointId);        // Returns Point2D | undefined
    24	 *    const line = world.getLine2D(lineId);           // Returns Line2D | undefined
    25	 *    const circle = world.getCircle2D(circleId);     // Returns Circle2D | undefined
    26	 *    const element = world.getElement2D(elementId);  // Returns Element2D | undefined
    27	 *    ```
    28	 *    These methods use hierarchical IDs (e.g., "proj_plane_1:point_5") to find the 
    29	 *    correct plane and retrieve the element. Type-safe and fast.
    30	 * 
    31	 * 2. **Via ProjectionPlane** (when you already have the plane):
    32	 *    ```typescript
    33	 *    const plane = world.getProjectionPlaneById(planeId);
    34	 *    const point = plane.getPoint(pointId);
    35	 *    const line = plane.getLine(lineId);
    36	 *    ```
    37	 * 
    38	 * 3. **Getting Realizations** (computed geometric data):
    39	 *    ```typescript
    40	 *    const plane = world.getProjectionPlaneById(planeId);
    41	 *    const point = plane.getPoint(pointId);
    42	 *    const realization = point?.realize2D(world);  // Get computed coordinates
    43	 *    ```
    44	 *    Realizations contain the actual computed positions/geometry. The domain object
    45	 *    stores the construction definition (e.g., "intersection of line A and circle B"),
    46	 *    while the realization stores the computed result (e.g., actual [x, y] coordinates).
    47	 * 
    48	 * 4. **Iterating All Elements** (for operations like select-all, export):
    49	 *    ```typescript
    50	 *    for (const plane of world.getAllProjectionPlanes()) {
    51	 *      for (const point of plane.getAllPoints()) {
    52	 *        // Process each point
    53	 *      }
    54	 *    }
    55	 *    ```
    56	 * 
    57	 * 5. **Semantic Access** (Phase 46 - for fixed initial planes):
    58	 *    ```typescript
    59	 *    const horizontalPlane = world.getProjectionPlaneByLabel('P_H');
    60	 *    const verticalPlane = world.getProjectionPlaneByLabel('P_V');
    61	 *    const originH = horizontalPlane.getPoint2DByLabel('O_H');  // Phase 53
    62	 *    const hingeLine = world.getMainHingeLine();
    63	 *    ```
    64	 * 
    65	 * **Why Facade Methods Were Removed** (Phase 48):
    66	 * 
    67	 * Previous versions had convenience methods like `world.getPoint2DRealization(id)` that
    68	 * bypassed ProjectionPlane ownership. These were removed because:
    69	 * - **Violated encapsulation**: World shouldn't know about ProjectionPlane's internal storage
    70	 * - **Tight coupling**: Client code became dependent on World instead of ProjectionPlane
    71	 * - **Inconsistent patterns**: Some code used facade, some used proper ownership
    72	 * - **Maintenance burden**: World had to mirror ProjectionPlane's interface
    73	 * 
    74	 * The current architecture enforces proper ownership: ProjectionPlane owns its elements,
    75	 * World provides semantic access and ID-based lookup.
    76	 * 
    77	 * @see Phase 45: Hierarchical Element IDs
    78	 * @see Phase 46: Semantic Accessors
    79	 * @see Phase 48: Remove World Facade Methods
    80	 */
    81	
