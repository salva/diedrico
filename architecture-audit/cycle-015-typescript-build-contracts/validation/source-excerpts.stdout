    91	<script setup lang="ts">
    92	import { provide, ref, onMounted, onUnmounted } from 'vue';
    93	import SvgCanvas from './components/workspace/SvgCanvas.vue';
    94	import Toolbar from './components/toolbars/Toolbar.vue';
    95	import StatusBar from './components/toolbars/StatusBar.vue';
    96	import ActionsPanel from './components/panels/ActionsPanel.vue';
    97	import ElementsPanel from './components/panels/ElementsPanel.vue';
    98	import ThreeView from './components/panels/ThreeView.vue';
    99	import StartupDialog from './components/dialogs/StartupDialog.vue';
   100	import ProjectNameDisplay from './components/header/ProjectNameDisplay.vue';
   101	import { useToolStore } from './stores/toolStore';
   102	import { TOOL_FAMILIES } from './config/toolFamilies';
   103	import { useSelectionStore } from './stores/selectionStore';
   104	import { useSettingsStore } from './stores/settingsStore';
   105	import { useAuthStore } from './stores/authStore';
   106	import { useViewStore } from './stores/viewStore';
   107	import { createAppShellRuntime } from './application/appShell/AppShellRuntime';
   108	
   109	const GOOGLE_CONFIG = {
   110	  clientId: import.meta.env.VITE_GOOGLE_CLIENT_ID || '',
   111	  apiKey: import.meta.env.VITE_GOOGLE_API_KEY || '',
   112	  appId: import.meta.env.VITE_GOOGLE_APP_ID || '',
   113	};
   114	const hasGoogleCredentials = Boolean(GOOGLE_CONFIG.clientId);
   115	
   116	const toolStore = useToolStore();
   117	toolStore.setToolFamilies(TOOL_FAMILIES);
   118	const selectionStore = useSelectionStore();
   119	useSettingsStore();
   120	const authStore = useAuthStore();
   121	const viewStore = useViewStore();
   122	
   123	const svgCanvasRef = ref<InstanceType<typeof SvgCanvas> | null>(null);
   124	const projectNameDisplayRef = ref<InstanceType<typeof ProjectNameDisplay> | null>(null);
   125	
   126	const runtime = createAppShellRuntime({
   127	  googleConfig: GOOGLE_CONFIG,
   128	  hasGoogleCredentials,
   129	  ports: {
   130	    authStore,
   131	    selectionStore,
   132	    toolStore,
   133	    viewStore,
   134	  },
   135	  callbacks: {
   136	    fitToView: () => svgCanvasRef.value?.fitToView(),
   137	    startRename: () => projectNameDisplayRef.value?.startEditing(),
   138	    alert: (message: string) => window.alert(message),
   139	  },
   140	});
   141	
   142	provide('world', runtime.world);
   143	provide('commandStack', runtime.commandStack);
   144	
   145	const activeTool = toolStore.currentTool;
   146	const activePlaneId = runtime.state.activePlaneId;
   147	const activePlaneName = runtime.state.activePlaneName;
   148	const coordinates3D = runtime.state.coordinates3D;
   149	const show3DView = runtime.state.show3DView;
   150	const showStartupDialog = runtime.state.showStartupDialog;
   151	const isSignedIn = runtime.state.isSignedIn;
   152	const currentProjectName = runtime.state.currentProjectName;
   153	const isRenamingProject = runtime.state.isRenamingProject;
   154	const saveStatus = runtime.state.saveStatus;
   155	const startupFiles = runtime.state.startupFiles;
   156	const startupLoading = runtime.state.startupLoading;
   157	const startupLoadingFiles = runtime.state.startupLoadingFiles;
   158	const startupError = runtime.state.startupError;
   159	
   160	function handleHighlightElements(elementIds: string[], temporary: boolean) {
   161	  void elementIds;
   162	  void temporary;
   163	}
   164	
   165	function handleClearHighlight() {}
   166	
   167	function handleFitToView() {
   168	  svgCanvasRef.value?.fitToView();
   169	}
   170	
   171	onMounted(() => runtime.actions.start());
   172	onUnmounted(() => runtime.actions.dispose());
   173	</script>
