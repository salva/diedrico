   126	              <label for="visibility-input">Visibility:</label>
   127	              <input
   128	                id="visibility-input"
   129	                type="checkbox"
   130	                v-model="editableVisible"
   131	                :disabled="!visibilityOverride"
   132	              />
   133	              <label class="override-checkbox">
   134	                <input type="checkbox" v-model="visibilityOverride" />
   135	                Override
   136	              </label>
   137	            </div>
   138	          </div>
   139	
   140	          <!-- Reset Button -->
