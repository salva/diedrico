   128	  }
   129	
   130	  /**
   131	   * Clear point realization cache
   132	   */
   133	  clearPointRealization2D(id: string): void {
   134	    this.elementStore.clearPointRealization2D(id);
   135	  }
   136	
   137	  // ==================== Line Methods ====================
