    75	   * Get a point by ID
    76	   */
    77	  getPoint(id: string): Point2D | undefined {
    78	    return this.elementStore.getPoint(id);
    79	  }
    80	
    81	  /**
    82	   * Get a point by label (semantic access)
    83	   * Phase 53: Enable label-based point lookup for semantic references
    84	   * 
    85	   * @param label - Point label (e.g., 'O_H', 'O_V', 'A', 'B')
    86	   * @returns Point with matching label
    87	   * @throws Error if no point found with given label
    88	   * 
    89	   * @example
    90	   * const originH = plane.getPoint2DByLabel('O_H');
    91	   */
    92	  getPoint2DByLabel(label: string): Point2D {
    93	    for (const point of this.elementStore.getAllPoints()) {
    94	      if (point.label === label) {
    95	        return point;
    96	      }
    97	    }
    98	    throw new Error(`Point not found on plane ${this.name} with label: ${label}`);
    99	  }
   100	
   101	  /**
   102	   * Get all points on this plane
   103	   */
   104	  getAllPoints(): Point2D[] {
