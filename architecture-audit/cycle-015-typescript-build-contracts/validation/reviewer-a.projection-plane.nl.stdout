   504	  /**
   505	   * Factory method: Create and add a Point2DCircleCircleIntersection to this plane
   506	   * @param circle1Id ID of first circle
   507	   * @param circle2Id ID of second circle
   508	   * @param index Intersection index (0 or 1)
   509	   * @param world World context for validation and ID generation
   510	   * @param id Optional ID for redo operations
   511	   * @returns The created Point2DCircleCircleIntersection
   512	   */
   513	  addCircleCircleIntersection(
   514	    circle1Id: string,
   515	    circle2Id: string,
   516	    index: number,
   517	    world: ProjectionPlaneMutationContext,
   518	    id?: string
   519	  ): Point2DCircleCircleIntersection {
   520	    if (!this.id) {
   521	      throw new Error('Cannot add point to plane without ID');
   522	    }
   523	
   524	    // Validate circles exist
   525	    const circle1Element = this.getCircle(circle1Id);
   526	    const circle2Element = this.getCircle(circle2Id);
   527	    const circle1 = circle1Element.realize2D(world);
   528	    const circle2 = circle2Element.realize2D(world);
   529	    
   530	    if (!circle1) {
   531	      throw new Error(`Invalid circle1Id: ${circle1Id}. Circle does not exist.`);
   532	    }
   533	    if (!circle2) {
   534	      throw new Error(`Invalid circle2Id: ${circle2Id}. Circle does not exist.`);
   535	    }
   536	
   537	    // Validate index
   538	    if (index !== 0 && index !== 1) {
   539	      throw new Error(`Invalid index: ${index}. Must be 0 or 1.`);
   540	    }
   541	
   542	    // Generate unique ID if not provided
   543	    if (!id) {
   544	      id = this.generatePoint2DId(world);
   545	    }
   546	
   547	    // Phase 97: Generate default label if not provided
   548	    const label = world.generateDefaultLabel(id, 'Point2D');
   549	
   550	    const point = new Point2DCircleCircleIntersection(id, circle1Id, circle2Id, index, this.id, label);
   551	    
   552	    this.addPoint(point, world);
   553	    return point;
   554	  }
   555	
   556	  /**
   557	   * Factory method: Create and add a Line2DByTwoPoints to this plane
   558	   * 
   559	   * @param point1Id ID of first point
   560	   * @param point2Id ID of second point
   561	   * @param world World context for validation and ID generation
   562	   * @param id Optional ID - ONLY for redo operations. Tests and normal operations should
   563	   *           omit this to get auto-generated IDs. See addFreePoint2D() for test pattern.
   564	   * @returns The created Line2DByTwoPoints
   565	   */
   566	  addLine2DBetweenTwoPoints(
   567	    point1Id: string,
   568	    point2Id: string,
   569	    world: ProjectionPlaneMutationContext,
   570	    id?: string
   571	  ): Line2DByTwoPoints {
   572	    if (!this.id) {
   573	      throw new Error('Cannot add line to plane without ID');
   574	    }
   575	
   576	    // Validate points exist
   577	    const point1 = this.getPoint(point1Id);
   578	    const point2 = this.getPoint(point2Id);
   579	    
   580	    if (!point1) {
   581	      throw new Error(`Invalid point1Id: ${point1Id}. Point does not exist on this plane.`);
   582	    }
   583	    if (!point2) {
   584	      throw new Error(`Invalid point2Id: ${point2Id}. Point does not exist on this plane.`);
   585	    }
   586	
   587	    // Validate points are distinct
   588	    if (point1Id === point2Id) {
   589	      throw new Error(`Cannot create line from a point to itself. point1Id and point2Id must be different.`);
   590	    }
   591	
   592	    // Validate points have distinct positions
   593	    const point1Realization = point1.realize2D(world);
   594	    const point2Realization = point2.realize2D(world);
   595	    
   596	    if (!point1Realization || !point2Realization) {
   597	      throw new Error(`Cannot compute point realizations. Points may depend on missing elements.`);
   598	    }
   599	
   600	    const distance = point1Realization.position.distanceTo(point2Realization.position);
   601	    if (distance < 1e-10) {
   602	      throw new Error(`Points ${point1Id} and ${point2Id} are too close (distance: ${distance}). Cannot create line.`);
   603	    }
   604	
   605	    // Generate unique ID if not provided
   606	    if (!id) {
   607	      id = this.generateLine2DId(world);
   608	    }
   609	
   610	    // Phase 97: Generate default label if not provided
   611	    const label = world.generateDefaultLabel(id, 'Line2D');
   612	
   613	    const line = new Line2DByTwoPoints(id, point1Id, point2Id, this.id, label);
   614	    
   615	    this.addLine(line, world);
   616	    return line;
   617	  }
   618	
   619	  /**
   620	   * Factory method: Create and add a Line2DParallel to this plane
   621	   * 
   622	   * @param referenceLineId ID of line to be parallel to
   623	   * @param throughPointId ID of point the new line passes through
   624	   * @param world World context for validation and ID generation
   625	   * @param id Optional ID - ONLY for redo operations. Tests and normal operations should
   626	   *           omit this to get auto-generated IDs. See addFreePoint2D() for test pattern.
   627	   * @returns The created Line2DParallel
   628	   */
   629	  addLine2DParallelToLine(
   630	    referenceLineId: string,
   631	    throughPointId: string,
