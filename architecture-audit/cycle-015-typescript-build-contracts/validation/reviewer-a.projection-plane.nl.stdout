   720	   * @param tangentIndex Index (0 or 1) to disambiguate which tangent line (angle-based)
   721	   * @param world World context for validation and ID generation
   722	   * @param id Optional ID - ONLY for redo operations
   723	   * @returns The created Line2DTangentToCircleThroughPoint
   724	   */
   725	  addLine2DTangentToCircleThroughPoint(
   726	    circleId: string,
   727	    throughPointId: string,
   728	    tangentIndex: 0 | 1,
   729	    world: ProjectionPlaneMutationContext,
   730	    id?: string
   731	  ): Line2DTangentToCircleThroughPoint {
   732	    if (!this.id) {
   733	      throw new Error('Cannot add line to plane without ID');
   734	    }
