   633	    id?: string
   634	  ): Line2DParallel {
   635	    if (!this.id) {
   636	      throw new Error('Cannot add line to plane without ID');
   637	    }
   638	
   639	    // Validate through-point exists on this plane
   640	    const throughPoint = this.getPoint(throughPointId);
   641	    if (!throughPoint) {
   642	      throw new Error(`Invalid throughPointId: ${throughPointId}. Point does not exist on this plane.`);
   643	    }
   644	
   645	    // Validate reference line exists (could be on any plane)
   646	    const refLineElement = world.getLine2D(referenceLineId);
   647	    const referenceLine = refLineElement.realize2D(world);
   648	    if (!referenceLine) {
   649	      throw new Error(`Invalid referenceLineId: ${referenceLineId}. Line does not exist.`);
   650	    }
   651	
   652	    // Generate unique ID if not provided
   653	    if (!id) {
   654	      id = this.generateLine2DId(world);
   655	    }
   656	
   657	    // Phase 97: Generate default label if not provided
   658	    const label = world.generateDefaultLabel(id, 'Line2D');
   659	
   660	    const line = new Line2DParallel(id, referenceLineId, throughPointId, this.id, label);
   661	    
   662	    this.addLine(line, world);
   663	    return line;
   664	  }
