   774	  /**
   775	   * Factory method: Create and add Line2DTangentToCircleParallelToLine to this plane
   776	   * 
   777	   * Phase 61: Tangent line to circle parallel to reference line
   778	   * 
   779	   * @param circleId ID of circle to be tangent to
   780	   * @param referenceLineId ID of line to be parallel to (can be on any plane)
   781	   * @param tangentIndex Index (0 or 1) to disambiguate which tangent line (angle-based)
   782	   * @param world World context for validation and ID generation
   783	   * @param id Optional ID - ONLY for redo operations
   784	   * @returns The created Line2DTangentToCircleParallelToLine
   785	   */
   786	  addLine2DTangentToCircleParallelToLine(
   787	    circleId: string,
   788	    referenceLineId: string,
   789	    tangentIndex: 0 | 1,
   790	    world: ProjectionPlaneMutationContext,
   791	    id?: string
   792	  ): Line2DTangentToCircleParallelToLine {
   793	    if (!this.id) {
   794	      throw new Error('Cannot add line to plane without ID');
   795	    }
   796	
   797	    // Validate circle exists on this plane
   798	    const circle = this.getCircle(circleId);
   799	    if (!circle) {
   800	      throw new Error(`Invalid circleId: ${circleId}. Circle does not exist on this plane.`);
   801	    }
   802	
   803	    // Validate reference line exists (could be on any plane)
   804	    const refLineElement = world.getLine2D(referenceLineId);
   805	    const referenceLine = refLineElement.realize2D(world);
   806	    if (!referenceLine) {
   807	      throw new Error(`Invalid referenceLineId: ${referenceLineId}. Line does not exist.`);
   808	    }
   809	
   810	    // Validate tangent index
   811	    if (tangentIndex !== 0 && tangentIndex !== 1) {
   812	      throw new Error(`Invalid tangentIndex: ${tangentIndex}. Must be 0 or 1.`);
   813	    }
   814	
   815	    // Generate unique ID if not provided
   816	    if (!id) {
   817	      id = this.generateLine2DId(world);
   818	    }
   819	
   820	    // Phase 97: Generate default label if not provided
   821	    const label = world.generateDefaultLabel(id, 'Line2D');
   822	
   823	    const line = new Line2DTangentToCircleParallelToLine(
   824	      id,
   825	      circleId,
   826	      referenceLineId,
   827	      tangentIndex,
   828	      this.id,
   829	      label
   830	    );
   831	    
   832	    this.addLine(line, world);
   833	    return line;
   834	  }
   835	
   836	  /**
   837	   * Factory method: Create and add a Segment2DByPoints to this plane
   838	   * 
   839	   * @param point1Id ID of first endpoint
   840	   * @param point2Id ID of second endpoint
   841	   * @param world World context for validation and ID generation
   842	   * @param id Optional ID - ONLY for redo operations. Tests and normal operations should
   843	   *           omit this to get auto-generated IDs. See addFreePoint2D() for test pattern.
   844	   * @returns The created Segment2DByPoints
   845	   */
   846	  addSegment2DBetweenPoints(
   847	    point1Id: string,
   848	    point2Id: string,
   849	    world: ProjectionPlaneMutationContext,
   850	    id?: string
   851	  ): Segment2DByPoints {
   852	    if (!this.id) {
   853	      throw new Error('Cannot add segment to plane without ID');
   854	    }
   855	
   856	    // Validate points exist
   857	    const point1 = this.getPoint(point1Id);
   858	    const point2 = this.getPoint(point2Id);
   859	    
   860	    if (!point1) {
   861	      throw new Error(`Invalid point1Id: ${point1Id}. Point does not exist on this plane.`);
   862	    }
   863	    if (!point2) {
   864	      throw new Error(`Invalid point2Id: ${point2Id}. Point does not exist on this plane.`);
   865	    }
   866	
   867	    // Validate points are distinct
   868	    if (point1Id === point2Id) {
   869	      throw new Error(`Cannot create segment from a point to itself. point1Id and point2Id must be different.`);
   870	    }
   871	
   872	    // Generate unique ID if not provided
   873	    if (!id) {
   874	      id = this.generateSegment2DId(world);
   875	    }
   876	
   877	    // Phase 97: Generate default label if not provided
   878	    const label = world.generateDefaultLabel(id, 'Segment2D');
   879	
   880	    const segment = new Segment2DByPoints(id, point1Id, point2Id, this.id, label);
   881	    
   882	    this.addLine(segment, world);  // Segments are stored as lines
   883	    return segment;
   884	  }
   885	
   886	  /**
   887	   * Factory method: Create and add a Circle2DByCenterAndPoint to this plane
   888	   * 
   889	   * @param centerPointId ID of center point
   890	   * @param circumferencePointId ID of point on circumference
   891	   * @param world World context for validation and ID generation
   892	   * @param id Optional ID - ONLY for redo operations. Tests and normal operations should
   893	   *           omit this to get auto-generated IDs. See addFreePoint2D() for test pattern.
   894	   * @returns The created Circle2DByCenterAndPoint
   895	   */
   896	  addCircle2DByCenterAndPoint(
   897	    centerPointId: string,
   898	    circumferencePointId: string,
   899	    world: ProjectionPlaneMutationContext,
   900	    id?: string
   901	  ): Circle2DByCenterAndPoint {
   902	    if (!this.id) {
   903	      throw new Error('Cannot add circle to plane without ID');
   904	    }
   905	
   906	    // Validate points exist
   907	    const centerPoint = this.getPoint(centerPointId);
   908	    const circumferencePoint = this.getPoint(circumferencePointId);
   909	    
   910	    if (!centerPoint) {
   911	      throw new Error(`Invalid centerPointId: ${centerPointId}. Point does not exist on this plane.`);
   912	    }
   913	    if (!circumferencePoint) {
   914	      throw new Error(`Invalid circumferencePointId: ${circumferencePointId}. Point does not exist on this plane.`);
   915	    }
   916	
   917	    // Validate points are distinct
   918	    if (centerPointId === circumferencePointId) {
   919	      throw new Error(`Cannot create circle with center and circumference point being the same point.`);
   920	    }
   921	
   922	    // Generate unique ID if not provided
   923	    if (!id) {
   924	      id = this.generateCircle2DId(world);
   925	    }
   926	
   927	    // Phase 97: Generate default label if not provided
   928	    const label = world.generateDefaultLabel(id, 'Circle2D');
   929	
   930	    const circle = new Circle2DByCenterAndPoint(id, centerPointId, circumferencePointId, this.id, label);
   931	    
   932	    this.addCircle(circle, world);
   933	    return circle;
   934	  }
   935	
   936	  /**
   937	   * Factory method: Create and add a Guide2D to this plane
   938	   * 
   939	   * @param referenceLineId ID of line to be perpendicular to
   940	   * @param throughPointId ID of point the guide passes through
   941	   * @param world World context for validation and ID generation
   942	   * @param id Optional ID - ONLY for redo operations. Tests and normal operations should
   943	   *           omit this to get auto-generated IDs. See addFreePoint2D() for test pattern.
   944	   * @returns The created Guide2D
   945	   */
   946	  addGuide2D(
   947	    referenceLineId: string,
   948	    throughPointId: string,
   949	    world: ProjectionPlaneMutationContext,
   950	    id?: string
   951	  ): Guide2D {
   952	    if (!this.id) {
   953	      throw new Error('Cannot add guide to plane without ID');
   954	    }
   955	
   956	    // Validate through point exists on this plane
   957	    const throughPoint = this.getPoint(throughPointId);
   958	    if (!throughPoint) {
   959	      throw new Error(`Invalid throughPointId: ${throughPointId}. Point does not exist on this plane.`);
   960	    }
   961	
   962	    // Validate reference line exists (could be on any plane for perpendicular construction)
   963	    const refLineElement = world.getLine2D(referenceLineId);
   964	    if (!refLineElement) {
   965	      throw new Error(`Invalid referenceLineId: ${referenceLineId}. Line does not exist.`);
   966	    }
   967	    
   968	    const referenceLine = refLineElement.realize2D(world);
   969	    if (!referenceLine) {
   970	      throw new Error(`Invalid referenceLineId: ${referenceLineId}. Line cannot be realized.`);
   971	    }
   972	
   973	    // Generate unique ID if not provided
   974	    if (!id) {
   975	      id = this.generateGuide2DId(world);
   976	    }
   977	
   978	    // Phase 97: Generate default label if not provided
   979	    const label = world.generateDefaultLabel(id, 'Guide2D');
   980	
   981	    const guide = new Guide2D(id, referenceLineId, throughPointId, this.id, label);
   982	    
   983	    this.addLine(guide, world);  // Guides are stored as lines
   984	    return guide;
   985	  }
   986	
   987	  /**
   988	   * Add a sibling guide to this plane
   989	   * 
   990	   * Sibling guides are automatically created when a primary Guide2D is created.
   991	   * They maintain the same geometric relationship (perpendicular to HalfHingeLine2D)
   992	   * but in the paired projection plane.
   993	   * 
   994	   * @param primaryGuideId ID of the primary guide that spawned this sibling
   995	   * @param referenceLineId ID of the HalfHingeLine2D in this (sibling) plane
   996	   * @param world World instance for validation
   997	   * @param id Optional ID for the sibling guide (generated if not provided)
   998	   * @returns The created SiblingGuide2D
   999	   * @throws Error if validation fails
  1000	   */
  1001	  addSiblingGuide2D(
  1002	    primaryGuideId: string,
  1003	    referenceLineId: string,
  1004	    world: ProjectionPlaneMutationContext,
  1005	    id?: string
  1006	  ): SiblingGuide2D {
  1007	    if (!this.id) {
  1008	      throw new Error('Cannot add sibling guide to plane without ID');
  1009	    }
  1010	
  1011	    // Validate reference line exists in world
  1012	    const refLineElement = world.getLine2D(referenceLineId);
  1013	    if (!refLineElement) {
  1014	      throw new Error(`Invalid referenceLineId: ${referenceLineId}. Line does not exist.`);
  1015	    }
  1016	    
  1017	    const referenceLine = refLineElement.realize2D(world);
  1018	    if (!referenceLine) {
  1019	      throw new Error(`Invalid referenceLineId: ${referenceLineId}. Line cannot be realized.`);
  1020	    }
  1021	
  1022	    // Validate primary guide exists
  1023	    const primaryGuide = world.getLine2D(primaryGuideId);
  1024	    if (!primaryGuide) {
  1025	      throw new Error(`Invalid primaryGuideId: ${primaryGuideId}. Primary guide does not exist.`);
  1026	    }
  1027	
  1028	    // Generate unique ID if not provided
  1029	    if (!id) {
  1030	      id = this.generateGuide2DId(world);
  1031	    }
  1032	
  1033	    // Get label from primary guide
  1034	    const label = primaryGuide.label;
  1035	    
  1036	    const siblingGuide = new SiblingGuide2D(
  1037	      id,
  1038	      referenceLineId,
  1039	      this.id,
  1040	      primaryGuideId,
  1041	      label
  1042	    );
  1043	    
  1044	    this.addLine(siblingGuide, world);  // Sibling guides are stored as lines
  1045	    return siblingGuide;
  1046	  }
  1047	
  1048	  /**
  1049	   * Factory method: Create and add a sibling intersection point to this plane
  1050	   * 
  1051	   * When an element intersects with a HalfHingeLine2D, the intersection represents
  1052	   * a 3D point that projects onto both planes. This method creates the sibling
  1053	   * intersection point on the paired projection plane.
  1054	   * 
  1055	   * Architecture note: Follows the same pattern as addSiblingGuide2D (Phase 36).
  1056	   * The sibling point uses SiblingIntersectionPoint2D which realizes by cloning
  1057	   * the primary point's coordinates (valid when HHL parametric consistency holds).
  1058	   * 
  1059	   * @param primaryIntersectionId ID of the primary intersection point
  1060	   * @param world World context for validation and ID generation
  1061	   * @param id Optional ID for redo support
  1062	   * @returns The created SiblingIntersectionPoint2D
  1063	   * @throws Error if plane has no ID or primary intersection doesn't exist
  1064	   */
  1065	  addSiblingIntersectionPoint(
  1066	    primaryIntersectionId: string,
  1067	    world: ProjectionPlaneMutationContext,
  1068	    id?: string
  1069	  ): SiblingIntersectionPoint2D {
  1070	    if (!this.id) {
  1071	      throw new Error('Cannot add sibling intersection point to plane without ID');
  1072	    }
  1073	
  1074	    // Validate primary intersection exists
  1075	    const primaryPlane = world.getPlaneForElement(primaryIntersectionId);
  1076	    if (!primaryPlane) {
  1077	      throw new Error(`Primary intersection point not found: ${primaryIntersectionId}`);
  1078	    }
  1079	
  1080	    const primaryPoint = primaryPlane.getPoint(primaryIntersectionId);
  1081	    if (!primaryPoint) {
  1082	      throw new Error(`Primary intersection point not found: ${primaryIntersectionId}`);
  1083	    }
  1084	
  1085	    // Validate primary is an intersection type using instanceof
  1086	    const isIntersection = primaryPoint instanceof Point2DLineLineIntersection ||
  1087	                           primaryPoint instanceof Point2DLineCircleIntersection ||
  1088	                           primaryPoint instanceof Point2DCircleCircleIntersection;
  1089	    
  1090	    if (!isIntersection) {
  1091	      throw new Error(`Primary point must be an intersection type, got: ${primaryPoint.constructor.name}`);
  1092	    }
  1093	
  1094	    // Generate unique ID if not provided
  1095	    if (!id) {
  1096	      id = this.generatePoint2DId(world);
  1097	    }
  1098	
  1099	    // Get label from primary point
  1100	    const label = primaryPoint.label;
  1101	    
  1102	    const siblingPoint = new SiblingIntersectionPoint2D(
  1103	      id,
  1104	      primaryIntersectionId,
  1105	      this.id,
  1106	      label
  1107	    );
  1108	    
  1109	    // Link bidirectionally
  1110	    (primaryPoint as any).siblingPointId = siblingPoint.id;
  1111	    
  1112	    this.addPoint(siblingPoint, world);
  1113	    return siblingPoint;
  1114	  }
  1115	
  1116	  /**
  1117	   * Element factory: Add origin point to projection plane
  1118	   * 
  1119	   * Creates a locked origin point at the specified position.
  1120	   * Origin points cannot be moved or deleted by user actions.
