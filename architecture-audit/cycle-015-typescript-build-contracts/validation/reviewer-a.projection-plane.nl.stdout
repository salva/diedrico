   361	
   362	  /**
   363	   * Factory method: Create and add a FreePoint2D to this plane
   364	   * 
   365	   * @param position Position vector in intrinsic plane coordinates
   366	   * @param world World instance for ID generation
   367	   * @param id Optional ID - ONLY pass this for redo operations that need to recreate
   368	   *           an element with its previous ID. All other callers (tests, tools, normal
   369	   *           operations) should omit this parameter to get an auto-generated hierarchical ID.
   370	   *           
   371	   *           Tests must pass null/undefined and capture the returned element's ID:
   372	   *           ```typescript
   373	   *           const p1 = plane.addFreePoint2D(pos, world);  // Auto-generates ID
   374	   *           const p2 = plane.addFreePoint2D(pos2, world);
   375	   *           const line = plane.addLineByTwoPoints(p1.id, p2.id, world);
   376	   *           ```
   377	   * @returns The created FreePoint2D
   378	   */
   379	  addFreePoint2D(
   380	    position: Vector3,
   381	    world: ProjectionPlaneMutationContext,
   382	    id?: string,
   383	    label?: string
   384	  ): FreePoint2D {
   385	    if (!this.id) {
   386	      throw new Error('Cannot add point to plane without ID');
   387	    }
   388	
   389	    // Generate unique ID if not provided
   390	    if (!id) {
   391	      id = this.generatePoint2DId(world);
   392	    }
   393	
   394	    // Phase 97: Generate default label if not provided
   395	    if (!label) {
   396	      label = world.generateDefaultLabel(id, 'Point2D');
   397	    }
   398	
   399	    const point = new FreePoint2D(id, position, this.id, label);
   400	    
   401	    this.addPoint(point, world);
   402	    return point;
   403	  }
   404	
   405	  /**
   406	   * Factory method: Create and add a Point2DLineLineIntersection to this plane
   407	   * 
   408	   * @param line1Id ID of first line
   409	   * @param line2Id ID of second line
   410	   * @param world World context for validation and ID generation
   411	   * @param id Optional ID - ONLY for redo operations. Tests and normal operations should
   412	   *           omit this to get auto-generated IDs. See addFreePoint2D() for test pattern.
   413	   * @returns The created Point2DLineLineIntersection
   414	   */
   415	  addLineLineIntersection(
   416	    line1Id: string,
   417	    line2Id: string,
   418	    world: ProjectionPlaneMutationContext,
   419	    id?: string
   420	  ): Point2DLineLineIntersection {
   421	    if (!this.id) {
   422	      throw new Error('Cannot add point to plane without ID');
   423	    }
   424	
   425	    // Validate lines exist
   426	    const l1 = this.getLine(line1Id) || world.getLine2D(line1Id);
   427	    const l2 = this.getLine(line2Id) || world.getLine2D(line2Id);
   428	    const line1 = l1.realize2D(world);
   429	    const line2 = l2.realize2D(world);
   430	    
   431	    if (!line1) {
   432	      throw new Error(`Invalid line1Id: ${line1Id}. Line does not exist.`);
   433	    }
   434	    if (!line2) {
   435	      throw new Error(`Invalid line2Id: ${line2Id}. Line does not exist.`);
   436	    }
   437	
   438	    // Generate unique ID if not provided
   439	    if (!id) {
   440	      id = this.generatePoint2DId(world);
   441	    }
   442	
   443	    // Phase 97: Generate default label if not provided
   444	    const label = world.generateDefaultLabel(id, 'Point2D');
   445	
   446	    const point = new Point2DLineLineIntersection(id, line1Id, line2Id, this.id, label);
   447	    
   448	    this.addPoint(point, world);
   449	    return point;
   450	  }
   451	
   452	  /**
   453	   * Factory method: Create and add a Point2DLineCircleIntersection to this plane
   454	   * @param lineId ID of the line
   455	   * @param circleId ID of the circle
   456	   * @param index Intersection index (0 or 1)
   457	   * @param world World context for validation and ID generation
   458	   * @param id Optional ID for redo operations
   459	   * @returns The created Point2DLineCircleIntersection
   460	   */
   461	  addLineCircleIntersection(
   462	    lineId: string,
   463	    circleId: string,
   464	    index: number,
   465	    world: ProjectionPlaneMutationContext,
   466	    id?: string
   467	  ): Point2DLineCircleIntersection {
   468	    if (!this.id) {
   469	      throw new Error('Cannot add point to plane without ID');
   470	    }
   471	
   472	    // Validate elements exist
   473	    const lineElement = this.getLine(lineId);
   474	    const circleElement = this.getCircle(circleId);
   475	    const line = lineElement.realize2D(world);
   476	    const circle = circleElement.realize2D(world);
   477	    
   478	    if (!line) {
   479	      throw new Error(`Invalid lineId: ${lineId}. Line does not exist.`);
   480	    }
   481	    if (!circle) {
   482	      throw new Error(`Invalid circleId: ${circleId}. Circle does not exist.`);
   483	    }
   484	
   485	    // Validate index
   486	    if (index !== 0 && index !== 1) {
   487	      throw new Error(`Invalid index: ${index}. Must be 0 or 1.`);
   488	    }
   489	
   490	    // Generate unique ID if not provided
   491	    if (!id) {
   492	      id = this.generatePoint2DId(world);
   493	    }
   494	
   495	    // Phase 97: Generate default label if not provided
   496	    const label = world.generateDefaultLabel(id, 'Point2D');
   497	
   498	    const point = new Point2DLineCircleIntersection(id, lineId, circleId, index, this.id, label);
   499	    
   500	    this.addPoint(point, world);
   501	    return point;
   502	  }
