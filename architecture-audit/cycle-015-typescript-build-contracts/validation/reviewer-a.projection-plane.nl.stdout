   240	  }
   241	
   242	  // ==================== Realization Computation Methods ====================
   243	  // Phase 22.5: Realization computation moved from World to ProjectionPlane
   244	  // These methods compute realizations and manage the plane-level cache
   245	
   246	  /**
   247	   * Compute and cache 2D realization for a point
   248	   * @param point Point to realize
   249	   * @param world World context for querying dependencies
   250	   * @returns Point2DRealization2D if computation succeeds, undefined otherwise
   251	   */
   252	  realizePoint2D(point: Point2D, world: ProjectionPlaneMutationContext): Point2DRealization2D | undefined {
   253	    // Check cache first
   254	    const cached = this.elementStore.getPointRealization2D(point.id);
   255	    if (cached) {
   256	      return cached;
   257	    }
   258	
   259	    // Compute realization - point will query world for parent element realizations
   260	    const realization = point.realize2D(world);
   261	    if (!realization) {
   262	      return undefined;  // Cannot compute (e.g., missing dependencies)
   263	    }
   264	
   265	    // Cache the result
   266	    this.elementStore.setPointRealization2D(point.id, realization);
   267	    return realization;
   268	  }
   269	
   270	  /**
   271	   * Compute and cache 2D realization for a line
   272	   * @param line Line to realize (includes segments, guides, hinge lines - all Line2D subtypes)
   273	   * @param world World context for querying dependencies
   274	   * @returns Line2DRealization2D if computation succeeds, undefined otherwise
   275	   */
   276	  realizeLine2D(line: Line2D, world: ProjectionPlaneMutationContext): Line2DRealization2D | undefined {
   277	    // Check cache first
   278	    const cached = this.elementStore.getLineRealization2D(line.id);
   279	    if (cached) {
   280	      return cached;
   281	    }
   282	
   283	    // Compute realization - line will query world for parent point realizations
   284	    const realization = line.realize2D(world);
   285	    if (!realization) {
   286	      return undefined;  // Cannot compute (e.g., missing dependency points)
   287	    }
   288	
   289	    // Cache the result
   290	    this.elementStore.setLineRealization2D(line.id, realization);
   291	    return realization;
   292	  }
   293	
   294	  /**
   295	   * Compute and cache 2D realization for a circle
   296	   * @param circle Circle to realize
   297	   * @param world World context for querying dependencies
   298	   * @returns Circle2DRealization2D if computation succeeds, undefined otherwise
   299	   */
   300	  realizeCircle2D(circle: Circle2D, world: ProjectionPlaneMutationContext): Circle2DRealization2D | undefined {
   301	    // Check cache first
   302	    const cached = this.elementStore.getCircleRealization2D(circle.id);
   303	    if (cached) {
   304	      return cached;
   305	    }
   306	
   307	    // Compute realization - circle will query world for parent element realizations
   308	    const realization = circle.realize2D(world);
   309	    if (!realization) {
   310	      return undefined;  // Cannot compute (e.g., missing dependencies)
   311	    }
   312	
   313	    // Cache the result
   314	    this.elementStore.setCircleRealization2D(circle.id, realization);
   315	    return realization;
   316	  }
