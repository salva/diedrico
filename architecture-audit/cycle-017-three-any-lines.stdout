    57	function lift(point2D: Vector3, matrix: any): Vector3 {
    58	  const domain = applyMatrix4x3(point2D, matrix);
    59	  const e = matrix.elements;
    60	  const normal = new Vector3().crossVectors(new Vector3(e[0], e[3], e[6]), new Vector3(e[1], e[4], e[7])).normalize();
    61	  domain.x += normal.x * THREE_STYLE.zOffset;
    62	  domain.y += normal.y * THREE_STYLE.zOffset;
    63	  domain.z += normal.z * THREE_STYLE.zOffset;
    64	  return domainToThreeJS(domain);
    65	}
