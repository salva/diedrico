   158	<script setup lang="ts">
   159	/**
   160	 * SvgCanvas.vue - Main 2D drawing canvas component
   161	 * 
   162	 * This is the primary workspace where all 2D geometric elements are rendered.
   163	 * Uses SVG for crisp, scalable vector graphics per Constitution Principle IV.
   164	 * 
   165	 * Rendering Pipeline:
   166	 * 1. World (domain objects + realizations) 
   167	 * 2. → PaperService (generates Paper primitives in paper coordinates)
   168	 * 3. → SVGRenderer (applies viewport transform, generates SVG attributes)
   169	 * 4. → SVG elements
   170	 * 
   171	 * Key requirements:
   172	 * - SVG element (not HTML Canvas) per ui-spec.md
   173	 * - All rendering goes through Paper abstraction layer
   174	 * - Generic rendering algorithms (no special cases for fixed elements)
   175	 * - Will support pan/zoom viewport transformations in Phase 6
   176	 * - Elements rendered using principle-based algorithms (Constitution Principle IV)
   177	 * 
   178	 * @see specs/001-dihedral-learning-mvp/ui-spec.md#canvas-component
   179	 */
   180	
   181	import { ref, computed, watch, onMounted, onUnmounted, inject, provide } from 'vue';
   182	import { Matrix3, Vector3 } from 'three';
   183	import { World } from '@/domain/world/World';
   184	import { Paper } from '@/domain/presentation/Paper';
   185	import { PaperService, type PrimitiveContext } from '@/services/PaperService';
   186	import { SVGRenderer, type ViewportTransform } from '@/services/SVGRenderer';
   187	import { InputService } from '@/services/InputService';
   188	import { CommandStack } from '@/commands/CommandStack';
   189	import { Command } from '@/commands/Command';
   190	import { UpdateElementStyleOp } from '@/commands/operations/world/UpdateElementStyleOp';
   191	import { UpdateFreePoint2DPositionOp } from '@/commands/operations/world/UpdateFreePoint2DPositionOp';
   192	import { PointTool } from '@/tools/PointTool';
   193	import { LineTool } from '@/tools/LineTool';
   194	import { SegmentTool } from '@/tools/SegmentTool';
   195	import { CircleTool } from '@/tools/CircleTool';
   196	import { GuideTool } from '@/tools/GuideTool';
   197	import { IntersectionTool } from '@/tools/IntersectionTool';
   198	import { ParallelLineTool } from '@/tools/ParallelLineTool';
   199	import { PerpendicularLineTool } from '@/tools/PerpendicularLineTool';
   200	import { TangentLineToCircleThroughPointTool } from '@/tools/TangentLineToCircleThroughPointTool';
   201	import { TangentLineToCircleParallelToLineTool } from '@/tools/TangentLineToCircleParallelToLineTool';
   202	import { Create3DPointTool } from '@/tools/Create3DPointTool';
   203	import { Create3DLineTool } from '@/tools/Create3DLineTool';
   204	import { Create3DSegmentTool } from '@/tools/Create3DSegmentTool';
   205	import { Create3DPlaneTool } from '@/tools/Create3DPlaneTool';
   206	import { CreateProjectionPlaneTool } from '@/tools/CreateProjectionPlaneTool';
   207	import { InteractiveProjectionSetupTool } from '@/tools/ExampleConstructionsTool';
   208	import { QuickProjectionSetupTool } from '@/tools/QuickProjectionSetupTool';
   209	import { Quick3DLineTool } from '@/tools/Quick3DLineTool';
   210	import { Quick3DSegmentTool } from '@/tools/Quick3DSegmentTool';
   211	import { FreePoint2D } from '@/domain/world/Point';
   212	import { useToolStore } from '@/stores/toolStore';
   213	import { useViewStore } from '@/stores/viewStore';
   214	import { useSelectionStore } from '@/stores/selectionStore';
   215	import { useViewport } from '@/composables/useViewport';
   216	import { useGlobalHoverHighlight } from '@/composables/useHoverHighlight';
   217	import { screenTo3D } from '@/utils/coordinateTransform';
   218	import PropertiesDialog from '@/components/dialogs/PropertiesDialog.vue';
   219	import type { ITool } from '@/tools/ITool';
   220	
   221	// Define emits
   222	const emit = defineEmits<{
   223	  'update-3d-coordinates': [coords: { x: number; y: number; z: number } | null];
   224	  'update-active-plane': [planeInfo: { id: string; name: string }];
   225	}>();
   226	
   227	const svgElement = ref<SVGSVGElement | null>(null);
   228	
   229	// Track World version changes (World is not reactive by itself)
   230	const worldVersion = ref(0);
   231	let versionPollId: number | null = null;
   232	let lastWorldVersion = 0;
   233	
   234	// Active plane - derived from World (managed by App.vue)
   235	const activePlane = computed(() => {
   236	  // Depend on worldVersion so plane switching triggers recomputation
   237	  const _ = worldVersion.value;
   238	  return world.getActivePlaneId();
   239	});
   240	
   241	// Dynamic canvas dimensions - updated based on container size
   242	const canvasWidth = ref(1600);
   243	const canvasHeight = ref(1000);
   244	
   245	// Properties dialog state
   246	const showPropertiesDialog = ref(false);
   247	const propertiesElementId = ref<string | null>(null);
   248	
   249	// Viewport transformation (pan/zoom)
   250	const viewStore = useViewStore();
   251	const viewport = computed<ViewportTransform>(() => {
   252	  const vp = viewStore.viewportState.value;
   253	  // Update Paper's viewport transform when it changes
   254	  paper.setViewportTransform(vp);
   255	  return vp;
   256	});
   257	
   258	// Setup viewport interactions (pan/zoom)
   259	const viewportComposable = useViewport({ element: svgElement });
