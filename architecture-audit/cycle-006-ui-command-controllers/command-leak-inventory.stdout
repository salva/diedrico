== Command execution composable ==
     1	import { useProcessStore } from '@/stores/processStore';
     2	import type { Command } from '@/commands/Command';
     3	
     4	/**
     5	 * Result type for command execution
     6	 */
     7	export interface CommandResult<T = any> {
     8	  success: boolean;
     9	  value?: T;
    10	  error?: string;
    11	}
    12	
    13	/**
    14	 * Composable for building and executing commands
    15	 * Handles command construction, validation, and execution with undo/redo
    16	 */
    17	export function useCommandExecution() {
    18	  const processStore = useProcessStore();
    19	
    20	  /**
    21	   * Execute a command with full lifecycle
    22	   * 1. Validate command
    23	   * 2. Execute (addAndExecute on command)
    24	   * 3. Add to command history
    25	   * 4. Return result
    26	   */
    27	  const executeCommand = async <T = any>(command: Command): Promise<CommandResult<T>> => {
    28	    try {
    29	      // Validate command before execution
    30	      const validation = await command.validate();
    31	      if (!validation.valid) {
    32	        return {
    33	          success: false,
    34	          error: validation.error || 'Command validation failed'
    35	        };
    36	      }
    37	
    38	      // Execute command (this calls addAndExecute which commits all operations)
    39	      const result = await command.addAndExecute();
    40	
    41	      // Add to command history for undo/redo
    42	      processStore.pushCommand(command);
    43	
    44	      return {
    45	        success: true,
    46	        value: result
    47	      };
    48	    } catch (error) {
    49	      return {
    50	        success: false,
    51	        error: error instanceof Error ? error.message : 'Command execution failed'
    52	      };
    53	    }
    54	  };
    55	
    56	  /**
    57	   * Execute command without adding to history (for preview/test)
    58	   */
    59	  const previewCommand = async <T = any>(command: Command): Promise<CommandResult<T>> => {
    60	    try {
    61	      const validation = await command.validate();
    62	      if (!validation.valid) {
    63	        return {
    64	          success: false,
    65	          error: validation.error || 'Command validation failed'
    66	        };
    67	      }
    68	
    69	      const result = await command.addAndExecute();
    70	
    71	      return {
    72	        success: true,
    73	        value: result
    74	      };
    75	    } catch (error) {
    76	      return {
    77	        success: false,
    78	        error: error instanceof Error ? error.message : 'Command preview failed'
    79	      };
    80	    }
    81	  };
    82	
    83	  /**
    84	   * Undo last command
    85	   */
    86	  const undo = (): boolean => {
    87	    return processStore.undo();
    88	  };
    89	
    90	  /**
    91	   * Redo last undone command
    92	   */
    93	  const redo = (): boolean => {
    94	    return processStore.redo();
    95	  };
    96	
    97	  /**
    98	   * Check if undo is available
    99	   */
   100	  const canUndo = (): boolean => {
   101	    return processStore.canUndo;
   102	  };
   103	
   104	  /**
   105	   * Check if redo is available
   106	   */
   107	  const canRedo = (): boolean => {
   108	    return processStore.canRedo;
   109	  };
   110	
   111	  return {
   112	    executeCommand,
   113	    previewCommand,
   114	    undo,
   115	    redo,
   116	    canUndo,
   117	    canRedo
   118	  };
   119	}

