   342	function handleGlobalKeyDown(event: KeyboardEvent) {
   343	  if (event.key === 'Escape') {
   344	    // T956: Cancel viewport pan on Esc
   345	    if (viewportPan.value.active) {
   346	      viewportPan.value = {
   347	        active: false,
   348	        startX: 0,
   349	        startY: 0
   350	      };
   351	      return;
   352	    }
   353	    
   354	    // T956: Cancel point drag on Esc
   355	    if (pointDrag.value.active) {
   356	      ignoreNextClick = true;
   357	      endPointDrag(false);
   358	    }
   359	  }
   360	}
