   624	/**
   625	 * Phase 79: Plane-Based Grid with Adaptive Spacing/Subdivisions
   626	 * 
   627	 * Grid uses the active projection plane's intrinsic (u,v) coordinate system
   628	 * Transformation pipeline: Plane (u,v) → Paper (x,y) → Screen (pixels)
   629	 * 
   630	 * Major Grid Lines (Powers of 10):
   631	 * - Major lines always at multiples of 10^n (e.g., 0.1, 1, 10, 100, 1000)
   632	 * - Power of 10 chosen based on zoom level to keep reasonable density
   633	 * 
   634	 * Subdivisions (2, 5, or 10):
   635	 * - Minor lines divide each major interval by 2, 5, or 10
   636	 * - Subdivision chosen to keep minor cells >= minimum pixel threshold (15px)
   637	 * - Preference: smallest subdivision that meets threshold (10 > 5 > 2)
   638	 * 
   639	 * Algorithm:
   640	 * - Calculate minimum spacing in plane units: minSpacing = minPixelsPerCell / zoom
   641	 * - Find smallest value from sequence: 10^n/10, 10^n/5, 10^n/2 that is >= minSpacing
   642	 * - This determines both minor spacing and major spacing (10^n)
   643	 * - Example at zoom=1.0: minSpacing=15, chooses 20 (=100/5), major=100, subdivision=5
   644	 * - Example at zoom=0.1: minSpacing=150, chooses 200 (=1000/5), major=1000, subdivision=5
   645	 */
   646	
   647	/**
   648	 * Compute adaptive grid parameters based on zoom level
   649	 * Major lines at powers of 10, subdivisions are 2, 5, or 10
   650	 */
   651	function computeAdaptiveGridParams(zoom: number): {
   652	  spacing: number;
   653	  subdivision: number;
   654	  majorSpacing: number;
   655	} {
   656	  const minPixelsPerCell = 15; // Minimum pixels per minor grid cell
   657	  const minSpacing = minPixelsPerCell / zoom; // Minimum spacing in plane units
   658	  
   659	  // Find the smallest spacing from sequence: ..., 0.1, 0.2, 0.5, 1, 2, 5, 10, 20, 50, 100, ...
   660	  // These are 10^n/10, 10^n/5, 10^n/2 for integer n
   661	  
   662	  const logMin = Math.log10(minSpacing);
   663	  const basePower = Math.floor(logMin);
   664	  
   665	  // Try powers of 10 starting from basePower
   666	  for (let n = basePower; n < basePower + 3; n++) {
   667	    const base = Math.pow(10, n);
   668	    
   669	    // Try subdivisions in order of preference (10 > 5 > 2 gives smallest cells)
   670	    for (const subdivision of [10, 5, 2]) {
   671	      const spacing = base / subdivision; // Minor line spacing
   672	      if (spacing >= minSpacing) {
   673	        return {
   674	          spacing,           // Minor line spacing (spacing between all lines)
   675	          subdivision,       // Number of minor intervals per major interval
   676	          majorSpacing: base // Major line spacing (10^n)
   677	        };
   678	      }
   679	    }
   680	  }
   681	  
   682	  // Fallback (shouldn't reach here)
   683	  return { spacing: 1, subdivision: 10, majorSpacing: 10 };
   684	}
   685	
