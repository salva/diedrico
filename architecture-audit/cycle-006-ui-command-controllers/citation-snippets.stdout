   314	function endPointDrag(commit: boolean): void {
   315	  if (!pointDrag.value.active) return;
   316	
   317	  const cmd = pointDrag.value.cmd;
   318	
   319	  try {
   320	    if (cmd) {
   321	      if (commit && cmd.getOperations().length > 0) {
   322	        cmd.commit();
   323	        commandStack.push(cmd);
   324	      } else {
   325	        cmd.rollback();
   326	      }
   327	    }
   328	  } finally {
   329	    pointDrag.value = {
   330	      active: false,
   331	      planeId: null,
   332	      pointId: null,
   333	      cmd: null,
   334	      startClientX: 0,
   335	      startClientY: 0,
   336	      moved: false
   337	    };
   338	    renderTick.value++;
   339	  }
   340	}
