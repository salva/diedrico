===== frontend/src/services/factories/PlaneSequenceFactory.ts =====
     1	/**
     2	 * PlaneSequenceFactory - Factory for creating 3D plane sequences with ProcessTree actions
     3	 * 
     4	 * Follows the sequence factory pattern established in Phase 81:
     5	 * - Factories execute operations AND create ProcessTree actions internally
     6	 * - Return element IDs for compositional nesting
     7	 * - Enable dependency tracking for reactive updates
     8	 * 
     9	 * Pattern: operation → extract ID → create action → return ID
    10	 * 
    11	 * Phase 85: Uses PushSubprocessOp/PopSubprocessOp for subprocess stack management.
    12	 * Operations automatically record actions to current subprocess.
    13	 * 
    14	 * Eliminates code duplication between Create3DPlaneTool and CreateProjectionPlaneTool
    15	 * while ensuring ProcessTree actions are created consistently.
    16	 */
    17	
    18	import type { Command } from '@/commands/Command';
    19	import { Add3DPlaneOp } from '@/commands/operations/world/Add3DPlaneOp';
    20	import { AddAuxiliaryProjectionPlaneOp } from '@/commands/operations/world/AddAuxiliaryProjectionPlaneOp';
    21	import { AddHingeLineOp, AddHalfHingeLine2DOp } from '@/commands/operations/world/InitializationOps';
    22	import { AddBrokenHingeLineOp } from '@/commands/operations/world/AddBrokenHingeLineOp';
    23	import { AddProcessTreeActionOp } from '@/commands/operations/processTree/AddProcessTreeActionOp';
    24	import { UpdateElementStyleOp } from '@/commands/operations/world/UpdateElementStyleOp';
    25	import { createAdd3DPlaneAction } from '@/domain/processTree/actions/Element3DActions';
    26	import { createProjectionPlaneAction } from '@/domain/processTree/actions/CreateProjectionPlaneAction';
    27	import {
    28	  createInitializeHingeLineAction,
    29	  createInitializeHalfHingeLine2DAction,
    30	  createInitializeBrokenHingeLineAction,
    31	  createInitializeBrokenHalfHingeLine2DAction
    32	} from '@/domain/processTree/actions/InitializeWorldActions';
    33	import { HalfHingeLine2D } from '@/domain/world/HingeLine';
    34	
    35	export class PlaneSequenceFactory {
    36	  /**
    37	   * Create a 3D plane from two trace lines on different projection planes
    38	   * 
    39	   * Creates:
    40	   * 1. Plane3DFromTraces (via Add3DPlaneOp)
    41	   * 2. ProcessTree action for dependency tracking
    42	   * 
    43	   * @param cmd - Command to add operations to
    44	   * @param trace1Id - ID of first trace line
    45	   * @param trace2Id - ID of second trace line
    46	   * @param plane1Id - ID of projection plane containing trace1
    47	   * @param plane2Id - ID of projection plane containing trace2
    48	   * @param label - Optional label for the plane
    49	   * @param groupId - The ID of the action group to attach operations to
    50	   * @returns Object containing the created plane ID
    51	   */
    52	  static create3DPlaneFromTraces(
    53	    cmd: Command,
    54	    trace1Id: string,
    55	    trace2Id: string,
    56	    plane1Id: string,
    57	    plane2Id: string,
    58	    label?: string,
    59	    groupId?: string
    60	  ): { planeId: string } {
    61	    // Execute operation to create 3D plane
    62	    const result = cmd.addAndExecute(new Add3DPlaneOp(
    63	      trace1Id,
    64	      trace2Id,
    65	      plane1Id,
    66	      plane2Id,
    67	      label
    68	    ));
    69	    
    70	    const planeId = result.outputs.planeId;
    71	    
    72	    // Create ProcessTree action for dependency tracking
    73	    const action = createAdd3DPlaneAction(planeId);
    74	    
    75	    if (groupId) {
    76	      cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
    77	    }
    78	    
    79	    return { planeId };
    80	  }
    81	
    82	  /**
    83	   * Create an auxiliary projection plane with automatic hinge line creation
    84	   * 
    85	   * Creates:
    86	   * 1. AuxiliaryProjectionPlane (via AddAuxiliaryProjectionPlaneOp)
    87	   * 2. HingeLine connecting hingeTracePlaneId to new projection plane
    88	   * 3. HalfHingeLine2D on both planes
    89	   * 4. Hides T1 trace line (unless it's already a HalfHingeLine2D)
    90	   * 5. ProcessTree action for dependency tracking
    91	   * 
    92	   * This is the canonical way to create auxiliary projection planes ("folded planes")
    93	   * that are connected to existing projection planes via a hinge line.
    94	   * 
    95	   * @param cmd - Command to add operations to
    96	   * @param world - World instance (needed to check if T1 is HalfHingeLine2D)
    97	   * @param plane3DId - ID of the Plane3D this projection plane projects
    98	   * @param t1HingeTraceId - ID of hinge trace line (T1) on existing projection plane
    99	   * @param t2OtherTraceId - ID of other trace line (T2) on different projection plane
   100	   * @param t2PrimeLineId - ID of position/orientation line (T2') on same plane as T1
   101	   * @param hingeTracePlaneId - ID of projection plane containing T1 (connects via hinge)
   102	   * @param name - Optional name for the plane (e.g., 'P_A1')
   103	   * @param groupId - The ID of the action group to attach operations to
   104	   * @returns Object containing the created projection plane ID
   105	   */
   106	  static createAuxiliaryProjectionPlane(
   107	    cmd: Command,
   108	    world: import('@/domain/world/World').World,
   109	    plane3DId: string,
   110	    t1HingeTraceId: string,
   111	    t2OtherTraceId: string,
   112	    t2PrimeLineId: string,
   113	    hingeTracePlaneId: string,
   114	    name: string | undefined,
   115	    groupId: string
   116	  ): { projPlaneId: string } {
   117	    
   118	    // Execute operation to create auxiliary projection plane
   119	    const result = cmd.addAndExecute(new AddAuxiliaryProjectionPlaneOp(
   120	      plane3DId,
   121	      t1HingeTraceId,
   122	      t2OtherTraceId,
   123	      t2PrimeLineId,
   124	      name
   125	    ));
   126	    
   127	    const projPlaneId = result.outputs.projPlaneId as string;
   128	    
   129	    // Create ProcessTree action for dependency tracking
   130	    const projPlaneAction = createProjectionPlaneAction(projPlaneId);
   131	
   132	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] About to add ProcessTree action for projPlane:', projPlaneId, 'groupId:', groupId);
   133	    cmd.addAndExecute(new AddProcessTreeActionOp(projPlaneAction, groupId));
   134	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] ProcessTree action added for projPlane');
   135	    
   136	    // Create hinge line connecting the new auxiliary plane to the hinge trace's plane
   137	    // IMPORTANT: plane1 = new auxiliary plane (canonical coords source), plane2 = existing plane
   138	    const hingeLineResult = cmd.addAndExecute(new AddHingeLineOp(
   139	      projPlaneId,        // plane1Id (new auxiliary plane - defines canonical coords)
   140	      hingeTracePlaneId   // plane2Id (existing plane containing T1)
   141	    ));
   142	    const hingeLineId = hingeLineResult.outputs.hingeLineId as string;
   143	    
   144	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] About to add ProcessTree action for hingeLine:', hingeLineId);
   145	    cmd.addAndExecute(new AddProcessTreeActionOp(
   146	      createInitializeHingeLineAction(hingeLineId),
   147	      groupId
   148	    ));
   149	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] ProcessTree action added for hingeLine');
   150	    
   151	    // Create HalfHingeLine2D on both planes (order matches HingeLine plane order)
   152	    const hhl1Op = new AddHalfHingeLine2DOp(projPlaneId, hingeLineId);
   153	    cmd.addAndExecute(hhl1Op);
   154	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] About to add ProcessTree action for HHL #1:', hhl1Op.outputs.lineId, 'groupId:', groupId);
   155	    cmd.addAndExecute(new AddProcessTreeActionOp(
   156	      createInitializeHalfHingeLine2DAction(hhl1Op.outputs.lineId),
   157	      groupId
   158	    ));
   159	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] ProcessTree action added for HHL #1');
   160	
   161	    const hhl2Op = new AddHalfHingeLine2DOp(hingeTracePlaneId, hingeLineId);
   162	    cmd.addAndExecute(hhl2Op);
   163	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] About to add ProcessTree action for HHL #2:', hhl2Op.outputs.lineId, 'groupId:', groupId);
   164	    cmd.addAndExecute(new AddProcessTreeActionOp(
   165	      createInitializeHalfHingeLine2DAction(hhl2Op.outputs.lineId),
   166	      groupId
   167	    ));
   168	    console.log('[PlaneSequenceFactory.createAuxiliaryProjectionPlane] ProcessTree action added for HHL #2');
   169	    
   170	    // Hide T1 trace line (now that it's become a hinge line), unless it's already a HalfHingeLine2D
   171	    const hingePlane = world.getProjectionPlaneById(hingeTracePlaneId);
   172	    if (hingePlane) {
   173	      const t1Line = hingePlane.getLine(t1HingeTraceId);
   174	      if (t1Line && !(t1Line instanceof HalfHingeLine2D)) {
   175	        // T1 is a regular line, hide it since it's now represented by the HalfHingeLine2D
   176	        cmd.addAndExecute(new UpdateElementStyleOp(
   177	          t1HingeTraceId,
   178	          hingeTracePlaneId,
   179	          { visible: false }
   180	        ));
   181	      }
   182	    }
   183	    
   184	    return { projPlaneId };
   185	  }
   186	
   187	  /**
   188	   * Create broken hinge lines for an auxiliary projection plane
   189	   * 
   190	   * Phase 101: Broken Hinge Lines for Auxiliary Planes
   191	   * 
   192	   * Creates broken hinge line connecting the auxiliary plane to another existing plane
