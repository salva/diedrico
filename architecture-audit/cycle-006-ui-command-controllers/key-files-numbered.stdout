
===== frontend/src/tools/ITool.ts =====
     1	/**
     2	 * ITool - Interface for geometric construction tools
     3	 * 
     4	 * Tools are responsible for translating user input into commands.
     5	 * They handle the interaction logic and validation, then create
     6	 * and execute commands via the CommandStack.
     7	 * 
     8	 * Reference: specs/001-dihedral-learning-mvp/ui-spec.md §Tool Interactions
     9	 * 
    10	 * Architecture:
    11	 * User input → Tool.handleClick() → Command creation → CommandStack.push()
    12	 * 
    13	 * Tools do NOT mutate World directly - they always go through commands.
    14	 */
    15	
    16	import type { Vector3 } from 'three';
    17	import type { CommandStack } from '@/commands/CommandStack';
    18	import type { World } from '@/domain/world/World';
    19	import type { Paper } from '@/domain/presentation/Paper';
    20	import type { SelectionMask } from '@/types/SelectionMask';
    21	import type { useToolStore } from '@/stores/toolStore';
    22	
    23	/**
    24	 * Context provided to tools when handling user input
    25	 */
    26	export interface ToolContext {
    27	  planeId: string;          // Which projection plane the click occurred on
    28	  planeCoords: Vector3;     // Click position in plane intrinsic coordinates (u, v, 1)
    29	  canvasCoords: { x: number; y: number }; // Click position in canvas/screen pixels
    30	  commandStack: CommandStack;  // Stack for executing commands
    31	  world: World;             // World for validation and queries
    32	  paper: Paper;             // Paper for spatial queries (hit testing, snapping)
    33	  paperToPlaneTransform: any;  // Transform matrix from paper to plane coordinates (Matrix3 | undefined)
    34	  toolStore: ReturnType<typeof useToolStore>; // Tool store for managing tool state and completion behavior
    35	}
    36	
    37	/**
    38	 * Result of a tool operation
    39	 */
    40	export interface ToolResult {
    41	  success: boolean;
    42	  message?: string;  // User-facing message (success or error)
    43	}
    44	
    45	/**
    46	 * Base interface for all tools
    47	 */
    48	export interface ITool {
    49	  /**
    50	   * Tool identifier (matches ToolType from toolStore)
    51	   */
    52	  readonly name: string;
    53	  
    54	  /**
    55	   * Handle a click event on the canvas
    56	   * 
    57	   * @param context - Tool context with planeId, coords (plane+canvas), commandStack, world
    58	   * @returns Result indicating success/failure and optional message
    59	   */
    60	  handleClick(context: ToolContext): ToolResult;
    61	  
    62	  /**
    63	   * Optional: Cancel ongoing multi-step operation
    64	   */
    65	  cancel?(): void;
    66	  
    67	  /**
    68	   * Optional: Get current tool state for UI feedback
    69	   */
    70	  getState?(): Record<string, any>;
    71	}

===== frontend/src/tools/PointTool.ts =====
     1	/**
     2	 * PointTool - Tool for creating free points (ArgumentCollectorTool Migration)
     3	 * 
     4	 * Migrated to ArgumentCollectorTool framework.
     5	 * 
     6	 * Uses SelectionMask.none() to capture just the mouse position without selecting
     7	 * any existing element. Framework creates ArgumentValue with element=null.
     8	 * 
     9	 * Code reduction: ~80 lines → ~50 lines (37% reduction)
    10	 * 
    11	 * Reference: specs/001-dihedral-learning-mvp/spec.md §US1
    12	 */
    13	
    14	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    15	import type { ToolContext } from './ITool';
    16	import type { ToolArgumentSet, ArgumentValue } from '@/types/ToolArgumentCollector';
    17	import { SelectionMask } from '@/types/SelectionMask';
    18	import { Command } from '@/commands/Command';
    19	import { PointSequenceFactory } from '@/commands/factories/PointSequenceFactory';
    20	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    21	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    22	
    23	/**
    24	 * PointTool using ArgumentCollectorTool framework
    25	 * 
    26	 * Framework handles:
    27	 * - Click capture with SelectionMask.none()
    28	 * - ArgumentValue creation with element=null, planeCoords from click
    29	 * - Automatic execution when position captured
    30	 * 
    31	 * Custom behavior:
    32	 * - Creates free point at mouse position (no element selection)
    33	 */
    34	export class PointTool extends ArgumentCollectorTool {
    35	  readonly name = 'point';
    36	  readonly completionBehavior = 'stay-active' as const;
    37	
    38	  /**
    39	   * Define argument specification
    40	   * Single argument with SelectionMask.none() - just captures position
    41	   */
    42	  protected getArgumentSets(): ToolArgumentSet[] {
    43	    return [
    44	      {
    45	        arguments: [
    46	          { 
    47	            name: 'position', 
    48	            mask: SelectionMask.none()  // No element selection - just mouse position
    49	          }
    50	        ]
    51	      }
    52	    ];
    53	  }
    54	
    55	  /**
    56	   * Execute point creation operations
    57	   */
    58	  protected executeOperations(
    59	    cmd: Command,
    60	    args: Map<string, ArgumentValue>,
    61	    context: ToolContext
    62	  ): void {
    63	    const positionArg = args.get('position')!;
    64	    const planeCoords = positionArg.planeCoords;
    65	    const { planeId, world } = context;
    66	
    67	    // Validate coordinates
    68	    if (!this.validateCoordinates(planeCoords)) {
    69	      throw new Error('Invalid coordinates: NaN or Infinity not allowed');
    70	    }
    71	
    72	    // Validate plane exists
    73	    const plane = world.getProjectionPlaneById(planeId);
    74	    if (!plane) {
    75	      throw new Error(`Plane not found: ${planeId}`);
    76	    }
    77	
    78	    // Create user action group for this tool operation
    79	    const groupId = `group_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    80	    const group = createActionGroup(groupId);
    81	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    82	
    83	    // Use factory to create free point with ProcessTree action
    84	    PointSequenceFactory.createFreePoint(cmd, planeId, planeCoords, groupId);
    85	  }
    86	
    87	  /**
    88	   * Validate that coordinates are finite numbers
    89	   */
    90	  private validateCoordinates(coords: any): boolean {
    91	    if (!coords) return false;
    92	    const { x, y, z } = coords;
    93	    return (
    94	      typeof x === 'number' && isFinite(x) &&
    95	      typeof y === 'number' && isFinite(y) &&
    96	      typeof z === 'number' && isFinite(z)
    97	    );
    98	  }
    99	
   100	  protected getCommandDescription(): string {
   101	    return "Create free point";
   102	  }
   103	}

===== frontend/src/tools/LineTool.ts =====
     1	/**
     2	 * LineTool - Tool for creating lines through two points (Phase 64 Migration)
     3	 * 
     4	 * Migrated to ArgumentCollectorTool framework.
     5	 * Declarative argument specification replaces manual state machine.
     6	 * 
     7	 * Arguments:
     8	 * - point1: Point2D (first point on line)
     9	 * - point2: Point2D (second point on line)
    10	 * 
    11	 * Code reduction: ~150 lines → ~70 lines (53% reduction)
    12	 * 
    13	 * Reference: specs/001-dihedral-learning-mvp/spec.md §US2
    14	 */
    15	
    16	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    17	import type { ToolContext } from './ITool';
    18	import type { ToolArgumentSet, ArgumentValue, CollectionContext } from '@/types/ToolArgumentCollector';
    19	import type { Element2D } from '@/domain/world/Element2D';
    20	import type { Point2D } from '@/domain/world/Point';
    21	import { SelectionMask } from '@/types/SelectionMask';
    22	import { Command } from '@/commands/Command';
    23	import { LineSequenceFactory } from '@/commands/factories/LineSequenceFactory';
    24	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    25	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    26	
    27	/**
    28	 * LineTool using ArgumentCollectorTool framework
    29	 * 
    30	 * Framework handles:
    31	 * - Argument collection (any-order, though semantically both are 'point')
    32	 * - Selection mask computation (point only)
    33	 * - UI feedback ("Creating line: pick point1, point2")
    34	 * - Automatic execution when both points collected
    35	 */
    36	export class LineTool extends ArgumentCollectorTool {
    37	  readonly name = 'line';
    38	  readonly completionBehavior = 'stay-active' as const; // Primitives stay active for repeated use
    39	
    40	  /**
    41	   * Define argument specification
    42	   * Single set with two point arguments
    43	   */
    44	  protected getArgumentSets(): ToolArgumentSet[] {
    45	    return [
    46	      {
    47	        arguments: [
    48	          { 
    49	            name: 'point1', 
    50	            mask: SelectionMask.point() 
    51	          },
    52	          { 
    53	            name: 'point2', 
    54	            mask: SelectionMask.point(),
    55	            // Argument-level validator: Ensure different from point1
    56	            validator: (element: Element2D, context: CollectionContext) => {
    57	              const point1 = context.collected.get('point1');
    58	              if (point1 && element.id === point1.element!.id) {
    59	                return {
    60	                  valid: false,
    61	                  error: 'Cannot create line: must select two different points'
    62	                };
    63	              }
    64	              return { valid: true };
    65	            }
    66	          }
    67	        ]
    68	      }
    69	    ];
    70	  }
    71	
    72	  /**
    73	   * Execute line creation operations
    74	   */
    75	  protected executeOperations(
    76	    cmd: Command,
    77	    args: Map<string, ArgumentValue>,
    78	    context: ToolContext
    79	  ): void {
    80	    const point1 = args.get('point1')!.element as Point2D;
    81	    const point2 = args.get('point2')!.element as Point2D;
    82	    const { planeId } = context;
    83	
    84	    // Create user action group for this tool operation
    85	    const groupId = `group_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    86	    const group = createActionGroup(groupId);
    87	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    88	
    89	    // Factory handles operation AND ProcessTree action
    90	    LineSequenceFactory.createLineByTwoPoints(cmd, planeId, point1.id, point2.id, groupId);
    91	  }
    92	}

===== frontend/src/tools/SegmentTool.ts =====
     1	/**
     2	 * SegmentTool - Tool for creating finite line segments between two points (Phase 64 Migration)
     3	 * 
     4	 * Migrated to ArgumentCollectorTool framework.
     5	 * Declarative argument specification replaces manual state machine.
     6	 * 
     7	 * Arguments:
     8	 * - point1: Point2D (first endpoint of segment)
     9	 * - point2: Point2D (second endpoint of segment)
    10	 * 
    11	 * Unlike LineTool which creates infinite lines, SegmentTool creates finite segments
    12	 * that only exist between their two endpoints.
    13	 * 
    14	 * Code reduction: ~155 lines → ~75 lines (52% reduction)
    15	 * 
    16	 * Reference: specs/001-dihedral-learning-mvp/spec.md §US2
    17	 */
    18	
    19	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    20	import type { ToolContext } from './ITool';
    21	import type { ToolArgumentSet, ArgumentValue, CollectionContext } from '@/types/ToolArgumentCollector';
    22	import type { Element2D } from '@/domain/world/Element2D';
    23	import type { Point2D } from '@/domain/world/Point';
    24	import { SelectionMask } from '@/types/SelectionMask';
    25	import { Command } from '@/commands/Command';
    26	import { AddSegment2DByPointsOp } from '@/commands/operations/world/AddSegmentOp';
    27	import { createSegmentAction } from '@/domain/processTree/actions/CreateSegmentAction';
    28	import { AddProcessTreeActionOp } from '@/commands/operations/processTree/AddProcessTreeActionOp';
    29	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    30	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    31	
    32	/**
    33	 * SegmentTool using ArgumentCollectorTool framework
    34	 * 
    35	 * Framework handles:
    36	 * - Argument collection (any-order, though semantically both are 'point')
    37	 * - Selection mask computation (point only)
    38	 * - UI feedback ("Creating segment: pick point1, point2")
    39	 * - Automatic execution when both points collected
    40	 */
    41	export class SegmentTool extends ArgumentCollectorTool {
    42	  readonly name = 'segment';
    43	  readonly completionBehavior = 'stay-active' as const; // Primitives stay active for repeated use
    44	
    45	  /**
    46	   * Define argument specification
    47	   * Single set with two point arguments
    48	   */
    49	  protected getArgumentSets(): ToolArgumentSet[] {
    50	    return [
    51	      {
    52	        arguments: [
    53	          { 
    54	            name: 'point1', 
    55	            mask: SelectionMask.point() 
    56	          },
    57	          { 
    58	            name: 'point2', 
    59	            mask: SelectionMask.point(),
    60	            // Argument-level validator: Ensure different from point1
    61	            validator: (element: Element2D, context: CollectionContext) => {
    62	              const point1 = context.collected.get('point1');
    63	              if (point1 && element.id === point1.element!.id) {
    64	                return {
    65	                  valid: false,
    66	                  error: 'Cannot create segment: must select two different points'
    67	                };
    68	              }
    69	              return { valid: true };
    70	            }
    71	          }
    72	        ]
    73	      }
    74	    ];
    75	  }
    76	
    77	  /**
    78	   * Execute segment creation operations
    79	   */
    80	  protected executeOperations(
    81	    cmd: Command,
    82	    args: Map<string, ArgumentValue>,
    83	    context: ToolContext
    84	  ): void {
    85	    const point1 = args.get('point1')!.element as Point2D;
    86	    const point2 = args.get('point2')!.element as Point2D;
    87	    const { planeId } = context;
    88	
    89	    // Create segment operation
    90	    const result = cmd.addAndExecute(new AddSegment2DByPointsOp(planeId, point1.id, point2.id));
    91	    const segmentId = result.outputs.segmentId;
    92	    
    93	    // Record ProcessTree action
    94	    const action = createSegmentAction(segmentId);
    95	
    96	    const groupId = `group_${Date.now()}_segment`;
    97	    const group = createActionGroup(groupId);
    98	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    99	    cmd.addAndExecute(new AddProcessTreeActionOp(action, group.id));
   100	  }
   101	}

===== frontend/src/tools/CircleTool.ts =====
     1	/**
     2	 * CircleTool - Tool for creating circles by center point and circumference point (Phase 64)
     3	 * 
     4	 * Migrated to ArgumentCollectorTool framework.
     5	 * Declarative argument specification replaces manual state machine.
     6	 * 
     7	 * Arguments:
     8	 * - center: Point2D (center of circle)
     9	 * - circumferencePoint: Point2D (defines radius and angle zero reference)
    10	 * 
    11	 * Code reduction: 192 lines → ~60 lines (68% reduction)
    12	 * 
    13	 * Reference: specs/001-dihedral-learning-mvp/spec.md §US2 - Create circles
    14	 */
    15	
    16	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    17	import type { ToolContext } from './ITool';
    18	import type { ToolArgumentSet } from '@/types/ToolArgumentCollector';
    19	import type { Point2D } from '@/domain/world/Point';
    20	import { SelectionMask } from '@/types/SelectionMask';
    21	import { Command } from '@/commands/Command';
    22	import { CircleSequenceFactory } from '@/commands/factories/CircleSequenceFactory';
    23	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    24	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    25	
    26	/**
    27	 * CircleTool using ArgumentCollectorTool framework
    28	 * 
    29	 * Framework handles:
    30	 * - Argument collection (any-order, though semantically both are 'point' so order doesn't matter)
    31	 * - Selection mask computation (point only)
    32	 * - UI feedback ("Creating circle: pick center, circumferencePoint")
    33	 * - Automatic execution when both points collected
    34	 */
    35	export class CircleTool extends ArgumentCollectorTool {
    36	  readonly name = 'circle';
    37	  readonly completionBehavior = 'stay-active' as const; // Primitives stay active for repeated use
    38	
    39	  /**
    40	   * Define argument specification
    41	   * Single set with two point arguments
    42	   */
    43	  protected getArgumentSets(): ToolArgumentSet[] {
    44	    return [
    45	      {
    46	        arguments: [
    47	          { 
    48	            name: 'center', 
    49	            mask: SelectionMask.point() 
    50	          },
    51	          { 
    52	            name: 'circumferencePoint', 
    53	            mask: SelectionMask.point() 
    54	          }
    55	        ],
    56	        // Set-level validator: Check minimum radius
    57	        setValidator: (args, context) => {
    58	          const center = args.get('center')!.element as Point2D;
    59	          const circumferencePoint = args.get('circumferencePoint')!.element as Point2D;
    60	          
    61	          const centerRealization = center.realize2D(context.world);
    62	          const circumferenceRealization = circumferencePoint.realize2D(context.world);
    63	          
    64	          if (centerRealization && circumferenceRealization) {
    65	            const radius = centerRealization.position.distanceTo(circumferenceRealization.position);
    66	            if (radius < 1e-3) {
    67	              return { 
    68	                valid: false, 
    69	                error: 'Radius too small. Please select points farther apart.' 
    70	              };
    71	            }
    72	          }
    73	          
    74	          return { valid: true };
    75	        }
    76	      }
    77	    ];
    78	  }
    79	
    80	  /**
    81	   * Execute circle creation operations
    82	   */
    83	  protected executeOperations(
    84	    cmd: Command,
    85	    args: Map<string, import('@/types/ToolArgumentCollector').ArgumentValue>,
    86	    context: ToolContext
    87	  ): void {
    88	    const { planeId } = context;
    89	    
    90	    const center = args.get('center')!.element as Point2D;
    91	    const circumferencePoint = args.get('circumferencePoint')!.element as Point2D;
    92	    
    93	    // Create user action group for this tool operation
    94	    const groupId = `group_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    95	    const group = createActionGroup(groupId);
    96	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    97	
    98	    // Factory handles operation AND ProcessTree action
    99	    CircleSequenceFactory.createCircleByCenterAndPoint(
   100	      cmd, 
   101	      planeId, 
   102	      center.id, 
   103	      circumferencePoint.id,
   104	      groupId
   105	    );
   106	  }
   107	}
   108	

===== frontend/src/tools/GuideTool.ts =====
     1	/**
     2	 * GuideTool - Tool for creating guides perpendicular to reference lines (ArgumentCollectorTool Migration)
     3	 * 
     4	 * Migrated to ArgumentCollectorTool framework.
     5	 * 
     6	 * Implements two-click workflow (order-independent):
     7	 * 1. First click: Select reference line (hinge line) OR through-point
     8	 * 2. Second click: Select the other element (point OR hinge line)
     9	 * 3. Create guide perpendicular to reference line, passing through the point
    10	 * 
    11	 * Guides are special construction lines used in dihedral geometry for transporting
    12	 * points and distances between projection planes. They render as dashed lines.
    13	 * 
    14	 * **Special behavior:**
    15	 * - Always creates TWO guides (primary + sibling on paired plane)
    16	 * - Sibling guide uses HalfHingeLine2D.getSiblingInfo()
    17	 * - Registers TWO ProcessTree actions (primary + sibling)
    18	 * 
    19	 * Code reduction: ~221 lines → ~150 lines (32% reduction)
    20	 * 
    21	 * Reference: 
    22	 * - specs/001-dihedral-learning-mvp/spec.md §US3 - Create Guide
    23	 * - specs/001-dihedral-learning-mvp/spec.md §Guides
    24	 */
    25	
    26	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    27	import type { ToolContext } from './ITool';
    28	import type { ToolArgumentSet, ArgumentValue } from '@/types/ToolArgumentCollector';
    29	import { SelectionMask } from '@/types/SelectionMask';
    30	import { Command } from '@/commands/Command';
    31	import { GuideSequenceFactory } from '@/commands/factories/GuideSequenceFactory';
    32	import { createGuideAction } from '@/domain/processTree/actions/CreateGuideAction';
    33	import { createSiblingGuideAction } from '@/domain/processTree/actions/CreateSiblingGuideAction';
    34	import { AddProcessTreeActionOp } from '@/commands/operations/processTree/AddProcessTreeActionOp';
    35	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    36	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    37	
    38	/**
    39	 * GuideTool using ArgumentCollectorTool framework
    40	 * 
    41	 * Framework handles:
    42	 * - Any-order argument collection (line→point OR point→line)
    43	 * - Selection mask computation (dynamic based on collected arguments)
    44	 * - UI feedback ("Creating guide: pick half-hinge-line, point")
    45	 * - Automatic execution when both elements collected
    46	 * 
    47	 * Custom behavior:
    48	 * - Creates TWO guides (primary + sibling) via GuideSequenceFactory
    49	 * - Registers TWO ProcessTree actions
    50	 * - Uses HalfHingeLine2D.getSiblingInfo() for sibling plane detection
    51	 */
    52	export class GuideTool extends ArgumentCollectorTool {
    53	  readonly name = 'guide';
    54	  readonly completionBehavior = 'stay-active' as const;
    55	
    56	  /**
    57	   * Define argument specification
    58	   * Single set with any-order half-hinge-line and point
    59	   */
    60	  protected getArgumentSets(): ToolArgumentSet[] {
    61	    return [
    62	      {
    63	        // ArgumentCollectorTool automatically supports any-order collection!
    64	        // User can select line→point OR point→line
    65	        arguments: [
    66	          { 
    67	            name: 'referenceLine', 
    68	            mask: SelectionMask.halfHingeLine()
    69	          },
    70	          { 
    71	            name: 'throughPoint', 
    72	            mask: SelectionMask.point()
    73	          }
    74	        ]
    75	      }
    76	    ];
    77	  }
    78	
    79	  /**
    80	   * Execute guide creation operations
    81	   * 
    82	   * Creates:
    83	   * - Primary guide on active plane
    84	   * - Sibling guide on paired plane (automatically via GuideSequenceFactory)
    85	   * 
    86	   * Records TWO ProcessTree actions:
    87	   * - createGuideAction (primary guide)
    88	   * - createSiblingGuideAction (sibling guide)
    89	   */
    90	  protected executeOperations(
    91	    cmd: Command,
    92	    args: Map<string, ArgumentValue>,
    93	    context: ToolContext
    94	  ): void {
    95	    const referenceLine = args.get('referenceLine')!.element!;
    96	    const throughPoint = args.get('throughPoint')!.element!;
    97	    const referenceLineId = referenceLine.id;
    98	    const throughPointId = throughPoint.id;
    99	    const { planeId, world } = context;
   100	
   101	    // Use factory to create guide with sibling
   102	    // This creates both primary and sibling guides automatically
   103	    const result = GuideSequenceFactory.createGuideWithSibling(
   104	      cmd, 
   105	      planeId, 
   106	      referenceLineId, 
   107	      throughPointId, 
   108	      world
   109	    );
   110	    
   111	    const guideId = result.guideId;
   112	    const siblingGuideId = result.siblingGuideId;
   113	
   114	    const groupId = `group_${Date.now()}_guide`;
   115	    const group = createActionGroup(groupId);
   116	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
   117	    
   118	    // Record ProcessTree action for primary guide
   119	    const primaryAction = createGuideAction(guideId);
   120	    cmd.addAndExecute(new AddProcessTreeActionOp(primaryAction, group.id));
   121	    
   122	    // Record ProcessTree action for sibling guide (only if sibling was created)
   123	    if (siblingGuideId) {
   124	      const siblingAction = createSiblingGuideAction(siblingGuideId);
   125	      cmd.addAndExecute(new AddProcessTreeActionOp(siblingAction, group.id));
   126	    }
   127	  }
   128	}

===== frontend/src/tools/IntersectionTool.ts =====
     1	/**
     2	 * IntersectionTool - Tool for creating intersection points (ArgumentCollectorTool Migration)
     3	 * 
     4	 * Migrated to ArgumentCollectorTool framework.
     5	 * 
     6	 * Supports intersections between:
     7	 * - Line-Line
     8	 * - Line-Circle (and Circle-Line)
     9	 * - Circle-Circle
    10	 * 
    11	 * When multiple intersection points exist (line-circle or circle-circle),
    12	 * the tool picks the intersection point nearest to the mouse cursor using
    13	 * the planeCoords from ArgumentValue.
    14	 * 
    15	 * Code reduction: ~407 lines → ~250 lines (38% reduction)
    16	 * 
    17	 * Reference: specs/001-dihedral-learning-mvp/spec.md
    18	 */
    19	
    20	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    21	import type { ToolContext } from './ITool';
    22	import type { ToolArgumentSet, ArgumentValue, CollectionContext } from '@/types/ToolArgumentCollector';
    23	import type { Element2D } from '@/domain/world/Element2D';
    24	import { SelectionMask } from '@/types/SelectionMask';
    25	import { Command } from '@/commands/Command';
    26	import { IntersectionSequenceFactory } from '@/commands/factories/IntersectionSequenceFactory';
    27	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    28	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    29	import { 
    30	  areLinesParallel, 
    31	  intersectLineCircle, 
    32	  intersectCircleCircle 
    33	} from '@/domain/calculations/Intersections';
    34	import type { World } from '@/domain/world/World';
    35	import { Line2D } from '@/domain/world/Line';
    36	import { Circle2D } from '@/domain/world/Circle';
    37	
    38	/**
    39	 * IntersectionTool using ArgumentCollectorTool framework
    40	 * 
    41	 * Framework handles:
    42	 * - Argument collection (element1, element2)
    43	 * - Selection mask computation (lines and circles)
    44	 * - UI feedback ("Creating intersection: pick element1, element2")
    45	 * - Automatic execution when both elements collected
    46	 */
    47	export class IntersectionTool extends ArgumentCollectorTool {
    48	  readonly name = 'intersection';
    49	  readonly completionBehavior = 'stay-active' as const;
    50	
    51	  /**
    52	   * Define argument specification
    53	   * Single set with two line-or-circle arguments
    54	   */
    55	  protected getArgumentSets(): ToolArgumentSet[] {
    56	    return [
    57	      {
    58	        arguments: [
    59	          { 
    60	            name: 'element1', 
    61	            mask: SelectionMask.union(SelectionMask.anyLine(), SelectionMask.circle())
    62	          },
    63	          { 
    64	            name: 'element2', 
    65	            mask: SelectionMask.union(SelectionMask.anyLine(), SelectionMask.circle()),
    66	            // Argument-level validator: Ensure different from element1
    67	            validator: (element: Element2D, context: CollectionContext) => {
    68	              const element1 = context.collected.get('element1');
    69	              if (element1 && element.id === element1.element!.id) {
    70	                return {
    71	                  valid: false,
    72	                  error: 'Cannot create intersection: must select two different elements'
    73	                };
    74	              }
    75	              return { valid: true };
    76	            }
    77	          }
    78	        ]
    79	      }
    80	    ];
    81	  }
    82	
    83	  /**
    84	   * Execute intersection creation operations
    85	   */
    86	  protected executeOperations(
    87	    cmd: Command,
    88	    args: Map<string, ArgumentValue>,
    89	    context: ToolContext
    90	  ): void {
    91	    const elem1Value = args.get('element1')!;
    92	    const elem2Value = args.get('element2')!;
    93	    const element1 = elem1Value.element!;
    94	    const element2 = elem2Value.element!;
    95	    const planeCoords = elem2Value.planeCoords; // Use second click position for index calculation
    96	    const { planeId, world } = context;
    97	
    98	    // Create user action group for this tool operation
    99	    const groupId = `group_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
   100	    const group = createActionGroup(groupId);
   101	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
   102	
   103	    // Determine intersection type and create appropriate intersection
   104	    // Factory handles operation AND ProcessTree actions (including siblings)
   105	    if (element1 instanceof Line2D && element2 instanceof Line2D) {
   106	      // Line-Line intersection
   107	      
   108	      // Validate not parallel - need to realize lines first
   109	      const line1Realization = element1.realize2D(world);
   110	      const line2Realization = element2.realize2D(world);
   111	      
   112	      if (!line1Realization || !line2Realization) {
   113	        throw new Error('Could not realize lines.');
   114	      }
   115	      
   116	      if (areLinesParallel(line1Realization, line2Realization)) {
   117	        throw new Error('Lines are parallel and do not intersect.');
   118	      }
   119	      
   120	      // Factory handles operation AND ProcessTree actions
   121	      IntersectionSequenceFactory.createLineLineIntersection(
   122	        cmd, planeId, element1.id, element2.id, world, groupId
   123	      );
   124	      
   125	    } else if (element1 instanceof Line2D && element2 instanceof Circle2D) {
   126	      // Line-Circle intersection (element1 is line, element2 is circle)
   127	      const index = this.computeLineCircleIntersectionIndex(
   128	        element1.id, element2.id, planeCoords, world
   129	      );
   130	      
   131	      if (index === null) {
   132	        throw new Error('Line and circle do not intersect.');
   133	      }
   134	      
   135	      // Factory handles operation AND ProcessTree actions
   136	      IntersectionSequenceFactory.createLineCircleIntersection(
   137	        cmd, planeId, element1.id, element2.id, index, world, groupId
   138	      );
   139	      
   140	    } else if (element1 instanceof Circle2D && element2 instanceof Line2D) {
   141	      // Line-Circle intersection (element1 is circle, element2 is line)
   142	      const index = this.computeLineCircleIntersectionIndex(
   143	        element2.id, element1.id, planeCoords, world
   144	      );
   145	      
   146	      if (index === null) {
   147	        throw new Error('Circle and line do not intersect.');
   148	      }
   149	      
   150	      // Factory handles operation AND ProcessTree actions
   151	      IntersectionSequenceFactory.createLineCircleIntersection(
   152	        cmd, planeId, element2.id, element1.id, index, world, groupId
   153	      );
   154	      
   155	    } else if (element1 instanceof Circle2D && element2 instanceof Circle2D) {
   156	      // Circle-Circle intersection
   157	      const index = this.computeCircleCircleIntersectionIndex(
   158	        element1.id, element2.id, planeCoords, world
   159	      );
   160	      
   161	      if (index === null) {
   162	        throw new Error('Circles do not intersect.');
   163	      }
   164	      
   165	      // Factory handles operation AND ProcessTree actions
   166	      IntersectionSequenceFactory.createCircleCircleIntersection(
   167	        cmd, planeId, element1.id, element2.id, index, world, groupId
   168	      );
   169	      
   170	    } else {
   171	      throw new Error('Unsupported element type combination for intersection.');
   172	    }
   173	  }
   174	
   175	  protected getCommandDescription(): string {
   176	    return "Create intersection point";
   177	  }
   178	
   179	  /**
   180	   * Compute which line-circle intersection point is closest to mouse position
   181	   * Returns 0 or 1, or null if no intersection
   182	   */
   183	  private computeLineCircleIntersectionIndex(
   184	    lineId: string,
   185	    circleId: string,
   186	    mousePos: THREE.Vector3,
   187	    world: World
   188	  ): number | null {
   189	    const line = world.getLine2D(lineId);
   190	    const circle = world.getCircle2D(circleId);
   191	    
   192	    if (!line || !circle) return null;
   193	    
   194	    const lineRealization = line.realize2D(world);
   195	    const circleRealization = circle.realize2D(world);
   196	    
   197	    if (!lineRealization || !circleRealization) return null;
   198	    
   199	    const intersections = intersectLineCircle(lineRealization, circleRealization);
   200	    
   201	    if (intersections.length === 0) return null;
   202	    if (intersections.length === 1) return 0;
   203	    
   204	    // Two intersections - pick closest to mouse
   205	    const dist0 = intersections[0].distanceTo(mousePos);
   206	    const dist1 = intersections[1].distanceTo(mousePos);
   207	    
   208	    return dist0 <= dist1 ? 0 : 1;
   209	  }
   210	
   211	  /**
   212	   * Compute which circle-circle intersection point is closest to mouse position
   213	   * Returns 0 or 1, or null if no intersection
   214	   */
   215	  private computeCircleCircleIntersectionIndex(
   216	    circle1Id: string,
   217	    circle2Id: string,
   218	    mousePos: THREE.Vector3,
   219	    world: World
   220	  ): number | null {

===== frontend/src/tools/CreateProjectionPlaneTool.ts =====
     1	/**
     2	 * CreateProjectionPlaneTool - Creates auxiliary projection planes (Phase 82)
     3	 * 
     4	 * Three-argument workflow:
     5	 * 1. T1 (hinge trace): Any line on any plane
     6	 * 2. T2 (other trace): Any line on DIFFERENT plane than T1 (validator checks)
     7	 * 3. T2' (position line): Any line on SAME plane as T1 (validator checks, warns if far from expected)
     8	 * 
     9	 * Creates:
    10	 * - Plane3DFromTraces (from T1 and T2)
    11	 * - AuxiliaryProjectionPlane (with T1, T2, T2' trace dependencies)
    12	 * - HingeLine (between T1's plane and new projection plane)
    13	 * - ProcessTree action
    14	 * 
    15	 * Validation:
    16	 * - T1 and T2 must be on different planes
    17	 * - T2' must be on same plane as T1
    18	 * - T2' position warning: If far from expected position (computed via computeExpectedT2Prime)
    19	 * 
    20	 * Reference: data-model.md §Phase 82 - Create Projection Plane Tool
    21	 */
    22	
    23	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    24	import type { ToolContext } from './ITool';
    25	import type { ToolArgumentSet, ArgumentValue, CollectionContext } from '@/types/ToolArgumentCollector';
    26	import { SelectionMask } from '@/types/SelectionMask';
    27	import { Command } from '@/commands/Command';
    28	import { PlaneSequenceFactory } from '@/services/factories/PlaneSequenceFactory';
    29	import { computeExpectedT2Prime, computeLineDistance } from '@/utils/projectionPlaneUtils';
    30	import type { Element2D } from '@/domain/world/Element2D';
    31	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    32	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    33	
    34	/**
    35	 * Tool for creating auxiliary projection planes using ArgumentCollectorTool framework
    36	 * 
    37	 * Pattern: Extends ArgumentCollectorTool with 3-argument set and validators
    38	 * - Base class handles argument collection, viable set tracking, execution
    39	 * - Subclass defines argument specs, validators, and operation logic
    40	 */
    41	export class CreateProjectionPlaneTool extends ArgumentCollectorTool {
    42	  readonly name = 'createprojectionplane';
    43	  readonly completionBehavior = 'stay-active' as const;
    44	
    45	  /**
    46	   * Distance threshold for T2' position warning (in plane units)
    47	   * If T2' is further than this from expected position, show warning
    48	   */
    49	  private readonly POSITION_WARNING_THRESHOLD = 10;
    50	
    51	  protected getArgumentSets(): ToolArgumentSet[] {
    52	    return [
    53	      {
    54	        arguments: [
    55	          { 
    56	            name: 't1HingeTrace', 
    57	            mask: SelectionMask.line()
    58	          },
    59	          { 
    60	            name: 't2OtherTrace', 
    61	            mask: SelectionMask.line(),
    62	            validator: (element: Element2D, context: CollectionContext) => {
    63	              // T2 must be on DIFFERENT plane than T1
    64	              const t1 = context.collected.get('t1HingeTrace');
    65	              if (!t1) return { valid: true }; // T1 not yet collected
    66	              
    67	              const t1PlaneId = t1.element!.planeId;
    68	              const t2PlaneId = element.planeId;
    69	              
    70	              if (t1PlaneId === t2PlaneId) {
    71	                return { 
    72	                  valid: false, 
    73	                  error: 'T2 must be on a DIFFERENT plane than T1' 
    74	                };
    75	              }
    76	              
    77	              return { valid: true };
    78	            }
    79	          },
    80	          { 
    81	            name: 't2PrimePositionLine', 
    82	            mask: SelectionMask.line(),
    83	            validator: (element: Element2D, context: CollectionContext) => {
    84	              // T2' must be on SAME plane as T1
    85	              const t1 = context.collected.get('t1HingeTrace');
    86	              if (!t1) return { valid: true }; // T1 not yet collected
    87	              
    88	              const t1PlaneId = t1.element!.planeId;
    89	              const t2PrimePlaneId = element.planeId;
    90	              
    91	              if (t1PlaneId !== t2PrimePlaneId) {
    92	                return { 
    93	                  valid: false, 
    94	                  error: 'T2\' must be on the SAME plane as T1' 
    95	                };
    96	              }
    97	              
    98	              // Compute expected T2' position and check distance
    99	              const t2 = context.collected.get('t2OtherTrace');
   100	              if (!t2) return { valid: true }; // T2 not yet collected, can't compute expected position
   101	              
   102	              const t1LineId = t1.element!.id;
   103	              const t2LineId = t2.element!.id;
   104	              const t2PrimeLineId = element.id;
   105	              
   106	              try {
   107	                const expected = computeExpectedT2Prime(
   108	                  t1LineId,
   109	                  t2LineId,
   110	                  context.world
   111	                );
   112	                
   113	                if (!expected) {
   114	                  // Expected position could not be computed (e.g., parallel traces)
   115	                  return { valid: true, warning: 'Could not compute expected T2\' position' };
   116	                }
   117	                
   118	                // Get realized T2' line to compute distance
   119	                const t2PrimeLineModel = context.world.getLine2D(t2PrimeLineId);
   120	                if (!t2PrimeLineModel) {
   121	                  return { valid: true, warning: 'Could not validate T2\' position' };
   122	                }
   123	                
   124	                const t2PrimeRealization = t2PrimeLineModel.realize2D(context.world);
   125	                if (!t2PrimeRealization) {
   126	                  return { valid: true, warning: 'Could not validate T2\' position' };
   127	                }
   128	                
   129	                // Compute distance between selected T2' and expected T2'
   130	                const distance = computeLineDistance(t2PrimeRealization, expected);
   131	                
   132	                if (distance > this.POSITION_WARNING_THRESHOLD) {
   133	                  return { 
   134	                    valid: true, 
   135	                    warning: `T2' is ${distance.toFixed(1)} units from expected position (unfolding T2)` 
   136	                  };
   137	                }
   138	                
   139	                return { valid: true };
   140	              } catch (error) {
   141	                // Error computing expected position - allow but warn
   142	                return { valid: true, warning: 'Could not validate T2\' position' };
   143	              }
   144	            }
   145	          }
   146	        ],
   147	        setValidator: (args: Map<string, ArgumentValue>, context: CollectionContext) => {
   148	          // Additional set-level validation (if needed)
   149	          // Currently all validation is done at argument level
   150	          const t1 = args.get('t1HingeTrace');
   151	          const t2 = args.get('t2OtherTrace');
   152	          const t2Prime = args.get('t2PrimePositionLine');
   153	          
   154	          if (!t1 || !t2 || !t2Prime) {
   155	            return { valid: false, error: 'Missing required arguments' };
   156	          }
   157	          
   158	          // Verify planes exist
   159	          const t1Plane = context.world.getProjectionPlaneById(t1.element!.planeId);
   160	          const t2Plane = context.world.getProjectionPlaneById(t2.element!.planeId);
   161	          
   162	          if (!t1Plane || !t2Plane) {
   163	            return { valid: false, error: 'One or more projection planes not found' };
   164	          }
   165	          
   166	          return { valid: true };
   167	        }
   168	      }
   169	    ];
   170	  }
   171	
   172	  protected executeOperations(
   173	    cmd: Command,
   174	    args: Map<string, ArgumentValue>,
   175	    _context: ToolContext
   176	  ): void {
   177	    const t1 = args.get('t1HingeTrace')!.element!;
   178	    const t2 = args.get('t2OtherTrace')!.element!;
   179	    const t2Prime = args.get('t2PrimePositionLine')!.element!;
   180	    
   181	    const t1Id = t1.id;
   182	    const t2Id = t2.id;
   183	    const t2PrimeId = t2Prime.id;
   184	    const t1PlaneId = t1.planeId;
   185	    const t2PlaneId = t2.planeId;
   186	
   187	    const groupId = `group_${Date.now()}_create_proj_plane`;
   188	    const group = createActionGroup(groupId);
   189	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
   190	
   191	    // Step 1: Create 3D plane from T1 and T2 using factory (handles ProcessTree action)
   192	    const { planeId: plane3DId } = PlaneSequenceFactory.create3DPlaneFromTraces(
   193	      cmd,
   194	      t1Id,
   195	      t2Id,
   196	      t1PlaneId,
   197	      t2PlaneId,
   198	      undefined,
   199	      groupId
   200	    );
   201	    
   202	    // Steps 2-4: Create auxiliary projection plane with hinge line and ProcessTree tracking
   203	    // Using factory method that creates plane + hinge line + ProcessTree action in one call
   204	    PlaneSequenceFactory.createAuxiliaryProjectionPlane(
   205	      cmd,
   206	      _context.world,  // world (needed to check if T1 is HalfHingeLine2D)
   207	      plane3DId,
   208	      t1Id,       // T1 (hinge trace)
   209	      t2Id,       // T2 (other trace)
   210	      t2PrimeId,  // T2' (position line)
   211	      t1PlaneId,   // Hinge trace plane (connects via hinge line)
   212	      undefined,
   213	      groupId
   214	    );
   215	  }
   216	
   217	  protected getCommandDescription(): string {
   218	    return "Create auxiliary projection plane";
   219	  }
   220	}

===== frontend/src/tools/QuickProjectionSetupTool.ts =====
     1	/**
     2	 * QuickProjectionSetupTool - Automatic projection plane setup with predefined points
     3	 * 
     4	 * Creates a complete 14-step geometric construction immediately using fixed coordinates:
     5	 * - A1 = (-20, 20) on P_H
     6	 * - A2 = (0, 10) on P_H
     7	 * - B1 = (0, 20) on P_V
     8	 * 
     9	 * Useful for:
    10	 * - Quick testing without manual point selection
    11	 * - Creating consistent example setups
    12	 * - Demonstrating auxiliary projection plane workflow
    13	 * 
    14	 * Related: InteractiveProjectionSetupTool (user selects points)
    15	 */
    16	
    17	import type { ITool, ToolContext, ToolResult } from './ITool';
    18	import type { SelectionMask } from '@/types/SelectionMask';
    19	import { Command } from '@/commands/Command';
    20	import { Vector3 } from 'three';
    21	import { PointSequenceFactory } from '@/commands/factories/PointSequenceFactory';
    22	import { constructProjectionPlaneSetup } from '../commands/factories/ProjectionSetupFactory';
    23	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    24	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    25	
    26	/**
    27	 * Tool that automatically creates projection plane setup with predefined points
    28	 * 
    29	 * Executes immediately on activation (toolbar click) - no canvas interaction needed
    30	 */
    31	export class QuickProjectionSetupTool implements ITool {
    32	  readonly name = 'quickprojectionsetup';
    33	
    34	  activate(context: ToolContext): void {
    35	    // Execute setup immediately on tool activation
    36	    this.executeSetup(context);
    37	  }
    38	
    39	  deactivate(_context: ToolContext): void {
    40	    // No state to clean up
    41	  }
    42	
    43	  handleClick(context: ToolContext): ToolResult {
    44	    // Also allow execution on canvas click (for consistency)
    45	    this.executeSetup(context);
    46	    return { success: true, message: 'Quick projection setup created' };
    47	  }
    48	
    49	  getSelectionMask(): SelectionMask | undefined {
    50	    // Tool doesn't need to select anything
    51	    return undefined;
    52	  }
    53	
    54	  private executeSetup(context: ToolContext): void {
    55	    const { world, commandStack, toolStore } = context;
    56	    
    57	    // Find P_H and P_V
    58	    const P_H = world.getAllProjectionPlanes().find(p => p.name === 'P_H');
    59	    const P_V = world.getAllProjectionPlanes().find(p => p.name === 'P_V');
    60	    
    61	    if (!P_H || !P_V) {
    62	      console.error('Standard projection planes not found');
    63	      toolStore.setTool('select');
    64	      return;
    65	    }
    66	
    67	    const cmd = new Command('Quick projection setup', world);
    68	
    69	    // Create operation group for this tool execution
    70	    const groupId = `group_${Date.now()}_quick_setup`;
    71	    const group = createActionGroup(groupId);
    72	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    73	
    74	    // Create A1 on P_H
    75	    const a1Pos = new Vector3(-20, 20, 1);
    76	    const { pointId: a1Id } = PointSequenceFactory.createFreePoint(cmd, P_H.id!, a1Pos, groupId);
    77	    const a1Point = world.getPoint2D(a1Id);
    78	    if (a1Point) a1Point.label = 'A1';
    79	
    80	    // Create A2 on P_H  
    81	    const a2Pos = new Vector3(0, 10, 1);
    82	    const { pointId: a2Id } = PointSequenceFactory.createFreePoint(cmd, P_H.id!, a2Pos, groupId);
    83	    const a2Point = world.getPoint2D(a2Id);
    84	    if (a2Point) a2Point.label = 'A2';
    85	
    86	    // Create B1 on P_V
    87	    const b1Pos = new Vector3(0, 20, 1);
    88	    const { pointId: b1Id } = PointSequenceFactory.createFreePoint(cmd, P_V.id!, b1Pos, groupId);
    89	    const b1Point = world.getPoint2D(b1Id);
    90	    if (b1Point) b1Point.label = 'B1';
    91	
    92	    // Construct complete projection plane setup
    93	    constructProjectionPlaneSetup(cmd, context, a1Id, a2Id, b1Id, groupId);
    94	
    95	    // Commit and push command, then return to selection tool
    96	    cmd.commit();
    97	    commandStack.push(cmd);
    98	    toolStore.setTool('select');
    99	  }
   100	}
   101	

===== frontend/src/tools/ExampleConstructionsTool.ts =====
     1	/**
     2	 * InteractiveProjectionSetupTool - Interactive tool for creating projection plane setups
     3	 * 
     4	 * Allows user to select 3 points (A1, A2 on P_H and B1 on P_V) and creates the complete
     5	 * 14-step geometric construction for projection plane setup with traces T1, T2, T2'.
     6	 * 
     7	 * Provides complete geometric constructions that demonstrate proper dihedral geometry
     8	 * and facilitate testing of complex features like auxiliary projection planes.
     9	 * 
    10	 * Reference: specs/001-dihedral-learning-mvp/example-setups.md
    11	 */
    12	
    13	import { ArgumentCollectorTool } from './ArgumentCollectorTool';
    14	import type { ToolContext } from './ITool';
    15	import type { ToolArgumentSet, ArgumentValue, CollectionContext } from '@/types/ToolArgumentCollector';
    16	import { SelectionMask } from '@/types/SelectionMask';
    17	import { Command } from '@/commands/Command';
    18	import { constructProjectionPlaneSetup } from '../commands/factories/ProjectionSetupFactory';
    19	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    20	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    21	
    22	/**
    23	 * Interactive tool for creating projection plane setup from user-selected points
    24	 * 
    25	 * User selects:
    26	 * - A1, A2 on P_H (horizontal plane)
    27	 * - B1 on P_V (vertical plane)
    28	 * 
    29	 * Tool constructs complete T1, T2, T2' setup with proper geometric unfolding.
    30	 */
    31	export class InteractiveProjectionSetupTool extends ArgumentCollectorTool {
    32	  readonly name = 'interactiveprojectionsetup';
    33	  readonly completionBehavior = 'return-to-selection' as const;
    34	
    35	  protected getArgumentSets(): ToolArgumentSet[] {
    36	    return [
    37	      {
    38	        arguments: [
    39	          {
    40	            name: 'pointA1',
    41	            mask: SelectionMask.point(),
    42	            validator: (element, context: CollectionContext) => {
    43	              const plane = context.world.getProjectionPlaneById(element.planeId);
    44	              if (plane?.name !== 'P_H') {
    45	                return { valid: false, error: 'Point A1 must be on P_H (horizontal plane)' };
    46	              }
    47	              return { valid: true };
    48	            }
    49	          },
    50	          {
    51	            name: 'pointA2',
    52	            mask: SelectionMask.point(),
    53	            validator: (element, context: CollectionContext) => {
    54	              const plane = context.world.getProjectionPlaneById(element.planeId);
    55	              if (plane?.name !== 'P_H') {
    56	                return { valid: false, error: 'Point A2 must be on P_H (horizontal plane)' };
    57	              }
    58	              return { valid: true };
    59	            }
    60	          },
    61	          {
    62	            name: 'pointB1',
    63	            mask: SelectionMask.point(),
    64	            validator: (element, context: CollectionContext) => {
    65	              const plane = context.world.getProjectionPlaneById(element.planeId);
    66	              if (plane?.name !== 'P_V') {
    67	                return { valid: false, error: 'Point B1 must be on P_V (vertical plane)' };
    68	              }
    69	              return { valid: true };
    70	            }
    71	          }
    72	        ]
    73	      }
    74	    ];
    75	  }
    76	
    77	  protected executeOperations(
    78	    cmd: Command,
    79	    args: Map<string, ArgumentValue>,
    80	    context: ToolContext
    81	  ): void {
    82	    const a1 = args.get('pointA1')!.element!;
    83	    const a2 = args.get('pointA2')!.element!;
    84	    const b1 = args.get('pointB1')!.element!;
    85	
    86	    const groupId = `group_${Date.now()}_interactive_setup`;
    87	    const group = createActionGroup(groupId);
    88	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    89	
    90	    constructProjectionPlaneSetup(cmd, context, a1.id, a2.id, b1.id, groupId);
    91	  }
    92	
    93	  protected getCommandDescription(): string {
    94	    return "Create projection plane setup from selected points";
    95	  }
    96	}

===== frontend/src/commands/factories/PointSequenceFactory.ts =====
     1	/**
     2	 * PointSequenceFactory - Factory for creating free point sequences with ProcessTree actions
     3	 * 
     4	 * Follows the sequence factory pattern established in Phase 81:
     5	 * - Factories execute operations AND create ProcessTree actions internally
     6	 * - Return element IDs for compositional nesting
     7	 * - Enable dependency tracking for reactive updates
     8	 * 
     9	 * Pattern: operation → extract ID → create action → return ID
    10	 * 
    11	 * Eliminates code duplication between PointTool, QuickProjectionSetupTool, and other
    12	 * point creation code while ensuring ProcessTree actions are created consistently.
    13	 */
    14	
    15	import type { Vector3 } from 'three';
    16	import type { Command } from '@/commands/Command';
    17	import { AddFreePoint2DOp } from '@/commands/operations/world/AddFreePointOp';
    18	import { AddProcessTreeActionOp } from '@/commands/operations/processTree/AddProcessTreeActionOp';
    19	import { createPointAction } from '@/domain/processTree/actions/CreatePointAction';
    20	
    21	export class PointSequenceFactory {
    22	  /**
    23	   * Create a free point at a specific position
    24	   * 
    25	   * Creates:
    26	   * 1. FreePoint2D (via AddFreePoint2DOp)
    27	   * 2. ProcessTree action for dependency tracking
    28	   * 
    29	   * @param cmd - Command to add operations to
    30	   * @param planeId - ID of projection plane containing the point
    31	   * @param position - Position in plane intrinsic coordinates (u, v, 1)
    32	   * @param groupId - ID of the ActionGroup to add the action to
    33	   * @returns Object containing the created point ID
    34	   */
    35	  static createFreePoint(
    36	    cmd: Command,
    37	    planeId: string,
    38	    position: Vector3,
    39	    groupId: string
    40	  ): { pointId: string } {
    41	    // Execute operation to create free point
    42	    const result = cmd.addAndExecute(new AddFreePoint2DOp(planeId, position));
    43	    const pointId = result.outputs.pointId;
    44	    
    45	    // Create ProcessTree action for dependency tracking (Phase 92: minimal signature)
    46	    const action = createPointAction(pointId);
    47	    
    48	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
    49	    
    50	    return { pointId };
    51	  }
    52	}

===== frontend/src/commands/factories/LineSequenceFactory.ts =====
     1	/**
     2	 * LineSequenceFactory - Factory for creating line operation sequences
     3	 * 
     4	 * Encapsulates the operation sequence for creating lines:
     5	 * - Line by two points (Line2DByTwoPoints)
     6	 * - Parallel line (Line2DParallel)
     7	 * - Perpendicular line (Line2DPerpendicularToLine)
     8	 * - Tangent lines (tangent to circle through point, parallel to line)
     9	 * 
    10	 * Pattern: Open Command - Receives an open Command, adds operations to it.
    11	 * Returns IDs of created elements for use in nested factory calls.
    12	 * 
    13	 * Benefits:
    14	 * - Consistent API for line creation across different line types
    15	 * - Returns element IDs for use in composite constructions
    16	 * - Testable without tool infrastructure
    17	 * - Reusable across different UIs or automation contexts
    18	 * 
    19	 * Example:
    20	 * ```typescript
    21	 * const cmd = new Command('Create construction', world);
    22	 * 
    23	 * // Create line by two points
    24	 * const lineResult = LineSequenceFactory.createLineByTwoPoints(
    25	 *   cmd, planeId, point1Id, point2Id
    26	 * );
    27	 * 
    28	 * // Use the line ID in subsequent operations
    29	 * const parallelResult = LineSequenceFactory.createParallelLine(
    30	 *   cmd, planeId, lineResult.lineId, throughPointId
    31	 * );
    32	 * ```
    33	 */
    34	
    35	import type { Command } from '../Command';
    36	import { 
    37	  AddLine2DByTwoPointsOp,
    38	  AddLine2DParallelToLineOp,
    39	  AddLine2DPerpendicularToLineOp,
    40	  AddLine2DTangentToCircleThroughPointOp,
    41	  AddLine2DTangentToCircleParallelToLineOp
    42	} from '../operations/world/AddLineOp';
    43	import { AddProcessTreeActionOp } from '../operations/processTree/AddProcessTreeActionOp';
    44	import { createLineAction } from '@/domain/processTree/actions/CreateLineAction';
    45	import { createParallelLineAction } from '@/domain/processTree/actions/CreateParallelLineAction';
    46	import { createPerpendicularLineAction } from '@/domain/processTree/actions/CreatePerpendicularLineAction';
    47	
    48	/**
    49	 * Result of line creation
    50	 */
    51	export interface LineResult {
    52	  lineId: string;
    53	}
    54	
    55	/**
    56	 * Factory for creating line operation sequences
    57	 */
    58	export class LineSequenceFactory {
    59	  /**
    60	   * Create a line by two points.
    61	   * 
    62	   * @param cmd - Open Command to add operations to
    63	   * @param planeId - ID of the projection plane
    64	   * @param point1Id - ID of first point
    65	   * @param point2Id - ID of second point
    66	   * @returns Object with lineId
    67	   * @throws Error if operation fails
    68	   */
    69	  static createLineByTwoPoints(
    70	    cmd: Command,
    71	    planeId: string,
    72	    point1Id: string,
    73	    point2Id: string,
    74	    groupId: string
    75	  ): LineResult {
    76	    const operation = new AddLine2DByTwoPointsOp(planeId, point1Id, point2Id);
    77	    const result = cmd.addAndExecute(operation);
    78	    
    79	    if (!result.success || !result.outputs.lineId) {
    80	      throw new Error(result.error || 'Failed to create line by two points');
    81	    }
    82	    
    83	    const lineId = result.outputs.lineId as string;
    84	    
    85	    // Record ProcessTree action for dependency tracking (Phase 92: minimal signature)
    86	    const action = createLineAction(lineId);
    87	    
    88	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
    89	    
    90	    return { lineId };
    91	  }
    92	
    93	  /**
    94	   * Create a line parallel to a reference line through a point.
    95	   * 
    96	   * @param cmd - Open Command to add operations to
    97	   * @param planeId - ID of the projection plane
    98	   * @param referenceLineId - ID of the reference line
    99	   * @param throughPointId - ID of the point the parallel line passes through
   100	   * @returns Object with lineId
   101	   * @throws Error if operation fails
   102	   */
   103	  static createParallelLine(
   104	    cmd: Command,
   105	    planeId: string,
   106	    referenceLineId: string,
   107	    throughPointId: string,
   108	    groupId: string
   109	  ): LineResult {
   110	    const operation = new AddLine2DParallelToLineOp(planeId, referenceLineId, throughPointId);
   111	    const result = cmd.addAndExecute(operation);
   112	    
   113	    if (!result.success || !result.outputs.lineId) {
   114	      throw new Error(result.error || 'Failed to create parallel line');
   115	    }
   116	    
   117	    const lineId = result.outputs.lineId as string;
   118	    
   119	    // Record ProcessTree action for dependency tracking
   120	    const action = createParallelLineAction(lineId);
   121	    
   122	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
   123	    
   124	    return { lineId };
   125	  }
   126	
   127	  /**
   128	   * Create a line perpendicular to a reference line through a point.
   129	   * 
   130	   * @param cmd - Open Command to add operations to
   131	   * @param planeId - ID of the projection plane
   132	   * @param referenceLineId - ID of the reference line
   133	   * @param throughPointId - ID of the point the perpendicular line passes through
   134	   * @returns Object with lineId
   135	   * @throws Error if operation fails
   136	   */
   137	  static createPerpendicularLine(
   138	    cmd: Command,
   139	    planeId: string,
   140	    referenceLineId: string,
   141	    throughPointId: string,
   142	    groupId: string
   143	  ): LineResult {
   144	    const operation = new AddLine2DPerpendicularToLineOp(planeId, referenceLineId, throughPointId);
   145	    const result = cmd.addAndExecute(operation);
   146	    
   147	    if (!result.success || !result.outputs.lineId) {
   148	      throw new Error(result.error || 'Failed to create perpendicular line');
   149	    }
   150	    
   151	    const lineId = result.outputs.lineId as string;
   152	    
   153	    // Record ProcessTree action for dependency tracking
   154	    const action = createPerpendicularLineAction(lineId);
   155	    
   156	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
   157	    
   158	    return { lineId };
   159	  }
   160	
   161	  /**
   162	   * Create a tangent line to a circle through a point.
   163	   * 
   164	   * @param cmd - Open Command to add operations to
   165	   * @param planeId - ID of the projection plane
   166	   * @param circleId - ID of the circle
   167	   * @param pointId - ID of the point the tangent passes through
   168	   * @param index - Which tangent (0 or 1) when two tangents exist
   169	   * @returns Object with lineId
   170	   * @throws Error if operation fails
   171	   */
   172	  static createTangentToCircleThroughPoint(
   173	    cmd: Command,
   174	    planeId: string,
   175	    circleId: string,
   176	    pointId: string,
   177	    index: 0 | 1
   178	  ): LineResult {
   179	    const operation = new AddLine2DTangentToCircleThroughPointOp(planeId, circleId, pointId, index);
   180	    const result = cmd.addAndExecute(operation);
   181	    
   182	    if (!result.success || !result.outputs.lineId) {
   183	      throw new Error(result.error || 'Failed to create tangent line through point');
   184	    }
   185	    
   186	    return { lineId: result.outputs.lineId as string };
   187	  }
   188	
   189	  /**
   190	   * Create a tangent line to a circle parallel to a reference line.
   191	   * 
   192	   * @param cmd - Open Command to add operations to
   193	   * @param planeId - ID of the projection plane
   194	   * @param circleId - ID of the circle
   195	   * @param referenceLineId - ID of the reference line
   196	   * @param index - Which tangent (0 or 1) when two tangents exist
   197	   * @returns Object with lineId
   198	   * @throws Error if operation fails
   199	   */
   200	  static createTangentToCircleParallelToLine(
   201	    cmd: Command,
   202	    planeId: string,
   203	    circleId: string,
   204	    referenceLineId: string,
   205	    index: 0 | 1
   206	  ): LineResult {
   207	    const operation = new AddLine2DTangentToCircleParallelToLineOp(planeId, circleId, referenceLineId, index);
   208	    const result = cmd.addAndExecute(operation);
   209	    
   210	    if (!result.success || !result.outputs.lineId) {
   211	      throw new Error(result.error || 'Failed to create tangent line parallel to line');
   212	    }
   213	    
   214	    return { lineId: result.outputs.lineId as string };
   215	  }
   216	}

===== frontend/src/commands/factories/GuideSequenceFactory.ts =====
     1	import type { Command } from '../Command';
     2	import { World } from '../../domain/world/World';
     3	import { AddGuide2DPerpendicularToLineOp, AddSiblingGuide2DOp } from '../operations/world/AddGuideOp';
     4	import { HalfHingeLine2D } from '../../domain/world/HingeLine';
     5	import { BrokenHalfHingeLine2D } from '../../domain/world/elements/BrokenHalfHingeLine2D';
     6	import { computeArcGeometry } from '../../utils/arcGeometry';
     7	import { Guide2D, SiblingGuide2D } from '../../domain/world/Guide';
     8	
     9	/**
    10	 * Factory for creating guide operation sequences.
    11	 * 
    12	 * Encapsulates the logic for:
    13	 * - Creating primary guide perpendicular to reference line
    14	 * - Detecting HalfHingeLine reference lines
    15	 * - Creating sibling guides on complementary planes
    16	 * - Updating bidirectional sibling links
    17	 * 
    18	 * @see GuideTool for usage example
    19	 * @see README.md for factory pattern documentation
    20	 */
    21	export class GuideSequenceFactory {
    22	  /**
    23	   * Creates a guide with its sibling on the complementary plane.
    24	   * 
    25	   * Guides MUST be perpendicular to HalfHingeLines. The sibling guide is
    26	   * automatically created in the paired plane using coordinate correspondence.
    27	   * 
    28	   * @param cmd - Open Command to add operations to
    29	   * @param planeId - ID of plane where primary guide is created
    30	   * @param referenceLineId - ID of HalfHingeLine2D to create perpendicular guide to
    31	   * @param throughPointId - ID of point guide should pass through
    32	   * @param world - World instance for navigation
    33	   * 
    34	   * @returns Object with guideId and siblingGuideId (both always present)
    35	   * 
    36	   * @example
    37	   * ```typescript
    38	   * const cmd = new Command('Create guide', world);
    39	   * const result = GuideSequenceFactory.createGuideWithSibling(
    40	   *   cmd, 
    41	   *   planeId, 
    42	   *   referenceLineId, 
    43	   *   throughPointId, 
    44	   *   world
    45	   * );
    46	   * // Tool handles: process tree action, commit, push to stack
    47	   * cmd.commit();
    48	   * commandStack.push(cmd);
    49	   * ```
    50	   */
    51	  static createGuideWithSibling(
    52	    cmd: Command,
    53	    planeId: string,
    54	    referenceLineId: string,
    55	    throughPointId: string,
    56	    world: World
    57	  ): { guideId: string; siblingGuideId?: string } {
    58	    console.log(`[GuideSequenceFactory] createGuideWithSibling called: plane=${planeId}, refLine=${referenceLineId}, point=${throughPointId}`);
    59	    
    60	    // Create primary guide
    61	    const result = cmd.addAndExecute(
    62	      new AddGuide2DPerpendicularToLineOp(planeId, referenceLineId, throughPointId)
    63	    );
    64	    const guideId = result.outputs.guideId;
    65	    
    66	    console.log(`[GuideSequenceFactory] Primary guide created: ${guideId}`);
    67	    
    68	    console.log(`[GuideSequenceFactory] Getting sibling plane info...`);
    69	    
    70	    // Check if reference line is a HalfHingeLine (regular or broken)
    71	    // Try HalfHingeLine2D first
    72	    let siblingInfo = HalfHingeLine2D.getSiblingInfo(world, referenceLineId, planeId);
    73	    
    74	    // If not regular HHL, try BrokenHalfHingeLine2D
    75	    if (!siblingInfo) {
    76	      siblingInfo = BrokenHalfHingeLine2D.getSiblingInfo(world, referenceLineId, planeId);
    77	    }
    78	    
    79	    if (!siblingInfo) {
    80	      console.log(`[GuideSequenceFactory] No sibling info - reference line is not a HalfHingeLine or BrokenHalfHingeLine2D`);
    81	      return { guideId };
    82	    }
    83	    
    84	    console.log(`[GuideSequenceFactory] Sibling plane: ${siblingInfo.siblingPlaneId}, HHL: ${siblingInfo.siblingHalfHingeLineId}`);
    85	    
    86	    // Create sibling guide using coordinate correspondence
    87	    const siblingResult = cmd.addAndExecute(
    88	      new AddSiblingGuide2DOp(
    89	        siblingInfo.siblingPlaneId,
    90	        guideId,
    91	        siblingInfo.siblingHalfHingeLineId
    92	      )
    93	    );
    94	    const siblingGuideId = siblingResult.outputs.siblingGuideId;
    95	    
    96	    // Update bidirectional links
    97	    const primaryGuide = world.getLine2D(guideId)!;
    98	    (primaryGuide as any).siblingGuideId = siblingGuideId;
    99	    
   100	    console.log(
   101	      `[GuideSequenceFactory] Created sibling guide ${siblingGuideId} ` +
   102	      `in plane ${siblingInfo.siblingPlaneId}`
   103	    );
   104	    
   105	    // Phase 101: If reference line is BrokenHalfHingeLine2D, compute arc geometry
   106	    const referenceLine = world.getLine2D(referenceLineId);
   107	    if (referenceLine instanceof BrokenHalfHingeLine2D) {
   108	      console.log(`[GuideSequenceFactory] Reference is BrokenHalfHingeLine2D - computing arc geometry`);
   109	      
   110	      const primaryGuideTyped = primaryGuide as Guide2D;
   111	      const siblingGuide = world.getLine2D(siblingGuideId) as SiblingGuide2D;
   112	      
   113	      // Compute arc geometry connecting the two guides
   114	      const arcGeometry = computeArcGeometry(world, primaryGuideTyped, siblingGuide);
   115	      
   116	      if (arcGeometry) {
   117	        // Store arc in BOTH guides for rendering
   118	        primaryGuideTyped.arcGeometry = arcGeometry;
   119	        siblingGuide.arcGeometry = arcGeometry;
   120	        
   121	        console.log(`[GuideSequenceFactory] Arc geometry computed and stored`);
   122	      } else {
   123	        console.warn(`[GuideSequenceFactory] Failed to compute arc geometry`);
   124	      }
   125	    }
   126	    
   127	    return { guideId, siblingGuideId };
   128	  }
   129	}

===== frontend/src/commands/factories/IntersectionSequenceFactory.ts =====
     1	/**
     2	 * IntersectionSequenceFactory - Factory for creating intersection point sequences
     3	 * 
     4	 * Phase 74: Refactored to eliminate IntersectionData string discriminator.
     5	 * Instead of one method with type string dispatch, provides 3 type-specific methods.
     6	 * Callers use instanceof checks to determine which method to call.
     7	 * 
     8	 * Encapsulates the operation sequence for creating intersection points between:
     9	 * - Line-Line intersections
    10	 * - Line-Circle intersections (with index for multiple intersections)
    11	 * - Circle-Circle intersections (with index for multiple intersections)
    12	 * 
    13	 * Phase 42: Handles HalfHingeLine2D intersections by creating sibling points
    14	 * on the complementary plane (follows same pattern as SiblingGuide2D from Phase 36).
    15	 * 
    16	 * Pattern: Open Command - Receives an open Command, adds operations to it.
    17	 * 
    18	 * Benefits:
    19	 * - No string discriminator round-trip (instanceof → string → dispatch)
    20	 * - Type-safe: each method knows exactly what it handles
    21	 * - Callers use instanceof directly, matching Phase 73 architectural principle
    22	 * - Testable without tool infrastructure
    23	 * - Reusable across different UIs or automation contexts
    24	 * 
    25	 * Example:
    26	 * ```typescript
    27	 * const cmd = new Command('Create intersection', world);
    28	 * const element1 = world.getLine2D(id1);
    29	 * const element2 = world.getLine2D(id2);
    30	 * 
    31	 * // Caller uses instanceof to select method
    32	 * let result;
    33	 * if (element1 instanceof Line2D && element2 instanceof Line2D) {
    34	 *   result = IntersectionSequenceFactory.createLineLineIntersection(
    35	 *     cmd, planeId, id1, id2, world
    36	 *   );
    37	 * }
    38	 * ```
    39	 * 
    40	 * @see frontend/src/commands/factories/README.md
    41	 * @see data-model.md §HalfHingeLine2D Intersection Sibling Behavior
    42	 * @see specs/001-dihedral-learning-mvp/for-planing.md Phase 74
    43	 */
    44	
    45	import type { Command } from '../Command';
    46	import { AddLineLineIntersectionPoint2DOp } from '../operations/world/AddLineLineIntersectionPoint2DOp';
    47	import { AddLineCircleIntersectionPoint2DOp } from '../operations/world/AddLineCircleIntersectionPoint2DOp';
    48	import { AddCircleCircleIntersectionPoint2DOp } from '../operations/world/AddCircleCircleIntersectionPoint2DOp';
    49	import { AddSiblingIntersectionPoint2DOp } from '../operations/world/AddSiblingIntersectionPoint2DOp';
    50	import { AddProcessTreeActionOp } from '../operations/processTree/AddProcessTreeActionOp';
    51	import { createLineLineIntersectionPointAction } from '@/domain/processTree/actions/CreateLineLineIntersectionPointAction';
    52	import { createLineCircleIntersectionPointAction } from '@/domain/processTree/actions/CreateLineCircleIntersectionPointAction';
    53	import { createCircleCircleIntersectionPointAction } from '@/domain/processTree/actions/CreateCircleCircleIntersectionPointAction';
    54	import { createSiblingIntersectionPointAction } from '@/domain/processTree/actions/CreateSiblingIntersectionPointAction';
    55	import type { World } from '@/domain/world/World';
    56	
    57	/**
    58	 * Result of intersection creation with optional sibling point
    59	 */
    60	export interface IntersectionResult {
    61	  pointId: string;
    62	  siblingPointId?: string;
    63	}
    64	
    65	/**
    66	 * Factory for creating intersection point operation sequences
    67	 */
    68	export class IntersectionSequenceFactory {
    69	  /**
    70	   * Create a line-line intersection point.
    71	   * 
    72	   * If either line is a HalfHingeLine2D, automatically creates a sibling
    73	   * intersection point on the complementary plane.
    74	   * 
    75	   * @param cmd - Open Command to add operations to
    76	   * @param planeId - ID of the projection plane
    77	   * @param line1Id - ID of first line
    78	   * @param line2Id - ID of second line
    79	   * @param world - World instance for HHL detection and sibling plane resolution
    80	   * @returns Object with pointId and optional siblingPointId
    81	   * @throws Error if operation fails
    82	   */
    83	  static createLineLineIntersection(
    84	    cmd: Command,
    85	    planeId: string,
    86	    line1Id: string,
    87	    line2Id: string,
    88	    world: World,
    89	    groupId: string
    90	  ): IntersectionResult {
    91	    const operation = new AddLineLineIntersectionPoint2DOp(planeId, line1Id, line2Id);
    92	    const result = this.executeWithSiblingSupport(cmd, operation, planeId, world);
    93	    
    94	    // Record ProcessTree action for primary intersection
    95	    const action = createLineLineIntersectionPointAction(result.pointId, planeId, line1Id, line2Id);
    96	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
    97	    
    98	    // Record ProcessTree action for sibling if created
    99	    if (result.siblingPointId) {
   100	      const primaryPoint = world.getPoint2D(result.pointId);
   101	      if (primaryPoint) {
   102	        const siblingPlaneId = world.getSiblingPlaneForIntersection(primaryPoint);
   103	        if (siblingPlaneId) {
   104	          const siblingAction = createSiblingIntersectionPointAction(
   105	            result.siblingPointId,
   106	            siblingPlaneId,
   107	            result.pointId
   108	          );
   109	          cmd.addAndExecute(new AddProcessTreeActionOp(siblingAction, groupId));
   110	        }
   111	      }
   112	    }
   113	    
   114	    return result;
   115	  }
   116	
   117	  /**
   118	   * Create a line-circle intersection point.
   119	   * 
   120	   * If the line is a HalfHingeLine2D, automatically creates a sibling
   121	   * intersection point on the complementary plane.
   122	   * 
   123	   * @param cmd - Open Command to add operations to
   124	   * @param planeId - ID of the projection plane
   125	   * @param lineId - ID of the line
   126	   * @param circleId - ID of the circle
   127	   * @param index - Which intersection point (0 or 1) when two exist
   128	   * @param world - World instance for HHL detection and sibling plane resolution
   129	   * @returns Object with pointId and optional siblingPointId
   130	   * @throws Error if operation fails
   131	   */
   132	  static createLineCircleIntersection(
   133	    cmd: Command,
   134	    planeId: string,
   135	    lineId: string,
   136	    circleId: string,
   137	    index: number,
   138	    world: World,
   139	    groupId: string
   140	  ): IntersectionResult {
   141	    const operation = new AddLineCircleIntersectionPoint2DOp(planeId, lineId, circleId, index);
   142	    const result = this.executeWithSiblingSupport(cmd, operation, planeId, world);
   143	    
   144	    // Record ProcessTree action for primary intersection
   145	    const action = createLineCircleIntersectionPointAction(result.pointId, planeId, lineId, circleId, index);
   146	    cmd.addAndExecute(new AddProcessTreeActionOp(action, groupId));
   147	    
   148	    // Record ProcessTree action for sibling if created
   149	    if (result.siblingPointId) {
   150	      const primaryPoint = world.getPoint2D(result.pointId);
   151	      if (primaryPoint) {
   152	        const siblingPlaneId = world.getSiblingPlaneForIntersection(primaryPoint);
   153	        if (siblingPlaneId) {
   154	          const siblingAction = createSiblingIntersectionPointAction(
   155	            result.siblingPointId,
   156	            siblingPlaneId,
   157	            result.pointId
   158	          );
   159	          cmd.addAndExecute(new AddProcessTreeActionOp(siblingAction, groupId));
   160	        }
   161	      }
   162	    }
   163	    
   164	    return result;
   165	  }
