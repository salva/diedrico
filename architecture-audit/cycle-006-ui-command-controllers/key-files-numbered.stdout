   214	  ): { brokenHingeLineId: string; bhhl1Id: string; bhhl2Id: string } {
   215	    
   216	    // Execute operation to create broken hinge line
   217	    const result = cmd.addAndExecute(new AddBrokenHingeLineOp(
   218	      mainHingeId,
   219	      auxiliaryPlaneId,
   220	      auxiliaryPlaneId,  // plane1Id (BHHL on auxiliary plane)
