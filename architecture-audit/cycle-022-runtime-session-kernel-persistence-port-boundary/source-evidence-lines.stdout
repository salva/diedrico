     9	export type SaveStatus = 'idle' | 'saving' | 'saved';
    10	
    11	export interface DrivePort {
    12	  initialize(): Promise<void>;
    13	  isSignedIn(): boolean;
    14	  signIn(): Promise<void>;
    15	  signOut(): Promise<void>;
    16	  fetchUserProfile(): Promise<GoogleUserProfile>;
    17	  listFiles(): Promise<GoogleDriveFile[]>;
    18	  createFile(fileName: string, data: object): Promise<string>;
    19	  loadFile(fileId: string): Promise<object>;
    20	  updateFile(fileId: string, data: object): Promise<void>;
    21	  renameFile(fileId: string, newName: string): Promise<void>;
    22	  generateDefaultProjectName(): Promise<string>;
    23	}
    24	
    25	export interface ProjectSessionPersistencePort {
    26	  snapshotCurrentSession(deps: { commandStack: CommandStack; world: World; projectName: string }): ProjectData;
    27	  assertProjectData(data: unknown): asserts data is ProjectData;
    28	  restoreSession(data: ProjectData, deps: { world: World; commandStack: CommandStack }): void;
    29	}
    30	
    31	export interface LastProjectRecord {
    32	  id: string;
    33	  name: string;
    34	}
    35	
    36	export interface LastProjectRepositoryPort {
    37	  getLastProject(): LastProjectRecord | null;
    38	  setLastProject(project: LastProjectRecord): void;
    39	  clearLastProject(): void;
    40	}
    41	
    42	export type TimeoutHandle = number;
    43	export type IntervalHandle = number;
    44	
    45	export interface SchedulerPort {
    46	  setTimeout(handler: () => void, ms: number): TimeoutHandle;
    47	  clearTimeout(handle: TimeoutHandle): void;
    48	  setInterval(handler: () => void, ms: number): IntervalHandle;
    49	  clearInterval(handle: IntervalHandle): void;
    50	}
    51	
    52	export interface AuthStorePort {
    53	  restoreSession(): boolean;
    54	  setUser(profile: GoogleUserProfile): void;
    55	  setAuthenticated(profile: GoogleUserProfile, accessToken: string, expiry?: Date): void;
    56	  clearAuth(): void;
    57	}
    58	
    59	export interface SelectionStorePort {
    60	  selectedIdsArray: string[];
    61	  clearSelection(): void;
    62	  selectMultiple(ids: string[]): void;
    63	  setCascadeHighlight(ids: string[]): void;
    64	  clearCascadeHighlight(): void;
    65	}
    66	
    67	export interface ToolStorePort {
