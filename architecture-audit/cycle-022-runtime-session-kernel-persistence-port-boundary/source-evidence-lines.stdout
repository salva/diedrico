     1	import { computed, ref } from 'vue';
     2	import { CommandStack } from '@/commands/CommandStack';
     3	import { World } from '@/domain/world/World';
     4	import { SelectionDeletionCommandService } from '@/application/selectionDeletion/SelectionDeletionCommandService';
     5	import { ActivePlaneUseCases } from './ActivePlaneUseCases';
     6	import { AutoSaveUseCases } from './AutoSaveUseCases';
     7	import { KeyboardShortcutRouter } from './KeyboardShortcutRouter';
     8	import type { AppShellRuntimePorts, SaveStatus } from './AppShellPorts';
     9	import { ProjectSessionUseCases } from './ProjectSessionUseCases';
    10	import { SelectionUseCases } from './SelectionUseCases';
    11	
    12	export interface AppShellRuntimeOptions {
    13	  ports: AppShellRuntimePorts;
    14	}
    15	
    16	export function createAppShellRuntime(options: AppShellRuntimeOptions) {
    17	  const world = new World();
    18	  const commandStack = new CommandStack();
    19	  const ports = options.ports;
    20	  const drive = ports.drive;
    21	
    22	  const activePlaneId = ref<string | undefined>(world.getActivePlaneId());
    23	  const activePlaneName = ref('');
    24	  const coordinates3D = ref<{ x: number; y: number; z: number } | null>(null);
    25	  const show3DView = ref(true);
    26	  const showStartupDialog = ref(false);
    27	  const isSignedIn = ref(false);
    28	  const currentProjectName = ref<string | null>(null);
    29	  const currentFileId = ref<string | null>(null);
    30	  const isRenamingProject = ref(false);
    31	  const saveStatus = ref<SaveStatus>('idle');
    32	  const startupDialog = {
    33	    files: ref([]),
    34	    loading: ref(false),
    35	    loadingFiles: ref(false),
    36	    error: ref<string | null>(null),
    37	  };
    38	
    39	  const activePlane = new ActivePlaneUseCases(world, { activePlaneId, activePlaneName });
    40	  const selectionDeletion = new SelectionDeletionCommandService(world, commandStack);
    41	  const selection = new SelectionUseCases(world, selectionDeletion, ports.selectionStore, () => activePlaneId.value);
    42	  const autoSave = new AutoSaveUseCases({
    43	    world,
    44	    commandStack,
    45	    drive,
    46	    persistence: ports.persistence,
    47	    lastProjectRepository: ports.lastProjectRepository,
    48	    scheduler: ports.scheduler,
    49	    currentFileId,
    50	    currentProjectName,
    51	    saveStatus,
    52	    showStartupDialog,
    53	    isSignedIn,
    54	    alert: ports.callbacks.alert,
    55	  });
    56	  const projectSession = new ProjectSessionUseCases({
    57	    world,
    58	    commandStack,
    59	    hasGoogleCredentials: drive !== null,
    60	    showStartupDialog,
    61	    isSignedIn,
    62	    currentProjectName,
    63	    currentFileId,
    64	    isRenamingProject,
    65	    saveStatus,
    66	    startupDialog,
    67	    autoSave,
    68	    ports,
    69	  });
    70	  const keyboard = new KeyboardShortcutRouter({
    71	    commandStack,
    72	    toolStore: ports.toolStore,
    73	    viewStore: ports.viewStore,
    74	    projectSession,
    75	    selection,
    76	    activePlane,
    77	    fitToView: ports.callbacks.fitToView,
    78	    startRename: ports.callbacks.startRename,
    79	  });
    80	
    81	  let started = false;
    82	  function start(): void {
    83	    if (started) return;
    84	    started = true;
    85	    activePlane.start();
    86	    selection.start();
    87	    keyboard.install(ports.keyboardTarget);
    88	    void projectSession.initialize();
    89	  }
    90	
    91	  function dispose(): void {
    92	    if (!started) return;
    93	    started = false;
    94	    keyboard.dispose();
    95	    autoSave.dispose();
    96	    activePlane.dispose();
    97	    selection.dispose();
    98	    projectSession.dispose();
    99	  }
   100	
   101	  return {
   102	    world,
   103	    commandStack,
   104	    state: {
   105	      activePlaneId,
   106	      activePlaneName,
   107	      coordinates3D,
   108	      show3DView,
   109	      showStartupDialog,
   110	      isSignedIn,
   111	      currentProjectName,
   112	      currentFileId,
   113	      isRenamingProject,
   114	      saveStatus,
   115	      startupFiles: computed(() => startupDialog.files.value),
   116	      startupLoading: computed(() => startupDialog.loading.value),
   117	      startupLoadingFiles: computed(() => startupDialog.loadingFiles.value),
   118	      startupError: computed(() => startupDialog.error.value),
   119	    },
   120	    actions: {
   121	      start,
   122	      dispose,
   123	      signIn: () => projectSession.signIn(),
   124	      toolbarSignIn: () => projectSession.toolbarSignIn(),
   125	      toolbarSignOut: () => projectSession.signOut(),
   126	      createProject: (name: string) => projectSession.createProject(name),
   127	      openProject: (fileId: string) => projectSession.openProject(fileId),
   128	      newProject: () => projectSession.newProject(),
   129	      showProjectChooser: () => projectSession.showStartupProjectChooser(),
   130	      renameProject: (name: string) => projectSession.renameProject(name),
   131	      requestFiles: () => projectSession.requestFiles(),
   132	      updateCoordinates: (coords: { x: number; y: number; z: number } | null) => { coordinates3D.value = coords; },
   133	      updateActivePlane: (planeInfo: { id: string; name: string }) => activePlane.updateActivePlane(planeInfo),
   134	    },
   135	    internals: { keyboard, activePlane, autoSave, selection, selectionDeletion, projectSession },
   136	  };
   137	}
   138	
   139	export type AppShellRuntime = ReturnType<typeof createAppShellRuntime>;
