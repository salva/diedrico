    12	import type { AppShellRuntimePorts, DrivePort, LastProjectRepositoryPort, ProjectSessionPersistencePort, SchedulerPort } from '@/application/appShell/AppShellPorts';
    13	
    14	function scheduler() {
    15	  let nextHandle = 1;
    16	  const timeouts = new Map<number, () => void>();
    17	  const intervals = new Map<number, () => void>();
    18	  return {
    19	    port: {
    20	      setTimeout: vi.fn((handler: () => void) => {
    21	        const handle = nextHandle++;
    22	        timeouts.set(handle, handler);
    23	        return handle;
    24	      }),
    25	      clearTimeout: vi.fn((handle: number) => { timeouts.delete(handle); }),
    26	      setInterval: vi.fn((handler: () => void) => {
    27	        const handle = nextHandle++;
    28	        intervals.set(handle, handler);
    29	        return handle;
    30	      }),
    31	      clearInterval: vi.fn((handle: number) => { intervals.delete(handle); }),
    32	    } satisfies SchedulerPort,
    33	    runTimeout(handle: number) {
    34	      timeouts.get(handle)?.();
    35	    },
    36	    runInterval(handle: number) {
    37	      intervals.get(handle)?.();
    38	    },
    39	  };
    40	}
    41	
    42	function drive(overrides: Partial<DrivePort> = {}): DrivePort {
    43	  return {
    44	    initialize: vi.fn().mockResolvedValue(undefined),
    45	    isSignedIn: vi.fn(() => true),
    46	    signIn: vi.fn().mockResolvedValue(undefined),
    47	    signOut: vi.fn().mockResolvedValue(undefined),
    48	    fetchUserProfile: vi.fn().mockResolvedValue({ email: 'user@example.test', name: 'User' }),
    49	    listFiles: vi.fn().mockResolvedValue([{ id: 'file-1', name: 'Project 1', modifiedTime: 'now' }]),
    50	    createFile: vi.fn().mockResolvedValue('file-created'),
    51	    loadFile: vi.fn().mockResolvedValue({ id: 'project-id', schemaVersion: '6.0.0', name: 'Loaded project', created: 'now', modified: 'now', nextElementId: 1, commands: [] }),
    52	    updateFile: vi.fn().mockResolvedValue(undefined),
    53	    renameFile: vi.fn().mockResolvedValue(undefined),
    54	    generateDefaultProjectName: vi.fn().mockResolvedValue('Untitled project'),
    55	    ...overrides,
    56	  } as DrivePort;
    57	}
    58	
    59	function persistence(): ProjectSessionPersistencePort {
    60	  return {
    61	    snapshotCurrentSession: vi.fn(({ world, projectName }) => ({
    62	      id: 'project-id',
    63	      schemaVersion: '6.0.0',
    64	      name: projectName,
    65	      created: 'now',
    66	      modified: 'now',
    67	      nextElementId: world.peekNextId(),
    68	      commands: [],
    69	    } as any)),
    70	    assertProjectData: vi.fn(),
    71	    restoreSession: vi.fn(),
    72	  };
    73	}
    74	
    75	function lastProjectRepository(): LastProjectRepositoryPort & { records: { set: unknown[]; cleared: number } } {
    76	  let current: { id: string; name: string } | null = null;
    77	  const repository = {
    78	    records: { set: [] as unknown[], cleared: 0 },
    79	    getLastProject: vi.fn(() => current),
    80	    setLastProject: vi.fn((project: { id: string; name: string }) => {
    81	      current = project;
    82	      repository.records.set.push(project);
    83	    }),
    84	    clearLastProject: vi.fn(() => {
    85	      current = null;
    86	      repository.records.cleared += 1;
    87	    }),
    88	  };
    89	  return repository;
    90	}
    91	
    92	function runtimePorts(overrides: Partial<AppShellRuntimePorts> = {}) {
    93	  const keyboardTarget = { addEventListener: vi.fn(), removeEventListener: vi.fn() };
    94	  return {
