    84	  loading: Ref<boolean>;
    85	  loadingFiles: Ref<boolean>;
    86	  error: Ref<string | null>;
    87	}
    88	
    89	export interface AppShellRuntimePorts {
    90	  drive: DrivePort | null;
    91	  persistence: ProjectSessionPersistencePort;
    92	  lastProjectRepository: LastProjectRepositoryPort;
    93	  scheduler: SchedulerPort;
    94	  keyboardTarget: KeyboardShortcutRouterTarget;
    95	  authStore: AuthStorePort;
    96	  selectionStore: SelectionStorePort;
    97	  toolStore: ToolStorePort;
    98	  viewStore: ViewStorePort;
    99	  callbacks: AppShellCallbacks;
   100	}
   101	
   102	export function createBrowserScheduler(): SchedulerPort {
   103	  return {
   104	    setTimeout: (handler, ms) => window.setTimeout(handler, ms),
   105	    clearTimeout: (handle) => window.clearTimeout(handle),
   106	    setInterval: (handler, ms) => window.setInterval(handler, ms),
   107	    clearInterval: (handle) => window.clearInterval(handle),
   108	  };
   109	}
--- frontend/src/application/appShell/ProjectSessionUseCases.ts ---
     1	import type { Ref } from 'vue';
     2	import type { CommandStack } from '@/commands/CommandStack';
     3	import type { World } from '@/domain/world/World';
     4	import { initializeWorld } from '@/application/world/initializeWorld';
     5	import type { ProjectData } from '@/services/ProjectService';
     6	import type { AutoSaveUseCases } from './AutoSaveUseCases';
     7	import type { AppShellRuntimePorts, SaveStatus, StartupDialogState } from './AppShellPorts';
     8	import { describeUnknownError } from './AppShellErrorClassifier';
     9	
    10	export class ProjectSessionUseCases {
    11	  constructor(
    12	    private readonly deps: {
    13	      world: World;
    14	      commandStack: CommandStack;
    15	      hasGoogleCredentials: boolean;
    16	      showStartupDialog: Ref<boolean>;
    17	      isSignedIn: Ref<boolean>;
    18	      currentProjectName: Ref<string | null>;
    19	      currentFileId: Ref<string | null>;
    20	      isRenamingProject: Ref<boolean>;
    21	      saveStatus: Ref<SaveStatus>;
    22	      startupDialog: StartupDialogState;
    23	      autoSave: AutoSaveUseCases;
    24	      ports: AppShellRuntimePorts;
    25	    },
    26	  ) {}
    27	
    28	  async initialize(): Promise<void> {
    29	    const { drive, authStore, lastProjectRepository } = this.deps.ports;
    30	    if (!this.deps.hasGoogleCredentials || !drive) {
    31	      initializeWorld(this.deps.world, this.deps.commandStack);
    32	      this.deps.showStartupDialog.value = false;
    33	      return;
    34	    }
    35	    try {
    36	      await drive.initialize();
    37	      this.deps.isSignedIn.value = drive.isSignedIn();
    38	      if (this.deps.isSignedIn.value && authStore.restoreSession()) {
    39	        try { authStore.setUser(await drive.fetchUserProfile()); } catch { /* profile refresh is non-blocking */ }
    40	      }
    41	      const lastProject = lastProjectRepository.getLastProject();
    42	      if (this.deps.isSignedIn.value && lastProject) {
    43	        try {
    44	          await this.openProject(lastProject.id);
    45	          return;
    46	        } catch {
    47	          lastProjectRepository.clearLastProject();
    48	          this.deps.currentProjectName.value = null;
    49	          this.deps.currentFileId.value = null;
    50	          initializeWorld(this.deps.world, this.deps.commandStack);
    51	        }
    52	      }
    53	      this.deps.showStartupDialog.value = true;
    54	    } catch {
    55	      this.deps.showStartupDialog.value = false;
    56	    }
    57	  }
    58	
    59	  async signIn(): Promise<void> {
    60	    const drive = this.requireDrive();
    61	    this.deps.startupDialog.loading.value = true;
    62	    this.deps.startupDialog.error.value = null;
    63	    try {
    64	      await drive.signIn();
    65	      this.deps.isSignedIn.value = drive.isSignedIn();
    66	      try {
    67	        const profile = await drive.fetchUserProfile();
    68	        this.deps.ports.authStore.setAuthenticated(profile, '', undefined);
    69	      } catch { /* allow Drive use without profile */ }
    70	      await this.requestFiles();
    71	    } catch (error: unknown) {
    72	      this.deps.startupDialog.error.value = `Sign-in failed: ${describeUnknownError(error)}`;
    73	    } finally {
    74	      this.deps.startupDialog.loading.value = false;
    75	    }
    76	  }
    77	
    78	  async toolbarSignIn(): Promise<void> {
    79	    await this.signIn();
    80	  }
    81	
    82	  async signOut(): Promise<void> {
    83	    const drive = this.requireDrive();
    84	    await drive.signOut();
    85	    this.deps.ports.authStore.clearAuth();
    86	    this.deps.isSignedIn.value = false;
    87	    this.deps.currentProjectName.value = null;
    88	    this.deps.currentFileId.value = null;
    89	    this.deps.autoSave.stop();
    90	    this.deps.world.clear();
    91	    this.deps.commandStack.clear();
    92	    this.deps.showStartupDialog.value = true;
    93	  }
    94	
    95	  async createProject(projectName: string): Promise<void> {
    96	    const drive = this.requireDrive();
    97	    try {
    98	      this.deps.world.clear();
    99	      this.deps.commandStack.clear();
   100	      initializeWorld(this.deps.world, this.deps.commandStack);
   101	      const projectData = this.deps.ports.persistence.snapshotCurrentSession({
   102	        commandStack: this.deps.commandStack,
   103	        world: this.deps.world,
   104	        projectName,
   105	      });
   106	      const fileId = await drive.createFile(projectName, projectData);
   107	      this.setCurrentProject(projectName, fileId);
   108	      this.deps.showStartupDialog.value = false;
   109	      this.deps.autoSave.start();
   110	      this.deps.saveStatus.value = 'saved';
   111	    } catch (error: unknown) {
   112	      this.deps.startupDialog.error.value = `Failed to create project: ${describeUnknownError(error)}`;
   113	      this.deps.startupDialog.loading.value = false;
   114	    }
   115	  }
   116	
   117	  async openProject(fileId: string): Promise<void> {
   118	    const drive = this.requireDrive();
   119	    try {
   120	      const projectData = await drive.loadFile(fileId) as ProjectData;
   121	      this.deps.world.clear();
   122	      this.deps.ports.persistence.assertProjectData(projectData);
   123	      this.deps.ports.persistence.restoreSession(projectData, {
   124	        world: this.deps.world,
   125	        commandStack: this.deps.commandStack,
   126	      });
   127	      if (this.deps.world.getAllProjectionPlanes().length === 0) initializeWorld(this.deps.world, this.deps.commandStack);
   128	      this.deps.world.markDirty();
   129	      this.setCurrentProject(projectData.name, fileId);
   130	      this.deps.showStartupDialog.value = false;
   131	      this.deps.autoSave.start();
   132	      this.deps.saveStatus.value = 'saved';
   133	    } catch (error: unknown) {
   134	      this.deps.startupDialog.error.value = `Failed to open project: ${describeUnknownError(error)}`;
   135	      this.deps.startupDialog.loading.value = false;
   136	      throw error;
   137	    }
   138	  }
   139	
   140	  async newProject(): Promise<void> {
   141	    const drive = this.requireDrive();
   142	    try {
   143	      const projectName = await drive.generateDefaultProjectName();
   144	      this.deps.world.clear();
   145	      this.deps.commandStack.clear();
   146	      await this.createProject(projectName);
   147	    } catch {
   148	      this.deps.showStartupDialog.value = true;
   149	    }
   150	  }
   151	
   152	  showStartupProjectChooser(): void {
   153	    this.deps.showStartupDialog.value = true;
   154	  }
   155	
   156	  async renameProject(newName: string): Promise<void> {
   157	    const drive = this.requireDrive();
   158	    if (!this.deps.currentFileId.value) return;
   159	    this.deps.isRenamingProject.value = true;
   160	    try {
   161	      await drive.renameFile(this.deps.currentFileId.value, newName);
   162	      this.deps.currentProjectName.value = newName;
   163	      this.deps.ports.lastProjectRepository.setLastProject({ id: this.deps.currentFileId.value, name: newName });
   164	      this.deps.autoSave.schedule();
   165	    } finally {
   166	      this.deps.isRenamingProject.value = false;
   167	    }
   168	  }
   169	
   170	  async requestFiles(): Promise<void> {
   171	    const drive = this.requireDrive();
   172	    this.deps.startupDialog.loadingFiles.value = true;
   173	    this.deps.startupDialog.error.value = null;
   174	    try {
   175	      this.deps.startupDialog.files.value = await drive.listFiles();
   176	    } catch (error: unknown) {
   177	      this.deps.startupDialog.error.value = `Failed to load files: ${describeUnknownError(error)}`;
   178	    } finally {
   179	      this.deps.startupDialog.loadingFiles.value = false;
   180	    }
   181	  }
   182	
   183	  dispose(): void {
   184	    this.deps.startupDialog.files.value = [];
   185	    this.deps.startupDialog.loading.value = false;
   186	    this.deps.startupDialog.loadingFiles.value = false;
   187	    this.deps.startupDialog.error.value = null;
   188	  }
   189	
   190	  private setCurrentProject(projectName: string, fileId: string): void {
   191	    this.deps.currentProjectName.value = projectName;
   192	    this.deps.currentFileId.value = fileId;
   193	    this.deps.ports.lastProjectRepository.setLastProject({ id: fileId, name: projectName });
   194	  }
   195	
   196	  private requireDrive() {
   197	    if (!this.deps.ports.drive) throw new Error('Google Drive service not available');
   198	    return this.deps.ports.drive;
   199	  }
   200	}
--- frontend/src/application/appShell/AutoSaveUseCases.ts ---
     1	import type { Ref } from 'vue';
     2	import type { CommandStack } from '@/commands/CommandStack';
     3	import type { World } from '@/domain/world/World';
     4	import type { DrivePort, IntervalHandle, LastProjectRepositoryPort, ProjectSessionPersistencePort, SaveStatus, SchedulerPort, TimeoutHandle } from './AppShellPorts';
     5	import { isAuthenticationError, isMissingRemoteFileError, isQuotaError } from './AppShellErrorClassifier';
     6	
     7	export class AutoSaveUseCases {
     8	  private pollInterval: IntervalHandle | null = null;
     9	  private debounceTimer: TimeoutHandle | null = null;
    10	  private savedStatusTimer: TimeoutHandle | null = null;
    11	  private lastVersion = 0;
    12	
    13	  constructor(
    14	    private readonly deps: {
    15	      world: World;
    16	      commandStack: CommandStack;
    17	      drive: DrivePort | null;
    18	      persistence: ProjectSessionPersistencePort;
    19	      lastProjectRepository: LastProjectRepositoryPort;
    20	      scheduler: SchedulerPort;
    21	      currentFileId: Ref<string | null>;
    22	      currentProjectName: Ref<string | null>;
    23	      saveStatus: Ref<SaveStatus>;
    24	      showStartupDialog: Ref<boolean>;
    25	      isSignedIn: Ref<boolean>;
    26	      alert: (message: string) => void;
    27	    },
    28	    private readonly delayMs = 2000,
    29	  ) {}
    30	
    31	  start(): void {
    32	    this.stopPolling();
    33	    this.lastVersion = this.deps.world.getVersion();
    34	    this.pollInterval = this.deps.scheduler.setInterval(() => {
    35	      const currentVersion = this.deps.world.getVersion();
    36	      if (currentVersion !== this.lastVersion) {
    37	        this.lastVersion = currentVersion;
    38	        this.schedule();
    39	      }
    40	    }, 100);
    41	  }
    42	
    43	  schedule(): void {
    44	    if (this.debounceTimer) this.deps.scheduler.clearTimeout(this.debounceTimer);
    45	    this.deps.saveStatus.value = 'saving';
    46	    this.debounceTimer = this.deps.scheduler.setTimeout(() => {
    47	      void this.perform();
    48	    }, this.delayMs);
    49	  }
    50	
    51	  async perform(): Promise<void> {
    52	    const { drive, currentFileId, currentProjectName } = this.deps;
    53	    if (!drive || !currentFileId.value || !currentProjectName.value) return;
    54	    try {
    55	      const projectData = this.deps.persistence.snapshotCurrentSession({
    56	        commandStack: this.deps.commandStack,
    57	        world: this.deps.world,
    58	        projectName: currentProjectName.value,
    59	      });
    60	      await drive.updateFile(currentFileId.value, projectData);
    61	      this.markSavedThenIdle();
    62	    } catch (error: unknown) {
    63	      await this.handleSaveError(error);
    64	    }
    65	  }
    66	
    67	  stop(): void {
    68	    this.stopPolling();
    69	    if (this.debounceTimer) this.deps.scheduler.clearTimeout(this.debounceTimer);
    70	    if (this.savedStatusTimer) this.deps.scheduler.clearTimeout(this.savedStatusTimer);
    71	    this.debounceTimer = null;
    72	    this.savedStatusTimer = null;
    73	    this.deps.saveStatus.value = 'idle';
    74	  }
    75	
    76	  dispose(): void {
    77	    this.stop();
    78	  }
    79	
    80	  private stopPolling(): void {
    81	    if (this.pollInterval) this.deps.scheduler.clearInterval(this.pollInterval);
    82	    this.pollInterval = null;
    83	  }
    84	
    85	  private markSavedThenIdle(): void {
    86	    this.deps.saveStatus.value = 'saved';
    87	    if (this.savedStatusTimer) this.deps.scheduler.clearTimeout(this.savedStatusTimer);
    88	    this.savedStatusTimer = this.deps.scheduler.setTimeout(() => {
    89	      if (this.deps.saveStatus.value === 'saved') this.deps.saveStatus.value = 'idle';
    90	    }, 2000);
    91	  }
    92	
    93	  private async handleSaveError(error: unknown): Promise<void> {
    94	    this.deps.saveStatus.value = 'idle';
    95	    if (isMissingRemoteFileError(error)) {
    96	      try {
    97	        if (!this.deps.drive || !this.deps.currentProjectName.value) throw new Error('No project name');
    98	        const projectData = this.deps.persistence.snapshotCurrentSession({
    99	          commandStack: this.deps.commandStack,
   100	          world: this.deps.world,
   101	          projectName: this.deps.currentProjectName.value,
   102	        });
   103	        const newFileId = await this.deps.drive.createFile(this.deps.currentProjectName.value, projectData);
   104	        this.deps.currentFileId.value = newFileId;
   105	        this.deps.lastProjectRepository.setLastProject({ id: newFileId, name: this.deps.currentProjectName.value });
   106	        this.markSavedThenIdle();
   107	        return;
   108	      } catch {
   109	        this.deps.alert('Remote file was deleted and could not be re-saved. Please try to export your work or refresh if connection is lost.');
   110	      }
   111	    }
   112	    if (isAuthenticationError(error)) {
   113	      this.deps.showStartupDialog.value = true;
   114	      this.deps.isSignedIn.value = false;
   115	      this.stop();
   116	    } else if (isQuotaError(error)) {
   117	      this.deps.alert('Google Drive storage quota exceeded. Please free up space or upgrade your account.');
   118	    }
   119	  }
   120	}
