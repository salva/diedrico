    51	    const sources = [appShellRuntime, appShellPorts, activePlane, autoSave, keyboard, projectSession, selection, appShellProductionRuntime];
    52	    for (const content of sources) {
    53	      expect(content).not.toMatch(/diedrico_last_file_id|diedrico_last_file_name/);
    54	    }
    55	    expect(browserLastProjectRepository).toMatch(/diedrico_last_file_id/);
    56	    expect(browserLastProjectRepository).toMatch(/diedrico_last_file_name/);
    57	  });
    58	
    59	  it('moves selection delete command construction behind the dedicated service boundary', () => {
    60	    expect(selection).not.toMatch(/DeletionSequenceFactory|new Command|CommandStack|commandStack\.push|\.commit\(/);
    61	    expect(selectionDeletionService).toMatch(/DeletionSequenceFactory/);
    62	    expect(selectionDeletionService).toMatch(/new Command/);
    63	    expect(selectionDeletionService).toMatch(/commandStack\.push/);
    64	    expect(selectionDeletionService).toMatch(/\.commit\(/);
    65	    expect(appShellRuntime).toMatch(/new SelectionDeletionCommandService\(world, commandStack\)/);
    66	  });
    67	});
