## package scripts
--- package.json ---
{
  "dev": "npm run dev:frontend",
  "dev:frontend": "npm run dev --workspace=frontend",
  "build": "npm run build --workspace=frontend",
  "test": "npm run test --workspace=frontend",
  "test:frontend": "npm run test --workspace=frontend",
  "lint": "npm run lint --workspace=frontend",
  "docs:dev": "vitepress dev docs",
  "docs:build": "vitepress build docs",
  "docs:preview": "vitepress preview docs",
  "test:architecture": "npm run test:architecture --workspace=frontend",
  "test:e2e": "npm run test:e2e --workspace=frontend"
}
--- frontend/package.json ---
{
  "dev": "vite",
  "build": "vue-tsc && vite build",
  "preview": "vite preview",
  "test": "vitest run",
  "test:watch": "vitest",
  "test:ui": "vitest --ui",
  "test:architecture": "vitest run tests/unit/architecture",
  "test:e2e": "playwright test",
  "test:e2e:headed": "playwright test --headed",
  "lint": "npm run test:architecture"
}
