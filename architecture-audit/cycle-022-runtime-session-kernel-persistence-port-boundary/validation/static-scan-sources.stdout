import type { CommandStack } from '@/commands/CommandStack';
import type { World } from '@/domain/world/World';
import type { RuntimeSessionRestoreHandle, RuntimeSessionSnapshotHandle } from './AppShellPorts';

export interface RuntimeSessionPersistenceSnapshotHandle extends RuntimeSessionSnapshotHandle {
  readonly commandStack: CommandStack;
}

export interface RuntimeSessionPersistenceRestoreHandle extends RuntimeSessionRestoreHandle {
  readonly world: World;
  readonly commandStack: CommandStack;
}

--- frontend/src/application/appShell/SelectionUseCases.ts ---
import { watch, type WatchStopHandle } from 'vue';
import type { SelectionDeletionCommandPort } from '@/application/selectionDeletion/SelectionDeletionPorts';
import type { SelectionReadPort, SelectionStorePort } from './AppShellPorts';

export class SelectionUseCases {
  private stopSelectionWatch: WatchStopHandle | null = null;

  constructor(
    private readonly selectionRead: SelectionReadPort,
    private readonly deleteSelectionCommand: SelectionDeletionCommandPort,
    private readonly selectionStore: SelectionStorePort,
    private readonly getActivePlaneId: () => string | undefined,
  ) {}

  start(): void {
    if (this.stopSelectionWatch) return;
    this.stopSelectionWatch = watch(
      () => this.selectionStore.selectedIdsArray,
      (selectedIds) => this.updateCascadePreview(selectedIds),
      { immediate: true },
    );
  }

  dispose(): void {
    this.stopSelectionWatch?.();
    this.stopSelectionWatch = null;
    this.selectionStore.clearCascadeHighlight();
  }

  deleteSelected(): void {
    const selectedIds = this.selectionStore.selectedIdsArray;
    if (selectedIds.length === 0) return;
    this.deleteSelectionCommand.execute(selectedIds);
    this.selectionStore.clearSelection();
  }

  clearSelection(): void {
    this.selectionStore.clearSelection();
  }

  selectAllInActivePlane(): void {
    const activePlaneId = this.getActivePlaneId();
    if (!activePlaneId) return;
    const selectedIds = this.selectionRead.getSelectableIdsInPlane(activePlaneId);
    if (selectedIds.length > 0) this.selectionStore.selectMultiple([...selectedIds]);
  }

  private updateCascadePreview(selectedIds: string[]): void {
    if (selectedIds.length === 0) {
      this.selectionStore.clearCascadeHighlight();
      return;
    }
    const cascadePreviewIds = this.selectionRead.getCascadePreviewIds(selectedIds);
    this.selectionStore.setCascadeHighlight([...cascadePreviewIds]);
  }
}

--- frontend/src/application/selectionDeletion/SelectionDeletionCommandService.ts ---
import { Command } from '@/commands/Command';
import type { CommandStack } from '@/commands/CommandStack';
import { DeletionSequenceFactory } from '@/commands/factories/DeletionSequenceFactory';
import type { World } from '@/domain/world/World';
import type { SelectionDeletionCommandPort } from './SelectionDeletionPorts';

interface SelectionDeletionCommandServiceInternals {
  createCommand(description: string, world: World): Command;
  createCascadeDeletion(command: Command, selectedIds: string[], world: World): void;
}

const defaultInternals: SelectionDeletionCommandServiceInternals = {
  createCommand: (description, world) => new Command(description, world),
  createCascadeDeletion: (command, selectedIds, world) => {
    DeletionSequenceFactory.createCascadeDeletion(command, selectedIds, world);
  },
};

export class SelectionDeletionCommandService implements SelectionDeletionCommandPort {
  private readonly internals: SelectionDeletionCommandServiceInternals;

  constructor(
    private readonly world: World,
    private readonly commandStack: CommandStack,
    internals: Partial<SelectionDeletionCommandServiceInternals> = {},
  ) {
    this.internals = { ...defaultInternals, ...internals };
  }

  execute(selectedIds: readonly string[]): void {
    if (selectedIds.length === 0) return;

    const deleteCommand = this.internals.createCommand('Delete elements', this.world);
    this.internals.createCascadeDeletion(deleteCommand, [...selectedIds], this.world);
    deleteCommand.commit();
    this.commandStack.push(deleteCommand);
  }
}

