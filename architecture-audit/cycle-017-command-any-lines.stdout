     1	/**
     2	 * ITool - Interface for geometric construction tools.
     3	 *
     4	 * Tools collect interaction arguments and emit typed application intents.
     5	 * Application controllers own command creation, validation orchestration,
     6	 * commit/rollback, and command-stack execution.
     7	 */
     8	
     9	import type { Vector3 } from 'three';
    10	import type { World } from '@/domain/world/World';
    11	import type { CanvasInteractionQuery } from '@/application/canvasPresentation/CanvasInteractionQuery';
    12	import type { SelectionMask } from '@/types/SelectionMask';
    13	import type { useToolStore } from '@/stores/toolStore';
    14	import type { ToolCommandSink } from '@/application/tools/ToolCommandIntents';
    15	
    16	/**
    17	 * Context provided to tools when handling user input.
    18	 */
    19	export interface ToolContext {
    20	  planeId: string;
    21	  planeCoords: Vector3;
    22	  canvasCoords: { x: number; y: number };
    23	  commandSink: ToolCommandSink;
    24	  world: World;
    25	  interactionQuery: CanvasInteractionQuery;
    26	  paperToPlaneTransform: any;
    27	  viewport: { zoom: number; panX: number; panY: number };
    28	  toolStore: ReturnType<typeof useToolStore>;
    29	}
    30	
    31	/**
    32	 * Result of a tool operation
    33	 */
    34	export interface ToolResult {
    35	  success: boolean;
    36	  message?: string;
    37	}
    38	
    39	/**
    40	 * Base interface for all tools.
    41	 */
    42	export interface ITool {
    43	  readonly name: string;
    44	  handleClick(context: ToolContext): ToolResult;
    45	  activate?(context: ToolContext): void;
    46	  deactivate?(context: ToolContext): void;
    47	  cancel?(): void;
    48	  getState?(): Record<string, any>;
    49	  getSelectionMask?(): SelectionMask | undefined;
    50	}
