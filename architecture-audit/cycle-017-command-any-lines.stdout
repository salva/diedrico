     1	import { Command } from '@/commands/Command';
     2	import type { CommandStack } from '@/commands/CommandStack';
     3	import type { World } from '@/domain/world/World';
     4	import { UpdateElementStyleOp } from '@/commands/operations/world/UpdateElementStyleOp';
     5	import type { StyleUpdateRequest, ToolCommandResult } from '@/application/tools/ToolCommandIntents';
     6	
     7	export class CanvasStyleUseCase {
     8	  constructor(private readonly world: World, private readonly commandStack: CommandStack) {}
     9	
    10	  update(request: StyleUpdateRequest): ToolCommandResult {
    11	    const cmd = new Command(`Update style: ${request.elementId}`, this.world);
    12	    try {
    13	      cmd.addAndExecute(new UpdateElementStyleOp(request.elementId, request.planeId, request.style) as any);
    14	      cmd.commit();
    15	      this.commandStack.push(cmd);
    16	      return { success: true };
    17	    } catch (error) {
    18	      cmd.rollback();
    19	      return { success: false, message: error instanceof Error ? error.message : String(error) };
    20	    }
    21	  }
    22	}

