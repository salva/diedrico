   166	function createIntersection(cmd: Command, intent: Extract<ToolConstructionIntent, { type: 'intersection' }>, world: World, groupId: string): void {
   167	  const element1 = intent.args.get('element1')!.element!;
   168	  const element2 = intent.args.get('element2')!.element!;
   169	  const selectionPoint = intent.metadata.selectionPoint;
   170	  if (element1 instanceof Line2D && element2 instanceof Line2D) {
   171	    const r1 = element1.realize2D(world);
   172	    const r2 = element2.realize2D(world);
   173	    if (!r1 || !r2) throw new Error('Could not realize lines.');
   174	    if (areLinesParallel(r1, r2)) throw new Error('Lines are parallel and do not intersect.');
   175	    IntersectionSequenceFactory.createLineLineIntersection(cmd, intent.planeId, element1.id, element2.id, world, groupId);
   176	  } else if (element1 instanceof Line2D && element2 instanceof Circle2D) {
   177	    const index = lineCircleIndex(element1.id, element2.id, selectionPoint, world);
   178	    if (index === null) throw new Error('Line and circle do not intersect.');
   179	    IntersectionSequenceFactory.createLineCircleIntersection(cmd, intent.planeId, element1.id, element2.id, index, world, groupId);
   180	  } else if (element1 instanceof Circle2D && element2 instanceof Line2D) {
   181	    const index = lineCircleIndex(element2.id, element1.id, selectionPoint, world);
   182	    if (index === null) throw new Error('Circle and line do not intersect.');
   183	    IntersectionSequenceFactory.createLineCircleIntersection(cmd, intent.planeId, element2.id, element1.id, index, world, groupId);
   184	  } else if (element1 instanceof Circle2D && element2 instanceof Circle2D) {
   185	    const index = circleCircleIndex(element1.id, element2.id, selectionPoint, world);
   186	    if (index === null) throw new Error('Circles do not intersect.');
   187	    IntersectionSequenceFactory.createCircleCircleIntersection(cmd, intent.planeId, element1.id, element2.id, index, world, groupId);
   188	  } else {
   189	    throw new Error('Unsupported element type combination for intersection.');
   190	  }
   191	}
   192	
   193	function lineCircleIndex(lineId: string, circleId: string, mousePos: THREE.Vector3, world: World): number | null {
   194	  const line = world.getLine2D(lineId);
   195	  const circle = world.getCircle2D(circleId);
   196	  if (!line || !circle) return null;
   197	  const lr = line.realize2D(world);
   198	  const cr = circle.realize2D(world);
   199	  if (!lr || !cr) return null;
   200	  const intersections = intersectLineCircle(lr, cr);
   201	  if (intersections.length === 0) return null;
   202	  if (intersections.length === 1) return 0;
   203	  return intersections[0].distanceTo(mousePos) <= intersections[1].distanceTo(mousePos) ? 0 : 1;
   204	}
   205	
   206	function circleCircleIndex(circle1Id: string, circle2Id: string, mousePos: THREE.Vector3, world: World): number | null {
   207	  const c1 = world.getCircle2D(circle1Id);
   208	  const c2 = world.getCircle2D(circle2Id);
   209	  if (!c1 || !c2) return null;
   210	  const r1 = c1.realize2D(world);
   211	  const r2 = c2.realize2D(world);
   212	  if (!r1 || !r2) return null;
   213	  const intersections = intersectCircleCircle(r1, r2);
   214	  if (intersections.length === 0) return null;
   215	  if (intersections.length === 1) return 0;
   216	  return intersections[0].distanceTo(mousePos) <= intersections[1].distanceTo(mousePos) ? 0 : 1;
   217	}
   218	
   219	function validateCoordinates(coords: any): void {
   220	  if (!coords || !isFinite(coords.x) || !isFinite(coords.y) || !isFinite(coords.z)) {
   221	    throw new Error('Invalid coordinates: NaN or Infinity not allowed');
   222	  }
   223	}
