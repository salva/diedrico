### frontend/src/commands/operations/processTree/AddProcessTreeActionGroupOp.ts
     1	/**
     2	 * AddProcessTreeActionGroupOp - Operation for adding an ActionGroup to the ProcessTree
     3	 * 
     4	 * Part of the split operation pattern for N-actions-1-group support.
     5	 * This operation creates the container group, while AddProcessTreeActionOp adds items to it.
     6	 */
     7	
     8	import type { IOperation, OperationResult } from '../IOperation';
     9	import type { World } from '@/domain/world/World';
    10	import type { ActionGroup } from '@/domain/processTree/ActionGroup';
    11	
    12	export class AddProcessTreeActionGroupOp implements IOperation {
    13	  readonly type = 'AddProcessTreeActionGroup';
    14	  parameters: Record<string, any>;
    15	  outputs: Record<string, any> = {};
    16	
    17	  // Transient reference to group (not serialized, rebuilt during apply?)
    18	  // Ideally operations should be serializable.
    19	  // Passing the full group object in constructor means we rely on the caller to create it.
    20	  constructor(private group: ActionGroup) {
    21	    // CRITICAL: Store visibility flags for proper serialization
    22	    this.parameters = { 
    23	      groupId: group.id,
    24	      isOutput: group.isOutput,
    25	      isAuxiliary: group.isAuxiliary
    26	    };
    27	  }
    28	
    29	  apply(world: World): OperationResult {
    30	    world.getProcessTree().addActionGroup(this.group);
    31	    this.outputs = { groupId: this.group.id };
    32	    
    33	    // Dependency maps might refer to groups? Probably not, they refer to elements (actions).
    34	    
    35	    return { success: true, outputs: this.outputs };
    36	  }
    37	
    38	  undo(world: World): void {
    39	    const processTree = world.getProcessTree();
    40	    processTree.removeActionGroup(this.group.id);
    41	  }
    42	
    43	  serialize() {
    44	    return {
    45	      opType: this.type,
    46	      groupId: this.parameters.groupId,
    47	      isOutput: this.parameters.isOutput,
    48	      isAuxiliary: this.parameters.isAuxiliary,
    49	      outputs: this.outputs
    50	    };
    51	  }
    52	}
### frontend/src/commands/operations/processTree/AddProcessTreeActionOp.ts
     1	/**
     2	 * AddProcessTreeActionOp - Operation for adding ProcessTree actions
     3	 * 
     4	 * Wraps ProcessTree action registration as an undoable operation.
     5	 * This ensures that when commands are undone, both the element AND its
     6	 * ProcessTree action are removed, preventing orphaned dependency entries.
     7	 * 
     8	 * Reference: specs/001-dihedral-learning-mvp/data-model.md §ProcessTree Action Registration (Phase 81)
     9	 */
    10	
    11	import type { IOperation, OperationResult } from '../IOperation';
    12	import type { World } from '@/domain/world/World';
    13	import type { Action } from '@/domain/processTree/Action';
    14	
    15	export class AddProcessTreeActionOp implements IOperation {
    16	  readonly type = 'AddProcessTreeActionOp';
    17	  parameters: Record<string, any>;
    18	  outputs: Record<string, any> = {};
    19	
    20	  constructor(action: Action, private groupId: string) {
    21	    // Store action in parameters for serializability
    22	    this.parameters = {
    23	      action: action,
    24	      groupId: groupId
    25	    };
    26	  }
    27	
    28	  apply(world: World): OperationResult {
    29	    // Add action to ProcessTree
    30	    const action = this.parameters.action as Action;
    31	    
    32	    // Add to existing group (Strict Mode: groupId is required)
    33	    const index = world.getProcessTree().addActionToGroup(action, this.groupId);
    34	    
    35	    // Phase 93: Actions no longer have IDs - store elementId for tracking
    36	    this.outputs = {
    37	      elementId: action.elementId,  // Store elementId instead of action.id
    38	      groupId: this.groupId,
    39	      index: index
    40	    };
    41	    
    42	    return {
    43	      success: true,
    44	      outputs: this.outputs
    45	    };
    46	  }
    47	
    48	  undo(world: World): void {
    49	    if (!this.outputs.elementId) {
    50	      throw new Error('Cannot undo: operation was not applied');
    51	    }
    52	    
    53	    // Phase 93: Remove action by elementId
    54	    // Find the action that produced this element and remove it
    55	    const actions = world.getProcessTree().getActionsProducingElement(this.outputs.elementId);
    56	    if (actions.length > 0) {
    57	      // Remove the most recent action (should be only one, but just in case)
    58	      world.getProcessTree().removeActionByElementId(this.outputs.elementId);
    59	    }
    60	
    61	    // Removed fallback: We rely on AddProcessTreeActionGroupOp to manage group lifecycle.
    62	    // If this op added an action to a group, undoing it naturally removes the action.
    63	    // The group itself is handled by its own Op.
    64	
    65	  }
    66	
    67	  serialize() {
    68	    return {
    69	      opType: this.type,
    70	      action: this.parameters.action,
    71	      groupId: this.groupId,
    72	      outputs: this.outputs
    73	    };
    74	  }
    75	}
### frontend/src/commands/operations/processTree/PopSubprocessOp.ts
     1	/**
     2	 * PopSubprocessOp - Pop subprocess from ProcessTree stack
     3	 * 
     4	 * Pops the current subprocess from the ProcessTree stack, returning to the parent subprocess.
     5	 * The subprocess remains in the tree as a child of its parent - only the stack is affected.
     6	 * 
     7	 * Phase 85: ProcessTree Subprocess Stack Architecture
     8	 * Reference: specs/001-dihedral-learning-mvp/data-model.md §ProcessTree (Phase 85)
     9	 */
    10	
    11	import type { IOperation, OperationResult } from '../IOperation';
    12	import type { World } from '@/domain/world/World';
    13	
    14	export class PopSubprocessOp implements IOperation {
    15	  readonly type = 'PopSubprocess';
    16	  parameters: Record<string, any> = {};
    17	  outputs: Record<string, any> = {};
    18	  
    19	  private poppedSubprocessId: string | undefined;
    20	
    21	  apply(world: World): OperationResult {
    22	    // Store info about subprocess being popped for undo
    23	    const currentSubprocess = world.getProcessTree().getCurrentSubprocess();
    24	    this.poppedSubprocessId = currentSubprocess.id;
    25	    
    26	    world.getProcessTree().popSubprocess();
    27	    return { success: true, outputs: {} };
    28	  }
    29	
    30	  undo(world: World): void {
    31	    if (!this.poppedSubprocessId) {
    32	      throw new Error('Cannot undo PopSubprocessOp: no subprocess ID stored');
    33	    }
    34	    
    35	    // Restore the subprocess to the stack
    36	    world.getProcessTree().restoreSubprocessToStack(this.poppedSubprocessId);
    37	  }
    38	
    39	  serialize() {
    40	    return { opType: this.type, outputs: this.outputs };
    41	  }
    42	}
### frontend/src/commands/operations/processTree/ProcessTreeOperations.ts
     1	/**
     2	 * ProcessTreeOperations - Operations for manipulating the construction history tree
     3	 * 
     4	 * These operations maintain stable indices using tombstone pattern:
     5	 * - Removed actions leave null holes in children arrays
     6	 * - Indices never shift, making undo/redo trivial
     7	 * - Visualization skips over null entries
     8	 * 
     9	 * Reference: specs/001-dihedral-learning-mvp/tasks.md Phase 30
    10	 */
    11	
    12	import type { IOperation, OperationResult } from '../IOperation';
    13	import type { World } from '@/domain/world/World';
    14	import type { ActionNode } from '@/domain/processTree/ProcessTree';
    15	
    16	/**
    17	 * RemoveActionFromProcessTreeOp - Remove an action from the construction history
    18	 * 
    19	 * Creates a tombstone (null) at the action's index. The index is preserved
    20	 * so undo can restore the action at exactly the same position.
    21	 * 
    22	 * This is the primary operation used by DeleteElementsCommand.
    23	 */
    24	export class RemoveActionFromProcessTreeOp implements IOperation {
    25	  readonly type = 'RemoveActionFromProcessTree';
    26	  readonly parameters: Record<string, any>;
    27	  outputs: Record<string, any> = {};
    28	  
    29	  // Stored for undo
    30	  private removedAction?: ActionNode;
    31	  private groupId?: string;
    32	  private index?: number;
    33	
    34	  constructor(
    35	    private actionId: string
    36	  ) {
    37	    this.parameters = { actionId };
    38	  }
    39	
    40	  apply(world: World): OperationResult {
    41	    try {
    42	      const processTree = world.getProcessTree();
    43	      const result = processTree.removeAction(this.actionId);
    44	      
    45	      if (!result) {
    46	        return {
    47	          success: false,
    48	          outputs: {},
    49	          error: `Action ${this.actionId} not found in ProcessTree`
    50	        };
    51	      }
    52	      
    53	      // Store for undo
    54	      this.removedAction = result.action;
    55	      this.groupId = result.groupId;
    56	      this.index = result.index;
    57	      
    58	      this.outputs = { 
    59	        removedActionId: this.actionId,
    60	        groupId: result.groupId,
    61	        index: result.index
    62	      };
    63	      
    64	      return {
    65	        success: true,
    66	        outputs: this.outputs
    67	      };
    68	    } catch (error) {
    69	      return {
    70	        success: false,
    71	        outputs: {},
    72	        error: error instanceof Error ? error.message : String(error)
    73	      };
    74	    }
    75	  }
    76	
    77	  undo(world: World): void {
    78	    if (!this.removedAction || this.groupId === undefined || this.index === undefined) {
    79	      throw new Error('Cannot undo: no action data stored');
    80	    }
    81	
    82	    const processTree = world.getProcessTree();
    83	    processTree.restoreAction(this.removedAction, this.groupId, this.index);
    84	  }
    85	
    86	  serialize() {
    87	    return { opType: this.type, actionId: this.actionId, outputs: this.outputs };
    88	  }
    89	}
    90	
    91	/**
    92	 * RemoveActionGroupFromProcessTreeOp - Remove an entire ActionGroup
    93	 * 
    94	 * Used when deleting a group of related elements or when user explicitly
    95	 * deletes an ActionGroup from the UI.
    96	 * 
    97	 * Note: Currently not used by DeleteElementsCommand, but available for
    98	 * future features (e.g., "delete construction step").
    99	 */
   100	export class RemoveActionGroupFromProcessTreeOp implements IOperation {
   101	  readonly type = 'RemoveActionGroupFromProcessTree';
   102	  readonly parameters: Record<string, any>;
   103	  outputs: Record<string, any> = {};
   104	  
   105	  // TODO: Implement when needed
   106	  // Similar pattern: store group data, parent ID, index
   107	
   108	  constructor(
   109	    private groupId: string
   110	  ) {
   111	    this.parameters = { groupId };
   112	  }
   113	
   114	  apply(_world: World): OperationResult {
   115	    return {
   116	      success: false,
   117	      outputs: {},
   118	      error: 'RemoveActionGroupFromProcessTreeOp not yet implemented'
   119	    };
   120	  }
   121	
   122	  undo(_world: World): void {
   123	    throw new Error('Not implemented');
   124	  }
   125	
   126	  serialize() {
   127	    return { opType: this.type, groupId: this.groupId, outputs: this.outputs };
   128	  }
   129	}
   130	
   131	
   132	/**
   133	 * RemoveSubprocessFromProcessTreeOp - Remove an entire Subprocess
   134	 * 
   135	 * Used when deleting a subprocess branch. Removes all contained
   136	 * ActionGroups and Actions recursively.
   137	 * 
   138	 * Note: Currently not used, but available for future features.
   139	 */
   140	export class RemoveSubprocessFromProcessTreeOp implements IOperation {
   141	  readonly type = 'RemoveSubprocessFromProcessTree';
   142	  readonly parameters: Record<string, any>;
   143	  outputs: Record<string, any> = {};
   144	  
   145	  // TODO: Implement when needed
   146	  // Must store entire subtree for restoration
   147	
   148	  constructor(
   149	    private subprocessId: string
   150	  ) {
   151	    this.parameters = { subprocessId };
   152	  }
   153	
   154	  apply(_world: World): OperationResult {
   155	    return {
   156	      success: false,
   157	      outputs: {},
   158	      error: 'RemoveSubprocessFromProcessTreeOp not yet implemented'
   159	    };
   160	  }
   161	
   162	  undo(_world: World): void {
   163	    throw new Error('Not implemented');
   164	  }
   165	
   166	  serialize() {
   167	    return { opType: this.type, subprocessId: this.subprocessId, outputs: this.outputs };
   168	  }
   169	}
