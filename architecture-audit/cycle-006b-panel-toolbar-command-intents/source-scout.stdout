   220	/**
   221	 * Find actions that have any of the selected element IDs in their inputs or outputs
   222	 */
   223	function findRelatedActions(selectedIds: string[]): void {
   224	  const related = new Set<string>();
   225	  const selectedIdSet = new Set(selectedIds);
   226	
   227	  // Get all actions from process tree
   228	  const allActions = processTree.value.getAllActions();
   229	
   230	  // Check each action's elementId and dependencies (Phase 92)
   231	  for (const action of allActions) {
   232	    // Check if action produces any selected element
   233	    const producesSelected = selectedIdSet.has(action.elementId);
   234	    
   235	    // Check if action depends on any selected element
   236	    // Dependencies are now in DependencyService, accessible via element
   237	    const dependsOnSelected = world && world.dependencyService 
   238	      ? world.dependencyService.getDependencies(action.elementId).some(depId => selectedIdSet.has(depId))
   239	      : false;
   240	
   241	    if (producesSelected || dependsOnSelected) {
   242	      related.add(action.id);
   243	    }
   244	  }
   245	
   246	  relatedActionIds.value = related;
   247	}
   248	
   249	/**
   250	 * Recursively count total nodes in the tree
   251	 */
   252	function countNodes(node: ProcessTreeNodeType): number {
   253	  let count = 1;
   254	  if (node.children) {
   255	    for (const child of node.children) {
   256	      if (child) {
   257	        count += countNodes(child);
   258	      }
   259	    }
   260	  }
   261	  return count;
   262	}
   263	
   264	// Stack management handlers
   265	function pushSubprocess() {
   266	  const subprocessName = `Subprocess ${Date.now()}`;
   267	  const cmd = new Command('Push subprocess', world);
   268	  cmd.addAndExecute(new PushSubprocessOp(subprocessName));
   269	  cmd.commit();
   270	  commandStack.push(cmd);
   271	  stackVersion.value++; // Trigger UI update
   272	}
   273	
