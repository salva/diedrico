     9	
    10	export interface CanvasToolControllerDependencies {
    11	  world: World;
    12	  commandStack: CommandStack;
    13	  toolStore: ReturnType<typeof useToolStore>;
    14	}
    15	
    16	export interface CanvasToolControllerProviderDependencies {
    17	  world: World;
    18	  commandStack: unknown;
    19	  toolStore: ReturnType<typeof useToolStore>;
    20	}
    21	
    22	export function createCanvasToolController(deps: CanvasToolControllerProviderDependencies): CanvasToolController {
    23	  if (!deps.commandStack) {
    24	    throw new Error('CommandStack not provided');
    25	  }
    26	  return new CanvasToolController({
    27	    world: deps.world,
    28	    commandStack: deps.commandStack as CommandStack,
    29	    toolStore: deps.toolStore
    30	  });
    31	}
    32	
    33	export class CanvasToolController implements ToolCommandSink {
    34	  private readonly movement: CanvasPointMovementUseCase;
    35	  private readonly style: CanvasStyleUseCase;
    36	
    37	  constructor(private readonly deps: CanvasToolControllerDependencies) {
    38	    this.movement = new CanvasPointMovementUseCase(deps.world, deps.commandStack);
    39	    this.style = new CanvasStyleUseCase(deps.world, deps.commandStack);
    40	  }
    41	
    42	  executeConstructionIntent(intent: ToolConstructionIntent): ToolCommandResult {
    43	    const result = executeConstructionIntent({
    44	      intent,
    45	      world: this.deps.world,
    46	      commandStack: this.deps.commandStack
    47	    });
    48	    return result;
    49	  }
    50	
    51	  executeQuickIntent(intent: QuickToolIntent): ToolCommandResult {
    52	    const result = executeQuickToolIntent({
    53	      intent,
    54	      world: this.deps.world,
    55	      commandStack: this.deps.commandStack
    56	    });
    57	    this.deps.toolStore.setTool('select');
    58	    return result;
    59	  }
    60	
    61	  startFreePointMove(request: MoveFreePointRequest): FreePointMoveSession {
    62	    return this.movement.start(request);
    63	  }
    64	
    65	  updateElementStyle(request: StyleUpdateRequest): ToolCommandResult {
    66	    return this.style.update(request);
    67	  }
