### frontend/src/commands/operations/processTree/PushSubprocessOp.ts
     1	/**
     2	 * PushSubprocessOp - Push subprocess onto ProcessTree stack
     3	 * 
     4	 * Creates a new subprocess and pushes it onto the ProcessTree subprocess stack.
     5	 * All subsequent actions will be added to this subprocess until it is popped.
     6	 * 
     7	 * Phase 85: ProcessTree Subprocess Stack Architecture
     8	 * Reference: specs/001-dihedral-learning-mvp/data-model.md §ProcessTree (Phase 85)
     9	 */
    10	
    11	import type { IOperation, OperationResult } from '../IOperation';
    12	import type { World } from '@/domain/world/World';
    13	
    14	export class PushSubprocessOp implements IOperation {
    15	  readonly type = 'PushSubprocess';
    16	  parameters: Record<string, any>;
    17	  outputs: Record<string, any> = {};
    18	
    19	  constructor(private readonly subprocessName: string, private subprocessId?: string) {
    20	    this.parameters = { subprocessName };
    21	    // If subprocessId provided (during deserialization), store it in outputs
    22	    if (subprocessId) {
    23	      this.outputs = { subprocessId };
    24	    }
    25	  }
    26	
    27	  apply(world: World): OperationResult {
    28	    // On replay (deserialization), reuse the stored subprocessId from outputs
    29	    // This ensures toggle operations can find the correct subprocess
    30	    const existingId = this.outputs.subprocessId;
    31	    const subprocess = world.getProcessTree().pushSubprocess(this.subprocessName, existingId);
    32	    this.outputs = { subprocessId: subprocess.id };
    33	    return { success: true, outputs: this.outputs };
    34	  }
    35	
    36	  undo(world: World): void {
    37	    // Undo by popping the subprocess from the stack
    38	    world.getProcessTree().popSubprocess();
    39	  }
    40	
    41	  serialize() {
    42	    return { opType: this.type, subprocessName: this.parameters.subprocessName, subprocessId: this.outputs.subprocessId, outputs: this.outputs };
    43	  }
    44	}
### frontend/src/commands/operations/processTree/RenameSubprocessOp.ts
     1	/**
     2	 * RenameSubprocessOp - Rename a subprocess in the ProcessTree
     3	 */
     4	
     5	import type { IOperation, OperationResult } from '../IOperation';
     6	import type { World } from '@/domain/world/World';
     7	
     8	export class RenameSubprocessOp implements IOperation {
     9	  readonly type = 'RenameSubprocess';
    10	  parameters: Record<string, any>;
    11	  outputs: Record<string, any> = {};
    12	  private oldName: string | null = null;
    13	
    14	  constructor(private readonly subprocessId: string, private readonly newName: string) {
    15	    this.parameters = { subprocessId, newName };
    16	  }
    17	
    18	  apply(world: World): OperationResult {
    19	    const processTree = world.getProcessTree();
    20	    const subprocess = processTree.findSubprocessById(this.subprocessId);
    21	    
    22	    if (!subprocess) {
    23	      return { success: false, error: `Subprocess not found: ${this.subprocessId}` };
    24	    }
    25	
    26	    if (this.oldName === null) {
    27	      this.oldName = subprocess.name;
    28	    }
    29	
    30	    processTree.renameSubprocess(this.subprocessId, this.newName);
    31	    return { success: true, outputs: this.outputs };
    32	  }
    33	
    34	  undo(world: World): void {
    35	    if (this.oldName !== null) {
    36	      const processTree = world.getProcessTree();
    37	      processTree.renameSubprocess(this.subprocessId, this.oldName);
    38	    }
    39	  }
    40	
    41	  redo(world: World): void {
    42	    const processTree = world.getProcessTree();
    43	    processTree.renameSubprocess(this.subprocessId, this.newName);
    44	  }
    45	
    46	  serialize() {
    47	    return { opType: this.type, subprocessId: this.parameters.subprocessId, newName: this.parameters.newName };
    48	  }
    49	}
### frontend/src/commands/operations/processTree/ToggleEncapsulationOp.ts
     1	/**
     2	 * ToggleEncapsulationOp - Toggle encapsulation (black-box) mode of a subprocess
     3	 */
     4	
     5	import type { IOperation, OperationResult } from '../IOperation';
     6	import type { World } from '@/domain/world/World';
     7	
     8	export class ToggleEncapsulationOp implements IOperation {
     9	  readonly type = 'ToggleEncapsulation';
    10	  parameters: Record<string, any>;
    11	  outputs: Record<string, any> = {};
    12	
    13	  constructor(private readonly subprocessId: string) {
    14	    this.parameters = { subprocessId };
    15	  }
    16	
    17	  apply(world: World): OperationResult {
    18	    const processTree = world.getProcessTree();
    19	    try {
    20	      console.log(`[ToggleEncapsulationOp.apply] subprocessId: ${this.subprocessId}`);
    21	      processTree.toggleSubprocessEncapsulation(this.subprocessId);
    22	      return { success: true, outputs: this.outputs };
    23	    } catch (e: any) {
    24	      return { success: false, outputs: {}, error: e.message };
    25	    }
    26	  }
    27	
    28	  undo(world: World): void {
    29	    const processTree = world.getProcessTree();
    30	    processTree.toggleSubprocessEncapsulation(this.subprocessId);
    31	  }
    32	
    33	  redo(world: World): void {
    34	    const processTree = world.getProcessTree();
    35	    console.log(`[ToggleEncapsulationOp.redo] subprocessId: ${this.subprocessId}`);
    36	    processTree.toggleSubprocessEncapsulation(this.subprocessId);
    37	  }
    38	
    39	  serialize() {
    40	    return { opType: this.type, subprocessId: this.parameters.subprocessId };
    41	  }
    42	}
