   139	
   140	/**
   141	 * Toolbar.vue - Tool selection toolbar
   142	 * 
   143	 * Provides buttons for selecting geometric construction tools (Point, Line, etc.),
   144	 * file operations (New, Open), and history controls (Undo/Redo).
   145	 * Manages active tool state via tool store.
   146	 * 
   147	 * Reference: specs/001-dihedral-learning-mvp/ui-spec.md - Toolbar Component
   148	 */
   149	
   150	interface Emits {
   151	  (e: 'new-project'): void;
   152	  (e: 'open-project'): void;
   153	  (e: 'fit-to-view'): void;
   154	  (e: 'sign-in'): void;
   155	  (e: 'sign-out'): void;
   156	}
   157	
   158	const emit = defineEmits<Emits>();
   159	
   160	const toolStore = useToolStore();
   161	const viewStore = useViewStore();
   162	
   163	// Inject command stack for undo/redo
   164	const commandStack = inject<CommandStack>('commandStack')!;
   165	if (!commandStack) {
   166	  throw new Error('CommandStack not provided');
   167	}
   168	
   169	// Inject world for example setups
   170	const world = inject<World>('world')!;
   171	if (!world) {
   172	  throw new Error('World not provided');
   173	}
   174	
   175	// Reactive trigger for CommandStack updates (Phase 91)
   205	/**
   206	 * Handle global keyboard shortcuts
   207	 * Phase 54.5: Esc activates Selection Tool
   208	 * Phase 67: Letter shortcuts activate specific sub-tools and update last-used
   209	 * Alt+E: Add projection plane example setup (for testing)
   210	 */
   211	function handleKeyDown(event: KeyboardEvent) {
   212	  if (event.key === 'Escape') {
   213	    selectTool('select');
   214	    event.preventDefault();
   215	    return;
   216	  }
   217	  
   218	  // Alt+E: Add projection plane example setup
   219	  if (event.altKey && (event.key === 'e' || event.key === 'E')) {
   220	    addProjectionPlaneSetup();
   221	    event.preventDefault();
   222	    return;
   223	  }
   224	  
   225	  // Handle letter shortcuts for tools
   226	  const key = event.key.toUpperCase();
   227	  
   228	  // Phase 106: D key toggles 3D element projection display
   229	  if (key === 'D') {
   230	    handleToggleProjections();
   231	    event.preventDefault();
   232	    return;
   233	  }
   234	  
   235	  // Find tool with matching shortcut across all families
   236	  for (const family of TOOL_FAMILIES) {
   237	    for (const tool of family.tools) {
   238	      if (tool.shortcut === key) {
   239	        // Activate tool directly and update last-used for its family
   240	        toolStore.selectSubTool(family.id, tool.id);
   241	        event.preventDefault();
   242	        return;
   243	      }
   244	    }
   245	  }
   246	}
   247	
   248	/**
   249	 * Add projection plane example setup (Alt+E)
   250	 * Creates T1, T2, and T2' lines for testing auxiliary projection plane creation
   251	 */
   252	function addProjectionPlaneSetup() {
   253	  try {
   254	    const planes = world.getAllProjectionPlanes();
   255	    const P_H = planes.find((p) => p.name === 'P_H');
   256	    const P_V = planes.find((p) => p.name === 'P_V');
   257	
   258	    if (!P_H || !P_V) {
   259	      console.error('Standard projection planes P_H and P_V not found');
   260	      return;
   261	    }
   262	
   263	    const cmd = new Command('Add projection plane example setup', world);
   264	
   265	    // T1 on P_H (horizontal trace)
   266	    const t1_p1 = cmd.addAndExecute(new AddFreePoint2DOp(P_H.id, new Vector3(150, 0, 1)));
   267	    const t1_p2 = cmd.addAndExecute(new AddFreePoint2DOp(P_H.id, new Vector3(450, 0, 1)));
   268	    const t1 = cmd.addAndExecute(new AddLine2DByTwoPointsOp(
   269	      P_H.id, 
   270	      t1_p1.outputs.pointId as string, 
   271	      t1_p2.outputs.pointId as string
   272	    ));
   273	    const t1Line = world.getLine2D(t1.outputs.lineId as string);
   274	    if (t1Line) t1Line.label = 'T1_H';
   275	
   276	    // T2 on P_V (diagonal trace)
   277	    const t2_p1 = cmd.addAndExecute(new AddFreePoint2DOp(P_V.id, new Vector3(200, 0, 1)));
   278	    const t2_p2 = cmd.addAndExecute(new AddFreePoint2DOp(P_V.id, new Vector3(400, 150, 1)));
   279	    const t2 = cmd.addAndExecute(new AddLine2DByTwoPointsOp(
   280	      P_V.id,
   281	      t2_p1.outputs.pointId as string,
   282	      t2_p2.outputs.pointId as string
   283	    ));
   284	    const t2Line = world.getLine2D(t2.outputs.lineId as string);
   285	    if (t2Line) t2Line.label = 'T2_V';
   286	
   287	    // T2' on P_H (position line)
   288	    const t2p_p1 = cmd.addAndExecute(new AddFreePoint2DOp(P_H.id, new Vector3(200, 80, 1)));
   289	    const t2p_p2 = cmd.addAndExecute(new AddFreePoint2DOp(P_H.id, new Vector3(400, 120, 1)));
   290	    const t2p = cmd.addAndExecute(new AddLine2DByTwoPointsOp(
   291	      P_H.id,
   292	      t2p_p1.outputs.pointId as string,
   293	      t2p_p2.outputs.pointId as string
   294	    ));
   295	    const t2pLine = world.getLine2D(t2p.outputs.lineId as string);
   296	    if (t2pLine) t2pLine.label = 'T2\'_H';
   297	
   298	    cmd.commit();
   299	    commandStack.push(cmd);
   300	    
   301	    console.log('Added projection plane example setup (T1_H, T2_V, T2\'_H)');
   302	  } catch (error) {
   303	    console.error('Failed to add projection plane setup:', error);
   304	  }
   305	}
