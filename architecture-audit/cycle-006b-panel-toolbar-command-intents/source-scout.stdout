### frontend/src/commands/operations/processTree/registerProcessTreeOperationDescriptors.ts
     1	import type { OperationRegistry } from '../OperationRegistry';
     2	import type { JsonObject } from '../IOperation';
     3	import { createActionGroup } from '@/domain/processTree/ActionGroup';
     4	import { AddProcessTreeActionOp } from './AddProcessTreeActionOp';
     5	import { AddProcessTreeActionGroupOp } from './AddProcessTreeActionGroupOp';
     6	import { PushSubprocessOp } from './PushSubprocessOp';
     7	import { PopSubprocessOp } from './PopSubprocessOp';
     8	import { RenameSubprocessOp } from './RenameSubprocessOp';
     9	import { ToggleEncapsulationOp } from './ToggleEncapsulationOp';
    10	import { ToggleOutputOp } from './ToggleOutputOp';
    11	import { RemoveActionFromProcessTreeOp, RemoveActionGroupFromProcessTreeOp, RemoveSubprocessFromProcessTreeOp } from './ProcessTreeOperations';
    12	import type { Action } from '@/domain/processTree/Action';
    13	
    14	function s(d: JsonObject, key: string): string { const v = d[key]; if (typeof v !== 'string') throw new Error(`Invalid ${String(d.opType)} descriptor: ${key} must be string`); return v; }
    15	function so(d: JsonObject, key: string): string | undefined { const v = d[key]; if (v === undefined || v === null) return undefined; if (typeof v !== 'string') throw new Error(`Invalid ${String(d.opType)} descriptor: ${key} must be string`); return v; }
    16	function obj(d: JsonObject, key: string): JsonObject { const v = d[key]; if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error(`Invalid ${String(d.opType)} descriptor: ${key} must be object`); return v as JsonObject; }
    17	function restoreOutput<T extends { outputs: JsonObject }>(op: T, outputs: unknown): T { if (outputs && typeof outputs === 'object' && !Array.isArray(outputs)) op.outputs = outputs as JsonObject; return op; }
    18	
    19	export function registerProcessTreeOperationDescriptors(registry: OperationRegistry): void {
    20	  registry.register('AddProcessTreeActionOp', d => restoreOutput(new AddProcessTreeActionOp(obj(d, 'action') as unknown as Action, s(d, 'groupId')), d.outputs));
    21	  registry.register('AddProcessTreeActionGroup', d => {
    22	    const group = createActionGroup(s(d, 'groupId'));
    23	    group.isOutput = d.isOutput !== false;
    24	    group.isAuxiliary = d.isAuxiliary === true;
    25	    return restoreOutput(new AddProcessTreeActionGroupOp(group), d.outputs);
    26	  });
    27	  registry.register('PushSubprocess', d => restoreOutput(new PushSubprocessOp(s(d, 'subprocessName'), so(d, 'subprocessId')), d.outputs));
    28	  registry.register('PopSubprocess', () => new PopSubprocessOp());
    29	  registry.register('RenameSubprocess', d => new RenameSubprocessOp(s(d, 'subprocessId'), s(d, 'newName')));
    30	  registry.register('ToggleEncapsulation', d => new ToggleEncapsulationOp(s(d, 'subprocessId')));
    31	  registry.register('ToggleOutput', d => new ToggleOutputOp(s(d, 'nodeId')));
    32	  registry.register('RemoveActionFromProcessTree', d => new RemoveActionFromProcessTreeOp(s(d, 'actionId')));
    33	  registry.register('RemoveActionGroupFromProcessTree', d => new RemoveActionGroupFromProcessTreeOp(s(d, 'groupId')));
    34	  registry.register('RemoveSubprocessFromProcessTree', d => new RemoveSubprocessFromProcessTreeOp(s(d, 'subprocessId')));
    35	}

