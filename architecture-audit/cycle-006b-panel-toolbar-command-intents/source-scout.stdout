     1	import { Command } from '@/commands/Command';
     2	import type { CommandStack } from '@/commands/CommandStack';
     3	import type { World } from '@/domain/world/World';
     4	import type { ToolConstructionIntent, ToolCommandResult } from '@/application/tools/ToolCommandIntents';
     5	import type { Point2D } from '@/domain/world/Point';
     6	import { Line2D } from '@/domain/world/Line';
     7	import { Circle2D } from '@/domain/world/Circle';
     8	import { PointSequenceFactory } from '@/commands/factories/PointSequenceFactory';
     9	import { LineSequenceFactory } from '@/commands/factories/LineSequenceFactory';
    10	import { CircleSequenceFactory } from '@/commands/factories/CircleSequenceFactory';
    11	import { GuideSequenceFactory } from '@/commands/factories/GuideSequenceFactory';
    12	import { IntersectionSequenceFactory } from '@/commands/factories/IntersectionSequenceFactory';
    13	import { PlaneSequenceFactory } from '@/services/factories/PlaneSequenceFactory';
    14	import { AddSegment2DByPointsOp } from '@/commands/operations/world/AddSegmentOp';
    15	import { Add3DPointOp } from '@/commands/operations/world/Add3DPointOp';
    16	import { Add3DLineOp } from '@/commands/operations/world/Add3DLineOp';
    17	import { Add3DSegmentOp } from '@/commands/operations/world/Add3DSegmentOp';
    18	import { AddLine2DTangentToCircleThroughPointOp, AddLine2DTangentToCircleParallelToLineOp } from '@/commands/operations/world/AddLineOp';
    19	import { createActionGroup } from '@/domain/processTree/ActionGroup';
    20	import { AddProcessTreeActionGroupOp } from '@/commands/operations/processTree/AddProcessTreeActionGroupOp';
    21	import { AddProcessTreeActionOp } from '@/commands/operations/processTree/AddProcessTreeActionOp';
    22	import { createSegmentAction } from '@/domain/processTree/actions/CreateSegmentAction';
    23	import { createGuideAction } from '@/domain/processTree/actions/CreateGuideAction';
    24	import { createSiblingGuideAction } from '@/domain/processTree/actions/CreateSiblingGuideAction';
    25	import { createAdd3DPointAction, createAdd3DLineAction, createAdd3DSegmentAction } from '@/domain/processTree/actions/Element3DActions';
    26	import { createTangentLineToCircleThroughPointAction, createTangentLineToCircleParallelToLineAction } from '@/domain/processTree/actions/CreateTangentLineAction';
    27	import { areLinesParallel, intersectLineCircle, intersectCircleCircle } from '@/domain/calculations/Intersections';
    28	
    29	export interface ExecuteConstructionParams {
    30	  intent: ToolConstructionIntent;
    31	  world: World;
    32	  commandStack: CommandStack;
    33	}
    34	
    35	export function executeConstructionIntent({ intent, world, commandStack }: ExecuteConstructionParams): ToolCommandResult {
    36	  const cmd = new Command(intent.description, world);
    37	  try {
    38	    const groupId = `group_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
    39	    const group = createActionGroup(groupId);
    40	    cmd.addAndExecute(new AddProcessTreeActionGroupOp(group));
    41	    executeConstructionOperations(cmd, intent, world, groupId);
    42	    checkCreatedElementsFeasibility(cmd, world);
    43	    cmd.commit();
    44	    commandStack.push(cmd);
    45	    return { success: true, message: `${intent.description} completed successfully` };
    46	  } catch (error) {
    47	    cmd.rollback();
    48	    return { success: false, message: error instanceof Error ? error.message : String(error) };
    49	  }
    50	}
    51	
    52	function executeConstructionOperations(cmd: Command, intent: ToolConstructionIntent, world: World, groupId: string): void {
    53	  const args = intent.args;
    54	  const planeId = intent.planeId;
    55	
    56	  switch (intent.type) {
    57	    case 'point': {
    58	      const planeCoords = args.get('position')!.planeCoords;
    59	      validateCoordinates(planeCoords);
    60	      if (!world.getProjectionPlaneById(planeId)) throw new Error(`Plane not found: ${planeId}`);
    61	      PointSequenceFactory.createFreePoint(cmd, planeId, planeCoords, groupId);
    62	      return;
    63	    }
    64	    case 'line': {
    65	      const p1 = args.get('point1')!.element as Point2D;
    66	      const p2 = args.get('point2')!.element as Point2D;
    67	      LineSequenceFactory.createLineByTwoPoints(cmd, planeId, p1.id, p2.id, groupId);
    68	      return;
    69	    }
    70	    case 'segment': {
    71	      const p1 = args.get('point1')!.element as Point2D;
    72	      const p2 = args.get('point2')!.element as Point2D;
    73	      const result = cmd.addAndExecute(new AddSegment2DByPointsOp(planeId, p1.id, p2.id));
    74	      cmd.addAndExecute(new AddProcessTreeActionOp(createSegmentAction(result.outputs.segmentId as string), groupId));
    75	      return;
    76	    }
    77	    case 'circle': {
    78	      const center = args.get('center')!.element as Point2D;
    79	      const circumferencePoint = args.get('circumferencePoint')!.element as Point2D;
    80	      CircleSequenceFactory.createCircleByCenterAndPoint(cmd, planeId, center.id, circumferencePoint.id, groupId);
    81	      return;
    82	    }
    83	    case 'guide': {
    84	      const referenceLineId = args.get('referenceLine')!.element!.id;
    85	      const throughPointId = args.get('throughPoint')!.element!.id;
    86	      const result = GuideSequenceFactory.createGuideWithSibling(cmd, planeId, referenceLineId, throughPointId, world);
    87	      cmd.addAndExecute(new AddProcessTreeActionOp(createGuideAction(result.guideId), groupId));
    88	      if (result.siblingGuideId) cmd.addAndExecute(new AddProcessTreeActionOp(createSiblingGuideAction(result.siblingGuideId), groupId));
    89	      return;
    90	    }
    91	    case 'parallel-line': {
    92	      const line = args.get('referenceLine')!.element as Line2D;
    93	      const point = args.get('throughPoint')!.element as Point2D;
    94	      LineSequenceFactory.createParallelLine(cmd, planeId, line.id, point.id, groupId);
    95	      return;
    96	    }
    97	    case 'perpendicular-line': {
    98	      const line = args.get('referenceLine')!.element as Line2D;
    99	      const point = args.get('throughPoint')!.element as Point2D;
   100	      LineSequenceFactory.createPerpendicularLine(cmd, planeId, line.id, point.id, groupId);
   101	      return;
   102	    }
   103	    case 'intersection': {
   104	      createIntersection(cmd, intent, world, groupId);
   105	      return;
   106	    }
   107	    case 'tangent-line-to-circle-through-point': {
   108	      const circle = args.get('circle')!.element as Circle2D;
   109	      const point = args.get('throughPoint')!.element as Point2D;
   110	      const tangentIndex = intent.metadata.tangentIndex;
   111	      const result = cmd.addAndExecute(new AddLine2DTangentToCircleThroughPointOp(planeId, circle.id, point.id, tangentIndex));
   112	      cmd.addAndExecute(new AddProcessTreeActionOp(createTangentLineToCircleThroughPointAction(result.outputs.lineId as string), groupId));
   113	      return;
   114	    }
   115	    case 'tangent-line-to-circle-parallel': {
   116	      const circle = args.get('circle')!.element as Circle2D;
   117	      const line = args.get('referenceLine')!.element as Line2D;
   118	      const tangentIndex = intent.metadata.tangentIndex;
   119	      const result = cmd.addAndExecute(new AddLine2DTangentToCircleParallelToLineOp(planeId, circle.id, line.id, tangentIndex));
   120	      cmd.addAndExecute(new AddProcessTreeActionOp(createTangentLineToCircleParallelToLineAction(result.outputs.lineId as string), groupId));
   121	      return;
   122	    }
   123	    case 'create3dpoint': {
   124	      const p1 = args.get('projection1')!.element!;
   125	      const p2 = args.get('projection2')!.element!;
   126	      const result = cmd.addAndExecute(new Add3DPointOp(p1.id, p2.id, p1.planeId, p2.planeId));
   127	      cmd.addAndExecute(new AddProcessTreeActionOp(createAdd3DPointAction(result.outputs.pointId as string), groupId));
   128	      return;
   129	    }
   130	    case 'create3dline': {
   131	      const l1 = args.get('projection1')!.element!;
   132	      const l2 = args.get('projection2')!.element!;
   133	      const result = cmd.addAndExecute(new Add3DLineOp(l1.id, l2.id, l1.planeId, l2.planeId));
   134	      cmd.addAndExecute(new AddProcessTreeActionOp(createAdd3DLineAction(result.outputs.lineId as string), groupId));
   135	      return;
   136	    }
   137	    case 'create3dsegment': {
   138	      const s1 = args.get('projection1')!.element!;
   139	      const s2 = args.get('projection2')!.element!;
   140	      const result = cmd.addAndExecute(new Add3DSegmentOp(s1.id, s2.id, s1.planeId, s2.planeId));
   141	      cmd.addAndExecute(new AddProcessTreeActionOp(createAdd3DSegmentAction(result.outputs.segmentId as string), groupId));
   142	      return;
   143	    }
   144	    case 'create3dplane': {
   145	      const t1 = args.get('trace1')!.element!;
   146	      const t2 = args.get('trace2')!.element!;
   147	      PlaneSequenceFactory.create3DPlaneFromTraces(cmd, t1.id, t2.id, t1.planeId, t2.planeId, undefined, groupId);
   148	      return;
   149	    }
   150	    case 'createprojectionplane': {
   151	      const t1 = args.get('t1HingeTrace')!.element!;
   152	      const t2 = args.get('t2OtherTrace')!.element!;
   153	      const t2Prime = args.get('t2PrimePositionLine')!.element!;
   154	      const { planeId: plane3DId } = PlaneSequenceFactory.create3DPlaneFromTraces(cmd, t1.id, t2.id, t1.planeId, t2.planeId, undefined, groupId);
   155	      PlaneSequenceFactory.createAuxiliaryProjectionPlane(cmd, world, plane3DId, t1.id, t2.id, t2Prime.id, t1.planeId, undefined, groupId);
   156	      return;
   157	    }
   158	    case 'interactiveprojectionsetup': {
   159	      throw new Error('Interactive projection setup is not retained in Wave 006a application controller');
   160	    }
   161	    default:
   162	      throw new Error(`Unsupported construction intent: ${(intent as any).type}`);
   163	  }
   164	}
   165	
   166	function createIntersection(cmd: Command, intent: Extract<ToolConstructionIntent, { type: 'intersection' }>, world: World, groupId: string): void {
   167	  const element1 = intent.args.get('element1')!.element!;
   168	  const element2 = intent.args.get('element2')!.element!;
   169	  const selectionPoint = intent.metadata.selectionPoint;
   170	  if (element1 instanceof Line2D && element2 instanceof Line2D) {
   171	    const r1 = element1.realize2D(world);
   172	    const r2 = element2.realize2D(world);
   173	    if (!r1 || !r2) throw new Error('Could not realize lines.');
   174	    if (areLinesParallel(r1, r2)) throw new Error('Lines are parallel and do not intersect.');
   175	    IntersectionSequenceFactory.createLineLineIntersection(cmd, intent.planeId, element1.id, element2.id, world, groupId);
   176	  } else if (element1 instanceof Line2D && element2 instanceof Circle2D) {
   177	    const index = lineCircleIndex(element1.id, element2.id, selectionPoint, world);
   178	    if (index === null) throw new Error('Line and circle do not intersect.');
   179	    IntersectionSequenceFactory.createLineCircleIntersection(cmd, intent.planeId, element1.id, element2.id, index, world, groupId);
   180	  } else if (element1 instanceof Circle2D && element2 instanceof Line2D) {
   181	    const index = lineCircleIndex(element2.id, element1.id, selectionPoint, world);
   182	    if (index === null) throw new Error('Circle and line do not intersect.');
   183	    IntersectionSequenceFactory.createLineCircleIntersection(cmd, intent.planeId, element2.id, element1.id, index, world, groupId);
   184	  } else if (element1 instanceof Circle2D && element2 instanceof Circle2D) {
   185	    const index = circleCircleIndex(element1.id, element2.id, selectionPoint, world);
   186	    if (index === null) throw new Error('Circles do not intersect.');
   187	    IntersectionSequenceFactory.createCircleCircleIntersection(cmd, intent.planeId, element1.id, element2.id, index, world, groupId);
   188	  } else {
   189	    throw new Error('Unsupported element type combination for intersection.');
   190	  }
   191	}
   192	
   193	function lineCircleIndex(lineId: string, circleId: string, mousePos: THREE.Vector3, world: World): number | null {
   194	  const line = world.getLine2D(lineId);
   195	  const circle = world.getCircle2D(circleId);
   196	  if (!line || !circle) return null;
   197	  const lr = line.realize2D(world);
   198	  const cr = circle.realize2D(world);
   199	  if (!lr || !cr) return null;
   200	  const intersections = intersectLineCircle(lr, cr);
   201	  if (intersections.length === 0) return null;
   202	  if (intersections.length === 1) return 0;
   203	  return intersections[0].distanceTo(mousePos) <= intersections[1].distanceTo(mousePos) ? 0 : 1;
   204	}
   205	
   206	function circleCircleIndex(circle1Id: string, circle2Id: string, mousePos: THREE.Vector3, world: World): number | null {
   207	  const c1 = world.getCircle2D(circle1Id);
   208	  const c2 = world.getCircle2D(circle2Id);
   209	  if (!c1 || !c2) return null;
   210	  const r1 = c1.realize2D(world);
   211	  const r2 = c2.realize2D(world);
   212	  if (!r1 || !r2) return null;
   213	  const intersections = intersectCircleCircle(r1, r2);
   214	  if (intersections.length === 0) return null;
   215	  if (intersections.length === 1) return 0;
   216	  return intersections[0].distanceTo(mousePos) <= intersections[1].distanceTo(mousePos) ? 0 : 1;
   217	}
