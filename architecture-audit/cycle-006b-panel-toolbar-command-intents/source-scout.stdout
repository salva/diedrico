    87	  commit(): ToolCommandResult;
    88	  cancel(): void;
    89	}
    90	
    91	export interface ToolCommandSink {
    92	  executeConstructionIntent(intent: ToolConstructionIntent): ToolCommandResult;
    93	  executeQuickIntent(intent: QuickToolIntent): ToolCommandResult;
    94	  startFreePointMove(request: MoveFreePointRequest): FreePointMoveSession;
    95	  updateElementStyle(request: StyleUpdateRequest): ToolCommandResult;
    96	}
### frontend/src/application/tools/CanvasToolController.ts
     1	import type { CommandStack } from '@/commands/CommandStack';
     2	import type { World } from '@/domain/world/World';
     3	import type { useToolStore } from '@/stores/toolStore';
     4	import type { ToolCommandSink, ToolConstructionIntent, QuickToolIntent, MoveFreePointRequest, FreePointMoveSession, StyleUpdateRequest, ToolCommandResult } from './ToolCommandIntents';
     5	import { executeConstructionIntent } from '@/application/construction/ConstructionUseCases';
     6	import { executeQuickToolIntent } from '@/application/construction/QuickToolUseCases';
     7	import { CanvasPointMovementUseCase } from '@/application/canvas/CanvasPointMovementUseCase';
