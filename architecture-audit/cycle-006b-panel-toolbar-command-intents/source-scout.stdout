### frontend/src/application/tools/ToolCommandIntents.ts
     1	import type { Vector3 } from 'three';
     2	import type { ArgumentValue } from '@/types/ToolArgumentCollector';
     3	
     4	export type ConstructionIntentType =
     5	  | 'point'
     6	  | 'line'
     7	  | 'segment'
     8	  | 'circle'
     9	  | 'guide'
    10	  | 'intersection'
    11	  | 'parallel-line'
    12	  | 'perpendicular-line'
    13	  | 'tangent-line-to-circle-through-point'
    14	  | 'tangent-line-to-circle-parallel'
    15	  | 'create3dpoint'
    16	  | 'create3dline'
    17	  | 'create3dsegment'
    18	  | 'create3dplane'
    19	  | 'createprojectionplane'
    20	  | 'interactiveprojectionsetup';
    21	
    22	export type QuickToolIntentType =
    23	  | 'quickprojectionsetup'
    24	  | 'quick3dline'
    25	  | 'quick3dsegment';
    26	
    27	export type TangentChoiceMetadata = {
    28	  tangentIndex: 0 | 1;
    29	  selectionPoint: Vector3;
    30	};
    31	
    32	export type IntersectionChoiceMetadata = {
    33	  selectionPoint: Vector3;
    34	};
    35	
    36	interface BaseToolConstructionIntent {
    37	  type: ConstructionIntentType;
    38	  description: string;
    39	  planeId: string;
    40	  args: Map<string, ArgumentValue>;
    41	}
    42	
    43	export type ToolConstructionIntent =
    44	  | (BaseToolConstructionIntent & {
    45	      type: 'tangent-line-to-circle-through-point' | 'tangent-line-to-circle-parallel';
    46	      metadata: TangentChoiceMetadata;
    47	    })
    48	  | (BaseToolConstructionIntent & {
    49	      type: 'intersection';
    50	      metadata: IntersectionChoiceMetadata;
    51	    })
    52	  | (BaseToolConstructionIntent & {
    53	      type: Exclude<ConstructionIntentType, 'tangent-line-to-circle-through-point' | 'tangent-line-to-circle-parallel' | 'intersection'>;
    54	      metadata?: never;
    55	    });
    56	
    57	export interface QuickToolIntent {
    58	  type: QuickToolIntentType;
    59	  description: string;
    60	}
    61	
    62	export interface MoveFreePointRequest {
    63	  planeId: string;
    64	  pointId: string;
    65	  label?: string;
    66	}
    67	
    68	export interface StyleUpdateRequest {
