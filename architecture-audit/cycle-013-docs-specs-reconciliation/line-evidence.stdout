===== frontend/src/stores/authStore.ts =====
     1	/**
     2	 * authStore.ts - Authentication state management
     3	 * 
     4	 * T402: Manages Google Drive authentication state and user profile information.
     5	 * NOT part of the command stack (authentication is user-specific, not document-specific).
     6	 * NOT persisted in project files (session-only via session storage).
     7	 * 
     8	 * @see specs/001-dihedral-learning-mvp/data-model.md - Authentication State
     9	 */
    10	
    11	import { ref, computed } from 'vue';
    12	import type { GoogleUserProfile } from '../services/GoogleDriveService';
    13	
    14	export interface AuthState {
    15	  isAuthenticated: boolean;
    16	  user: GoogleUserProfile | null;
    17	  accessToken: string | null;
    18	  tokenExpiry: Date | null;
    19	}
    20	
    21	// Reactive state
    22	const isAuthenticated = ref(false);
    23	const user = ref<GoogleUserProfile | null>(null);
    24	const accessToken = ref<string | null>(null);
    25	const tokenExpiry = ref<Date | null>(null);
    26	
    27	// Session storage keys
    28	const SESSION_TOKEN_KEY = 'diedrico_access_token';
    29	const SESSION_PROFILE_KEY = 'diedrico_user_profile';
    30	const SESSION_EXPIRY_KEY = 'diedrico_token_expiry';
    31	
    32	export function useAuthStore() {
    33	  /**
    34	   * Set authenticated state with user profile
    35	   */
    36	  function setAuthenticated(profile: GoogleUserProfile, token: string, expiry?: Date) {
    37	    isAuthenticated.value = true;
    38	    user.value = profile;
    39	    accessToken.value = token;
    40	    tokenExpiry.value = expiry || null;
    41	    
    42	    // Persist to session storage
    43	    sessionStorage.setItem(SESSION_TOKEN_KEY, token);
    44	    sessionStorage.setItem(SESSION_PROFILE_KEY, JSON.stringify(profile));
    45	    if (expiry) {
    46	      sessionStorage.setItem(SESSION_EXPIRY_KEY, expiry.toISOString());
    47	    }
    48	  }
    49	
    50	  /**
    51	   * Update user profile information
    52	   */
    53	  function setUser(profile: GoogleUserProfile) {
    54	    user.value = profile;
    55	    sessionStorage.setItem(SESSION_PROFILE_KEY, JSON.stringify(profile));
    56	  }
    57	
    58	  /**
    59	   * Clear authentication state (sign out)
    60	   */
    61	  function clearAuth() {
    62	    isAuthenticated.value = false;
    63	    user.value = null;
    64	    accessToken.value = null;
    65	    tokenExpiry.value = null;
    66	    
    67	    // Clear session storage
    68	    sessionStorage.removeItem(SESSION_TOKEN_KEY);
    69	    sessionStorage.removeItem(SESSION_PROFILE_KEY);
    70	    sessionStorage.removeItem(SESSION_EXPIRY_KEY);
    71	  }
    72	
    73	  /**
    74	   * Restore authentication state from session storage
    75	   * Returns true if session was restored, false if no valid session exists
    76	   */
    77	  function restoreSession(): boolean {
    78	    const storedToken = sessionStorage.getItem(SESSION_TOKEN_KEY);
    79	    const storedProfile = sessionStorage.getItem(SESSION_PROFILE_KEY);
    80	    const storedExpiry = sessionStorage.getItem(SESSION_EXPIRY_KEY);
    81	
    82	    if (!storedToken || !storedProfile) {
    83	      return false;
    84	    }
    85	
    86	    // Check token expiry if available
    87	    if (storedExpiry) {
    88	      const expiry = new Date(storedExpiry);
    89	      if (expiry < new Date()) {
    90	        // Token expired, clear session
    91	        clearAuth();
    92	        return false;
    93	      }
    94	      tokenExpiry.value = expiry;
    95	    }
    96	
    97	    try {
    98	      const profile = JSON.parse(storedProfile);
    99	      isAuthenticated.value = true;
   100	      user.value = profile;
   101	      accessToken.value = storedToken;
   102	      return true;
   103	    } catch (error) {
   104	      console.error('[AuthStore] Failed to parse stored profile:', error);
   105	      clearAuth();
   106	      return false;
   107	    }
   108	  }
   109	
   110	  /**
   111	   * Check if token is expired or about to expire (within 5 minutes)
   112	   */
   113	  function isTokenExpired(): boolean {
   114	    if (!tokenExpiry.value) {
   115	      return false; // No expiry info, assume valid
   116	    }
   117	    const fiveMinutesFromNow = new Date(Date.now() + 5 * 60 * 1000);
   118	    return tokenExpiry.value < fiveMinutesFromNow;
   119	  }
   120	
   121	  return {
   122	    // State (readonly)
   123	    isAuthenticated: computed(() => isAuthenticated.value),
   124	    user: computed(() => user.value),
   125	    accessToken: computed(() => accessToken.value),
   126	    tokenExpiry: computed(() => tokenExpiry.value),
   127	    
   128	    // Actions
   129	    setAuthenticated,
   130	    setUser,
   131	    clearAuth,
   132	    restoreSession,
   133	    isTokenExpired,
   134	  };
   135	}

===== frontend/src/commands/CommandStack.ts =====
     1	/**
     2	 * CommandStack - Manages undo/redo history
     3	 * 
     4	 * Maintains two stacks:
     5	 * - undoStack: Commands that can be undone
     6	 * - redoStack: Commands that have been undone and can be redone
     7	 * 
     8	 * Reference: specs/001-dihedral-learning-mvp/data-model.md §Command Pattern
     9	 * 
    10	 * Behavior:
    11	 * - execute(): Adds command to undo stack, clears redo stack
    12	 * - undo(): Pops from undo stack, pushes to redo stack
    13	 * - redo(): Pops from redo stack, pushes back to undo stack
    14	 */
    15	
    16	import { Command, CommandStatus } from './Command';
    17	
    18	type Unsubscribe = () => void;
    19	type ChangeListener = () => void;
    20	
    21	export class CommandStack {
    22	  private undoStack: Command[] = [];
    23	  private redoStack: Command[] = [];
    24	  private listeners: ChangeListener[] = [];
    25	
    26	  /**
    27	   * Subscribe to changes in the stack
    28	   * @param callback Function to call when stack changes (push, undo, redo)
    29	   * @returns Unsubscribe function
    30	   */
    31	  subscribe(callback: ChangeListener): Unsubscribe {
    32	    this.listeners.push(callback);
    33	    return () => {
    34	      this.listeners = this.listeners.filter(l => l !== callback);
    35	    };
    36	  }
    37	
    38	  private notify(): void {
    39	    this.listeners.forEach(cb => cb());
    40	  }
    41	
    42	  /**
    43	   * Push a pre-built and committed command to the undo stack
    44	   * Clears the redo stack (can't redo after new action)
    45	   * 
    46	   * Phase 47: Non-undoable commands (canUndo() === false) are not added to the stack.
    47	   * This allows world initialization and other non-undoable commands to execute
    48	   * without appearing in undo history.
    49	   * 
    50	   * Note: Commands should be built, executed, and committed by tools before pushing
    51	   */
    52	  push(command: Command): void {
    53	    // Verify command is committed (not building)
    54	    if (command.status !== 'committed') {
    55	      throw new Error('Can only push committed commands to stack');
    56	    }
    57	    
    58	    // Phase 47: Skip non-undoable commands
    59	    if (!command.canUndo()) {
    60	      return;
    61	    }
    62	    
    63	    // Add to undo stack
    64	    this.undoStack.push(command);
    65	    
    66	    // Clear redo stack (new action invalidates redo history)
    67	    this.redoStack = [];
    68	    
    69	    this.notify();
    70	  }
    71	
    72	  /**
    73	   * Undo the most recent command
    74	   * Moves command from undo stack to redo stack
    75	   */
    76	  undo(): void {
    77	    if (this.undoStack.length === 0) {
    78	      throw new Error('Nothing to undo');
    79	    }
    80	    
    81	    const command = this.undoStack.pop()!;
    82	    command.undo();
    83	    this.redoStack.push(command);
    84	    
    85	    this.notify();
    86	  }
    87	
    88	  /**
    89	   * Redo the most recently undone command
    90	   * Moves command from redo stack back to undo stack
    91	   */
    92	  redo(): void {
    93	    if (this.redoStack.length === 0) {
    94	      throw new Error('Nothing to redo');
    95	    }
    96	    
    97	    const command = this.redoStack.pop()!;
    98	    command.redo();
    99	    this.undoStack.push(command);
   100	    
   101	    this.notify();
   102	  }
   103	
   104	  /**
   105	   * Check if undo is available
   106	   */
   107	  canUndo(): boolean {
   108	    return this.undoStack.length > 0;
   109	  }
   110	
   111	  /**
   112	   * Check if redo is available
   113	   */
   114	  canRedo(): boolean {
   115	    return this.redoStack.length > 0;
   116	  }
   117	
   118	  /**
   119	   * Get number of commands in undo stack
   120	   */
   121	  getUndoCount(): number {
   122	    return this.undoStack.length;
   123	  }
   124	
   125	  /**
   126	   * Get number of commands in redo stack
   127	   */
   128	  getRedoCount(): number {
   129	    return this.redoStack.length;
   130	  }
   131	
   132	  /**
   133	   * Get commands from undo stack for serialization
   134	   */
   135	  getCommands(): readonly Command[] {
   136	    return [...this.undoStack];
   137	  }
   138	
   139	  getCommittedCommands(): readonly Command[] {
   140	    return this.getCommands();
   141	  }
   142	
   143	  restoreCommittedCommands(commands: readonly Command[]): void {
   144	    for (const command of commands) {
   145	      if (command.status !== CommandStatus.Committed) {
   146	        throw new Error('Can only restore committed commands');
   147	      }
   148	    }
   149	    this.undoStack = [...commands];
   150	    this.redoStack = [];
   151	    this.notify();
   152	  }
   153	
   154	  /**
   155	   * Clear all history
   156	   */
   157	  clear(): void {
   158	    this.undoStack = [];
   159	    this.redoStack = [];
   160	    this.notify();
   161	  }
   162	}

