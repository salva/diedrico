    28	        title="Save (Enter)"
    29	      >
    30	        ✓
    31	      </button>
    32	      <button
    33	        class="cancel-button"
    34	        @mousedown.prevent="cancelEdit"
    35	        title="Cancel (Escape)"
    36	      >
    37	        ✕
    38	      </button>
    39	    </div>
    40	  </div>
    41	</template>
    42	
    43	<script setup lang="ts">
    44	import { ref, computed, nextTick, watch } from 'vue';
    45	
    46	/**
    47	 * ProjectNameDisplay.vue - Editable project name display component
    48	 * 
    49	 * Displays the current project name in the app header with in-place editing.
    50	 * - Double-click to edit
    51	 * - Enter to save, Escape to cancel
    52	 * - Validates name (non-empty, reasonable length, no special characters)
    53	 * - Shows save indicator while renaming
    54	 * 
    55	 * Reference: specs/001-dihedral-learning-mvp/spec.md - Project Name Display and Editing
    56	 */
    57	
    58	interface Props {
    59	  projectName: string | null;
    60	  isRenaming?: boolean;
    61	}
    62	
    63	interface Emits {
    64	  (e: 'rename', newName: string): void;
    65	}
    66	
    67	const props = withDefaults(defineProps<Props>(), {
    68	  isRenaming: false
    69	});
    70	
    71	const emit = defineEmits<Emits>();
    72	
    73	const isEditing = ref(false);
    74	const editedName = ref('');
    75	const nameInput = ref<HTMLInputElement | null>(null);
    76	
    77	// Display name (default to "Untitled Project" if no name)
    78	const displayName = computed(() => {
    79	  return props.projectName || 'Untitled Project';
    80	});
    81	
    82	// Validation: non-empty, no file system reserved characters
    83	const isValidName = computed(() => {
    84	  if (!editedName.value.trim()) {
    85	    return false;
    86	  }
    87	  
    88	  // File system reserved characters: / \ : * ? " < > |
    89	  const invalidChars = /[\/\\:*?"<>|]/;
    90	  return !invalidChars.test(editedName.value);
    91	});
    92	
    93	// Start editing mode
    94	function startEditing() {
    95	  if (props.isRenaming) {
    96	    return; // Don't allow editing while a rename is in progress
    97	  }
    98	  
    99	  isEditing.value = true;
   100	  editedName.value = displayName.value;
   101	  
   102	  // Focus and select the input on next tick
   103	  nextTick(() => {
   104	    if (nameInput.value) {
   105	      nameInput.value.focus();
   106	      nameInput.value.select();
   107	    }
   108	  });
   109	}
   110	
   111	// Save the edited name
   112	function saveEdit() {
   113	  if (!isValidName.value) {
   114	    return;
   115	  }
   116	  
   117	  const trimmedName = editedName.value.trim();
   118	  
   119	  // Only emit if the name actually changed
   120	  if (trimmedName !== props.projectName) {
   121	    emit('rename', trimmedName);
   122	  }
   123	  
   124	  isEditing.value = false;
   125	}
   126	
   127	// Cancel editing and revert to original name
   128	function cancelEdit() {
   129	  isEditing.value = false;
   130	  editedName.value = '';
   131	}
   132	
   133	// Watch for external requests to start editing (e.g., from Ctrl+R shortcut)
   134	watch(() => props.isRenaming, (renaming) => {
   135	  if (renaming && isEditing.value) {
   136	    // If rename fails, stay in edit mode
   137	    // If rename succeeds, the parent will update projectName and we'll exit edit mode
   138	  }
   139	});
   140	
   141	// Expose method to start editing (for parent component to trigger via Ctrl+R)
   142	defineExpose({
   143	  startEditing
   144	});
   145	</script>
   146	
