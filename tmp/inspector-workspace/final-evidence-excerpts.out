   911	    expectSourceContains(appSource, "import { useAppCanvasSession } from './composables/useAppCanvasSession'", 'App.vue');
   912	    expectSourceContains(appSource, 'const projectSession = useDriveProjectSession({', 'App.vue');
   913	    expectSourceContains(appSource, 'const canvasSession = useAppCanvasSession({', 'App.vue');
   914	    expectSourceContains(appSource, 'useAppKeyboardShortcuts({', 'App.vue');
   915	    expectSourceContains(appSource, 'stopAutoSave();', 'App.vue unmount cleanup delegates autosave teardown to session composable');
