     1	/**
     2	 * Symbolic path types for element addressing
     3	 */
     4	export type ElementPath = string;  // Format: "/world/elements2D/{id}" or "/world/elements3D/{id}"
     5	export type ActionPath = string;   // Format: "/process/subprocess/{id}/actionGroup/{id}/action/{id}"
     6	export type PlanePath = string;    // Format: "/world/planes/{id}"
     7	
     8	/**
     9	 * Base interface for all 2D elements (without discriminator)
    10	 */
    11	export interface Element2DBase {
    12	  id: string;
    13	  name: string;
    14	  planeId: string;
    15	  createdBy: string;             // ActionId that created this element
    16	  infeasible: boolean;
    17	  visualStyle: VisualStyle;
    18	}
    19	
    20	/**
    21	 * === POINT 2D CONSTRUCTIONS ===
    22	 */
    23	
    24	/**
    25	 * Free point - placed at arbitrary location
    26	 */
    27	export interface Point2DFree extends Element2DBase {
    28	  kind: 'Point2DFree';
    29	  x: number;
    30	  y: number;
    31	}
    32	
    33	/**
    34	 * Point constrained to lie on an element
    35	 */
    36	export interface Point2DOnElement extends Element2DBase {
    37	  kind: 'Point2DOnElement';
    38	  hostElementId: string;         // Line, segment, or circle
    39	  parameter: number;             // Position along element (0-1 for segments, angle for circles)
    40	}
--- processStore
     1	import { defineStore } from "pinia";
     2	import { CommandStack } from "../commands/CommandStack";
     3	import type { Command } from "../commands/Command";
     4	
     5	interface ProcessProjectionState {
     6	  commandHistory: CommandStack;
     7	}
     8	
     9	/**
    10	 * Runtime command-history projection.
    11	 *
    12	 * Process tree/domain state is reducer-owned by ProjectStateRecord. This Pinia store does
    13	 * not duplicate or mutate the process tree; it only exposes the runtime-only
    14	 * CommandStack used by runtime callers that receive command-stack state from this store.
    15	 */
    16	export const useProcessStore = defineStore("process", {
    17	  state: (): ProcessProjectionState => ({
    18	    commandHistory: new CommandStack(),
    19	  }),
    20	
    21	  getters: {
    22	    canUndo: (state): boolean => state.commandHistory.canUndo(),
    23	    canRedo: (state): boolean => state.commandHistory.canRedo(),
    24	    undoCount: (state): number => state.commandHistory.getUndoCount(),
    25	    redoCount: (state): number => state.commandHistory.getRedoCount(),
    26	  },
    27	
    28	  actions: {
    29	    pushCommand(command: Command): void {
    30	      this.commandHistory.push(command);
    31	    },
    32	
    33	    undo(): boolean {
    34	      if (!this.commandHistory.canUndo()) return false;
    35	      this.commandHistory.undo();
    36	      return true;
    37	    },
    38	
    39	    redo(): boolean {
    40	      if (!this.commandHistory.canRedo()) return false;
    41	      this.commandHistory.redo();
    42	      return true;
    43	    },
    44	
    45	    clear(): void {
    46	      this.commandHistory.clear();
    47	    },
    48	  },
    49	});
