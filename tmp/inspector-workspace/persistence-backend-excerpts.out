    87	
    88	export interface ActionGroupRecordDTO {
    89	  id: string;
    90	  kind: 'actionGroup';
    91	  childIds: (string | null)[];
    92	  auxiliary: boolean;
    93	  createdAt: string;
    94	}
    95	
    96	export interface ActionRecordDTO {
    97	  id: string;
    98	  kind: 'action';
    99	  actionType: string;
   100	  inputIds: string[];
   101	  outputIds: string[];
   102	  parameters: JsonObjectDTO;
   103	  description: string;
   104	  createdAt: string;
