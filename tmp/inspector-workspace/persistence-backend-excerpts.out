   135	  planes: Record<string, PlaneRecordDTO>;
   136	  projectionPlanes: Record<string, ProjectionPlaneRecordDTO>;
   137	  elements: Record<string, ElementRecordDTO>;
   138	  guides: Record<string, GuideRecordDTO>;
