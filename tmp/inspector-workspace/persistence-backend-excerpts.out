   146	  contract: 'current-snapshot';
   147	  savedAt: string;
   148	  source: 'local' | 'google-drive' | 'backend' | 'test';
   149	}
   150	
   151	export interface ProjectDTO {
   152	  id: string;
   153	  name: string;
   154	  schemaVersion: '4.0.0';
   155	  createdAt: string;
   156	  updatedAt: string;
   157	  provenance: ProjectProvenanceDTO;
   158	  domain: ProjectStateRecordDTO;
