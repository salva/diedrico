   161	/**
   162	 * Project metadata for listing projects
   163	 */
   164	export interface ProjectMetadata {
   165	  id: string;
   166	  name: string;
   167	  createdAt: string;
   168	  updatedAt: string;
   169	}
   170	
   171	/**
   172	 * Create a new empty project with default current reducer snapshot values
   173	 */
   174	export function createEmptyProject(name: string): ProjectDTO {
   175	  const now = new Date().toISOString();
   176	  const id = `project_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
   177	
   178	  return {
   179	    id,
   180	    name,
   181	    schemaVersion: '4.0.0',
   182	    createdAt: now,
   183	    updatedAt: now,
   184	    provenance: {
   185	      app: 'diedrico',
   186	      contract: 'current-snapshot',
   187	      savedAt: now,
   188	      source: 'backend'
   189	    },
   190	    domain: {
   191	      schemaVersion: '4.0.0',
   192	      planes: {
   193	        P_H: {
   194	          id: 'P_H',
   195	          kind: 'horizontal',
   196	          label: 'Horizontal Plane',
   197	          normal: { x: 0, y: 0, z: 1 },
   198	          origin: { x: 0, y: 0, z: 0 },
   199	          metadata: {}
   200	        },
   201	        P_V: {
   202	          id: 'P_V',
   203	          kind: 'vertical',
   204	          label: 'Vertical Plane',
   205	          normal: { x: 0, y: 1, z: 0 },
   206	          origin: { x: 0, y: 0, z: 0 },
   207	          metadata: {}
   208	        }
   209	      },
   210	      projectionPlanes: {
   211	        P_H: {
   212	          id: 'P_H',
   213	          sourcePlaneId: 'P_H',
   214	          label: 'Horizontal Projection',
   215	          basisU: { x: 1, y: 0, z: 0 },
   216	          basisV: { x: 0, y: 1, z: 0 },
   217	          origin: { x: 0, y: 0, z: 0 },
   218	          elementIds: [],
   219	          guideIds: [],
   220	          metadata: {}
