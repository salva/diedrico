   270	/**
--- project model
     1	/**
     2	 * Current Project Data Transfer Object.
     3	 *
     4	 * A project persists one authoritative reducer-owned ProjectStateRecord snapshot
     5	 * plus provenance metadata. Undo/redo command stacks are runtime-only and are
     6	 * not part of this DTO.
     7	 */
     8	
     9	export type JsonPrimitiveDTO = string | number | boolean | null;
    10	export type JsonValueDTO = JsonPrimitiveDTO | JsonObjectDTO | JsonArrayDTO;
    11	export interface JsonObjectDTO {
    12	  [key: string]: JsonValueDTO;
    13	}
    14	export type JsonArrayDTO = JsonValueDTO[];
    15	
    16	export type ProjectElementKindDTO = 'point' | 'line' | 'segment' | 'circle';
    17	export type ProjectGuideKindDTO = 'line' | 'circle' | 'point' | 'custom';
    18	export type ProcessNodeRecordKindDTO = 'subprocess' | 'actionGroup' | 'action';
    19	export type DependencyNodeKindDTO = 'element' | 'action';
    20	
    21	export interface Vector3RecordDTO {
    22	  x: number;
    23	  y: number;
    24	  z: number;
    25	}
    26	
    27	export interface PlaneRecordDTO {
    28	  id: string;
    29	  kind: 'horizontal' | 'vertical' | 'auxiliary';
    30	  label?: string;
    31	  normal: Vector3RecordDTO;
    32	  origin: Vector3RecordDTO;
    33	  metadata: JsonObjectDTO;
    34	}
    35	
    36	export interface ProjectionPlaneRecordDTO {
    37	  id: string;
    38	  sourcePlaneId: string;
    39	  label?: string;
    40	  basisU: Vector3RecordDTO;
    41	  basisV: Vector3RecordDTO;
    42	  origin: Vector3RecordDTO;
    43	  elementIds: string[];
    44	  guideIds: string[];
    45	  metadata: JsonObjectDTO;
    46	}
    47	
    48	export interface ElementRecordDTO {
    49	  id: string;
    50	  planeId: string;
    51	  kind: ProjectElementKindDTO;
    52	  constructionType: string;
    53	  label?: string;
    54	  visible: boolean;
    55	  definition: JsonObjectDTO;
    56	  dependencyIds: string[];
    57	  producedByActionId?: string;
    58	}
    59	
    60	export interface GuideRecordDTO {
    61	  id: string;
    62	  planeId: string;
    63	  kind: ProjectGuideKindDTO;
    64	  constructionType: string;
    65	  visible: boolean;
    66	  definition: JsonObjectDTO;
    67	  dependencyIds: string[];
    68	  producedByActionId?: string;
    69	}
    70	
    71	export interface ProcessTreeRecordDTO {
    72	  rootId: string;
    73	  nodes: Record<string, ProcessNodeRecordDTO>;
    74	  version: number;
    75	}
    76	
    77	export type ProcessNodeRecordDTO = SubprocessRecordDTO | ActionGroupRecordDTO | ActionRecordDTO;
    78	
    79	export interface SubprocessRecordDTO {
    80	  id: string;
    81	  kind: 'subprocess';
    82	  name: string;
