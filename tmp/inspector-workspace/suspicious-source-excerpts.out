    46	<script setup lang="ts">
    47	import { ref, computed, onMounted, onUnmounted } from 'vue';
    48	import type { ToolFamilyConfig } from '@/types/ToolConfig';
    49	import { useToolStore } from '@/stores/toolStore';
    50	
    51	// Props
    52	const props = defineProps<{
    53	  family: ToolFamilyConfig;
    54	}>();
    55	
    56	// Store
    57	const toolStore = useToolStore();
    58	
    59	// State
    60	const isDropdownOpen = ref(false);
    61	
    62	// Computed
    63	const isAnyToolActive = computed(() => {
    64	  return props.family.tools.some(tool => toolStore.isToolActive(tool.id as any));
    65	});
    66	
    67	const activeToolConfig = computed(() => {
    68	  // Find currently active tool in family
    69	  const activeTool = props.family.tools.find(tool => toolStore.isToolActive(tool.id as any));
    70	  if (activeTool) return activeTool;
    71	  
    72	  // Otherwise, use last-used or default
    73	  const lastUsed = toolStore.getLastUsedTool(props.family.id);
    74	  if (lastUsed) {
    75	    return props.family.tools.find(tool => tool.id === lastUsed);
    76	  }
    77	  
    78	  // Fallback to default
    79	  return props.family.tools.find(tool => tool.id === props.family.defaultTool);
    80	});
    81	
    82	const activeToolIcon = computed(() => {
    83	  const icon = activeToolConfig.value?.icon || props.family.icon;
    84	  console.log('[ToolFamilyButton] activeToolIcon:', icon, 'type:', typeof icon);
    85	  return icon;
    86	});
    87	
    88	const activeToolTooltip = computed(() => {
    89	  return activeToolConfig.value?.tooltip || `${props.family.label} tools`;
    90	});
    91	
    92	// Methods
    93	function activateLastUsed() {
    94	  toolStore.activateToolFamily(props.family.id);
    95	  isDropdownOpen.value = false;
    96	}
    97	
    98	function toggleDropdown() {
    99	  isDropdownOpen.value = !isDropdownOpen.value;
   100	  if (isDropdownOpen.value) {
   101	    console.log('[ToolFamilyButton] Dropdown opened for family:', props.family.id);
   102	    console.log('[ToolFamilyButton] Tools in family:', props.family.tools);
   103	  }
   104	}
   105	
   106	function selectTool(toolId: string) {
   107	  console.log('[ToolFamilyButton] Selecting tool:', toolId);
   108	  toolStore.selectSubTool(props.family.id, toolId);
   109	  isDropdownOpen.value = false;
   110	}
