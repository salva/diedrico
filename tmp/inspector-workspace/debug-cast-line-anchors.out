  1120	/**
  1121	 * Fit to View - Zoom and pan to show all elements (T274)
  1122	 * 
  1123	 * Calculates bounding box of all rendered elements and adjusts viewport
  1124	 * to fit them with 10% padding on all sides.
  1125	 */
  1126	function fitToView() {
  1127	  console.log('[SvgCanvas] fitToView called');
  1128	  
  1129	  // Get all rendered primitives
  1130	  const allPrimitives = primitives.value;
  1131	  
  1132	  if (allPrimitives.length === 0) {
  1133	    // No elements - reset to default view
  1134	    console.log('[SvgCanvas] No elements to fit, resetting to default view');
  1135	    viewStore.setZoom(1.0);
  1136	    viewStore.setPan(0, 0);
  1137	    return;
  1138	  }
  1139	  
  1140	  // Calculate bounding box of all primitives in paper coordinates
  1141	  let minX = Infinity;
  1142	  let minY = Infinity;
  1143	  let maxX = -Infinity;
  1144	  let maxY = -Infinity;
  1145	  
  1146	  for (const prim of allPrimitives) {
  1147	    if (prim.type === 'point') {
  1148	      minX = Math.min(minX, prim.position.x);
  1149	      minY = Math.min(minY, prim.position.y);
  1150	      maxX = Math.max(maxX, prim.position.x);
  1151	      maxY = Math.max(maxY, prim.position.y);
  1152	    } else if (prim.type === 'segment') {
  1153	      minX = Math.min(minX, prim.point1.x, prim.point2.x);
  1154	      minY = Math.min(minY, prim.point1.y, prim.point2.y);
  1155	      maxX = Math.max(maxX, prim.point1.x, prim.point2.x);
  1156	      maxY = Math.max(maxY, prim.point1.y, prim.point2.y);
  1157	    } else if (prim.type === 'line') {
  1158	      minX = Math.min(minX, prim.point.x);
  1159	      minY = Math.min(minY, prim.point.y);
  1160	      maxX = Math.max(maxX, prim.point.x);
  1161	      maxY = Math.max(maxY, prim.point.y);
  1162	    } else if (prim.type === 'circle') {
  1163	      minX = Math.min(minX, prim.cx - prim.radius);
  1164	      minY = Math.min(minY, prim.cy - prim.radius);
  1165	      maxX = Math.max(maxX, prim.cx + prim.radius);
  1166	      maxY = Math.max(maxY, prim.cy + prim.radius);
  1167	    }
  1168	    // Note: Guides extend to infinity, so we skip them in bounding box calculation
  1169	  }
  1170	  
  1171	  // Check if we found any valid bounds
  1172	  if (!isFinite(minX) || !isFinite(minY) || !isFinite(maxX) || !isFinite(maxY)) {
  1173	    console.log('[SvgCanvas] No valid bounds found, resetting to default view');
  1174	    viewStore.setZoom(1.0);
  1175	    viewStore.setPan(0, 0);
  1176	    return;
  1177	  }
  1178	  
  1179	  // Calculate bounding box dimensions
  1180	  const boxWidth = maxX - minX;
  1181	  const boxHeight = maxY - minY;
  1182	  
  1183	  // Add padding (10% on each side = 0.9 content fill factor)
  1184	  const paddingFactor = 0.9;
  1185	  
  1186	  // Calculate zoom to fit both dimensions
  1187	  const zoomX = (canvasWidth.value / boxWidth) * paddingFactor;
  1188	  const zoomY = (canvasHeight.value / boxHeight) * paddingFactor;
  1189	  const newZoom = Math.min(zoomX, zoomY, 4.0); // Cap at 4x zoom
  1190	  
  1191	  // Calculate pan to center the bounding box
  1192	  const boxCenterX = (minX + maxX) / 2;
  1193	  const boxCenterY = (minY + maxY) / 2;
  1194	  const newPanX = (canvasWidth.value / (2 * newZoom)) - boxCenterX;
  1195	  const newPanY = (canvasHeight.value / (2 * newZoom)) - boxCenterY;
  1196	  
  1197	  console.log('[SvgCanvas] Fit to view:', {
  1198	    bounds: { minX, minY, maxX, maxY },
  1199	    boxSize: { width: boxWidth, height: boxHeight },
  1200	    viewport: { width: canvasWidth.value, height: canvasHeight.value },
  1201	    newZoom,
  1202	    newPan: { x: newPanX, y: newPanY },
  1203	  });
  1204	  
  1205	  // Apply new viewport transform
