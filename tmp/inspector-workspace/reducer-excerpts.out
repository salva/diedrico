     3	export type ProjectStateRuntimeListener = (snapshot: ProjectStateRuntimeSnapshot) => void;
     4	
     5	export interface ProjectStateRuntimeSnapshot {
     6	  readonly state: ProjectStateRecord;
     7	  readonly version: number;
     8	}
     9	
    10	export interface ProjectStateRuntimeHolderOptions {
    11	  readonly initialState?: ProjectStateRecord;
    12	}
    13	
    14	/**
    15	 * Live runtime owner for reducer ProjectStateRecord data.
    16	 *
    17	 * This holder intentionally stores only the immutable ProjectStateRecord plus
    18	 * runtime metadata needed by the app shell. It must not retain mutable geometry,
    19	 * construction-history, dependency-service, or adapter instances.
    20	 */
    21	export class ProjectStateRuntimeHolder {
    22	  #state: ProjectStateRecord;
    23	  #version = 0;
    24	  #listeners = new Set<ProjectStateRuntimeListener>();
    25	
    26	  constructor(options: ProjectStateRuntimeHolderOptions = {}) {
    27	    this.#state = options.initialState
    28	      ? createProjectStateRecord(cloneProjectStateRecord(options.initialState))
    29	      : emptyProjectState();
    30	  }
    31	
    32	  get state(): ProjectStateRecord {
    33	    return this.#state;
    34	  }
    35	
    36	  get version(): number {
    37	    return this.#version;
    38	  }
    39	
    40	  snapshot(): ProjectStateRuntimeSnapshot {
    41	    return { state: this.#state, version: this.#version };
    42	  }
    43	
    44	  commit(nextState: ProjectStateRecord): ProjectStateRecord {
    45	    const committedState = createProjectStateRecord(cloneProjectStateRecord(nextState));
    46	    if (committedState === this.#state) return this.#state;
    47	
    48	    this.#state = committedState;
    49	    this.#version += 1;
    50	    this.#emit();
    51	    return this.#state;
    52	  }
    53	
    54	  reset(nextState: ProjectStateRecord = emptyProjectState()): ProjectStateRecord {
    55	    return this.commit(nextState);
    56	  }
    57	
    58	  subscribe(listener: ProjectStateRuntimeListener): () => void {
    59	    this.#listeners.add(listener);
    60	    return () => {
    61	      this.#listeners.delete(listener);
    62	    };
    63	  }
    64	
    65	  #emit(): void {
    66	    const snapshot = this.snapshot();
    67	    for (const listener of this.#listeners) {
    68	      listener(snapshot);
    69	    }
    70	  }
    71	}
