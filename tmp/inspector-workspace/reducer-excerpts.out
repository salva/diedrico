   703	function asVector2(value: unknown): ProjectStateVector2Dto | undefined {
   704	  if (typeof value !== 'object' || value === null) return undefined;
   705	  const vector = value as { readonly x?: unknown; readonly y?: unknown; readonly z?: unknown };
   706	  if (typeof vector.x !== 'number' || typeof vector.y !== 'number') return undefined;
   707	  return { x: vector.x, y: vector.y, z: typeof vector.z === 'number' ? vector.z : 1 };
   708	}
